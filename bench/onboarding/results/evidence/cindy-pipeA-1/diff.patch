+"""#
+
+    private static func cnProbe(_ variant: String) throws -> VendorProbeRecipe {
+        try #require(VendorProbeRegistry.recipes.first {
+            $0.bundleID == "com.xd.cindycn" && $0.variant == variant
+        })
+    }
+
+    @Test func cnIsOneStableProbePerArchitecture() throws {
+        let arm = try Self.cnProbe("arm64")
+        let x64 = try Self.cnProbe("x64")
+        #expect(arm.channel == .stable && x64.channel == .stable)
+        #expect(arm.recipeID == "vendor:com.xd.cindycn:stable:arm64")
+        #expect(x64.recipeID == "vendor:com.xd.cindycn:stable:x64")
+        #expect(arm.url.absoluteString == "https://hotfix.cindy.com.cn/cindy/manifest-darwin-arm64.json")
+        #expect(x64.url.absoluteString == "https://hotfix.cindy.com.cn/cindy/manifest-darwin-x64.json")
+        #expect(arm.runs(onOS: "14.0.0", arch: .arm64) && !arm.runs(onOS: "14.0.0", arch: .x86_64))
+        #expect(x64.runs(onOS: "14.0.0", arch: .x86_64) && !x64.runs(onOS: "14.0.0", arch: .arm64))
+        #expect(arm.install?.kind == .dmg && x64.install?.kind == .dmg)
+        #expect(arm.install?.checksumFormat == .sha256Hex)
+        #expect(x64.install?.checksumFormat == .sha256Hex)
+    }
+
+    @Test(arguments: ["arm64", "x64"])
+    func cnPatternsReadTheAppBlockNotTheBundledToolsOnes(_ variant: String) throws {
+        let recipe = try Self.cnProbe(variant)
+        let body = variant == "arm64" ? Self.armManifest : Self.x64Manifest
+        // `codex` (0.145.0) and `claudeCode` (2.1.296) come first in the body.
+        #expect(VendorProbeRecipe.extractVersion(from: body, pattern: recipe.versionPattern) == "0.1.104")
+
+        let spec = try #require(recipe.install)
+        guard case let .bodyPatternRelative(filePattern, base) = spec.urlSource else {
+            Issue.record("expected a bodyPatternRelative install source"); return
+        }
+        #expect(base.absoluteString == "https://hotfix.cindy.com.cn/cindy/")
+        let file = try #require(VendorProbeRecipe.extractVersion(from: body, pattern: filePattern))
+        #expect(file == "app/darwin-\(variant)/cindy-0.1.104-\(variant).dmg")
+
+        // The digests the GitHub assets of the same two dmgs publish, and that the
+        // downloaded files hash to.
+        let checksumPattern = try #require(spec.checksumPattern)
+        let digest = try #require(VendorProbeRecipe.extractVersion(from: body, pattern: checksumPattern))
+        #expect(digest == (variant == "arm64"
+            ? "8f0704e311a4c960a202cb632cf1b8d164f095d9354eee62d9c8475d9cf46331"
+            : "565f86c74382d22b5a2423053b58224915f904c80aa04da173ea032f2d71f1a5"))
+    }
+
+    /// Each architecture's patterns are pinned to its own directory, so a body
+    /// served for the other architecture reads no install URL and no digest rather
+    /// than the wrong one.
+    @Test func cnInstallPatternsDoNotReadTheOtherArchitecturesBody() throws {
+        for (variant, foreign) in [("arm64", Self.x64Manifest), ("x64", Self.armManifest)] {
+            let probe = try Self.cnProbe(variant)
+            let spec = try #require(probe.install)
+            let checksumPattern = try #require(spec.checksumPattern)
+            guard case let .bodyPatternRelative(filePattern, _) = spec.urlSource else {
+                Issue.record("expected a bodyPatternRelative install source"); return
+            }
+            #expect(VendorProbeRecipe.extractVersion(from: foreign, pattern: filePattern) == nil)
+            #expect(VendorProbeRecipe.extractVersion(from: foreign, pattern: checksumPattern) == nil)
+        }
+    }
+
+    @Test func cnVersionPatternIsAnchoredInsideTheAppBlock() throws {
+        let pattern = try Self.cnProbe("arm64").versionPattern
+        // Without the anchor the first `"version"` in the body is codex's.
+        #expect(VendorProbeRecipe.extractVersion(from: Self.betaManifest, pattern: pattern) == "0.1.108")
+        #expect(VendorProbeRecipe.extractVersion(
+            from: Self.armManifest, pattern: #""version"\s*:\s*"([0-9]+(?:\.[0-9]+)+)""#) == "0.145.0")
+    }
+
+    @Test func cnReadsTheReleaseNotesTheGlobalRecipeDoes() throws {
+        let cn = try #require(ChangelogRecipeRegistry.recipes.first { $0.bundleID == "com.xd.cindycn" })
+        let global = try #require(ChangelogRecipeRegistry.recipes.first { $0.bundleID == "com.xd.cindy" })
+        #expect(cn.source == global.source && cn.structuredFormat == .gitHubReleases)
+        #expect(cn.skipSections == ["PRs"])
+    }
+}
