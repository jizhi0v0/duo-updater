+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/wang-jianing-app-OpenInTerminal.swift
@@ -0,0 +1,47 @@
+import Foundation
+
+enum wang_jianing_app_OpenInTerminal {
+    static let set = AppRecipeSet(
+        family: "wang-jianing-app-OpenInTerminal",
+        githubRules: [
+        // OpenInTerminal — Finder-toolbar app. No SUFeedURL, no Sparkle.framework, and
+        // the Homebrew cask (`openinterminal`) tracks the same GitHub release. v-tags
+        // match CFBundleShortVersionString (CFBundleVersion is a constant `1`). Single
+        // stable track. The repo ships three apps as TWO release series: this one under
+        // `v2.x`, and OpenInTerminal-Lite + OpenInEditor-Lite together under `v1.x`
+        // (rules below). GitHub's "Latest" badge goes to whichever was published last
+        // and the repo's release procedure moves it back to the main app by hand, so
+        // `/releases/latest` can briefly be a Lite release. Two things keep the series
+        // apart: the asset name (`OpenInTerminal.zip` is absent from a Lite release, so
+        // the source falls back to the list and walks to the main one) and the tag's
+        // major, which also keeps the other series out of the release history the
+        // fallback builds. If the app ever reaches 3.x the pattern stops matching and
+        // the row goes unknown loudly, rather than quietly reading the wrong series.
+        // Universal zip, notarized. The signing Team changed at 2.3.9
+        // (Q33U8R4U57 → C8VX3ZLX5U), so the Team-ID gate refuses one-click for 2.3.8
+        // and older copies; they update by hand once.
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.app.OpenInTerminal",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            versionPattern: #"^v(2(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^OpenInTerminal\.zip$"#,
+            installerKind: .zip),
+        // OpenInTerminal-Lite and OpenInEditor-Lite — separate apps (bundle ids
+        // `…OpenInTerminal-Lite` / `…OpenInEditor-Lite`), one `v1.x` release carrying both
+        // zips. Same Team change as the main app, at 1.2.8 (1.2.7 was Q33U8R4U57). Each
+        // check is a `/releases/latest` call plus the list call: the badge is on the main
+        // release, which has no Lite asset, so the fallback is the normal path here.
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.app.OpenInTerminal-Lite",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            versionPattern: #"^v(1(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^OpenInTerminal-Lite\.zip$"#,
+            installerKind: .zip),
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.app.OpenInEditor-Lite",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            versionPattern: #"^v(1(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^OpenInEditor-Lite\.zip$"#,
+            installerKind: .zip),
+        ])
+}
diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
index 69eb47c..b88e46a 100644
--- a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
@@ -404,7 +404,20 @@ public extension GitHubReleaseRule {
     /// decides a row is orphaned when no rule produces its key. A second,
     /// separately-maintained spelling of this string would make the prune delete
     /// live rows the first time the two drifted.
-    var recipeID: String { "github:\(slug):\(channel.rawValue)" }
+    ///
+    /// Several apps built from one repo on the same channel (OpenInTerminal and its
+    /// two Lite siblings) would share this key, and with it one `RecipeHealth` row and
+    /// one baseline entry — the first to fail would hide the others. When the
+    /// registry holds more than one rule for this repo AND channel, the bundle id is
+    /// appended, as `VendorProbeRecipe.recipeID` appends a `variant`; every rule that
+    /// is alone on its repo and channel keeps the key it always had.
+    var recipeID: String {
+        let base = "github:\(slug):\(channel.rawValue)"
+        let siblings = GitHubReleaseRegistry.rules.filter {
+            $0.slug == slug && $0.channel == channel
+        }
+        return siblings.count > 1 ? "\(base):\(bundleID)" : base
+    }
 }
 
