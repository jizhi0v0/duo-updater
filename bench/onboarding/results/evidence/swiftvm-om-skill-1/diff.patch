diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift
new file mode 100644
index 0000000..3e5e532
--- /dev/null
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift
@@ -0,0 +1,47 @@
+import Foundation
+
+/// SwiftVM (`com.swiftvm.app`) — a Sparkle app whose beta builds declare their
+/// own feed, in which EVERY item is tagged `<sparkle:channel>beta</sparkle:channel>`.
+///
+/// What SwiftVM does (read from `swiftvm-app/swiftvm`): the channel is a property
+/// of the build, not a setting. `App/Updates/UpdateService.swift`'s
+/// `allowedChannels` returns `["beta"]` when the copy's
+/// CFBundleShortVersionString contains `-beta.`, otherwise nothing; and the
+/// release workflows bake the feed in per train — `release.yml` builds with
+/// `releases/latest/download/appcast.xml` (untagged items), `release-beta.yml`
+/// with `releases/download/beta-channel/appcast-beta.xml` (all tagged `beta` by
+/// `scripts/generate-appcast.sh`).
+///
+/// Why a binding is needed at all: without one, `SparkleAppcastSource` infers
+/// the channel from the installed build's own feed item. That works while the
+/// beta appcast lists the build — it accumulates today (7 items, 2026-10-14) —
+/// but the workflows write a fresh one-item appcast whenever fetching the
+/// previous one fails. A beta copy absent from it falls back to the default
+/// channel, matches nothing in an all-tagged feed, and reads unknown: CodeEdit's
+/// failure.
+///
+/// The declared feed stands in for the version check the app makes: both are
+/// stamped by the same workflow, and the resolver is handed the feed keys, not
+/// the version. Beta feed → `.beta`, whose tag is derived
+/// (`ReleaseChannel.beta.rawValue`, the spelling the vendor's script writes), so
+/// no tag is declared by hand. Anything else → nil: a stable copy stays on the
+/// untagged items by inference, which is all SwiftVM's own updater allows.
+///
+/// Not in `boundBundleIDs`, same as CodeEdit: nothing a user sets changes the answer.
+enum SwiftVMChannel {
+    static let bundleID = "com.swiftvm.app"
+
+    static let betaFeed = URL(
+        string: "https://github.com/swiftvm-app/swiftvm/releases/download/beta-channel/appcast-beta.xml")!
+
+    /// The feed keys of the real 1.3.0 and 1.4.0-beta.37 bundles (2026-10-14),
+    /// for `ChannelBinding.allResolutions`, which enumerates without a bundle.
+    static let stableBundleFeeds: [String: URL] = [
+        "SUFeedURL": URL(string: "https://github.com/swiftvm-app/swiftvm/releases/latest/download/appcast.xml")!,
+    ]
+    static let betaBundleFeeds: [String: URL] = ["SUFeedURL": betaFeed]
+
+    static func resolve(bundleFeeds: [String: URL]) -> ResolvedChannel? {
+        bundleFeeds["SUFeedURL"] == betaFeed ? ResolvedChannel(channel: .beta) : nil
+    }
+}
