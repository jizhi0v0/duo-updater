    "Released sometime between %@ and %@ — estimated from when we detected the change, not a vendor date.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Irgendwann zwischen %@ und %@ veröffentlicht – geschätzt ab dem Zeitpunkt, an dem wir die Änderung bemerkt haben, nicht das Datum des Anbieters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se publicó entre %@ y %@; es una estimación basada en cuándo detectamos el cambio, no una fecha del proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publiée entre %@ et %@ — estimation basée sur le moment où le changement a été détecté, pas une date de l'éditeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblicata tra %@ e %@: stima basata su quando abbiamo rilevato il cambiamento, non una data del produttore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から %@ の間にリリースされたと推定されます — これはベンダーの公開日ではなく、変更を検知した時点からの推定です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lançada em algum momento entre %@ e %@ — estimado a partir de quando detectamos a mudança, não uma data do fornecedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выпущено где-то между %@ и %@ — оценка на основе момента обнаружения изменения, а не даты поставщика."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile %@ arasında bir zamanda yayımlandı — geliştiricinin verdiği bir tarih değil, değişikliği fark ettiğimiz zamana göre tahmin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布时间在 %@ 到 %@ 之间 — 根据我们检测到变化的时间估算，而非厂商公布的日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "於 %@ 到 %@ 之間發行——依我們偵測到變化的時間估算，並非廠商提供的日期。"
          }
        }
      }
    },
    "Detected %@. The vendor dates this release %@, after we had already seen it, so the detection time is shown instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkannt am %@. Der Anbieter datiert diese Version auf %@ – später, als wir sie bereits gesehen hatten –, daher wird der Erkennungszeitpunkt angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected %@. The vendor dates this release %@, after we had already seen it, so the detection time is shown instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectada el %@. El proveedor fecha esta versión el %@, después de que ya la hubiéramos visto, así que se muestra la hora de detección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détectée le %@. L’éditeur date cette version du %@, après que nous l’avions déjà vue ; l’heure de détection est donc affichée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevata il %@. Il produttore data questa release al %@, dopo che l’avevamo già vista, quindi viene mostrata l’ora del rilevamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に検知。ベンダーはこのリリースの日付を %@ としていますが、検知より後の日時のため、検知時刻を表示しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectada em %@. O fornecedor data esta versão de %@, depois de já a termos visto, então o horário da detecção é mostrado no lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружено %@. Поставщик датирует этот выпуск %@ — позже, чем мы его увидели, поэтому показано время обнаружения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Algılanma: %@. Geliştirici bu sürümün tarihini %@ olarak veriyor; bu, sürümü gördüğümüz andan sonra olduğu için algılanma zamanı gösteriliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测于 %@。厂商给这个版本标的日期是 %@，晚于我们首次看到它的时间，所以改为显示检测时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測於 %@。廠商為這個版本標示的日期是 %@，晚於我們首次看到它的時間，所以改為顯示偵測時間。"
          }
        }
      }
    },
    "Releases appear here as the apps you track ship them": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Releases erscheinen hier, sobald die verfolgten Apps sie veröffentlichen"
