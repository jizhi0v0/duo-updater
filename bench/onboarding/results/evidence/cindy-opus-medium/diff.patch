     /// Registry patterns whose alternation chooses between TAGS rather than
@@ -278,4 +286,23 @@ struct GitHubAssetSelectionTests {
         #expect(picked(["KeePassXC-2.7.11-9-arm64.dmg", "KeePassXC-2.7.11-10-arm64.dmg"])
                 == "KeePassXC-2.7.11-10-arm64.dmg")
     }
+
+    /// Cindy's two regions are two products with two signing Teams, so each
+    /// rule must land its own region's dmg for the host's arch, from the real
+    /// listing, or the Team-ID gate refuses every install.
+    @Test func cindyRulesPickTheirOwnRegionPerArch() throws {
+        let listing = ["cindy-0.1.104-darwin-arm64-cn.dmg", "cindy-0.1.104-darwin-arm64-global.dmg",
+                       "cindy-0.1.104-darwin-x64-cn.dmg", "cindy-0.1.104-darwin-x64-global.dmg",
+                       "cindy-0.1.104-linux-x64-global.deb", "cindy-0.1.104-win32-x64-global.exe"]
+            .map { (name: $0, url: URL(string: "https://example.invalid/\($0)")!, size: Int64?.none) }
+        for (bundleID, region) in [("com.xd.cindy", "global"), ("com.xd.cindycn", "cn")] {
+            let rule = try #require(GitHubReleaseRegistry.rules.first { $0.bundleID == bundleID })
+            let pattern = try #require(rule.installAssetPattern)
+            for (arch, token) in [(HostArch.arm64, "arm64"), (HostArch.x86_64, "x64")] {
+                #expect(GitHubReleaseRule.installableAsset(
+                    from: listing, matching: pattern, preferring: arch)?.url.lastPathComponent
+                    == "cindy-0.1.104-darwin-\(token)-\(region).dmg")
+            }
+        }
+    }
 }
