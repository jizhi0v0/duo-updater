    "%@ must quit to finish updating — click to quit it, install, and reopen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss beendet werden, um das Update abzuschließen – zum Beenden, Installieren und erneuten Öffnen klicken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ debe cerrarse para terminar de actualizar; haz clic para cerrarla, instalar y volver a abrirla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit quitter pour terminer la mise à jour — cliquez pour la quitter, installer, puis la rouvrir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deve chiudersi per completare l’aggiornamento — fai clic per chiuderla, installare e riaprirla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新を完了するには %@ を終了する必要があります — クリックすると終了・インストール・再度開くを行います"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ precisa encerrar para concluir a atualização — clique para encerrar, instalar e reabrir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ должно закрыться, чтобы завершить обновление — нажмите, чтобы закрыть, установить и открыть заново"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güncellemeyi bitirmek için kapanmalı — kapatıp yüklemek ve yeniden açmak için tıklayın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必须退出才能完成更新 — 点击以退出、安装并重新打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必須結束才能完成更新 — 按一下即可結束、安裝並重新打開"
          }
        }
      }
    },
