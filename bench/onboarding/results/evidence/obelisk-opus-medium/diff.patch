+import Foundation
+
+enum com_obelisk_app {
+    static let set = AppRecipeSet(
+        family: "com-obelisk-app",
+        changelogs: [
+        // Obelisk — GitHub releases, because the appcast's notes are unmarked
+        // Markdown in a single, rewritten-in-place <item>.
+        //
+        // Detection needs no recipe: the bundle's `SUFeedURL` is
+        // `github.com/tommy0103/obelisk/releases/latest/download/appcast-<arch>.xml`
+        // (an Electron app driving real Sparkle through `electron-sparkle-updater`),
+        // so `SparkleAppcastSource` answers. The vendor's `app/scripts/
+        // update-release.mjs` writes that feed with exactly one <item> and copies
+        // the GitHub release body into a plain `<description>`, with no
+        // `sparkle:format="markdown"`. So the source reads Markdown as HTML, finds
+        // no list structure, and the pane shows raw text for one version only.
+        //
+        // github.com/tommy0103/obelisk carries the same body (the release workflow
+        // reads it back with `gh release view --json body`) plus the history.
+        // Tags are `v<package.json version>`, so `stripLeadingV` gives
+        // `CFBundleShortVersionString`. A `-` tag is published as a GitHub
+        // prerelease, which `.gitHubReleases` already drops (none published yet).
+        //
+        // `skipSections` names the sections in these bodies that are not changes:
+        // the per-PR contributor roster ("Included work"), asset filenames
+        // ("Downloads") and install instructions. Without it the roster's bullets
+        // land in the pane as items. "Compatibility" stays: it states the macOS floor.
+        ChangelogRecipe(
+            bundleID: "com.obelisk.app",
+            source: URL(
+                string: "https://api.github.com/repos/tommy0103/obelisk/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases,
+            skipSections: [
+                "Included work", "Downloads", "Installation", "macOS installation",
+                "Install the Linux package", "Install or update the CLI", "Install the CLI",
+            ]),
+        ],
+        githubRules: [
+        // Obelisk — detection only, for copies that predate the updater.
+        //
+        // From 0.2.4 the bundle declares `SUFeedURL` and `SparkleAppcastSource`,
+        // which runs ahead of this source, answers (with the EdDSA-signed zip
+        // as the one-click route). The 0.2.2 bundle declares no feed and is ad-hoc
+        // signed with no Team ID, so without this rule it resolves to nothing;
+        // the vendor's notes say the same of every earlier build (v0.2.1:
+        // "unsigned and not notarized"), and that those copies need one manual
+        // upgrade. And
+        // the Team-ID gate would refuse an ad-hoc → Developer ID swap anyway, so
+        // no install asset is named here.
+        GitHubReleaseRule(
+            bundleID: "com.obelisk.app",
+            owner: "tommy0103", repo: "obelisk",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/ObeliskChangelogRecipeTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/ObeliskChangelogRecipeTests.swift
