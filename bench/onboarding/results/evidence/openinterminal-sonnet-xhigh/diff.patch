+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/wang-jianing-app-OpenInTerminal.swift
@@ -0,0 +1,50 @@
+import Foundation
+
+enum wang_jianing_app_OpenInTerminal {
+    static let set = AppRecipeSet(
+        family: "wang-jianing-app-OpenInTerminal",
+        githubRules: [
+        // History: docs/app-audits/wang-jianing-app-OpenInTerminal.md#历史与实测
+        // OpenInTerminal — open source (`Ji4n1ng/OpenInTerminal`), a Finder Sync
+        // toolbar app. No updater of its own (no Sparkle, no update URL anywhere
+        // in the source) and no Mac App Store listing. Homebrew's `openinterminal`
+        // cask is not `auto_updates`, so a brew-installed copy is answered by
+        // `HomebrewCaskSource` ahead of this rule and a direct download lands here.
+        //
+        // ⚠️ ONE REPO, THREE APPS, TWO TAG LINES. The main app is `v2.x` with
+        // `OpenInTerminal.zip`; `OpenInTerminal-Lite` and `OpenInEditor-Lite`
+        // (their own bundle ids, not covered here) ride a single `v1.x` release
+        // carrying two other zips. The maintainer's own release procedure says
+        // the Latest mark has to be moved back to the main app by hand after the
+        // Lite release goes out, so `/releases/latest` is this app's release only
+        // while that step is done. Two anchors make the rule independent of it:
+        //   - `versionPattern` takes the main line only (major 2 and up) and
+        //     rejects the Lite line, so a Lite tag is never read as this app's
+        //     version and never lands in its release history;
+        //   - `installAssetPattern` is anchored at both ends, so it matches
+        //     neither `OpenInTerminal-Lite.zip` nor the pre-v2.3.7 name
+        //     `OpenInTerminal.app.zip`. A Lite release therefore carries no
+        //     asset, and `settle()` falls back to the releases list and walks to
+        //     the main app's newest one. `OpenInTerminalGitHubRuleTests` pins it.
+        // The lower bound is 2 because that is where the main line starts and
+        // Lite's is 1.x; a future `v3.x` of the main app still matches.
+        //
+        // Tags are `vX.Y.Z` and equal `CFBundleShortVersionString`;
+        // `CFBundleVersion` is a constant `1` and must not be compared.
+        //
+        // One-click: the zip holds `OpenInTerminal.app`, a universal build of
+        // `wang.jianing.app.OpenInTerminal`, Developer ID signed, notarized and
+        // stapled. ⚠️ The signing Team changed at v2.3.9 (`Q33U8R4U57` before,
+        // `C8VX3ZLX5U` since — History has the packages), so `SignatureVerifier`'s
+        // same-Team gate refuses the swap from any copy older than v2.3.9. That
+        // is the gate working, not the rule failing: those copies update through
+        // `brew upgrade` or by hand once, and every release after that is
+        // same-Team.
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.app.OpenInTerminal",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            versionPattern: #"^v([2-9]\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^OpenInTerminal\.zip$"#,
+            installerKind: .zip),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift
new file mode 100644
index 0000000..b39c887
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift
@@ -0,0 +1,238 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// OpenInTerminal (`wang.jianing.app.OpenInTerminal`, `Ji4n1ng/OpenInTerminal`)
+/// shares its repository with two other apps. The main app is the `v2.x` tag
+/// line with `OpenInTerminal.zip`; `OpenInTerminal-Lite` and `OpenInEditor-Lite`
+/// ride one `v1.x` release carrying two other zips. The maintainer's release
+/// procedure says the Latest mark must be moved back to the main app by hand
+/// after the Lite release — so `/releases/latest` is this app's release only
+/// while that step is done.
+///
+/// These pin that the rule does not depend on the convention, against the tag
+/// shapes, asset names and release body the repository really publishes.
+///
+/// See `docs/app-audits/wang-jianing-app-OpenInTerminal.md` for the measurements.
+@Suite(.serialized) struct OpenInTerminalGitHubRuleTests {
+
+    private static let bundleID = "wang.jianing.app.OpenInTerminal"
+
+    /// EVERY rule this bundle id carries, and non-empty: a lookup that stops
+    /// finding anything (bundle id typo'd, family unregistered) must fail loudly
+    /// rather than leave the suite green over a rule nobody runs.
+    private static var rules: [GitHubReleaseRule] {
+        get throws {
+            let found = GitHubReleaseRegistry.rules.filter { $0.bundleID == bundleID }
+            try #require(!found.isEmpty, "\(bundleID) is no longer in GitHubReleaseRegistry")
+            return found
+        }
+    }
+
+    private static var rule: GitHubReleaseRule {
+        get throws {
+            try #require(
+                rules.first { $0.channel == .stable },
+                "\(bundleID) has no stable rule any more")
+        }
+    }
+
+    // MARK: - Tags and assets, as published
+
+    /// Main-line tags resolve to the version the bundle itself reports
+    /// (`CFBundleShortVersionString` is the tag minus its `v`), and every other
+    /// tag shape the repo has carried does not: the Lite line, and the
+    /// pre-2021 tags that have no `v`. A Lite tag read as this app's version
+    /// would be a real, newer-looking, never-installable "update".
+    @Test(arguments: [
+        ("v2.3.9", "2.3.9"), ("v2.3.8", "2.3.8"), ("v2.3.7", "2.3.7"),
+        ("v1.2.8", nil), ("v1.2.7", nil), ("v1.2.0", nil),
+        ("1.1.5", nil), ("2.2.3", nil),
+    ] as [(String, String?)])
+    func tagsResolveToTheMainLineOnly(tag: String, expected: String?) throws {
+        let rule = try Self.rule
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == expected,
+                "\(tag)")
+    }
+
+    /// The asset names of the main release, the Lite release and the pre-v2.3.7
+    /// main release. Only the first is this app's install: matching
+    /// `OpenInTerminal-Lite.zip` would hand the installer a different app, and
+    /// the legacy `.app.zip` spelling is a release that predates the name.
+    @Test(arguments: [
+        ("OpenInTerminal.zip", true),
+        ("OpenInTerminal-Lite.zip", false),
+        ("OpenInEditor-Lite.zip", false),
+        ("Icons.zip", false),
+        ("OpenInTerminal.app.zip", false),
+    ] as [(String, Bool)])
+    func onlyTheMainZipIsTheInstallAsset(name: String, installs: Bool) throws {
+        let pattern = try #require(try Self.rule.installAssetPattern)
+        #expect((name.range(of: pattern, options: .regularExpression) != nil) == installs, "\(name)")
+    }
+
+    @Test func theRuleIsOneClickAsAZip() throws {
+        for rule in try Self.rules {
+            #expect(rule.installAssetPattern != nil && rule.installerKind == .zip,
+                    "\(rule.bundleID): the package is a notarized zip, so the rule installs it")
+            #expect(!rule.usePrereleases,
+                    "\(rule.bundleID): the repo has no prerelease track, and a list-reading rule would take a Lite tag's neighbours")
+        }
+    }
+
+    // MARK: - Which release answers
+
+    /// Real asset names and sizes, real tags and publish times, newest first —
+    /// the interleaved order the list endpoint returns them in.
+    private static let mainBody = """
+        Changes:
+
+        - Security: Fixed an AppleScript/command injection vulnerability that allowed arbitrary command execution via a crafted folder name when opening it in a non-default terminal or an editor. Thanks to Paul Gerste ([Sonar](https://www.sonarsource.com)) for the responsible disclosure.
+        - Added support for Zed, Emacs, Kakoune, GitKraken, and cmux.
+        - Added an option to limit global keyboard shortcuts to Finder-only shortcuts. (#251, #243)
+        - Introduced a new default app icon with automatic light/dark mode support.
+        - Added an option to display the Finder context menu items in a submenu.
+        - Fixed the Finder extension icon being rendered as a template icon.
+        - Improved startup responsiveness by fetching installed applications on a background thread.
+        - Fixed the keyboard shortcut overlapping the "Open in ..." title in the status bar menu.
+        """
+
+    private struct Fixture {
+        let tag: String
+        let publishedAt: String
+        let assets: [(name: String, size: Int)]
+        let body: String
+    }
+
+    private static let releases: [Fixture] = [
+        Fixture(tag: "v1.2.8", publishedAt: "2026-07-13T12:08:48Z",
+                assets: [("OpenInEditor-Lite.zip", 9_678_900), ("OpenInTerminal-Lite.zip", 9_652_162)],
+                body: "Changes:\n\n- Added support for Zed, Emacs, Kakoune, GitKraken, and cmux.\n"),
+        Fixture(tag: "v2.3.9", publishedAt: "2026-07-13T12:08:34Z",
+                assets: [("OpenInTerminal.zip", 24_842_104)], body: mainBody),
+        Fixture(tag: "v1.2.7", publishedAt: "2025-01-07T08:30:28Z",
+                assets: [("Icons.zip", 882_027), ("OpenInEditor-Lite.zip", 5_042_235),
+                         ("OpenInTerminal-Lite.zip", 5_022_717)],
+                body: "Changes:\n\n- Support fork.\n"),
+        Fixture(tag: "v2.3.8", publishedAt: "2025-01-07T08:43:08Z",
+                assets: [("OpenInTerminal.zip", 14_683_040)],
+                body: "Happy New Year!\r\n\r\nChanges:\r\n\r\n- Support Ghostty.\r\n"),
+        Fixture(tag: "v1.2.6", publishedAt: "2023-12-27T08:21:36Z",
+                assets: [("Icons.zip", 882_027), ("OpenInEditor-Lite.zip", 4_782_358),
+                         ("OpenInTerminal-Lite.zip", 4_755_541)],
+                body: "Changes:\n\n- Support Cursor.\n"),
+        Fixture(tag: "v2.3.7", publishedAt: "2023-12-27T08:23:55Z",
+                assets: [("OpenInTerminal.zip", 14_298_586)],
+                body: "Changes:\n\n- Support Korean\n"),
+    ]
+
+    private static func json(_ release: Fixture) -> String {
+        let assets = release.assets.map {
+            #"{"name": "\#($0.name)", "size": \#($0.size), "browser_download_url": "https://github.com/Ji4n1ng/OpenInTerminal/releases/download/\#(release.tag)/\#($0.name)"}"#
+        }.joined(separator: ",")
+        // `JSONEncoder` so the body's newlines, quotes and `\r\n` are escaped the
+        // way the API sends them.
+        let body = String(data: try! JSONEncoder().encode(release.body), encoding: .utf8)!
+        return #"{"tag_name": "\#(release.tag)", "draft": false, "prerelease": false, "published_at": "\#(release.publishedAt)", "html_url": "https://github.com/Ji4n1ng/OpenInTerminal/releases/tag/\#(release.tag)", "body": \#(body), "assets": [\#(assets)]}"#
+    }
+
+    /// `/releases/latest` answers `latestTag`'s release; the list endpoint answers
+    /// all of them. Records the order the URLs were asked in.
+    private final class Repo: URLProtocol, @unchecked Sendable {
+        nonisolated(unsafe) static var latestTag = "v2.3.9"
+        nonisolated(unsafe) static var requested: [String] = []
+        private static let lock = NSLock()
+
+        static func reset(latest: String) {
+            lock.lock(); defer { lock.unlock() }
+            latestTag = latest; requested = []
+        }
+        static var urls: [String] { lock.lock(); defer { lock.unlock() }; return requested }
+
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+        override func startLoading() {
+            let url = request.url!.absoluteString
+            Self.lock.lock()
+            Self.requested.append(url)
+            let latest = Self.latestTag
+            Self.lock.unlock()
+            let body: String
+            if url.hasSuffix("/releases/latest") {
+                let release = OpenInTerminalGitHubRuleTests.releases.first { $0.tag == latest }!
+                body = OpenInTerminalGitHubRuleTests.json(release)
+            } else {
+                body = "[" + OpenInTerminalGitHubRuleTests.releases
+                    .map(OpenInTerminalGitHubRuleTests.json).joined(separator: ",") + "]"
+            }
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: 200, httpVersion: "HTTP/1.1",
+                headerFields: ["Content-Type": "application/json"])!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: Data(body.utf8))
+            client?.urlProtocolDidFinishLoading(self)
+        }
+        override func stopLoading() {}
+    }
+
+    private static func resolve(latest: String) async throws -> ProbeOutcome {
+        Repo.reset(latest: latest)
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.protocolClasses = [Repo.self]
+        configuration.urlCache = nil
+        let rule = try Self.rule
+        let source = GitHubReleasesSource(rules: [rule], session: URLSession(configuration: configuration))
+        // The host is pinned: the asset is a universal zip with no arch marker,
+        // so this holds on either architecture, but a pinned host keeps it so.
+        return await source.resolveDiagnostic(
+            rule, preferring: .arm64, allowingIntelTranslation: false)
+    }
+
+    /// The healthy round: Latest is the main app's release, one request answers.
+    @Test func whenLatestIsTheMainReleaseOneRequestAnswers() async throws {
+        let outcome = try await Self.resolve(latest: "v2.3.9")
+        let remote = try #require(outcome.remote)
+        #expect(remote.shortVersion == "2.3.9")
+        #expect(remote.downloadURL?.absoluteString
+                == "https://github.com/Ji4n1ng/OpenInTerminal/releases/download/v2.3.9/OpenInTerminal.zip")
+        #expect(remote.vendorInstallerKind == .zip)
+        #expect(!remote.requiresManualInstaller)
+        #expect(Repo.urls == ["https://api.github.com/repos/Ji4n1ng/OpenInTerminal/releases/latest"])
+    }
+
+    /// The mutation this suite exists for: the Lite release was published last
+    /// and nobody moved the Latest mark, so `/releases/latest` is `v1.2.8`. It
+    /// carries no `OpenInTerminal.zip`, so the source must go to the list and
+    /// answer the main app's newest release — not "no answer", and not 1.2.8.
+    /// Neither may the Lite tags reach the release history it backfills.
+    @Test func whenLatestIsALiteReleaseTheListAnswersTheMainApp() async throws {
+        let outcome = try await Self.resolve(latest: "v1.2.8")
+        let remote = try #require(outcome.remote)
+        #expect(remote.shortVersion == "2.3.9")
+        #expect(remote.downloadURL?.lastPathComponent == "OpenInTerminal.zip")
+        #expect(remote.downloadURL?.absoluteString.contains("/v2.3.9/") == true)
+        #expect(remote.vendorInstallerKind == .zip)
+        #expect(remote.releaseHistory.map(\.version) == ["2.3.9", "2.3.8", "2.3.7"])
+        #expect(Repo.urls.count == 2 && Repo.urls[0].hasSuffix("/releases/latest")
+                && Repo.urls[1].contains("/releases?per_page="))
+    }
+
+    // MARK: - The changelog
+
+    /// The release body is a plain `Changes:` bullet list; `GitHubMarkdownParser`
+    /// turns it into native entries and the rule needs no changelog recipe. Parsed
+    /// from the body the repository really carries for v2.3.9, through the source.
+    @Test func theReleaseBodyBecomesAStructuredChangelog() async throws {
+        let outcome = try await Self.resolve(latest: "v2.3.9")
+        let changelog = try #require(outcome.remote?.structuredChangelog)
+        #expect(changelog.itemSyntax == .markdown)
+        let entry = try #require(changelog.entries.first)
+        #expect(changelog.entries.count == 1)
+        #expect(entry.version == "2.3.9")
+        #expect(entry.items.count == 8)
+        #expect(entry.items.first?.hasPrefix("Security: Fixed an AppleScript/command injection") == true)
+        #expect(entry.items.contains("Added support for Zed, Emacs, Kakoune, GitKraken, and cmux."))
+        // `Changes:` is a lead-in line, not a note.
+        #expect(!entry.items.contains { $0.hasPrefix("Changes") })
+    }
+}
