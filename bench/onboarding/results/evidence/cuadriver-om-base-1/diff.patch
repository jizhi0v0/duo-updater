+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// Cua Driver (`com.trycua.driver`, `trycua/cua`) is released from a monorepo
+/// that flags every one of its releases `prerelease`, so the usual gates do not
+/// apply and the rule leans on its tag and asset patterns instead. Each test
+/// here pins one of those decisions against strings the vendor actually
+/// publishes.
+///
+/// See `docs/app-audits/com-trycua-driver.md` for the measurements.
+@Suite struct CuaDriverGitHubRuleTests {
+
+    /// EVERY rule this bundle id carries, not the first one: a second rule (a
+    /// nightly track, say) must not slip past the guards below. Non-empty is
+    /// required, so a lookup that stops finding anything fails loudly instead of
+    /// leaving the suite green.
+    private static var rules: [GitHubReleaseRule] {
+        get throws {
+            let found = GitHubReleaseRegistry.rules.filter { $0.bundleID == "com.trycua.driver" }
+            try #require(!found.isEmpty, "com.trycua.driver is no longer in GitHubReleaseRegistry")
+            return found
+        }
+    }
+
+    private static var stableRule: GitHubReleaseRule {
+        get throws {
+            try #require(
+                self.rules.first { $0.channel == .stable },
+                "com.trycua.driver has no stable rule any more")
+        }
+    }
+
+    /// The real v0.35.4 release body, verbatim (fetched 2026-10-14).
+    private static func releaseBody() throws -> String {
+        let url = URL(fileURLWithPath: #filePath)
+            .deletingLastPathComponent()
+            .appendingPathComponent("Fixtures/cua-driver-rs-v0.35.4-release-body.md")
+        return try String(contentsOf: url, encoding: .utf8)
+    }
+
+    /// The vendor flags every driver release `prerelease` (to keep the
+    /// monorepo's "Latest" pointer off it), so `/releases/latest` answers with a
+    /// different product. Reading the list is the only way to see the driver.
+    @Test func readsTheListBecauseEveryDriverReleaseIsFlaggedPrerelease() throws {
+        let rule = try Self.stableRule
+        #expect(rule.usePrereleases)
+        #expect(rule.channel == .stable)
+    }
+
+    /// Driver tags as published, and what the source must read out of each.
+    @Test(arguments: [
+        ("cua-driver-rs-v0.35.4", "0.35.4"),
+        ("cua-driver-rs-v0.35.2", "0.35.2"),
+        ("cua-driver-rs-v0.28.0", "0.28.0"),
+    ])
+    func realDriverTagsResolveToTheirVersion(tag: String, expected: String) throws {
+        let rule = try Self.stableRule
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == expected)
+    }
+
+    /// With GitHub's `prerelease` flag meaning nothing here, the anchored tag
+    /// pattern is the ONLY channel gate. The first four are real tags from the
+    /// same releases list; the nightly one matters most, because a nightly
+    /// bundle is stamped with the bare `x.y.z` and so carries no on-disk channel
+    /// signal. The last two are hypothetical shapes: a release candidate (only
+    /// the `$` anchor rejects it) and a prefixed tag with a plain version (only
+    /// the `^` anchor rejects it — the real nightly tag is caught by either).
+    @Test(arguments: [
+        "nightly-cua-driver-rs-v0.35.5-nightly.20261014.38513423832",
+        "cua-driver-v0.2.0",
+        "cua-spaces-v0.8.0",
+        "cua-spaces-v0.8.0-beta.5",
+        "lume-v0.6.1",
+        "cua-driver-rs-v0.36.0-rc.1",
+        "nightly-cua-driver-rs-v0.36.0",
+    ])
+    func otherTracksAndProductsAreRejected(tag: String) throws {
+        let rule = try Self.stableRule
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == nil)
+    }
+
+    /// The registry's default pattern would accept the nightly tag and read it
+    /// as a plain release — the failure the anchors exist to prevent.
+    @Test func theDefaultPatternWouldAdmitTheNightlyTrack() {
+        #expect(VendorProbeRecipe.extractVersion(
+            from: "nightly-cua-driver-rs-v0.35.5-nightly.20261014.38513423832",
+            pattern: #"v?([0-9]+(?:\.[0-9]+)+)"#) == "0.35.5")
+    }
+
+    /// The v0.35.4 asset list, verbatim. Exactly one asset may match, and it must
+    /// be the arm64-named tarball — never `-darwin-universal-binary.tar.gz`
+    /// (bare CLI, no app inside), a `.sigstore.json`, or a non-macOS build.
+    private static let v0354Assets = [
+        "checksums.txt",
+        "cua-driver-rs-0.35.4-darwin-arm64.tar.gz",
+        "cua-driver-rs-0.35.4-darwin-arm64.tar.gz.sigstore.json",
+        "cua-driver-rs-0.35.4-darwin-universal-binary.tar.gz",
+        "cua-driver-rs-0.35.4-darwin-universal-binary.tar.gz.sigstore.json",
+        "cua-driver-rs-0.35.4-darwin-universal.tar.gz",
+        "cua-driver-rs-0.35.4-darwin-universal.tar.gz.sigstore.json",
+        "cua-driver-rs-0.35.4-darwin-x86_64.tar.gz",
+        "cua-driver-rs-0.35.4-darwin-x86_64.tar.gz.sigstore.json",
+        "cua-driver-rs-0.35.4-linux-arm64-binary.tar.gz",
+        "cua-driver-rs-0.35.4-linux-arm64-binary.tar.gz.sigstore.json",
+        "cua-driver-rs-0.35.4-linux-arm64.tar.gz",
+        "cua-driver-rs-0.35.4-linux-arm64.tar.gz.sigstore.json",
+        "cua-driver-rs-0.35.4-linux-x86_64-binary.tar.gz",
+        "cua-driver-rs-0.35.4-linux-x86_64-binary.tar.gz.sigstore.json",
+        "cua-driver-rs-0.35.4-linux-x86_64.tar.gz",
+        "cua-driver-rs-0.35.4-linux-x86_64.tar.gz.sigstore.json",
+        "cua-driver-rs-0.35.4-windows-arm64-binary.zip",
+        "cua-driver-rs-0.35.4-windows-arm64-binary.zip.sigstore.json",
+        "cua-driver-rs-0.35.4-windows-arm64.zip",
+        "cua-driver-rs-0.35.4-windows-arm64.zip.sigstore.json",
+        "cua-driver-rs-0.35.4-windows-x86_64-binary.zip",
+        "cua-driver-rs-0.35.4-windows-x86_64-binary.zip.sigstore.json",
+        "cua-driver-rs-0.35.4-windows-x86_64.zip",
+        "cua-driver-rs-0.35.4-windows-x86_64.zip.sigstore.json",
+        "cua-driver-rs-v0.35.4-skills.tar.gz",
+        "cua-driver-rs-v0.35.4-skills.tar.gz.sigstore.json",
+        "cua-hyprland-plugin-0.35.4-d74a9cab3fb2e80ab7f0cef47025ec828586ea75-build-kit.tar.gz",
+        "cua-hyprland-plugin-0.35.4-d74a9cab3fb2e80ab7f0cef47025ec828586ea75-build-kit.tar.gz.sigstore.json",
+        "cua-hyprland-plugin-0.35.4-d74a9cab3fb2e80ab7f0cef47025ec828586ea75.tar.gz",
+        "cua-hyprland-plugin-0.35.4-d74a9cab3fb2e80ab7f0cef47025ec828586ea75.tar.gz.sigstore.json",
+        "cua_driver-0.35.4-py3-none-macosx_13_0_universal2.whl",
+        "cua_driver-0.35.4-py3-none-manylinux_2_31_aarch64.whl",
+        "cua_driver-0.35.4-py3-none-manylinux_2_31_x86_64.whl",
+        "cua_driver-0.35.4-py3-none-win_amd64.whl",
+        "cua_driver-0.35.4-py3-none-win_arm64.whl",
+        "install.ps1",
+        "install.ps1.sigstore.json",
+        "install.sh",
+        "install.sh.sigstore.json",
+        "python-sdk-checksums.txt",
+        "release-manifest.json",
+        "SHA256SUMS",
+        "SHA256SUMS.sigstore.json",
+        "uninstall.ps1",
+        "uninstall.ps1.sigstore.json",
+        "uninstall.sh",
+        "uninstall.sh.sigstore.json",
+        "_install-rust.sh",
+        "_install-rust.sh.sigstore.json",
+    ]
+
+    @Test func installPatternPicksExactlyTheArm64TarballOfARealRelease() throws {
+        for rule in try Self.rules {
+            let pattern = try #require(rule.installAssetPattern,
+                                       "\(rule.bundleID) (\(rule.channel)) lost its install pattern")
+            #expect(rule.installerKind == .tarGz)
+            let matched = Self.v0354Assets.filter {
+                $0.range(of: pattern, options: .regularExpression) != nil
+            }
+            #expect(matched == ["cua-driver-rs-0.35.4-darwin-arm64.tar.gz"])
+
+            let assets = Self.v0354Assets.map {
+                (name: $0, url: URL(string: "https://example.invalid/\($0)")!, size: Int64?.none)
+            }
+            let picked = GitHubReleaseRule.installableAsset(
+                from: assets, matching: pattern, preferring: .arm64, allowingIntelTranslation: false)
+            #expect(picked?.url.lastPathComponent == "cua-driver-rs-0.35.4-darwin-arm64.tar.gz")
+        }
+    }
+
+    /// The inline parse `GitHubReleasesSource` runs on the newest release: the
+    /// 16 `## Fixes` bullets and nothing from the install one-liners, the
+    /// "Why GitHub says Pre-release" note or the checksum block.
+    @Test func theRealReleaseBodyParsesToItsFixes() throws {
+        let changelog = try #require(GitHubMarkdownParser.parse(
+            body: try Self.releaseBody(), version: "0.35.4", date: "2026-10-14"))
+        let entry = try #require(changelog.entries.first)
+        #expect(entry.items.count == 16)
+        #expect(entry.items.first?.hasPrefix("print the named command's help for `<command> --help`.") == true)
+        #expect(entry.items.last?.hasPrefix("write action.json timestamp as ISO-8601 as documented.") == true)
+        for item in entry.items {
+            #expect(!item.contains("curl") && !item.contains("irm ") && !item.contains("Pre-release"),
+                    "boilerplate leaked into the notes: \(item)")
+            #expect(item.range(of: #"[0-9a-f]{64}"#, options: .regularExpression) == nil,
+                    "a checksum leaked into the notes: \(item)")
+        }
+        #expect(entry.content.contains(.heading("Fixes")))
+        #expect(!entry.content.contains(.heading("Install")))
+    }
+
+    /// Why this family carries no `ChangelogRecipe`. `.gitHubReleases` keeps
+    /// only releases whose `prerelease` flag matches the recipe's channel, and
+    /// every driver release is flagged — so a stable recipe, even with the right
+    /// `tagPattern`, decodes the real release to nothing. Flipping only the flag
+    /// proves the flag is the whole reason.
+    @Test func aGitHubReleasesRecipeWouldDropEveryDriverRelease() throws {
+        let rule = try Self.stableRule
+        func feed(prerelease: Bool) throws -> String {
+            let release: [String: Any] = [
+                "tag_name": "cua-driver-rs-v0.35.4",
+                "prerelease": prerelease,
+                "draft": false,
+                "published_at": "2026-10-14T12:32:14Z",
+                "body": try Self.releaseBody(),
+            ]
+            let data = try JSONSerialization.data(withJSONObject: [release])
+            return try #require(String(data: data, encoding: .utf8))
+        }
+        #expect(StructuredChangelogDecoder.decodeGitHubReleases(
+            try feed(prerelease: true), maxEntries: 40, tagPattern: rule.versionPattern) == nil)
+        let unflagged = StructuredChangelogDecoder.decodeGitHubReleases(
+            try feed(prerelease: false), maxEntries: 40, tagPattern: rule.versionPattern)
+        #expect(unflagged?.entries.first?.version == "0.35.4")
+        #expect(ChangelogRecipeRegistry.recipes.allSatisfy { $0.bundleID != "com.trycua.driver" })
+    }
+}
