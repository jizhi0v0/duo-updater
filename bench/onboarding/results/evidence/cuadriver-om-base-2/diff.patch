@@ -0,0 +1,68 @@
+import Foundation
+
+enum com_trycua_driver {
+    static let set = AppRecipeSet(
+        family: "com-trycua-driver",
+        githubRules: [
+        // History: docs/app-audits/com-trycua-driver.md#历史与实测
+        //
+        // Cua Driver — `CuaDriver.app` (`com.trycua.driver`), the macOS half of
+        // the `cua-driver-rs` train in the `trycua/cua` MONOREPO. The bundle
+        // carries no `SUFeedURL` and no `app-update.yml`; the vendor's own
+        // `cua-driver update --apply` just re-runs its `install.sh`, which
+        // resolves the newest `cua-driver-rs-v*` tag off this same Releases list.
+        //
+        // EVERY RELEASE IN THIS REPO IS FLAGGED `prerelease`, stable ones
+        // included, and that is the vendor's stated policy rather than a
+        // mislabel: each Cua Driver release body ends with a "Why GitHub says
+        // Pre-release" section saying the flag only keeps the monorepo's
+        // repository-wide "Latest" pointer from flipping between products, and
+        // that a plain `x.y.z` is stable. Its installer selects by tag grammar
+        // for the same reason. So `/releases/latest` can never answer for this
+        // app (it is computed with prereleases excluded), and the rule reads
+        // the list (`usePrereleases`) and lets the TAG decide the channel.
+        //
+        // With the flag useless, the pattern is the whole channel gate. The
+        // literal `cua-driver-rs-v` drops the other products (`cua-spaces-v…`,
+        // `lume-v…`, the retired Swift `cua-driver-v…` train). The nightly
+        // train's tags read `nightly-cua-driver-rs-v0.30.5-nightly.20260929.<run>`,
+        // and EACH anchor rejects them on its own: `^` the prefix, `$` the
+        // suffix. With both anchors gone, a nightly tag reads as a plain stable
+        // `0.30.5`. `$` also drops a suffixed `cua-driver-rs-v…-rc.1`, which only
+        // it can catch, so it is the load-bearing one.
+        //
+        // NIGHTLY IS NOT DETECTABLE FROM THE BUNDLE (pattern D): it ships the
+        // same bundle id, and the release workflow stamps the plist with
+        // `${VERSION%%-*}`, so a nightly copy reads a bare `0.30.5`, the same as
+        // a stable one. The choice lives in `~/.cua-driver/release-channel`,
+        // which nothing reads yet. The audit covers what that means for a copy
+        // installed from nightly.
+        //
+        // listPageSize: other products' releases land between two
+        // `cua-driver-rs-v` tags. The worst run measured is 21, so the floor is
+        // 22, and 30 leaves headroom. That costs ~2.1 MB per round, because
+        // each release here carries 30+ assets (History has the counts).
+        // `probesNewestFirst: false` for the reason Bitwarden gives: the newest
+        // release is usually another product. Only 19 of the newest 100
+        // releases (105 of 500) are `cua-driver-rs-v` tags, so a one-row probe
+        // would miss most rounds and only add a request.
+        //
+        // One-click: the `darwin-arm64` tarball holds `CuaDriver.app` one
+        // directory down (the depth `ArchiveExtractor` searches), next to loose
+        // CLI binaries that the vendor's macOS installer does not install
+        // separately. On macOS it symlinks `~/.local/bin/cua-driver` into the
+        // bundle, so swapping the bundle is the whole upgrade. The app is
+        // universal, Developer ID Team YCK386LBJ7, notarized and stapled (both
+        // releases checked are in the audit). `-binary` tarballs carry no app,
+        // and the anchors keep this pattern off them.
+        GitHubReleaseRule(
+            bundleID: "com.trycua.driver",
+            owner: "trycua", repo: "cua",
+            usePrereleases: true,
+            listPageSize: 30,
+            versionPattern: #"^cua-driver-rs-v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^cua-driver-rs-[0-9.]+-darwin-arm64\.tar\.gz$"#,
+            installerKind: .tarGz,
+            probesNewestFirst: false),
+        ])
+}
