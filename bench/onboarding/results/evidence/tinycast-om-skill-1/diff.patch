+import Foundation
+
+enum com_tinycast_app {
+    static let set = AppRecipeSet(
+        family: "com-tinycast-app",
+        githubRules: [
+        // History: docs/app-audits/com-tinycast-app.md#历史与实测
+        //
+        // Tinycast — a native launcher distributed only through this repo's
+        // Releases (and a third-party Homebrew tap that downloads the same dmg).
+        // No `SUFeedURL`: the app's own updater reads this same `/releases` list
+        // and expands the `.zip` asset itself.
+        //
+        // **Stable and beta are separate apps**, so they are two rules on two
+        // bundle ids, not one id with a channel switch. The vendor's release
+        // workflow stamps each channel with its own name and id —
+        // `Tinycast` / `com.tinycast.app` and `Tinycast Beta` /
+        // `com.tinycast.app.beta` — and they install side by side. The vendor's
+        // own `ReleaseChannel` keys on exactly those two ids, and its updater
+        // gives stable only non-prereleases and beta only prereleases; these
+        // rules follow the same split.
+        //
+        // The stable pattern is anchored at both ends. `/releases/latest`
+        // already excludes prereleases and the vendor does set the flag on every
+        // beta, so today the anchors are a second gate, not the only one: they
+        // keep a `-beta.N`, `-alpha.N` or `-sequoia` tag that ever arrives
+        // unflagged from being read as the plain version it starts with.
+        //
+        // Detection-only on both tracks, and not as a backlog item. Every
+        // package is signed with the vendor's own self-signed certificate
+        // ("Tinycast Self-Signed"): no Team Identifier, not notarized.
+        // `SignatureVerifier` gate 3 needs a Team ID on the installed copy AND
+        // the download, so it refuses every swap with `noTeamIdentifier` before
+        // comparing anything — an `installAssetPattern` here could only produce
+        // an Update button that always fails. `TinycastGitHubRuleTests` pins it.
+        //
+        // ⚠️ Known gap, stated rather than discovered: the vendor also publishes
+        // `-sequoia` builds for macOS 15 under the SAME id `com.tinycast.app`
+        // (version `0.9.7-sequoia`, `LSMinimumSystemVersion` 15.0), while every
+        // stable release requires macOS 26. Such a copy reads as `.stable` and is
+        // offered the newest stable release; on a macOS 26 Mac that is the right
+        // offer, on a macOS 15 Mac it is a version that will not launch there.
+        // `GitHubReleaseRule` has no OS floor to state that with; the audit
+        // records it.
+        GitHubReleaseRule(
+            bundleID: "com.tinycast.app",
+            owner: "abue-ammar", repo: "tinycast",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+
+        // Beta — `Tinycast Beta.app`, `com.tinycast.app.beta`. `ReleaseChannel.detect()`
+        // reads `.beta` off the bundle-id suffix, which is what admits this rule
+        // and keeps the stable one away from these copies.
+        //
+        // The pattern captures the WHOLE `x.y.z-beta.N`, because that is what the
+        // bundle's `CFBundleShortVersionString` says (the workflow stamps the
+        // full tag version as the marketing version). Capturing only `x.y.z`
+        // would compare a bare base against `x.y.z-beta.N` on disk — newer by
+        // semver — and offer the beta copy its own build. Anchored so the
+        // prerelease-flagged `-sequoia` and `-alpha.N` tags on the same list
+        // never match.
+        //
+        // listPageSize: 10 against a measured floor of 5, registered in
+        // `GitHubListPageSizeTests.measuredMinimumDepth`; History has the walk.
+        GitHubReleaseRule(
+            bundleID: "com.tinycast.app.beta",
+            owner: "abue-ammar", repo: "tinycast",
+            usePrereleases: true,
+            listPageSize: 10,
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+-beta\.[0-9]+)$"#,
+            channel: .beta),
+        ])
+}
