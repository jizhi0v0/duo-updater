@@ -0,0 +1,39 @@
+import Foundation
+
+enum io_github_tobi_disktree {
+    static let set = AppRecipeSet(
+        family: "io-github-tobi-disktree",
+        githubRules: [
+        // Shared rationale for digest-only: Recipes/org-alacritty.swift.
+
+        // disktree (tobi/disktree) — a Rust + GPUI treemap of what fills the disk.
+        // No updater of any kind: no Sparkle, no electron-builder config, no HTTP
+        // client among its dependencies. GitHub Releases is the only macOS
+        // distribution (no Homebrew cask, no MAS). Settled from source:
+        // `.github/workflows/release.yml` refuses a tag that is not `v` + the
+        // Cargo workspace version, and `xtask/src/bundle.rs` writes that same
+        // version into CFBundleShortVersionString and CFBundleVersion, so tag
+        // `v0.11.0` is the bundle's `0.11.0`. One track, no prereleases.
+        //
+        // One zip per architecture, `disktree-<v>-aarch64-macos.zip` and
+        // `…-x86_64-macos.zip`; both are matched and the source's arch preference
+        // picks this Mac's. The `.sha256` siblings and the Windows `.zip` are
+        // excluded by the `-macos\.zip$` anchor. v0.9.0/v0.9.1 carry Linux builds
+        // only, which never matters for `/releases/latest`.
+        //
+        // Ad-hoc signed, no Team ID (`spctl` rejected, no stapled ticket): CI signs
+        // with Developer ID only when the repository has signing secrets, and the
+        // releases so far were built without them. It takes `.publishedDigestOnly`:
+        // on both arches of 0.10.1 and 0.11.0 the seal verifies
+        // (`codesign --verify --deep --strict` 0), the signed identifier is
+        // io.github.tobi.disktree, the short version is the tag's, and the GitHub
+        // `digest` of every macOS zip equals the download (checked 2026-10-14).
+        // The bundle is one executable and its icon: no nested apps or helpers.
+        GitHubReleaseRule(
+            bundleID: "io.github.tobi.disktree",
+            owner: "tobi", repo: "disktree",
+            installAssetPattern: #"^disktree-[0-9.]+-(?:aarch64|x86_64)-macos\.zip$"#,
+            installerKind: .zip,
+            installTrust: .publishedDigestOnly),
+        ])
+}
