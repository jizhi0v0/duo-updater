diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift
new file mode 100644
index 0000000..4871be2
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift
@@ -0,0 +1,173 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// Tinycast (`abue-ammar/tinycast`) ships stable and beta as two apps on two
+/// bundle ids, both detection-only. Every assertion here runs against strings
+/// the vendor actually published or bundles actually carry.
+///
+/// See `docs/app-audits/com-tinycast-app.md` for the measurements.
+@Suite struct TinycastGitHubRuleTests {
+
+    private static let stableID = "com.tinycast.app"
+    private static let betaID = "com.tinycast.app.beta"
+
+    /// Every rule either id carries — not `.first` — so a rule added later for
+    /// either track is inspected too. Both ids must be present: a lookup that
+    /// silently finds nothing would leave this suite green over no rule at all.
+    private static var rules: [GitHubReleaseRule] {
+        get throws {
+            let found = GitHubReleaseRegistry.rules.filter {
+                $0.bundleID == stableID || $0.bundleID == betaID
+            }
+            try #require(found.contains { $0.bundleID == stableID },
+                         "com.tinycast.app is no longer in GitHubReleaseRegistry")
+            try #require(found.contains { $0.bundleID == betaID },
+                         "com.tinycast.app.beta is no longer in GitHubReleaseRegistry")
+            return found
+        }
+    }
+
+    private static func rule(_ bundleID: String, _ channel: ReleaseChannel) throws -> GitHubReleaseRule {
+        try #require(
+            rules.first { $0.bundleID == bundleID && $0.channel == channel },
+            "\(bundleID) has no \(channel) rule any more")
+    }
+
+    /// Every package — stable thin, stable universal, beta — is signed with the
+    /// vendor's self-signed "Tinycast Self-Signed" identity: `TeamIdentifier=not
+    /// set`, no notarization ticket. `SignatureVerifier` gate 3 throws
+    /// `noTeamIdentifier` on such a copy before comparing anything, so an
+    /// install spec here could only ever produce an Update button that fails.
+    @Test func tinycastStaysDetectionOnly() throws {
+        for rule in try Self.rules {
+            #expect(rule.installAssetPattern == nil,
+                    "\(rule.bundleID) (\(rule.channel)): Tinycast is self-signed with no Team ID — an install pattern can only fail gate 3")
+            #expect(rule.installerKind == nil,
+                    "\(rule.bundleID) (\(rule.channel)): see above")
+        }
+    }
+
+    /// Every non-prerelease tag published as of 2026-10-14, and what the stable
+    /// rule reads out of each. `extractVersion` is the call `GitHubReleasesSource`
+    /// makes on every release it walks.
+    @Test(arguments: [
+        "v0.11.19", "v0.11.12", "v0.11.3", "v0.10.23", "v0.10.20", "v0.10.15",
+        "v0.10.5", "v0.10.2", "v0.10.1", "v0.10.0", "v0.9.8", "v0.9.7", "v0.9.5",
+        "v0.9.4", "v0.9.3", "v0.9.1", "v0.9.0", "v0.7.5", "v0.7.4", "v0.7.3",
+    ])
+    func everyStableTagResolves(tag: String) throws {
+        let rule = try Self.rule(Self.stableID, .stable)
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+                == String(tag.dropFirst()))
+    }
+
+    /// The next releases, which the pattern must read without an edit: a
+    /// minor bump, a major bump, and a two-part tag.
+    @Test(arguments: [("v0.12.0", "0.12.0"), ("v1.0.0", "1.0.0"), ("v1.0", "1.0")])
+    func theNextStableTagResolves(tag: String, expected: String) throws {
+        let rule = try Self.rule(Self.stableID, .stable)
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+                == expected)
+    }
+
+    /// Prerelease-flagged tags on the same list, each of which the unanchored
+    /// default pattern reads as the plain stable version it starts with. The
+    /// `-sequoia` and `-alpha.N` ones are real tags; `-rc.1` is one the vendor
+    /// has not published, standing in for a suffix it might forget to flag.
+    @Test(arguments: ["v0.11.21-beta.120", "v0.9.7-sequoia", "v0.5.7-alpha.22", "v1.0.0-rc.1"])
+    func aPrereleaseShapedTagIsNotStable(tag: String) throws {
+        let rule = try Self.rule(Self.stableID, .stable)
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == nil)
+        // The failure the anchors guard against, spelled out.
+        #expect(VendorProbeRecipe.extractVersion(
+            from: tag, pattern: #"v?([0-9]+(?:\.[0-9]+)+)"#) != nil)
+    }
+
+    /// Real beta tags resolve to the WHOLE `x.y.z-beta.N`, which is what the
+    /// beta bundle's `CFBundleShortVersionString` carries (`0.11.21-beta.120` on
+    /// the v0.11.21-beta.120 zip), so the comparison is like for like.
+    @Test(arguments: [
+        ("v0.11.21-beta.120", "0.11.21-beta.120"),
+        ("v0.11.0-beta.95", "0.11.0-beta.95"),
+        ("v0.6.0-beta.23", "0.6.0-beta.23"),
+    ])
+    func realBetaTagsResolveToTheFullVersion(tag: String, expected: String) throws {
+        let rule = try Self.rule(Self.betaID, .beta)
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+                == expected)
+    }
+
+    /// Stable, `-sequoia` and `-alpha.N` tags share the list the beta rule
+    /// walks; none of them is a beta release. The vendor's own updater gives a
+    /// beta copy prereleases only.
+    @Test(arguments: ["v0.11.19", "v0.9.7-sequoia", "v0.5.7-alpha.22"])
+    func otherTracksAreNotBeta(tag: String) throws {
+        let rule = try Self.rule(Self.betaID, .beta)
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == nil)
+    }
+
+    /// Why the beta rule captures the suffix: against the installed short
+    /// version, the full capture orders correctly, and a base-only capture would
+    /// read a beta copy's own build as an update to it.
+    @Test func betaVersionsCompareLikeForLike() {
+        #expect(VersionComparator.isNewer("0.11.21-beta.120", than: "0.11.20-beta.119"))
+        #expect(VersionComparator.isNewer("0.11.0-beta.95", than: "0.10.23-beta.94"))
+        #expect(!VersionComparator.isNewer("0.11.21-beta.120", than: "0.11.21-beta.120"))
+        #expect(VersionComparator.isNewer("0.11.21", than: "0.11.21-beta.120"))
+    }
+
+    /// The channel each real bundle reads as, which decides which rule may
+    /// serve it. Values off the v0.11.19 and v0.11.21-beta.120 zips.
+    @Test func eachBundleReadsAsItsOwnTrack() throws {
+        #expect(ReleaseChannel.detect(name: "Tinycast", bundleID: Self.stableID,
+                                      keystoneChannel: nil, version: "0.11.19") == .stable)
+        #expect(ReleaseChannel.detect(name: "Tinycast Beta", bundleID: Self.betaID,
+                                      keystoneChannel: nil, version: "0.11.21-beta.120") == .beta)
+        #expect(try Self.rule(Self.betaID, .beta).usePrereleases)
+    }
+
+    /// The real v0.11.19 body, excerpted verbatim: its first two and last
+    /// "What's Changed" bullets, the "New Contributors" section's first entry,
+    /// and the whole install block the vendor appends after
+    /// `<!-- tinycast:install -->`. The inline parse in `GitHubReleasesSource`
+    /// has to keep the changes and drop everything below them — which is why
+    /// this family carries no `ChangelogRecipe`.
+    @Test func theRealReleaseBodyYieldsOnlyTheChanges() throws {
+        let body = """
+        ## What's Changed
+        * Add local Dictation and expand keyboard shortcut capabilities by @Risengan in #1280
+        * Preserve pinned clipboard state during Raycast import by @barissglc in #1284
+        * Load bundled extension dependencies by @szupzj18 in #1489
+
+        ## New Contributors
+        * @barissglc made their first contribution in #1284
+
+        <!-- tinycast:install -->
+
+        **Channel:** stable · **Version:** 0.11.19 · **Bundle ID:** `com.tinycast.app`
+        Built from 126c998d87cd7e93bd5e3437098d9c646eb6a714. [Full changelog](https://github.com/abue-ammar/tinycast/compare/v0.11.12...v0.11.19)
+
+        **Recommended:** install via Homebrew — it clears the quarantine flag automatically on every install and update, so there's nothing to run by hand:
+        ```sh
+        brew trust --tap abue-ammar/tinycast
+        brew install --cask abue-ammar/tinycast/tinycast
+        ```
+        On an **Intel** Mac, install `abue-ammar/tinycast/tinycast-universal` instead — same app, built with both slices.
+        This build is self-signed. If you download the DMG directly instead of using Homebrew, macOS will refuse to open it until you clear the quarantine flag once:
+        ```sh
+        xattr -dr com.apple.quarantine "/Applications/Tinycast.app"
+        ```
+        """
+
+        let changelog = try #require(
+            GitHubMarkdownParser.parse(body: body, version: "0.11.19", date: "2026-10-10T15:14:51Z"))
+        let entry = try #require(changelog.entries.first)
+        #expect(changelog.entries.count == 1)
+        #expect(entry.items == [
+            "Add local Dictation and expand keyboard shortcut capabilities by @Risengan in #1280",
+            "Preserve pinned clipboard state during Raycast import by @barissglc in #1284",
+            "Load bundled extension dependencies by @szupzj18 in #1489",
+        ])
+    }
+}
