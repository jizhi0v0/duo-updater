+import Foundation
+
+enum rocks_spotifast_Spotifast {
+    static let set = AppRecipeSet(
+        family: "rocks-spotifast-Spotifast",
+        changelogs: [
+        // Spotifast — release bodies from the releases API. The GitHub rule below
+        // carries only the newest body, and a copy a few versions behind should
+        // see every version it skipped (nine stable releases between 2026-09-21
+        // and 2026-10-03). Bodies are Markdown: `## New` / `## Fixed` (0.12.0
+        // adds `## Changed`, 0.11.x `## Known limitations`) over top-level
+        // bullets, a prose `## Thanks` that is not a list, and a download-links
+        // paragraph that is not a bullet either, so none of it needs
+        // `skipSections`. The 0.1.x bodies are a lone "Full Changelog" link and
+        // yield no entry. The `-rcN` tags are flagged prerelease and the stable
+        // decoder leaves them out.
+        ChangelogRecipe(
+            bundleID: "rocks.spotifast.Spotifast",
+            source: URL(string: "https://api.github.com/repos/crmne/spotifast/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases),
+        ],
+        githubRules: [
+        // Spotifast — Rust/egui Spotify client (crmne/spotifast, formerly
+        // Fastpotify). No Sparkle (`feed-discover`: no `SUFeedURL`, no
+        // electron-builder config). Its own updater (`fastframe-update`) reads
+        // `/releases/latest` of this same repo once a day; it downloads only when
+        // the user asks and swaps only when they choose "Restart to update". Not
+        // in homebrew-cask; the author's tap cask sets no `auto_updates`. Tags
+        // are `vX.Y.Z` and equal both `CFBundleShortVersionString` and
+        // `CFBundleVersion`. Release candidates (`vX.Y.Z-rcN`) are flagged
+        // prerelease, so `/releases/latest` skips them and the anchored pattern
+        // refuses them anyway.
+        //
+        // Bundle id: `rocks.spotifast.Spotifast` from 0.10.0. 0.9.1 and earlier
+        // are `me.paolino.fastpotify` (0.9.1 ships a bridge dmg with both
+        // `Fastpotify.app` and `Spotifast.app` under that id) and are not
+        // matched here on purpose: 0.9.1's notes say to update to 0.9.1 before
+        // updating further, and 0.12.0's that a copy updated straight from 0.9.0
+        // or older starts fresh. See the audit.
+        //
+        // One-click: the universal dmg, one `Spotifast.app`, Developer ID, Team
+        // JPL7999US3 and notarized on 0.10.0, 0.11.2 and 0.12.0, so the
+        // Team-ID gate passes for every copy this rule matches. No nested apps.
+        // GitHub publishes the asset's SHA-256 and it equals `checksums.txt`,
+        // which the app's own updater verifies against a publisher signature.
+        GitHubReleaseRule(
+            bundleID: "rocks.spotifast.Spotifast",
+            owner: "crmne", repo: "spotifast",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^spotifast-v[0-9]+(?:\.[0-9]+)+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
