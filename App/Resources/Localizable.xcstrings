        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store"
          }
        }
      }
    },
    "App Store can't replace %@ while it's open. If this looks stuck, switch to App Store and click Continue — it waits until you do. %@ reopens when the update lands.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store kann %@ nicht ersetzen, solange es geöffnet ist. Wenn es hängen zu bleiben scheint: Wechsle in den App Store und klicke auf „Fortfahren“ – er wartet darauf. %@ wird wieder geöffnet, sobald das Update eingespielt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store no puede reemplazar %@ mientras está abierta. Si parece bloqueado, cambia a App Store y haz clic en «Continuar»: espera a que lo hagas. %@ se volverá a abrir cuando llegue la actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store ne peut pas remplacer %@ tant qu’elle est ouverte. Si cela semble bloqué, passe à l’App Store et clique sur « Continuer » — il attend que tu le fasses. %@ se rouvre une fois la mise à jour installée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store non può sostituire %@ mentre è aperta. Se sembra bloccato, passa all’App Store e fai clic su Continua: attende finché non lo fai. %@ si riapre quando l’aggiornamento è completato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が開いている間、App Store はそれを置き換えられません。止まって見えるときは App Store に切り替えて「続ける」をクリックしてください（クリックするまで待ち続けます）。更新が適用されると %@ は再び開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não pode substituir %@ enquanto ele estiver aberto. Se parecer travado, vá até a App Store e clique em Continuar — ela espera até você fazer isso. %@ reabre quando a atualização for instalada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store не может заменить %@, пока оно открыто. Если кажется, что всё зависло, перейдите в App Store и нажмите «Продолжить» — он ждёт именно этого. %@ откроется снова, когда обновление установится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store, %@ açıkken onu değiştiremez. Takılmış gibi görünüyorsa App Store’a geçip Devam’a tıklayın — siz tıklayana kadar bekler. Güncelleme tamamlanınca %@ yeniden açılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 开着的时候 App Store 无法替换它。如果看起来卡住了，切到 App Store 点「继续」—— 它会一直等你点。更新装好后 %@ 会自动重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 開著時，App Store 無法替換它。如果看起來卡住了，請切換到 App Store 並按一下「繼續」——它會一直等到你按下。更新完成後 %@ 會重新打開。"
          }
        }
      }
    },
