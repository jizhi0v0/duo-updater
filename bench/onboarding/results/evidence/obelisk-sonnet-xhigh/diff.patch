@@ -0,0 +1,39 @@
+import Foundation
+
+enum com_obelisk_app {
+    static let set = AppRecipeSet(
+        family: "com-obelisk-app",
+        changelogs: [
+        // Obelisk — GitHub releases, not the appcast's own notes.
+        //
+        // The bundle declares its feed in `SUFeedURL`
+        // (`releases/latest/download/appcast-<arch>.xml`), so `SparkleAppcastSource`
+        // already answers for detection and one-click, and needs no recipe. What
+        // it cannot do is notes. The release workflow
+        // (`app/scripts/update-release.mjs`) writes the GitHub release body into
+        // `<description>` as XML-escaped Markdown with no `sparkle:format`, so the
+        // pane would print raw `##` / `-` text. Each feed also holds exactly ONE
+        // `<item>`, so there is no history behind it either.
+        //
+        // github.com/tommy0103/obelisk carries the same body plus every earlier
+        // release, and the tag is the marketing version behind a `v`
+        // (`v0.2.5` → `0.2.5` via `stripLeadingV` == `CFBundleShortVersionString`).
+        // No `tagPattern`: `release-app.yml` is the only workflow that creates
+        // GitHub releases, so every release on the page is the desktop app's.
+        //
+        // `skipSections` names the two headings that hold bullets which are not
+        // changes: `Included work` is the PR credit roll, one line per merged PR,
+        // and `Downloads` lists the asset file names. The sections that hold the
+        // changes (`Highlights`, `Updates` and its `###` groups) keep their
+        // headings in the pane. `Installation` and the `Install …` headings carry
+        // only prose and a code block, so they yield nothing and need no entry.
+        ChangelogRecipe(
+            bundleID: "com.obelisk.app",
+            source: URL(
+                string: "https://api.github.com/repos/tommy0103/obelisk/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["Included work", "Downloads"]),
+        ])
+}
