          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque requête que DuoUpdater effectue lui-même : vérifications de mises à jour, notes de version et téléchargements qu’il installe pour vous."
          }
        },
        "it": {
          "stringUnit": {
