index 0000000..ee56489
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SwiftVMChangelogRecipeTests.swift
@@ -0,0 +1,123 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Seven releases from `api.github.com/repos/swiftvm-app/swiftvm/releases`
+/// (fetched 2026-10-14), verbatim, each picked for a decision the recipes make.
+///
+/// - v1.4.0-beta.37 / v1.4.0-beta.35: betas, `prerelease: true`.
+/// - v1.3.0 / v1.2.0: releases, the shape every body has today.
+/// - v1.3.0-beta.30: the beta a release was cut from, same body.
+/// - v1.0.0: a release with a `null` body.
+/// - beta-channel: the rolling release that only holds `appcast-beta.xml`,
+///   also `prerelease: true`.
+private let swiftVMReleasesFixture = #"""
+[
+ {
+  "tag_name": "v1.4.0-beta.37",
+  "prerelease": true,
+  "draft": false,
+  "published_at": "2026-10-14T10:55:58Z",
+  "body": "## What's Changed\n* Add optional disk compression for Linux virtual machines"
+ },
+ {
+  "tag_name": "v1.4.0-beta.35",
+  "prerelease": true,
+  "draft": false,
+  "published_at": "2026-10-13T16:40:18Z",
+  "body": "## What's Changed\n* Add reusable virtual machine templates\n* Drive macOS guests without anyone at their screen"
+ },
+ {
+  "tag_name": "v1.3.0",
+  "prerelease": false,
+  "draft": false,
+  "published_at": "2026-10-13T11:24:47Z",
+  "body": "## What's Changed\n* Keep machines on any disk, and open up settings that were fixed"
+ },
+ {
+  "tag_name": "v1.3.0-beta.30",
+  "prerelease": true,
+  "draft": false,
+  "published_at": "2026-10-13T11:07:29Z",
+  "body": "## What's Changed\n* Keep machines on any disk, and open up settings that were fixed"
+ },
+ {
+  "tag_name": "v1.2.0",
+  "prerelease": false,
+  "draft": false,
+  "published_at": "2026-10-12T18:41:07Z",
+  "body": "## What's Changed\n* Add guest automation: exec, cp, screenshot, and ui commands through the guest tools"
+ },
+ {
+  "tag_name": "v1.0.0",
+  "prerelease": false,
+  "draft": false,
+  "published_at": "2026-10-11T16:48:47Z",
+  "body": null
+ },
+ {
+  "tag_name": "beta-channel",
+  "prerelease": true,
+  "draft": false,
+  "published_at": "2026-10-11T15:05:52Z",
+  "body": "Rolling Sparkle appcast for the beta channel. Do not delete."
+ }
+]
+"""#
+
+@Suite struct SwiftVMChangelogRecipeTests {
+
+    private let bundleID = "com.swiftvm.app"
+
+    private func recipe(_ channel: ReleaseChannel) throws -> ChangelogRecipe {
+        let r = try #require(ChangelogRecipeRegistry.recipe(forBundleID: bundleID, channel: channel))
+        try #require(r.channel == channel)
+        return r
+    }
+
+    /// Through `ChangelogService.parse`, the one route the app and `duo verify`
+    /// both take, so `tagPattern` is applied.
+    private func parsed(_ channel: ReleaseChannel) throws -> Changelog {
+        try #require(ChangelogService.parse(try recipe(channel), body: swiftVMReleasesFixture))
+    }
+
+    @Test func bothChannelsReadTheAppsOwnReleasesList() throws {
+        for channel in [ReleaseChannel.stable, .beta] {
+            let r = try recipe(channel)
+            #expect(r.structuredFormat == .gitHubReleases)
+            #expect(r.mode == .json)
+            #expect(r.source.host == "api.github.com")
+            #expect(r.source.path == "/repos/swiftvm-app/swiftvm/releases")
+        }
+    }
+
+    /// Releases only, under the version the bundle reports (1.3.0). The `null`
+    /// body produces no entry.
+    @Test func stableEntriesAreTheReleases() throws {
+        let cl = try parsed(.stable)
+        #expect(cl.entries.map(\.version) == ["1.3.0", "1.2.0"])
+        #expect(cl.entries.map(\.date) == ["2026-10-13", "2026-10-12"])
+        #expect(cl.itemSyntax == .markdown)
+    }
+
+    /// Betas only, suffix kept, the way a beta bundle reports its version
+    /// (`1.4.0-beta.37`). The rolling `beta-channel` release is a prerelease
+    /// too, and its sentence would otherwise be an entry named `beta-channel`.
+    @Test func betaEntriesAreTheBetasAndNotTheRollingAppcastRelease() throws {
+        let cl = try parsed(.beta)
+        #expect(cl.entries.map(\.version) == ["1.4.0-beta.37", "1.4.0-beta.35", "1.3.0-beta.30"])
+        #expect(!cl.entries.contains { $0.items.contains { $0.contains("Rolling Sparkle appcast") } })
+    }
+
+    /// One `## What's Changed` over a flat list: the vendor writes no sections,
+    /// so the entry is the list and nothing is flattened.
+    @Test func eachBodyIsAFlatList() throws {
+        let entry = try #require(try parsed(.beta).entries.first { $0.version == "1.4.0-beta.35" })
+        #expect(entry.items == [
+            "Add reusable virtual machine templates",
+            "Drive macOS guests without anyone at their screen",
+        ])
+        #expect(entry.content.isEmpty)
+    }
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SwiftVMChannelTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SwiftVMChannelTests.swift
new file mode 100644
index 0000000..9f2d7ac
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SwiftVMChannelTests.swift
@@ -0,0 +1,114 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// SwiftVM's beta feed (`beta-channel/appcast-beta.xml`), captured 2026-10-14
+/// and cut to its two newest items, verbatim. Every item in it is tagged
+/// `<sparkle:channel>beta</sparkle:channel>`; there is no untagged item.
+private let swiftVMBetaFeedFixture = #"""
+<?xml version="1.0" encoding="utf-8"?>
+<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" xmlns:dc="http://purl.org/dc/elements/1.1/">
+  <channel>
+    <title>SwiftVM Updates (beta)</title>
+    <link>https://github.com/swiftvm-app/swiftvm</link>
+    <description>Updates for SwiftVM (beta channel)</description>
+    <language>en</language>
+    <item>
+      <title>Version 1.4.0-beta.37</title>
+      <pubDate>Wed, 14 Oct 2026 10:55:52 +0000</pubDate>
+      <sparkle:channel>beta</sparkle:channel>
+      <sparkle:version>37</sparkle:version>
+      <sparkle:shortVersionString>1.4.0-beta.37</sparkle:shortVersionString>
+      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
+      <sparkle:fullReleaseNotesLink>https://github.com/swiftvm-app/swiftvm/releases/tag/v1.4.0-beta.37</sparkle:fullReleaseNotesLink>
+      <enclosure url="https://github.com/swiftvm-app/swiftvm/releases/download/v1.4.0-beta.37/SwiftVM-1.4.0-beta.37.dmg" sparkle:edSignature="WofvqvFJz+jkXpBOAYpjSZQ1FWTUoONR/yZEeVl91ph0dorstki7xSOfGlJ7bfto3IzD6Srvp1jBEY26MIw5Cg==" length="6096786" type="application/octet-stream" />
+    </item>
+    <item>
+      <title>Version 1.4.0-beta.35</title>
+      <pubDate>Tue, 13 Oct 2026 16:40:12 +0000</pubDate>
+      <sparkle:channel>beta</sparkle:channel>
+      <sparkle:version>35</sparkle:version>
+      <sparkle:shortVersionString>1.4.0-beta.35</sparkle:shortVersionString>
+      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
+      <sparkle:fullReleaseNotesLink>https://github.com/swiftvm-app/swiftvm/releases/tag/v1.4.0-beta.35</sparkle:fullReleaseNotesLink>
+      <enclosure url="https://github.com/swiftvm-app/swiftvm/releases/download/v1.4.0-beta.35/SwiftVM-1.4.0-beta.35.dmg" sparkle:edSignature="I+8YsLs4FRMlvfXL7yWKJX1g5i92mi3TC47a2AvOo36qX7G1ln5/KN/QNhatoc6BnUpftq+HgFGuscxKzEAyCw==" length="6005437" type="application/octet-stream" />
+    </item>
+  </channel>
+</rss>
+"""#
+
+@Suite struct SwiftVMChannelTests {
+    /// Spelled out rather than taken from the binding: it is what the real
+    /// bundles report (`CFBundleIdentifier` of the 1.3.0 and 1.4.0-beta.37
+    /// dmgs), so a binding keyed on anything else fails here.
+    private static let bundleID = "com.swiftvm.app"
+    private static let betaFeed = URL(string: "https://github.com/swiftvm-app/swiftvm/releases/download/beta-channel/appcast-beta.xml")!
+    private static let stableFeed = URL(string: "https://github.com/swiftvm-app/swiftvm/releases/latest/download/appcast.xml")!
+
+    private var items: [SparkleAppcastItem] {
+        SparkleAppcastParser.parse(Data(swiftVMBetaFeedFixture.utf8))
+    }
+
+    /// An install of a beta build, wearing whatever `ChannelBinding` resolves for
+    /// it from the bundle's own `SUFeedURL` — the fields `AppScanner` copies.
+    private func betaBuild(short: String, build: String) -> InstalledApp {
+        let bound = ChannelBinding.resolve(bundleID: Self.bundleID, bundleFeeds: ["SUFeedURL": Self.betaFeed])
+        return InstalledApp(
+            name: "SwiftVM", bundleID: Self.bundleID,
+            shortVersion: short, buildVersion: build,
+            path: URL(fileURLWithPath: "/Applications/ZZFixture-SwiftVM.app"),
+            isMASApp: false,
+            sparkleFeedURL: Self.betaFeed,
+            sparkleChannelNames: bound?.sparkleChannelNames ?? [],
+            sparkleEdPublicKey: "key",
+            releaseChannel: bound?.channel ?? .stable,
+            channelIsAuthoritative: bound != nil)
+    }
+
+    private func best(for app: InstalledApp) -> String? {
+        SparkleAppcastSource.bestItem(
+            for: app, from: items, osVersion: "27.0", hostArch: .arm64,
+            allowingIntelTranslation: true
+        )?.shortVersionString
+    }
+
+    @Test func theBetaFeedHasNoDefaultChannel() {
+        #expect(items.count == 2)
+        #expect(items.allSatisfy { $0.channel == "beta" })
+    }
+
+    /// The build decides: the beta feed resolves `.beta` with the tag derived,
+    /// the release feed resolves nothing.
+    @Test func theFeedTheBuildNamesDecides() {
+        #expect(ChannelBinding.resolve(bundleID: Self.bundleID, bundleFeeds: ["SUFeedURL": Self.betaFeed])
+                == ResolvedChannel(channel: .beta))
+        #expect(ChannelBinding.resolve(bundleID: Self.bundleID, bundleFeeds: ["SUFeedURL": Self.stableFeed]) == nil)
+        #expect(ChannelBinding.resolve(bundleID: Self.bundleID, bundleFeeds: [:]) == nil)
+    }
+
+    /// The case the binding exists for: a beta the feed does not list (beta.30
+    /// is cut from this fixture). Mutations that turn this red: removing the
+    /// `ChannelBinding` case; resolving to `.stable`.
+    @Test func aBetaMissingFromTheFeedIsOfferedTheNewestBeta() {
+        #expect(best(for: betaBuild(short: "1.3.0-beta.30", build: "30")) == "1.4.0-beta.37")
+    }
+
+    @Test func aListedBetaIsOfferedTheNewestBeta() {
+        #expect(best(for: betaBuild(short: "1.4.0-beta.35", build: "35")) == "1.4.0-beta.37")
+    }
+
+    /// Why a binding and not the version-suffix inference: that one is not
+    /// authoritative, so a beta missing from the feed lands on the default
+    /// channel and matches nothing. A fixture guard, not a mutation target.
+    @Test func withoutABindingABetaMissingFromTheFeedSeesNothing() {
+        let unbound = InstalledApp(
+            name: "SwiftVM", bundleID: Self.bundleID,
+            shortVersion: "1.3.0-beta.30", buildVersion: "30",
+            path: URL(fileURLWithPath: "/Applications/ZZFixture-SwiftVM.app"),
+            isMASApp: false,
+            sparkleFeedURL: Self.betaFeed,
+            sparkleEdPublicKey: "key",
+            releaseChannel: .beta, channelIsAuthoritative: false)
+        #expect(best(for: unbound) == nil)
+    }
+}
