@@ -0,0 +1,36 @@
+import Foundation
+
+enum io_github_tobi_disktree {
+    static let set = AppRecipeSet(
+        family: "io-github-tobi-disktree",
+        githubRules: [
+        // disktree — a Rust + GPUI treemap for finding what fills a disk. The
+        // app has no updater of its own (no Sparkle, no network client in the
+        // binary), so `/releases/latest` is the only source. v-tags; short ==
+        // CFBundleVersion == the tag's X.Y.Z (checked 2026-10-14 on 0.10.0,
+        // 0.10.1 and 0.11.0). Release notes are GitHub's generated list of
+        // merged pull requests.
+        //
+        // Detection-only (see `Recipes/org-alacritty.swift`): the macOS zips
+        // are built by upstream's release workflow, which signs and notarizes
+        // only when the repository has signing secrets. The published ones do
+        // not: every one of the six zips examined (0.10.0, 0.10.1, 0.11.0;
+        // arm64 and x86_64) is ad-hoc signed with no Team ID, `spctl` rejects
+        // it, and there is no stapled ticket. The Team-ID gate in
+        // `VendorInstaller` would refuse the swap, so no `installAssetPattern`.
+        // The seal does verify and the signed identifier is the bundle id, so
+        // `.publishedDigestOnly` is open to it; it is not taken because it
+        // lowers the install bar to a file hash.
+        //
+        // Per-arch zips (`disktree-<v>-aarch64-macos.zip` / `-x86_64-macos.zip`),
+        // no universal build. A rule with no `installAssetPattern` also skips
+        // the walk past releases that carry no macOS asset. v0.9.0 and v0.9.1
+        // are Linux-only, but they predate the macOS port (first macOS asset:
+        // 0.10.0), and the release workflow publishes a release only once the
+        // Linux, macOS and Windows builds are all in.
+        GitHubReleaseRule(
+            bundleID: "io.github.tobi.disktree",
+            owner: "tobi", repo: "disktree",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+        ])
+}
