+import Foundation
+
+enum rocks_spotifast_Spotifast {
+    static let set = AppRecipeSet(
+        family: "rocks-spotifast-Spotifast",
+        changelogs: [
+        // Spotifast — release bodies from the releases API, so a copy a few
+        // versions behind sees every version's notes (upstream ships every few
+        // days). Bodies are Markdown: an intro paragraph and a download line,
+        // then `## New` / `## Fixed` / `## Changed` / `## Known limitations`.
+        // `## Thanks` is the contributor roster, not a change.
+        ChangelogRecipe(
+            bundleID: "rocks.spotifast.Spotifast",
+            source: URL(string: "https://api.github.com/repos/crmne/spotifast/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["Thanks"]),
+        ],
+        githubRules: [
+        // Spotifast — Rust Spotify client (crmne/spotifast). No SUFeedURL: its
+        // own updater (fastframe-update) reads `releases/latest` of this repo and
+        // installs the `-macos-universal.dmg`. One stable track; the `-rcN` tags
+        // are flagged prerelease and the anchored pattern refuses them anyway.
+        // short == build == tag without the `v`.
+        //
+        // The bundle id is `rocks.spotifast.Spotifast` from 0.10.0 on. 0.9.1 and
+        // older ship as `me.paolino.fastpotify` (the app was Fastpotify), which
+        // this rule does not claim — see the audit.
+        //
+        // One-click: Team JPL7999US3 on 0.12.0 and 0.13.0, notarized dmg, one
+        // executable and no nested apps or helpers.
+        GitHubReleaseRule(
+            bundleID: "rocks.spotifast.Spotifast",
+            owner: "crmne", repo: "spotifast",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^spotifast-v[0-9.]+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
