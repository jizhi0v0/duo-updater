@@ -0,0 +1,35 @@
+import Foundation
+
+enum io_github_tobi_disktree {
+    static let set = AppRecipeSet(
+        family: "io-github-tobi-disktree",
+        githubRules: [
+        // Shared rationale for digest-only: Recipes/org-alacritty.swift.
+
+        // disktree (tobi) — a Rust + GPUI treemap, built for Omarchy and also
+        // shipped as a macOS app. No Sparkle and no updater of its own; the
+        // README points at the latest GitHub release. v-tags; CFBundleShortVersionString
+        // and CFBundleVersion both equal the tag's X.Y.Z (checked 2026-10-14 on
+        // 0.10.0, 0.10.1 and 0.11.0, both arches).
+        //
+        // Ad-hoc signed, no Team ID, so the Team-ID gate can't apply. It takes
+        // `.publishedDigestOnly`: on all six macOS zips the seal verifies
+        // (`codesign --verify --deep --strict` 0), the signed identifier is
+        // io.github.tobi.disktree, the short version is the tag's, and GitHub
+        // publishes a sha256 `digest` for every asset (matches the downloads and
+        // the `.sha256` sibling). The bundle has no nested apps or helpers.
+        //
+        // One zip per architecture, `disktree-<ver>-aarch64-macos.zip` /
+        // `-x86_64-macos.zip`, each a bare `disktree.app`; the arch is left to the
+        // source's arch preference. The `.sha256` siblings, the Linux tarballs
+        // and the Windows zips don't match the anchor. 0.9.x releases carry no
+        // macOS asset at all, so a release without one is walked past.
+        GitHubReleaseRule(
+            bundleID: "io.github.tobi.disktree",
+            owner: "tobi", repo: "disktree",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^disktree-[0-9.]+-(?:aarch64|x86_64)-macos\.zip$"#,
+            installerKind: .zip,
+            installTrust: .publishedDigestOnly),
+        ])
+}
