    "Lower this on a slow connection; raise it to check a large library faster.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einer langsamen Verbindung verringern; erhöhen, um eine große Bibliothek schneller zu prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
