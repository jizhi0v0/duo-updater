          "stringUnit": {
            "state": "translated",
            "value": "Die neueste Version von %@%@ erfordert macOS %@ oder neuer. Dieser Mac kann sie erst nach einem Upgrade installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última versión de %@%@ requiere macOS %@ o posterior. Este Mac no podrá instalarla hasta que se actualice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière version de %@%@ nécessite macOS %@ ou ultérieur. Ce Mac ne pourra pas l'installer tant qu'il n'aura pas été mis à niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima versione di %@%@ richiede macOS %@ o versioni successive. Questo Mac non può installarla finché non viene aggiornato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の最新バージョン%@ には macOS %@ 以降が必要です。この Mac はアップグレードするまでインストールできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão mais recente de %@%@ requer o macOS %@ ou posterior. Este Mac não pode instalá-la até ser atualizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя версия %@%@ требует macOS %@ или новее. Этот Mac не сможет установить её, пока не будет обновлён."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasının en son sürümü%@ macOS %@ veya sonrasını gerektiriyor. Bu Mac yükseltilene kadar yüklenemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的最新版本%@ 需要 macOS %@ 或更高版本。此 Mac 要升级后才能安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的最新版本%@ 需要 macOS %@ 或以上版本。這台 Mac 必須先升級才能安裝。"
          }
        }
      }
    },
    "You can keep using the installed version (%@) until then.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis dahin kannst du weiterhin die installierte Version (%@) verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta entonces, puedes seguir usando la versión instalada (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'ici là, vous pouvez continuer à utiliser la version installée (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino ad allora puoi continuare a usare la versione installata (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それまでは、インストール済みのバージョン（%@）を引き続き使用できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até lá, você pode continuar usando a versão instalada (%@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До этого момента можно продолжать использовать установленную версию (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O zamana kadar yüklü sürümü (%@) kullanmaya devam edebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此之前，你可以继续使用已安装的版本（%@）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在那之前，你可以繼續使用已安裝的版本（%@）。"
          }
        }
      }
    },
    "%@ already downloaded an update — relaunch to apply it (no extra download; a large app may take a minute to swap & reopen)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat bereits ein Update heruntergeladen – neu starten, um es anzuwenden (kein erneuter Download nötig; bei einer großen App kann der Austausch & Neustart eine Minute dauern)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya descargó una actualización; reabre para aplicarla (sin descarga adicional; en apps grandes el intercambio y la reapertura pueden tardar un minuto)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a déjà téléchargé une mise à jour — relancez pour l'appliquer (pas de nouveau téléchargement ; pour une grande application, l'échange et la réouverture peuvent prendre une minute)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha già scaricato un aggiornamento — riapri per applicarlo (nessun download aggiuntivo; un’app grande può impiegare un minuto per sostituirsi e riaprirsi)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでにアップデートをダウンロード済みです — 再起動して適用してください（追加のダウンロードは不要です。大きなアプリは入れ替えと再起動に1分ほどかかる場合があります）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já baixou uma atualização — reabra para aplicar (sem novo download; um app grande pode levar um minuto para trocar e reabrir)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже загрузило обновление — перезапустите, чтобы применить (без повторной загрузки; для крупного приложения замена и открытие могут занять минуту)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir güncellemeyi zaten indirdi — uygulamak için yeniden başlatın (ek indirme yok; büyük bir uygulamanın değiştirilip yeniden açılması bir dakika sürebilir)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下载更新 — 重新启动以应用（无需再次下载；大型应用替换并重新打开可能需要一分钟）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下載更新 — 重新開啟即可套用（不必重新下載；大型 App 替換並重新開啟可能需要一分鐘）"
          }
        }
      }
    },
    "%@ already downloaded an update — relaunch to apply it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat bereits ein Update heruntergeladen – neu starten, um es anzuwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya descargó una actualización; reabre para aplicarla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
