    "Couldn’t back up the current version — this update will be applied without a rollback point.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Version konnte nicht gesichert werden – dieses Update wird ohne Wiederherstellungspunkt eingespielt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo hacer una copia de seguridad de la versión actual: esta actualización se aplicará sin punto de reversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sauvegarder la version actuelle — cette mise à jour sera appliquée sans point de restauration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eseguire il backup della versione attuale: questo aggiornamento verrà applicato senza un punto di ripristino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバージョンをバックアップできませんでした。この更新はロールバック先なしで適用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível fazer backup da versão atual — esta atualização será aplicada sem ponto de reversão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сделать резервную копию текущей версии — обновление будет установлено без точки отката."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli sürüm yedeklenemedi — bu güncelleme bir geri alma noktası olmadan uygulanacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能备份当前版本 —— 这次更新将在没有回滚点的情况下安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法備份目前的版本——這次更新將在沒有還原點的情況下套用。"
          }
        }
      }
    },
    "Couldn’t fully stop %@’s own updater — quit and reopen it, then update.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eigene Updater von %@ ließ sich nicht vollständig beenden – App beenden, erneut öffnen und dann aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo detener del todo el actualizador propio de %@: ciérralo, vuelve a abrirlo y luego actualiza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’arrêter complètement le système de mise à jour de %@ — quittez-le, rouvrez-le, puis mettez à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile fermare del tutto il programma di aggiornamento di %@: chiudila e riaprila, poi aggiorna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 自身のアップデータを完全には停止できませんでした。終了して開き直してから、アップデートしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível parar totalmente o atualizador de %@ — encerre-o e abra-o de novo, depois atualize."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось полностью остановить встроенный модуль обновлений %@ — закройте приложение, откройте снова и обновите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasının kendi güncelleyicisi tam olarak durdurulamadı — uygulamadan çıkıp yeniden açın, sonra güncelleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能完全停掉 %@ 自带的更新程序 —— 退出并重新打开它，然后再更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完全停止 %@ 自己的更新程式——請結束並重新打開它，然後再更新。"
          }
        }
      }
    },
