@@ -0,0 +1,59 @@
+import Foundation
+
+enum com_xd_cindy {
+    static let set = AppRecipeSet(
+        family: "com-xd-cindy",
+        changelogs: [
+        // The same release bodies the rule below reads, as a list so the pane has
+        // history. Each body ends with a `## PRs` link dump and a metadata footer
+        // under it; `skipSections` drops both.
+        ChangelogRecipe(
+            bundleID: "com.xd.cindy",
+            source: URL(
+                string: "https://api.github.com/repos/makecindy/cindy/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 40,
+            channel: .stable,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["PRs"]),
+        ],
+        githubRules: [
+        // Cindy — Electron desktop app (source makecindy/cindy, a monorepo; the
+        // release tags are `vX.Y.Z` with `vX.Y.Z-beta` prereleases beside them).
+        // No SUFeedURL: updates come from the app's own manifest on its CDN
+        // (hotfix.cindy.app), and the GitHub release carries the same installer:
+        // the manifest's `app.installer.sha256` is the GitHub asset digest
+        // (checked 2026-10-14; History has the measurement). The manifest URL has
+        // no device parameter, so the newest stable release is the build the
+        // vendor names for every machine.
+        // History: docs/app-audits/com-xd-cindy.md#历史与实测
+        //
+        // Global edition only, `com.xd.cindy` (Team SX9RG894L5, Developer ID,
+        // notarized). The cn edition ships from the same repo under its own bundle
+        // id `com.xd.cindycn` (Team NTC4BJ542G), but a second GitHubReleaseRule on
+        // this repo and channel would share the RecipeHealth id
+        // `github:makecindy/cindy:stable` with this one, and the registry's health
+        // test requires one row per rule. Not wired until that id scheme changes;
+        // see docs/app-audits/com-xd-cindy.md.
+        //
+        // Beta is not taken: the prerelease tags are the same bundle id, and the
+        // only switch is an in-app setting in userData (`enableBeta`), which
+        // ReleaseChannel.detect() cannot see. The stable rule therefore answers
+        // beta copies too; see the audit doc.
+        //
+        // The version anchor keeps `-beta` tags out (they would otherwise read as
+        // a plain X.Y.Z). It does not pin the major: v1.0.0 (July, no assets) and
+        // any future 2.x still match.
+        //
+        // One-click: arm64 dmg only (DuoUpdater runs on Apple silicon). The x64
+        // dmg beside it is deliberately not matched. GitHub publishes a sha256
+        // digest for every asset, which the installer checks before the Team-ID
+        // gate.
+        GitHubReleaseRule(
+            bundleID: "com.xd.cindy",
+            owner: "makecindy", repo: "cindy",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^cindy-[0-9]+\.[0-9]+\.[0-9]+-darwin-arm64-global\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/ComXdCindyGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/ComXdCindyGitHubRuleTests.swift
