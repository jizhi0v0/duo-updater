+import Foundation
+
+// History: docs/app-audits/rocks-spotifast-Spotifast.md#历史与实测
+enum rocks_spotifast_Spotifast {
+    static let set = AppRecipeSet(
+        family: "rocks-spotifast-Spotifast",
+        changelogs: [
+        // Spotifast's own release bodies: a summary line, then `## New`,
+        // `## Fixed`, `## Changed` and `## Thanks` (contributor handles, dropped
+        // here). `tagPattern` is the same anchored tag as the rules below, so the
+        // `-rcN` prereleases on the same endpoint are not this track's notes.
+        ChangelogRecipe(
+            bundleID: "rocks.spotifast.Spotifast",
+            source: URL(
+                string: "https://api.github.com/repos/crmne/spotifast/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 40,
+            channel: .stable,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["Thanks"],
+            tagPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#),
+        ],
+        githubRules: [
+        // Spotifast — Rust native client, crmne/spotifast. No SUFeedURL; it
+        // updates itself from the same GitHub releases (fastframe-update). Every
+        // release since 0.1.0 publishes a macOS dmg, `…-macos-universal.dmg`
+        // (0.8.0 to 0.9.1 under both the old and the new name, byte-identical).
+        // Mounted v0.12.0 and v0.11.2: rocks.spotifast.Spotifast, Team JPL7999US3,
+        // Developer ID, notarized; the file's SHA-256 equals the release's
+        // `digest`. LSMinimumSystemVersion 11.0.
+        // Copies still on the pre-rename id, me.paolino.fastpotify (0.1.0 to 0.9.1),
+        // are filed under this rule by `BundleIDMigration`. One-click is gated at
+        // install time: only Team JPL7999US3 copies below 0.10.0 pass (0.8.0 to
+        // 0.9.1); ad-hoc copies from 0.2.0 to 0.7.1 have no Team, and 0.1.x fail the
+        // seal, so the gate refuses those.
+        GitHubReleaseRule(
+            bundleID: "rocks.spotifast.Spotifast",
+            owner: "crmne", repo: "spotifast",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^spotifast-v[0-9]+\.[0-9]+\.[0-9]+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
