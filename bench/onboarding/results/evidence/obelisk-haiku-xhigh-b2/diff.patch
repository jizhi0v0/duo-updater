+import Foundation
+
+enum com_obelisk_app {
+    static let set = AppRecipeSet(
+        family: "com-obelisk-app",
+        changelogs: [
+        // Obelisk (tommy0103/obelisk). Copies from 0.2.4 on declare a Sparkle feed
+        // in Info.plist (`releases/latest/download/appcast-<arch>.xml`) and are
+        // Developer ID signed, Team 433DLLA855, notarized; the generic Sparkle
+        // source answers them first, so they need no rule. 0.1.0 through 0.2.2 have
+        // no SUFeedURL and are ad-hoc signed with no Team ID: the GitHub rule below
+        // is what reaches them.
+        //
+        // Sparkle's inline notes are raw markdown, so channel-verify reads them as
+        // `raw inline notes, no structure`. The release body carries the same notes
+        // with its `##` / `###` headings, which `.gitHubReleases` keeps.
+        ChangelogRecipe(
+            bundleID: "com.obelisk.app",
+            source: URL(string: "https://api.github.com/repos/tommy0103/obelisk/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .stable,
+            structuredFormat: .gitHubReleases),
+        ],
+        githubRules: [
+        // Obelisk — Electron. Tags are `v<version>` and match CFBundleShortVersionString
+        // (CFBundleVersion is the same number). Stable only: no prerelease has been
+        // published, and `/releases/latest` never returns one. v0.2.3 is a tag with no
+        // release and no assets, so it is not offered.
+        //
+        // One-click pins the arm64 dmg. Every copy this rule answers (0.1.0 to 0.2.2)
+        // is ad-hoc with no Team ID, so `verifyTeamIdentifierMatch` refuses it at
+        // install time (the installed copy has no Team). Those copies are upgraded by
+        // hand once, as the 0.2.2 release notes say; this is not a bug in the rule.
+        GitHubReleaseRule(
+            bundleID: "com.obelisk.app",
+            owner: "tommy0103", repo: "obelisk",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^Obelisk-[0-9.]+-mac-arm64\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
