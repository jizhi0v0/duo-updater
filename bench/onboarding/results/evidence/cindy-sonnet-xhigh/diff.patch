+    /// The beta is skipped, and each stable body comes out as its sections: one
+    /// heading and one change per `###`, in either body shape (with and without a
+    /// `## PRs` heading above the provenance bullets).
+    @Test(arguments: bundleIDs)
+    func notesAreTheChangesUnderTheirHeadings(bundleID: String) throws {
+        let changelog = try #require(ChangelogExtractor.extract(
+            from: Self.releasesFixture, using: try Self.recipe(bundleID)))
+        #expect(changelog.entries.map(\.version) == ["0.1.104", "0.1.85", "0.1.82"])
+        #expect(changelog.entries.map(\.date) == ["2026-10-12", "2026-09-17", "2026-09-15"])
+        #expect(changelog.entries.map(\.items.count) == [10, 11, 1])
+
+        for entry in changelog.entries {
+            let sections = try Self.expectedSections(version: entry.version)
+            #expect(Self.headings(entry) == sections.map(\.heading))
+            #expect(entry.items == sections.map(\.note))
+            #expect(Self.notes(entry) == entry.items)
+            let joined = entry.items.joined(separator: "\n")
+            for noise in ["commit:", "source tag", "iOS(", "Android(", "Desktop release", "#5506"] {
+                #expect(!joined.contains(noise), "\(entry.version) kept \(noise)")
+            }
+            #expect(!joined.contains("\\n"))
+        }
+
+        let newest = try #require(changelog.entries.first)
+        #expect(Self.headings(newest).first == "🧩 供应商组自动换机")
+        #expect(Self.headings(newest).last == "🧹 稳定性修复")
+        // The credit that ends the paragraph goes; an `@` inside a sentence stays.
+        #expect(newest.items[0].hasSuffix("不再暴露分享者的电脑名。"))
+        #expect(newest.items.contains { $0.contains("再单独 @ 也能补上") })
+    }
