@@ -0,0 +1,45 @@
+import Foundation
+
+enum com_obelisk_app {
+    static let set = AppRecipeSet(
+        family: "com-obelisk-app",
+        changelogs: [
+        // Obelisk — 0.2.4 and later detect and install through the bundle's own
+        // Sparkle feed (`SUFeedURL`, `appcast-<arch>.xml` on the latest release),
+        // which answers first. The GitHub rule below is only for the copies from
+        // before that feed (see the rule). The changelog recipe is the notes.
+        //
+        // The appcast inlines the release body in a plain `<description>`, but
+        // it is Markdown and the element carries no `sparkle:format="markdown"`,
+        // so the pane showed it as one raw block. The GitHub release is the same
+        // text and goes through the decoder every GitHub-sourced app uses, which
+        // keeps its `##`/`###` headings. The appcast lists only the newest
+        // release; this gives the pane the history as well.
+        ChangelogRecipe(
+            bundleID: "com.obelisk.app",
+            source: URL(string: "https://api.github.com/repos/tommy0103/obelisk/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases),
+        ],
+        githubRules: [
+        // 0.1.0, 0.2.1 and 0.2.2 (the ones checked; 0.2.0 was not) shipped before
+        // the updater (0.2.4 is the first build with `SUFeedURL`): no
+        // `SUFeedURL`, no `app-update.yml`, ad-hoc signed with no Team ID. Nothing
+        // else resolves them, so they showed as unknown. Sparkle
+        // is ahead of this source in `SourceStack`, so 0.2.4+ never reaches it.
+        //
+        // Detection only, on purpose: no `installAssetPattern`. The installed copy
+        // has no Team ID and every 0.2.4+ download is Developer ID (Team
+        // 433DLLA855), so the Team-ID gate refuses the swap whichever route is
+        // asked, and these users update by hand once (the release notes say so).
+        // 0.1.0 and 0.2.1 declare macOS 11.0 as their floor; 0.2.4+ need 12.0, and
+        // a rule carries no OS floor, so a macOS 11 copy is offered an update it
+        // cannot run. Tags are `v0.2.5` == `CFBundleShortVersionString`; no
+        // release is a prerelease.
+        GitHubReleaseRule(
+            bundleID: "com.obelisk.app",
+            owner: "tommy0103", repo: "obelisk",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+        ])
+}
