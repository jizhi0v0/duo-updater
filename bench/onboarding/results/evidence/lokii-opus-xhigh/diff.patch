+import Foundation
+
+enum com_lokii_app {
+    static let set = AppRecipeSet(
+        family: "com-lokii-app",
+        githubRules: [
+        // Shared rationale for digest-only: Recipes/org-alacritty.swift.
+
+        // Lokii — Rust + AppKit menu-bar file search (huangy7/lokii). No Sparkle:
+        // no `SUFeedURL`, and its own updater (`Lokii/Lokii/AppUpdater.swift`)
+        // only reads `/releases/latest` and opens the asset in a browser, so it
+        // never swaps the bundle itself. The tap cask (`huangy7/homebrew-tap`)
+        // is not in Homebrew's catalog, so this rule is the only source. The
+        // release workflow refuses a tag that is not `v` + the crate version,
+        // and `scripts/build.sh` stamps that version as the short version.
+        //
+        // Ad-hoc signed, no Team ID, not notarized: CI falls back to `codesign
+        // --sign -` while no certificate secret is set. The seal verifies, the
+        // signed identifier is `com.lokii.app`, and short == tag (0.1.1, 0.1.2),
+        // so it takes the digest-only route. One dmg per architecture, with no
+        // version in the name; the host picks.
+        GitHubReleaseRule(
+            bundleID: "com.lokii.app",
+            owner: "huangy7", repo: "lokii",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^Lokii-(?:arm64|x86_64)\.dmg$"#,
+            installerKind: .dmg,
+            installTrust: .publishedDigestOnly),
+        ])
+}
