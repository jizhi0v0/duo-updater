    },
    "Network — what keeping these apps updated has cost, and every request behind it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerk – was das Aktuellhalten dieser Apps gekostet hat, und jede Anfrage dahinter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Red — lo que ha costado mantener estas apps al día, y cada solicitud detrás de ello"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réseau — ce qu’a coûté la mise à jour de ces apps, et chaque requête derrière"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク — これらの App を最新に保つのにかかった通信量と、その裏側のすべてのリクエスト"
