+    /// (2026-10-14), trimmed to the fields the decoder reads, two of its 13 topics
+    /// and three of its four locales.
+    static let notice = #"""
+    {
+     "version": "0.1.104",
+     "date": "2026-10-12",
+     "intro": "本次更新共 172 项功能与修复，带来供应商组第二期（同账号直连与分享中转）、协同 Worker 可放到另一台电脑运行、Agent 自助更新 Cindy 等能力。",
+     "topics": [
+      {"emoji": "🗂️", "title": "供应商组第二期：同账号直连与分享中转", "text": "供应商组现在覆盖同账号的其他电脑和别人分享给你的电脑。"},
+      {"emoji": "🖥️", "title": "协同 Worker 可以放到另一台电脑运行", "text": "开协同或新建 Worker 时可选「运行设备」，把某个 Worker 放到同账号另一台电脑上跑。"}
+     ],
+     "contentByLocale": {
+      "zh-CN": {
+       "intro": "本次更新共 172 项功能与修复，带来供应商组第二期（同账号直连与分享中转）、协同 Worker 可放到另一台电脑运行、Agent 自助更新 Cindy 等能力。",
+       "topics": [
+        {"emoji": "🗂️", "title": "供应商组第二期：同账号直连与分享中转", "text": "供应商组现在覆盖同账号的其他电脑和别人分享给你的电脑。"},
+        {"emoji": "🖥️", "title": "协同 Worker 可以放到另一台电脑运行", "text": "开协同或新建 Worker 时可选「运行设备」，把某个 Worker 放到同账号另一台电脑上跑。"}
+       ]
+      },
+      "en": {
+       "intro": "This update includes 172 features and fixes, bringing provider groups phase 2 (same-account direct connection and sharing relay), running Orca workers on another computer, and letting the Agent update Cindy for you.",
+       "topics": [
+        {"emoji": "🗂️", "title": "Provider Groups Phase 2: Same-Account Direct and Sharing Relay", "text": "Provider groups now cover your other computers on the same account and computers shared with you. The model list collapses grouped providers into a single \"Provider Group\" entry showing the machine count."},
+        {"emoji": "🖥️", "title": "Run Orca Workers on Another Computer", "text": "When starting collaboration or creating a worker, you can now pick a \"run device\" to put that worker on another computer on the same account."}
+       ]
+      },
+      "ja": {
