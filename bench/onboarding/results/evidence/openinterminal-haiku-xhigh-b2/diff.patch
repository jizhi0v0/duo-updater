+import Foundation
+
+enum wang_jianing_app_OpenInTerminal {
+    static let set = AppRecipeSet(
+        family: "wang-jianing-app-OpenInTerminal",
+        probes: [
+        // History: docs/app-audits/wang-jianing-app-OpenInTerminal.md#历史与实测
+        // OpenInTerminal-Lite and OpenInEditor-Lite ship from the same repo and the
+        // same release list as the main edition, so they are probes rather than
+        // GitHub rules: a GitHub rule is keyed by repo and channel, and the main
+        // rule already holds that key. Each probe takes the newest release that
+        // carries its own asset. The tempered token keeps the match inside one
+        // release, so a release without the asset cannot lend its version to it.
+        // One-click: the download URL is built from the version that won, so the
+        // file installed is the release that was compared. The asset name is exact
+        // for that reason: an unlisted name is a detection miss, not a broken URL.
+        // The Team gate applies as it does for the main edition.
+        VendorProbeRecipe(
+            bundleID: "wang.jianing.app.OpenInTerminal-Lite",
+            url: URL(string: "https://api.github.com/repos/Ji4n1ng/OpenInTerminal/releases?per_page=20")!,
+            mode: .responseBody,
+            versionPattern: #""tag_name": ?"v([0-9]+(?:\.[0-9]+)+)"(?:(?!"tag_name")[\s\S])*?"name": ?"OpenInTerminal-Lite\.zip""#,
+            downloadURL: URL(string: "https://github.com/Ji4n1ng/OpenInTerminal/releases")!,
+            changelogURL: URL(string: "https://github.com/Ji4n1ng/OpenInTerminal/releases")!,
+            selectHighest: true,
+            install: VendorInstallSpec(
+                urlSource: .versionTemplate(
+                    "https://github.com/Ji4n1ng/OpenInTerminal/releases/download/v{version}/OpenInTerminal-Lite.zip"),
+                kind: .zip)),
+
+        // OpenInEditor-Lite — same repo, release list and asset naming as the Lite
+        // terminal above.
+        VendorProbeRecipe(
+            bundleID: "wang.jianing.app.OpenInEditor-Lite",
+            url: URL(string: "https://api.github.com/repos/Ji4n1ng/OpenInTerminal/releases?per_page=20")!,
+            mode: .responseBody,
+            versionPattern: #""tag_name": ?"v([0-9]+(?:\.[0-9]+)+)"(?:(?!"tag_name")[\s\S])*?"name": ?"OpenInEditor-Lite\.zip""#,
+            downloadURL: URL(string: "https://github.com/Ji4n1ng/OpenInTerminal/releases")!,
+            changelogURL: URL(string: "https://github.com/Ji4n1ng/OpenInTerminal/releases")!,
+            selectHighest: true,
+            install: VendorInstallSpec(
+                urlSource: .versionTemplate(
+                    "https://github.com/Ji4n1ng/OpenInTerminal/releases/download/v{version}/OpenInEditor-Lite.zip"),
+                kind: .zip)),
+
+        // Copies under the bundle ids the three editions shipped before they were
+        // renamed. Detection only: the install gate refuses every such copy, since
+        // the downloaded build's signing identifier is `wang.jianing.app.*`, not the
+        // installed one. The same release list carries every edition, so each probe
+        // still anchors its version to its own asset.
+        VendorProbeRecipe(
+            bundleID: "wang.jianing.OpenInTerminal",
+            url: URL(string: "https://api.github.com/repos/Ji4n1ng/OpenInTerminal/releases?per_page=20")!,
+            mode: .responseBody,
+            versionPattern: #""tag_name": ?"v?([0-9]+(?:\.[0-9]+)+)"(?:(?!"tag_name")[\s\S])*?"name": ?"OpenInTerminal\.zip""#,
+            downloadURL: URL(string: "https://github.com/Ji4n1ng/OpenInTerminal/releases")!,
+            changelogURL: URL(string: "https://github.com/Ji4n1ng/OpenInTerminal/releases")!,
+            selectHighest: true),
+        VendorProbeRecipe(
+            bundleID: "wang.jianing.OpenInTerminal-Lite",
+            url: URL(string: "https://api.github.com/repos/Ji4n1ng/OpenInTerminal/releases?per_page=20")!,
+            mode: .responseBody,
+            versionPattern: #""tag_name": ?"v?([0-9]+(?:\.[0-9]+)+)"(?:(?!"tag_name")[\s\S])*?"name": ?"OpenInTerminal-Lite\.zip""#,
+            downloadURL: URL(string: "https://github.com/Ji4n1ng/OpenInTerminal/releases")!,
+            changelogURL: URL(string: "https://github.com/Ji4n1ng/OpenInTerminal/releases")!,
+            selectHighest: true),
+        VendorProbeRecipe(
+            bundleID: "wang.jianing.OpenInEditor-Lite",
+            url: URL(string: "https://api.github.com/repos/Ji4n1ng/OpenInTerminal/releases?per_page=20")!,
+            mode: .responseBody,
+            versionPattern: #""tag_name": ?"v?([0-9]+(?:\.[0-9]+)+)"(?:(?!"tag_name")[\s\S])*?"name": ?"OpenInEditor-Lite\.zip""#,
+            downloadURL: URL(string: "https://github.com/Ji4n1ng/OpenInTerminal/releases")!,
+            changelogURL: URL(string: "https://github.com/Ji4n1ng/OpenInTerminal/releases")!,
+            selectHighest: true),
+        ],
+        githubRules: [
+        // OpenInTerminal (main) — Ji4n1ng/OpenInTerminal. Tags are `vX.Y.Z`, or
+        // `X.Y.Z` on older releases; the optional `v` is the only shape difference,
+        // so the pattern is anchored and accepts both. `/releases/latest` answers
+        // with the main edition, and the asset filter keeps a Lite-only release from
+        // being read as the main version.
+        // One-click: `OpenInTerminal.zip` carries `OpenInTerminal.app`, signed
+        // Developer ID by Team C8VX3ZLX5U and notarized. The install gate also
+        // needs the installed copy to carry the same Team and the signing
+        // identifier `wang.jianing.app.OpenInTerminal`; any other copy is refused.
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.app.OpenInTerminal",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            versionPattern: #"^v?([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^OpenInTerminal(?:\.app)?\.zip$"#,
+            installerKind: .zip),
+        ])
+}
