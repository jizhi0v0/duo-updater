diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SpotifastGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SpotifastGitHubRuleTests.swift
new file mode 100644
index 0000000..6db2047
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SpotifastGitHubRuleTests.swift
@@ -0,0 +1,141 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Spotifast (`Recipes/rocks-spotifast-Spotifast.swift`): the install pattern has to
+/// pick the one macOS dmg out of a release that carries twenty assets, and out of
+/// the 0.8.0–0.9.1 releases that carry every asset twice (`fastpotify-…` and
+/// `spotifast-…`, byte-identical). Releases up to 0.9.1 are `me.paolino.fastpotify`;
+/// 0.10.0 is the first `rocks.spotifast.Spotifast`.
+@Suite struct SpotifastGitHubRuleTests {
+
+    private static let newID = "rocks.spotifast.Spotifast"
+    private static let oldID = "me.paolino.fastpotify"
+
+    private static func rule(_ id: String) -> GitHubReleaseRule? {
+        GitHubReleaseRegistry.rules.first { $0.bundleID == id }
+    }
+
+    @Test func ruleReadsTheBareTagAndTheMacDmgOnly() throws {
+        let rule = try #require(Self.rule(Self.newID), "no GitHubReleaseRule for \(Self.newID)")
+        #expect(rule.owner == "crmne" && rule.repo == "spotifast")
+        #expect(rule.channel == .stable && !rule.usePrereleases)
+        #expect(rule.installerKind == .dmg)
+        let pattern = try #require(rule.installAssetPattern)
+        func matches(_ name: String) -> Bool {
+            name.range(of: pattern, options: .regularExpression) != nil
+        }
+
+        #expect(VendorProbeRecipe.extractVersion(from: "v0.13.1", pattern: rule.versionPattern) == "0.13.1")
+
+        #expect(matches("spotifast-v0.13.1-macos-universal.dmg"))
+        // The rest of the real v0.13.1 listing, and the pre-rename copy in 0.8.0–0.9.1.
+        #expect(!matches("fastpotify-v0.9.1-macos-universal.dmg"))
+        #expect(!matches("spotifast-v0.13.1-source.tar.gz"))
+        #expect(!matches("spotifast-0.13.1-aarch64.AppImage"))
+        #expect(!matches("spotifast-v0.13.1-x86_64.flatpak"))
+        #expect(!matches("spotifast-v0.13.1-x86_64-pc-windows-msvc.msi"))
+        #expect(!matches("spotifast-v0.13.1-x86_64-unknown-linux-gnu.tar.gz"))
+        #expect(!matches("spotifast_0.13.1_arm64.deb"))
+        #expect(!matches("checksums.txt"))
+    }
+
+    /// The old id is filed under the new id's rule by `BundleIDMigration`, so it is
+    /// deliberately not keyed here: two rules on one repo and channel would share a
+    /// `recipeID`, and with it one health entry.
+    @Test func theOldIdHasNoRuleOfItsOwn() {
+        #expect(Self.rule(Self.oldID) == nil)
+    }
+
+    // MARK: - The rename
+
+    private static let migration = BundleIDMigration.all.first { $0.from == oldID }
+
+    @Test func theRenameIsRegisteredForTheOneTeam() throws {
+        let entry = try #require(Self.migration)
+        #expect(entry.to == Self.newID && entry.teamID == "JPL7999US3")
+        #expect(entry.lastFromVersion == "0.9.1" && entry.firstToVersion == "0.10.0")
+    }
+
+    @Test func anOldCopyIsFiledUnderTheNewIdUpToTheBound() {
+        for version in ["0.1.0", "0.7.1", "0.9.1"] {
+            #expect(BundleIDMigration.recipeBundleID(for: Self.oldID, installedVersion: version) == Self.newID)
+        }
+        // 0.10.0 is the first release on the new id; an old-id copy at or past it is
+        // not the rename that was measured.
+        #expect(BundleIDMigration.recipeBundleID(for: Self.oldID, installedVersion: "0.10.0") == Self.oldID)
+        #expect(BundleIDMigration.recipeBundleID(for: Self.newID, installedVersion: "0.10.0") == Self.newID)
+    }
+
+    @Test func theGateNeedsTheTeamOnBothSides() {
+        func gate(_ version: String?, _ installedTeam: String?, _ downloadedTeam: String?) -> BundleIDMigration? {
+            BundleIDMigration.migration(
+                installed: Self.oldID, downloaded: Self.newID, installedVersion: version,
+                installedTeam: installedTeam, downloadedTeam: downloadedTeam)
+        }
+        #expect(gate("0.9.1", "JPL7999US3", "JPL7999US3") != nil)
+        #expect(gate("0.8.0", "JPL7999US3", "JPL7999US3") != nil)
+        // 0.1.0–0.7.1 are ad-hoc signed: no Team, no migration.
+        #expect(gate("0.7.1", nil, "JPL7999US3") == nil)
+        #expect(gate("0.9.1", "JPL7999US3", "OTHERTEAM1") == nil)
+        #expect(gate("0.10.0", "JPL7999US3", "JPL7999US3") == nil)
+        #expect(gate(nil, "JPL7999US3", "JPL7999US3") == nil)
+    }
+
+    // MARK: - An old-id copy, through the source
+
+    private static func installed(id: String, version: String) -> InstalledApp {
+        InstalledApp(
+            name: "Spotifast", bundleID: id, shortVersion: version, buildVersion: version,
+            path: URL(fileURLWithPath: "/Applications/ZZFixture-Spotifast.app"),
+            isMASApp: false, sparkleFeedURL: nil, releaseChannel: .stable)
+    }
+
+    final class StubRelease: URLProtocol, @unchecked Sendable {
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+        override func startLoading() {
+            let release = """
+            {"tag_name":"v0.13.1","name":"Spotifast v0.13.1","draft":false,"prerelease":false,\
+            "published_at":"2026-10-14T08:01:25Z",\
+            "html_url":"https://github.com/crmne/spotifast/releases/tag/v0.13.1","body":"notes",\
+            "assets":[{"name":"spotifast-v0.13.1-macos-universal.dmg",\
+            "browser_download_url":"https://github.com/crmne/spotifast/releases/download/v0.13.1/spotifast-v0.13.1-macos-universal.dmg",\
+            "size":31711983}]}
+            """
+            let url = request.url?.absoluteString ?? ""
+            let body = url.contains("/releases/latest") ? release : "[\(release)]"
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: 200, httpVersion: "HTTP/1.1",
+                headerFields: ["Content-Type": "application/json"])!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: Data(body.utf8))
+            client?.urlProtocolDidFinishLoading(self)
+        }
+
+        override func stopLoading() {}
+    }
+
+    private static func latest(for app: InstalledApp) async throws -> RemoteVersion? {
+        let config = URLSessionConfiguration.ephemeral
+        config.protocolClasses = [StubRelease.self]
+        return try await GitHubReleasesSource(session: URLSession(configuration: config))
+            .latestVersion(for: app)
+    }
+
+    /// 0.9.1 and earlier are `me.paolino.fastpotify`: they reach the rule keyed by the
+    /// new id, and are offered the dmg. At 0.10.0 an old-id copy is not the rename that
+    /// was measured and gets nothing.
+    @Test func anOldIdCopyIsOfferedTheNewestDmg() async throws {
+        for version in ["0.1.0", "0.7.1", "0.9.1"] {
+            let remote = try await Self.latest(for: Self.installed(id: Self.oldID, version: version))
+            #expect(remote?.shortVersion == "0.13.1", "\(version)")
+            #expect(remote?.downloadURL?.lastPathComponent == "spotifast-v0.13.1-macos-universal.dmg")
+        }
+        #expect(try await Self.latest(for: Self.installed(id: Self.oldID, version: "0.10.0")) == nil)
+        let current = try await Self.latest(for: Self.installed(id: Self.newID, version: "0.13.0"))
+        #expect(current?.shortVersion == "0.13.1")
+    }
+}
