@@ -0,0 +1,35 @@
+import Foundation
+
+enum com_lokii_app {
+    static let set = AppRecipeSet(
+        family: "com-lokii-app",
+        githubRules: [
+        // Lokii — native macOS instant file search (Rust core, AppKit shell), MIT,
+        // huangy7/lokii. No Sparkle and no electron-builder config (feed-discover:
+        // noKnownUpdater). Its own AppUpdater reads the same `/releases/latest` and
+        // only opens the download page, so nothing else replaces the bundle.
+        //
+        // v-tags. `scripts/build.sh` stamps CFBundleShortVersionString from
+        // lokii-core/Cargo.toml, and the release workflow refuses a tag that disagrees
+        // with it, so short == tag. Every release is published with prerelease: false
+        // and the publish job forces `--latest` on whatever tag it is given, so an
+        // `-rc` tag would become `/releases/latest`. The anchored pattern refuses it,
+        // and because the asset name carries no version the source does not walk past
+        // it: detection says nothing until the next stable release. A known limit,
+        // not a wrong answer.
+        //
+        // Ad-hoc signed (`codesign --sign -`), no Team ID, not notarized. The seal
+        // verifies and the signed identifier is the bundle id, so the one-click route
+        // is `.publishedDigestOnly`: the download must match the digest GitHub
+        // publishes for its asset, and the user has to allow that route in Settings.
+        // Measured for 0.1.0, 0.1.1 and 0.1.2 (both arches): every asset carries a
+        // digest and it equalled the real download's SHA-256.
+        GitHubReleaseRule(
+            bundleID: "com.lokii.app",
+            owner: "huangy7", repo: "lokii",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^Lokii-arm64\.dmg$"#,
+            installerKind: .dmg,
+            installTrust: .publishedDigestOnly),
+        ])
+}
