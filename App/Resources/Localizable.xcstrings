    "Backups": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias de seguridad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekler"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份"
          }
        }
      }
    },
    "Backups are copied here in the background, after an update is installed, so nothing waits on the disk.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups werden nach der Installation eines Updates im Hintergrund hierher kopiert, sodass nichts auf die Festplatte wartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias se copian aquí en segundo plano, después de instalar una actualización, así que nada espera al disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sont copiées ici en arrière-plan, après l’installation d’une mise à jour, donc rien n’attend le disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup vengono copiati qui in background, dopo l’installazione di un aggiornamento, così nulla resta in attesa del disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップは更新のインストール後にバックグラウンドでここへコピーされるため、ディスクを待つ処理はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups são copiados para cá em segundo plano, depois que uma atualização é instalada, então nada fica esperando pelo disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии переносятся сюда в фоне, уже после установки обновления, поэтому ничего не ждёт диск."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekler, bir güncelleme yüklendikten sonra arka planda buraya kopyalanır; böylece hiçbir şey diski beklemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份在更新安装完成后于后台复制到这里，因此不会有任何操作等待磁盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份會在更新安裝完成後於背景拷貝到這裡，因此不會有任何操作在等磁碟。"
          }
        }
      }
    },
    "Backups are copies of whole apps, so they are large. Keeping them on an external disk or a network share frees that space on this Mac without giving up the ability to undo an update.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups sind Kopien vollständiger Apps und entsprechend groß. Wenn du sie auf einer externen Festplatte oder einem Netzlaufwerk aufbewahrst, wird dieser Speicherplatz auf diesem Mac frei, ohne dass du auf das Rückgängigmachen von Updates verzichten musst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias contienen apps completas, así que ocupan mucho. Guardarlas en un disco externo o en un recurso de red libera ese espacio en este Mac sin renunciar a poder deshacer una actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sont des copies d’apps entières, donc volumineuses. Les conserver sur un disque externe ou un partage réseau libère cet espace sur ce Mac sans renoncer à la possibilité d’annuler une mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup sono copie di intere app, quindi sono grandi. Tenerli su un disco esterno o una condivisione di rete libera quello spazio su questo Mac senza rinunciare alla possibilità di annullare un aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップは App 全体のコピーなので容量が大きくなります。外付けディスクやネットワーク共有に置けば、更新を取り消せる機能はそのままに、この Mac の容量を空けられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups são cópias de apps inteiros, por isso são grandes. Mantê-los num disco externo ou num compartilhamento de rede libera esse espaço neste Mac sem abrir mão de poder desfazer uma atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии — это копии программ целиком, поэтому они большие. Хранение их на внешнем диске или в сетевой папке освобождает это место на Mac, не лишая возможности отменить обновление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekler uygulamaların tam kopyalarıdır, bu yüzden büyüktür. Bunları harici bir diskte veya ağ paylaşımında tutmak, bir güncellemeyi geri alabilme olanağından vazgeçmeden bu Mac’te yer açar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份是整个 App 的完整副本，因此很占地方。把它们放到外接磁盘或网络共享上，可以在不放弃撤销更新能力的前提下腾出这台 Mac 的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份是整個 App 的完整拷貝，因此佔用空間很大。將它們存放在外接磁碟或網路共享上，就能釋出這台 Mac 的空間，同時保留還原更新的能力。"
          }
        }
      }
    },
    "Backups keep one previous version of each app, so an update can be undone. Retention is one per app — the previous version is replaced, not accumulated.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups bewahren je App eine vorherige Version auf, sodass ein Update rückgängig gemacht werden kann. Aufbewahrt wird genau eine pro App – die vorherige Version wird ersetzt, nicht angesammelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias conservan una versión anterior de cada app, de modo que una actualización pueda deshacerse. Se conserva una por app: la versión anterior se sustituye, no se acumula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes conservent une version précédente de chaque app, afin qu’une mise à jour puisse être annulée. Une seule par app est conservée : la version précédente est remplacée, non accumulée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup conservano una versione precedente di ogni app, così un aggiornamento può essere annullato. Se ne conserva uno per app: la versione precedente viene sostituita, non accumulata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップは各 App の以前のバージョンを 1 つ保持し、更新を取り消せるようにします。保持数は App ごとに 1 つで、以前のバージョンは蓄積されず置き換えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups guardam uma versão anterior de cada app, para que uma atualização possa ser desfeita. É mantido um por app — a versão anterior é substituída, não acumulada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии хранят одну предыдущую версию каждой программы, чтобы обновление можно было отменить. Хранится по одной на программу: предыдущая версия заменяется, а не накапливается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekler her uygulamanın bir önceki sürümünü tutar; böylece bir güncelleme geri alınabilir. Her uygulama için bir yedek tutulur — önceki sürüm birikmez, yenisiyle değiştirilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份为每个 App 保留一个此前的版本，以便撤销更新。每个 App 只留一份——旧版本会被替换，不会累积。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份會為每個 App 保留一個先前的版本，以便還原更新。每個 App 只保留一份——舊的會被取代，不會累積。"
          }
        }
      }
    },
    "Backups on another disk are stored as a single compressed archive. That is what lets a disk formatted for Windows, or a network share, hold one at all — and it is usually less than half the size of the app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups auf einer anderen Festplatte werden als einzelnes komprimiertes Archiv abgelegt. Genau dadurch kann eine für Windows formatierte Festplatte oder ein Netzlaufwerk überhaupt eines aufnehmen – und es ist meist weniger als halb so groß wie die App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias en otro disco se guardan como un único archivo comprimido. Eso es lo que permite que un disco formateado para Windows, o un recurso de red, pueda alojarlas, y suele ocupar menos de la mitad que la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sur un autre disque sont stockées sous forme d’une seule archive compressée. C’est ce qui permet à un disque formaté pour Windows, ou à un partage réseau, d’en contenir une — et elle fait généralement moins de la moitié de la taille de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup su un altro disco vengono salvati come un unico archivio compresso. È ciò che permette a un disco formattato per Windows, o a una condivisione di rete, di contenerne uno, e di solito occupa meno della metà dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のディスク上のバックアップは、単一の圧縮アーカイブとして保存されます。Windows 用にフォーマットされたディスクやネットワーク共有でも保存できるのはこのためで、サイズは通常 App の半分未満になります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups em outro disco são armazenados como um único arquivo compactado. É isso que permite que um disco formatado para Windows, ou um compartilhamento de rede, consiga guardar um — e ele costuma ter menos da metade do tamanho do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии на другом диске хранятся в виде одного сжатого архива. Именно поэтому их может принять диск, отформатированный для Windows, или сетевая папка, — и обычно архив занимает меньше половины размера программы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir diskteki yedekler tek bir sıkıştırılmış arşiv olarak saklanır. Windows için biçimlendirilmiş bir diskin veya bir ağ paylaşımının yedek tutabilmesini sağlayan budur — ve genellikle uygulamanın yarısından da küçüktür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存放在另一块磁盘上的备份是单个压缩归档。正因如此，为 Windows 格式化的磁盘或网络共享才能存得下它——而且通常不到 App 体积的一半。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存放在其他磁碟上的備份會是單一壓縮封存檔。正因如此，Windows 格式的磁碟或網路共享才存得下它——而且通常不到 App 大小的一半。"
          }
        }
      }
    },
    "Backups on “%@” aren’t available right now — showing only what’s on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups auf „%@“ sind derzeit nicht verfügbar — es wird nur gezeigt, was auf diesem Mac liegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias en «%@» no están disponibles ahora mismo; solo se muestra lo que hay en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sur « %@ » sont indisponibles pour le moment ; seul ce qui se trouve sur ce Mac est affiché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup su “%@” non sono disponibili al momento: vengono mostrati solo quelli su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のバックアップは現在利用できません。この Mac にあるものだけを表示しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups em “%@” não estão disponíveis agora — mostrando só o que está neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии на «%@» сейчас недоступны — показано только то, что есть на этом Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” üzerindeki yedekler şu anda kullanılamıyor — yalnızca bu Mac’tekiler gösteriliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”上的备份现在读不到 —— 只显示这台 Mac 上的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」上的備份目前無法使用——只顯示這台 Mac 上的備份。"
          }
        }
      }
    },
    "Choose a folder on an external disk or a network share. Backups are kept inside it, and moving them there is what frees space on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner auf einer externen Festplatte oder einem Netzlaufwerk. Die Backups werden darin aufbewahrt, und genau dieses Verschieben schafft Speicherplatz auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta en un disco externo o en un recurso de red. Las copias se guardan dentro de ella, y es ese traslado lo que libera espacio en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier sur un disque externe ou un partage réseau. Les sauvegardes y sont conservées, et c’est ce déplacement qui libère de l’espace sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella su un disco esterno o una condivisione di rete. I backup vengono conservati lì dentro, ed è spostandoli lì che si libera spazio su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けディスクまたはネットワーク共有上のフォルダを選んでください。バックアップはその中に保存され、そこへ移すことでこの Mac の容量が空きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta num disco externo ou num compartilhamento de rede. Os backups ficam dentro dela, e é movê-los para lá que libera espaço neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку на внешнем диске или в сетевой папке. Копии хранятся внутри неё, и именно этот перенос освобождает место на этом Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harici bir diskte veya ağ paylaşımında bir klasör seçin. Yedekler bu klasörün içinde tutulur; onları oraya taşımak bu Mac’te yer açar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择外接磁盘或网络共享上的文件夹。备份会存放在其中，正是这次搬移才腾出这台 Mac 的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇外接磁碟或網路共享上的資料夾。備份會存放在其中，搬到那裡才會釋出這台 Mac 的空間。"
          }
        }
      }
    },
    "Compression": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimierung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compresión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
