    "%@ %@ is supported only up to macOS %@, and this Mac runs macOS %@. DuoUpdater won’t offer it until the developer supports this version of macOS.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ wird nur bis macOS %@ unterstützt, auf diesem Mac läuft macOS %@. DuoUpdater bietet es erst an, wenn der Entwickler diese macOS-Version unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ solo es compatible hasta macOS %@, y este Mac tiene macOS %@. DuoUpdater no la ofrecerá hasta que el desarrollador admita esta versión de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ n’est prise en charge que jusqu’à macOS %@, et ce Mac exécute macOS %@. DuoUpdater ne la proposera pas tant que le développeur ne prendra pas en charge cette version de macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ è supportata solo fino a macOS %@ e questo Mac ha macOS %@. DuoUpdater non la proporrà finché lo sviluppatore non supporterà questa versione di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ は macOS %@ までしかサポートされておらず、この Mac は macOS %@ です。開発元がこのバージョンの macOS に対応するまで、DuoUpdater はこのバージョンを提供しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ é compatível somente até o macOS %@, e este Mac usa o macOS %@. O DuoUpdater não vai oferecê-lo até que o desenvolvedor dê suporte a esta versão do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ поддерживается только до macOS %@, а на этом Mac установлена macOS %@. DuoUpdater не предложит эту версию, пока разработчик не добавит поддержку этой версии macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ yalnızca macOS %@ sürümüne kadar destekleniyor; bu Mac ise macOS %@ çalıştırıyor. Geliştirici bu macOS sürümünü destekleyene kadar DuoUpdater bu güncellemeyi önermeyecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 最高只支持到 macOS %@，而此 Mac 运行的是 macOS %@。在开发者支持此版本的 macOS 之前，DuoUpdater 不会提供这个版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 最高只支援到 macOS %@，而這台 Mac 執行的是 macOS %@。在開發者支援此版本的 macOS 之前，DuoUpdater 不會提供這個版本。"
          }
        }
      }
    },
    "%@ %@ needs macOS %@ or later, and this Mac runs macOS %@. It can’t be installed until this Mac runs a newer macOS.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ erfordert macOS %@ oder neuer, auf diesem Mac läuft macOS %@. Installieren lässt es sich erst, wenn auf diesem Mac ein neueres macOS läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ requiere macOS %@ o posterior, y este Mac tiene macOS %@. No se podrá instalar hasta que este Mac tenga un macOS más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ nécessite macOS %@ ou ultérieur, et ce Mac exécute macOS %@. Elle ne pourra pas être installée tant que ce Mac n’exécutera pas un macOS plus récent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ richiede macOS %@ o versioni successive e questo Mac ha macOS %@. Non può essere installata finché questo Mac non avrà un macOS più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ には macOS %@ 以降が必要ですが、この Mac は macOS %@ です。この Mac でより新しい macOS を使うまではインストールできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ requer o macOS %@ ou posterior, e este Mac usa o macOS %@. Não será possível instalá-lo até que este Mac tenha um macOS mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ требует macOS %@ или новее, а на этом Mac установлена macOS %@. Установить её можно будет только после перехода этого Mac на более новую macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ için macOS %@ veya sonrası gerekiyor; bu Mac ise macOS %@ çalıştırıyor. Bu Mac daha yeni bir macOS çalıştırana kadar yüklenemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 需要 macOS %@ 或更高版本，而此 Mac 运行的是 macOS %@。此 Mac 运行更新的 macOS 之前无法安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 需要 macOS %@ 或以上版本，而這台 Mac 執行的是 macOS %@。必須等這台 Mac 升級到較新的 macOS 才能安裝。"
          }
        }
      }
    },
    "%@ %@ → %@ is a major new version. If this is a commercial app, it may need a new license — with an expired subscription the update can drop into a limited/trial mode.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ → %@ ist eine neue Hauptversion. Falls es sich um eine kommerzielle App handelt, ist möglicherweise eine neue Lizenz nötig – bei abgelaufenem Abo kann das Update in einen eingeschränkten Modus/Testmodus wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ → %@ es una nueva versión principal. Si es una app comercial, puede necesitar una licencia nueva; con una suscripción caducada, la actualización puede pasar a un modo limitado o de prueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ → %@ est une nouvelle version majeure. S'il s'agit d'une application commerciale, une nouvelle licence peut être nécessaire — avec un abonnement expiré, la mise à jour peut basculer en mode limité/essai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ → %@ è una nuova versione principale. Se è un’app commerciale potrebbe richiedere una nuova licenza: con un abbonamento scaduto l’aggiornamento può passare a una modalità limitata o di prova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ → %@ は新しいメジャーバージョンです。商用アプリの場合、新しいライセンスが必要になることがあります — サブスクリプションが期限切れの場合、更新後に制限付き/体験モードになる可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ → %@ é uma nova versão principal. Se for um app pago, talvez seja necessária uma nova licença — com a assinatura vencida, a atualização pode cair em modo limitado/de avaliação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ → %@ — это новая мажорная версия. Если это коммерческое приложение, может потребоваться новая лицензия — при истёкшей подписке обновление может перейти в ограниченный/пробный режим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ → %@ büyük bir yeni sürüm. Ücretli bir uygulamaysa yeni bir lisans gerekebilir — aboneliğin süresi dolmuşsa güncelleme sınırlı/deneme moduna düşebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ → %@ 是一个重大新版本。如果这是商业应用，可能需要新许可证 — 订阅过期后更新可能会进入受限/试用模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ → %@ 是重大新版本。如果這是付費 App，可能需要新的授權——訂閱過期時，更新後可能會進入功能受限或試用模式。"
          }
        }
      }
    },
    "%@ already downloaded %@ — relaunch to apply it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat %@ bereits heruntergeladen – neu starten, um es anzuwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya descargó %@; reabre para aplicarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a déjà téléchargé %@ — relancez pour l'appliquer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha già scaricato %@ — riapri per applicarlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに %@ をダウンロード済みです — 再起動して適用してください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já baixou %@ — reabra para aplicar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже загрузило %@ — перезапустите, чтобы применить"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ sürümünü zaten indirdi — uygulamak için yeniden başlatın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下载 %@ — 重新启动以应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下載 %@ — 重新開啟即可套用"
          }
        }
      }
    },
    "%@ already downloaded %@ — relaunch to apply it (no extra download; a large app may take a minute to swap & reopen)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat %@ bereits heruntergeladen – neu starten, um es anzuwenden (kein erneuter Download nötig; bei einer großen App kann der Austausch & Neustart eine Minute dauern)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya descargó %@; reabre para aplicarlo (sin descarga adicional; en apps grandes el intercambio y la reapertura pueden tardar un minuto)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a déjà téléchargé %@ — relancez pour l'appliquer (pas de nouveau téléchargement ; pour une grande application, l'échange et la réouverture peuvent prendre une minute)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha già scaricato %@ — riapri per applicarlo (nessun download aggiuntivo; un’app grande può impiegare un minuto per sostituirsi e riaprirsi)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに %@ をダウンロード済みです — 再起動して適用してください（追加のダウンロードは不要です。大きなアプリは入れ替えと再起動に1分ほどかかる場合があります）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já baixou %@ — reabra para aplicar (sem novo download; um app grande pode levar um minuto para trocar e reabrir)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже загрузило %@ — перезапустите, чтобы применить (без повторной загрузки; для крупного приложения замена и открытие могут занять минуту)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ sürümünü zaten indirdi — uygulamak için yeniden başlatın (ek indirme yok; büyük bir uygulamanın değiştirilip yeniden açılması bir dakika sürebilir)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下载 %@ — 重新启动以应用（无需再次下载；大型应用替换并重新打开可能需要一分钟）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下載 %@ — 重新開啟即可套用（不必重新下載；大型 App 替換並重新開啟可能需要一分鐘）"
          }
        }
      }
    },
    "%@ and %@ have updates.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ und %@ sind Updates verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay actualizaciones para %@ y %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des mises à jour sont disponibles pour %@ et %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono disponibili aggiornamenti per %@ e %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ と %@ にアップデートがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e %@ têm atualizações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ и %@ доступны обновления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ve %@ için güncelleme var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 和 %@ 有可用更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 和 %@ 有可用的更新。"
          }
        }
      }
    },
    "%@ could not be read back at its path after the install.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nach der Installation an seinem Pfad nicht wieder gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo volver a leer %@ en su ruta después de la instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de relire %@ à son emplacement après l'installation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rileggere %@ nel suo percorso dopo l’installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール後、%@ をそのパスから読み直せませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler %@ no caminho dele após a instalação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось повторно прочитать %@ по его пути после установки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, yüklemeden sonra kendi konumunda yeniden okunamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装后无法在其路径重新读取 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝後無法在原路徑重新讀取 %@。"
          }
        }
      }
    },
    "%@ could not be read back at its path after the rollback.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nach der Wiederherstellung an seinem Pfad nicht wieder gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo volver a leer %@ en su ruta después de la reversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de relire %@ à son emplacement après la restauration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rileggere %@ nel suo percorso dopo il ripristino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロールバック後、%@ をそのパスから読み直せませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler %@ no caminho dele após a reversão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось повторно прочитать %@ по его пути после отката."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, geri alma işleminden sonra kendi konumunda yeniden okunamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回滚后无法在其路径重新读取 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原後無法在原路徑重新讀取 %@。"
          }
        }
      }
    },
    "%@ didn’t quit — it has a window waiting for you (a save prompt, a sign-in sheet, a dialog). Switch to it, deal with that window, then quit it or click Relaunch again. Nothing was changed and the new version is already installed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nicht beendet – es hat ein Fenster offen, das auf dich wartet (eine Sicherungsabfrage, ein Anmeldefenster, ein Dialog). Wechsle dorthin, erledige dieses Fenster und beende die App dann selbst oder klicke erneut auf „Neu starten“. Es wurde nichts verändert, und die neue Version ist bereits installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se cerró: tiene una ventana esperándote (un aviso para guardar, una hoja de inicio de sesión, un diálogo). Ve a la app, resuelve esa ventana y luego ciérrala o vuelve a pulsar «Reabrir». No se ha cambiado nada y la versión nueva ya está instalada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas quitté — une fenêtre y attend ta réponse (une demande d’enregistrement, une feuille de connexion, une boîte de dialogue). Passe à l’app, règle cette fenêtre, puis quitte-la ou reclique sur « Relancer ». Rien n’a été modifié et la nouvelle version est déjà installée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non si è chiusa: ha una finestra in attesa (una richiesta di salvataggio, un foglio di accesso, una finestra di dialogo). Passa all’app, gestisci quella finestra, poi chiudila o fai di nuovo clic su Riapri. Non è stato modificato nulla e la nuova versione è già installata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は終了しませんでした。操作を待っているウインドウがあります（保存の確認、サインインのシート、ダイアログなど）。アプリに切り替えてそのウインドウを片付けてから、自分で終了するか、もう一度「再起動」をクリックしてください。何も変更しておらず、新しいバージョンはすでにインストール済みです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não encerrou — há uma janela esperando por você (um pedido para salvar, uma tela de login, um diálogo). Vá até o app, resolva essa janela e depois encerre-o ou clique em Reabrir de novo. Nada foi alterado e a nova versão já está instalada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не закрылось — в нём открыто окно, которое ждёт вас (запрос на сохранение, форма входа, диалог). Переключитесь на приложение, разберитесь с этим окном, а затем закройте его сами или нажмите «Перезапустить» ещё раз. Ничего не изменено, новая версия уже установлена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kapanmadı — sizi bekleyen bir penceresi var (kaydetme sorusu, oturum açma sayfası, bir iletişim kutusu). Uygulamaya geçip o pencereyle ilgilenin, ardından uygulamadan çıkın veya tekrar Yeniden Başlat’a tıklayın. Hiçbir şey değiştirilmedi ve yeni sürüm zaten yüklü."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有退出 —— 它有一个窗口在等你处理（保存提示、登录框、对话框之类）。切过去把那个窗口处理掉，然后自己退出它，或者再点一次「重新启动」。什么都没有改动，新版本已经装好了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有結束——它有一個視窗在等你處理（儲存提示、登入視窗或對話框）。請切換過去處理完那個視窗，然後結束它，或再按一次「重新開啟」。沒有做任何變更，新版本已經安裝好了。"
          }
        }
      }
    },
    "%@ quit, but its own updater didn’t apply the update in time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde beendet, aber sein eigener Updater hat das Update nicht rechtzeitig angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se cerró, pero su propio actualizador no aplicó la actualización a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a quitté, mais son propre outil de mise à jour n’a pas appliqué la mise à jour à temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si è chiusa, ma il suo programma di aggiornamento non ha applicato l’aggiornamento in tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は終了しましたが、アプリ自身のアップデータが時間内にアップデートを適用しませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ encerrou, mas o atualizador dele não aplicou a atualização a tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ закрылось, но его собственный механизм обновления не успел применить обновление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kapandı, ancak kendi güncelleyicisi güncellemeyi zamanında uygulamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已退出，但它自带的更新程序没有及时应用更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已結束，但它自己的更新程式沒有及時套用更新。"
          }
        }
      }
    },
    "%@ restarted without applying the update.": {
