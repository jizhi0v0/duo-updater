    "Alcove keeps release notes and installable builds behind its license.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcove verbirgt Versionshinweise und installierbare Builds hinter seiner Lizenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcove reserva las notas de versión y las compilaciones instalables a quienes tienen licencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcove protège les notes de version et les versions installables derrière sa licence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcove tiene note di rilascio e build installabili dietro la sua licenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcove のリリースノートとインストール用ビルドは、ライセンスがないと利用できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alcove mantém as notas de versão e os builds instaláveis por trás da licença."
          }
        },
        "ru": {
