+/// and asset names, 2026-10-14.
+@Test func whatcableRulesKeepStableAndBetaSeparateByTag() {
+    let bundleID = "uk.whatcable.whatcable"
+
+    #expect(extract("v1.5.0", bundleID, channel: .stable) == "1.5.0")
+    #expect(extract("v1.5.0-beta.10", bundleID, channel: .stable) == nil)
+    #expect(rule(bundleID, channel: .stable).usePrereleases == false)
+
+    #expect(extract("v1.5.0-beta.10", bundleID, channel: .beta) == "1.5.0-beta.10")
+    #expect(extract("v1.5.0", bundleID, channel: .beta) == nil)
+    #expect(rule(bundleID, channel: .beta).usePrereleases == true)
+
+    for channel in [ReleaseChannel.stable, .beta] {
+        #expect(matches("WhatCable.zip", bundleID, channel: channel))
+        // The CLI ships beside the app on every release since v0.13.0.
+        #expect(!matches("whatcable-cli-1.5.0.zip", bundleID, channel: channel))
+        #expect(!matches("whatcable-cli-1.5.0-beta.10.zip", bundleID, channel: channel))
+        #expect(rule(bundleID, channel: channel).installerKind == .zip)
+    }
