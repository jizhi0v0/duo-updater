    },
    "Nothing touches an app while it is open: it installs only once the app is closed, and offers Open instead, leaving the update to the app itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine geöffnete App bleibt unangetastet: Installiert wird erst, wenn sie geschlossen ist; bis dahin wird „Öffnen“ angeboten und das Update der App selbst überlassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada toca una app mientras está abierta: solo se instala cuando se cierra, y mientras tanto se ofrece Abrir, dejando la actualización a la propia app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne touche une application ouverte : l'installation n'a lieu qu'une fois l'application fermée, et Ouvrir est proposé à la place, laissant la mise à jour à l'application elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna app viene toccata mentre è aperta: l’installazione avviene solo dopo la chiusura, e viene proposto Apri, lasciando l’aggiornamento all’app stessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているアプリには手を加えません。アプリが閉じられてからインストールし、それまでは「開く」を表示して、更新はアプリ自身に委ねます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada toca num app enquanto ele está aberto: a instalação só acontece depois que o app é fechado, e em vez disso é oferecido Abrir, deixando a atualização com o próprio app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытое приложение не трогается: установка происходит только после его закрытия, а до тех пор предлагается «Открыть», оставляя обновление самому приложению."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken hiçbir uygulamaya dokunulmaz: yalnızca uygulama kapandıktan sonra yükler, bu sırada güncellemeyi uygulamanın kendisine bırakıp Aç seçeneğini sunar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用打开时不做任何改动：只在应用关闭后才安装，期间改为提供“打开”，把更新交给应用自己处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 開啟時不會動它：只在 App 關閉後才安裝，期間改為提供「打開」，把更新交給 App 自己處理。"
          }
        }
      }
    },
    "Notify me when updates are found": {
      "extractionState": "manual",
      "localizations": {
        "de": {
