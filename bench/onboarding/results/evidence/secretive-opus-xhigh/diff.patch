+import Foundation
+
+enum com_maxgoedjen_Secretive_Host {
+    static let set = AppRecipeSet(
+        family: "com-maxgoedjen-Secretive-Host",
+        githubRules: [
+        // Secretive — SSH keys in the Secure Enclave. No SUFeedURL; its own
+        // updater (an XPC service) reads this repo's /releases list, drops
+        // prereleases and only links to the release page, so the repo is the
+        // authoritative source. The release workflow stamps the tag minus `v`
+        // into CFBundleShortVersionString (CFBundleVersion is `1.<run id>`).
+        // The anchor also keeps out the release-less `v0.0.0_beta1`,
+        // `v0.0.0_test` and `v3.0.1-skipped` tags. Single track: nightlies are
+        // Actions artifacts only (`0.0.0_nightly-<date>`), never releases. One
+        // universal `Secretive.zip` per release, unversioned name. The body's
+        // "Minimum macOS Version" is not read here; the downloaded bundle's
+        // LSMinimumSystemVersion is checked at install. Team Z72PRUAWF6,
+        // notarized (ticket not stapled).
+        GitHubReleaseRule(
+            bundleID: "com.maxgoedjen.Secretive.Host",
+            owner: "maxgoedjen", repo: "secretive",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^Secretive\.zip$"#,
+            installerKind: .zip),
+        ])
+}
