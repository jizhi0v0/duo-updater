+import Foundation
+
+enum com_tinycast_app {
+    static let set = AppRecipeSet(
+        family: "com-tinycast-app",
+        changelogs: [
+        // History: docs/app-audits/com-tinycast-app.md#历史与实测
+        //
+        // Tinycast — release bodies are GitHub's generated notes ("What's
+        // Changed" bullets, then "New Contributors"), followed by a
+        // `<!-- tinycast:install -->` block of Homebrew and xattr instructions.
+        // `GitHubMarkdownParser` keeps the bullets and drops the rest; the real
+        // bodies are pinned in `TinycastGitHubRuleTests`.
+        //
+        // `tagPattern` is a filter as much as a version reader. GitHub's
+        // prerelease flag alone does not separate the beta train: the repo also
+        // carries `-sequoia` side builds and the retired `-alpha.N` train, all
+        // flagged prerelease, and neither is a build the beta app would take.
+        // Same `per_page=40` / `maxEntries: 20` house shape as Yaak and Cline.
+        ChangelogRecipe(
+            bundleID: "com.tinycast.app",
+            source: URL(string: "https://api.github.com/repos/abue-ammar/tinycast/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .stable,
+            structuredFormat: .gitHubReleases,
+            tagPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+
+        ChangelogRecipe(
+            bundleID: "com.tinycast.app.beta",
+            source: URL(string: "https://api.github.com/repos/abue-ammar/tinycast/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .beta,
+            structuredFormat: .gitHubReleases,
+            tagPattern: #"^v([0-9]+(?:\.[0-9]+)+-beta\.[0-9]+)$"#),
+        ],
+        githubRules: [
+        // Tinycast — a launcher distributed only through this repo's Releases:
+        // no `SUFeedURL`, no electron-builder config, no Homebrew core cask (the
+        // vendor's own tap only), nothing on the Mac App Store. The app's own
+        // updater reads the same `/releases` list.
+        //
+        // Stable and beta are separate apps, settled from source
+        // (`.github/workflows/release.yml`, `ReleaseChannel.swift`):
+        // `com.tinycast.app` takes non-prerelease `vX.Y.Z` tags, and
+        // `com.tinycast.app.beta` ("Tinycast Beta") takes prerelease
+        // `vX.Y.Z-beta.N` tags, where N is the workflow run number. Both bundles
+        // carry the tag minus its `v` as `CFBundleShortVersionString`, suffix
+        // included, so the beta rule captures the suffix too. The `.beta` bundle
+        // id suffix is what `ReleaseChannel.detect()` reads.
+        //
+        // Both patterns are anchored at both ends. The repo also publishes
+        // `-sequoia` builds (a macOS 15 side train under the STABLE bundle id)
+        // and once published `-alpha.N`; neither belongs to either rule, and an
+        // unanchored pattern reads `v0.9.7-sequoia` as `0.9.7`.
+        //
+        // Detection-only, on both tracks. Every build is signed with the
+        // vendor's self-signed "Tinycast Self-Signed" identity and is not
+        // notarized: `TeamIdentifier=not set`. `SignatureVerifier` gate 3 (Team
+        // ID match) refuses a swap when either side has no Team ID, so an
+        // install pattern could only produce an Update button that always
+        // fails. `TinycastGitHubRuleTests` pins that.
+        GitHubReleaseRule(
+            bundleID: "com.tinycast.app",
+            owner: "abue-ammar", repo: "tinycast",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+
+        // Beta: the newest release is a beta most days, so the one-row probe
+        // usually answers. 10 rows against a measured floor of 5 (see
+        // `GitHubListPageSizeTests`).
+        GitHubReleaseRule(
+            bundleID: "com.tinycast.app.beta",
+            owner: "abue-ammar", repo: "tinycast",
+            usePrereleases: true,
+            listPageSize: 10,
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+-beta\.[0-9]+)$"#,
+            channel: .beta),
+        ])
+}
