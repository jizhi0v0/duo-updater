diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift
new file mode 100644
index 0000000..3e37309
--- /dev/null
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift
@@ -0,0 +1,38 @@
+import Foundation
+
+/// SwiftVM (`com.swiftvm.app`) — one bundle id, two Sparkle feeds, and the
+/// track is baked into each build rather than chosen in a setting.
+///
+/// What the vendor does (swiftvm-app/swiftvm, read 2026-10-14):
+/// `.github/workflows/release.yml` builds stable copies with `SUFeedURL`
+/// `releases/latest/download/appcast.xml`, whose items carry no
+/// `<sparkle:channel>`; `release-beta.yml` builds `X.Y.Z-beta.N` copies with
+/// `SUFeedURL` `releases/download/beta-channel/appcast-beta.xml`, and
+/// `scripts/generate-appcast.sh` tags every item there `beta`. The app's own
+/// `UpdateChannel.channels(forVersion:)` returns `["beta"]` for a version
+/// containing `-beta.` and nothing otherwise. There is no toggle: a copy stays on
+/// the track it was built for.
+///
+/// Why a binding: a beta copy reads a feed with no untagged item. Without one,
+/// `SparkleAppcastSource.allowedChannels` infers the tag from the installed
+/// build's own item — fine while the feed keeps every beta (it does today),
+/// nothing at all for a copy the feed stops listing.
+///
+/// Keyed on the feed the bundle declares, which only `release-beta.yml` writes;
+/// the version suffix the app itself reads always comes with it (that workflow
+/// stamps `X.Y.Z-beta.N`). A stable copy, or any copy declaring another feed,
+/// resolves nil: the untagged items and `ReleaseChannel.detect()` already serve
+/// it. No feed override and no explicit tag (`.beta` derives `beta`), so the
+/// install comes from the address the bundle names, like MonitorControl's.
+///
+/// Not in `boundBundleIDs`, same as CodeEdit: nothing a user sets changes the answer.
+enum SwiftVMChannel {
+    static let bundleID = "com.swiftvm.app"
+
+    /// The `SUFeedURL` every beta build declares.
+    static let betaFeed = URL(string: "https://github.com/swiftvm-app/swiftvm/releases/download/beta-channel/appcast-beta.xml")!
+
+    static func resolve(bundleFeeds: [String: URL]) -> ResolvedChannel? {
+        bundleFeeds["SUFeedURL"] == betaFeed ? ResolvedChannel(channel: .beta) : nil
+    }
+}
