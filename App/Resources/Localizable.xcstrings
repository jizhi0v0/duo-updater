          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый запрос, который DuoUpdater делает сам: проверки обновлений, заметки о выпуске и загрузки, которые он для вас устанавливает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
