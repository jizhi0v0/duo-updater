@@ -0,0 +1,33 @@
+import Foundation
+
+enum io_github_tobi_disktree {
+    static let set = AppRecipeSet(
+        family: "io-github-tobi-disktree",
+        githubRules: [
+        // Shared rationale for digest-only: Recipes/org-alacritty.swift.
+
+        // disktree (tobi) — Rust + GPUI disk-usage treemap. No Sparkle (no
+        // `SUFeedURL`, no Frameworks/ in the bundle) and no self-updater (no
+        // update-check strings in the binary), so the GitHub rule is the only
+        // detection. Tags are `v<X.Y.Z>` and equal `CFBundleShortVersionString`
+        // (release.yml refuses a tag that does not match Cargo.toml).
+        //
+        // Ad-hoc signed, no Team ID (`spctl` rejects it), so the Team-ID gate
+        // can't apply. It takes `.publishedDigestOnly`: on 0.10.0, 0.10.1 and
+        // 0.11.0 the seal verifies (`codesign --verify --deep --strict` 0), the
+        // signed identifier is io.github.tobi.disktree, the short version is
+        // the tag's, and GitHub publishes a sha256 for every macOS asset
+        // (matches the downloads).
+        //
+        // Apple silicon only: the arm64 zip is the one offered. The x86_64 zip
+        // is not matched (DuoUpdater runs on Apple silicon only). The
+        // `.sha256` sidecars are not zips, so the trailing `$` leaves them out.
+        GitHubReleaseRule(
+            bundleID: "io.github.tobi.disktree",
+            owner: "tobi", repo: "disktree",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^disktree-[0-9.]+-aarch64-macos\.zip$"#,
+            installerKind: .zip,
+            installTrust: .publishedDigestOnly),
+        ])
+}
