+curl -fsSLO https://github.com/crmne/spotifast/releases/download/v0.12.0/spotifast-v0.12.0-macos-universal.dmg
+shasum -a 256 spotifast-v0.12.0-macos-universal.dmg              # 805704658ce48c7109b6914d1dd1a503fbd4c354f983096559dd45b8654daab6
