    "%@ wasn’t relaunched: an update to it is being installed right now. Try again once that finishes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nicht neu gestartet: Gerade wird ein Update dafür installiert. Versuche es erneut, sobald das abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se reinició: ahora mismo se está instalando una actualización. Vuelve a intentarlo cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas été relancé : une mise à jour est en cours d’installation. Réessayez une fois celle-ci terminée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è stata riaperta: è in corso l’installazione di un suo aggiornamento. Riprova al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は再起動されませんでした。現在アップデートをインストール中です。完了してからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não foi reaberto: uma atualização dele está sendo instalada agora. Tente de novo quando terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не перезапущено: сейчас устанавливается его обновление. Повторите попытку, когда установка завершится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yeniden başlatılmadı: şu anda bir güncellemesi yükleniyor. Bu bitince yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有重新启动：正在为它安装更新。安装完成后再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未重新開啟：它的更新正在安裝中。完成後再試一次。"
          }
        }
      }
    },
    "%@ wasn’t relaunched: it is being rolled back right now. Try again once that finishes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nicht neu gestartet: Gerade wird die vorherige Version wiederhergestellt. Versuche es erneut, sobald das abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se reinició: ahora mismo se está restaurando la versión anterior. Vuelve a intentarlo cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas été relancé : le retour à la version précédente est en cours. Réessayez une fois celui-ci terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è stata riaperta: è in corso il ripristino. Riprova al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は再起動されませんでした。現在以前のバージョンにロールバック中です。完了してからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não foi reaberto: ele está sendo revertido agora. Tente de novo quando terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не перезапущено: сейчас выполняется откат к предыдущей версии. Повторите попытку, когда откат завершится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yeniden başlatılmadı: şu anda geri alınıyor. Bu bitince yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有重新启动：正在将它回滚到之前的版本。回滚完成后再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未重新開啟：它正在還原中。完成後再試一次。"
          }
        }
      }
    },
    "%@ wasn’t reopened after it quit: an update or rollback of it was still in progress. Open it yourself when you’re ready.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nach dem Beenden nicht wieder geöffnet: Ein Update oder eine Wiederherstellung der App lief noch. Öffne sie selbst, wenn du so weit bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se volvió a abrir después de cerrarse: todavía había una actualización o una restauración de la versión anterior en curso. Ábrela tú cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas été rouvert après avoir quitté : une mise à jour ou un retour à la version précédente était encore en cours. Ouvrez-le vous-même quand vous le souhaitez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è stata riaperta dopo la chiusura: era ancora in corso un aggiornamento o un ripristino. Aprila tu quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は終了後に再度開かれませんでした。アップデートまたはロールバックがまだ進行中でした。準備ができたらご自身で開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não foi reaberto depois de encerrar: uma atualização ou reversão dele ainda estava em andamento. Abra-o você mesmo quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не было открыто снова после выхода: обновление или откат ещё выполнялись. Откройте его сами, когда будете готовы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kapandıktan sonra yeniden açılmadı: bir güncellemesi veya geri alınması hâlâ sürüyordu. Hazır olduğunuzda kendiniz açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 退出后没有重新打开：它的更新或回滚仍在进行中。准备好后请自行打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 結束後未重新打開：它的更新或還原仍在進行中。準備好後請自行打開。"
          }
        }
      }
    },
