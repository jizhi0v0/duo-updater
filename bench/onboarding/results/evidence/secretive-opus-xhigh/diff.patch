+// MARK: - Secretive nightly: the word follows an underscore in CFBundleShortVersionString
+
+/// Secretive's nightly ships the stable bundle id, `CFBundleName` and filename;
+/// the version is the only signal. Values read off real bundles 2026-10-13: the
+/// nightly Actions artifact reports `0.0.0_nightly-2026-10-13`, the v4.0.0
+/// release `4.0.0`. The underscore is why step 4's dash-tail shape misses it,
+/// asserted below by the `com.example.other` row.
+@Test func secretiveNightlyVersionSignalsNightly() {
+    func detect(_ bundleID: String, _ version: String) -> ReleaseChannel {
+        ReleaseChannel.detect(
+            name: "Secretive", bundleID: bundleID, keystoneChannel: nil, version: version)
+    }
+    #expect(detect("com.maxgoedjen.Secretive.Host", "0.0.0_nightly-2026-10-13") == .nightly)
+    #expect(detect("com.maxgoedjen.Secretive.Host", "4.0.0") == .stable)
+    // Scoped to this bundle id: the same string on any other app falls through
+    // to the ordinary signals, none of which reads it.
+    #expect(detect("com.example.other", "0.0.0_nightly-2026-10-13") == .stable)
+}
+
+/// Why the rule above is worth having: the stable rule carries a one-click
+/// install spec, the nightly is signed by the same Team ID, and `0.0.0` sorts
+/// below every release — so a nightly read as `.stable` is offered, and
+/// installable, the newest release. Drives the REAL registry entry.
+@Test func secretiveStableRuleDoesNotReachTheNightly() async throws {
+    let bundleID = "com.maxgoedjen.Secretive.Host"
+    let rule = try #require(GitHubReleaseRegistry.rules.first { $0.bundleID == bundleID })
+    #expect(rule.channel == .stable)
+    #expect(rule.installAssetPattern != nil,
+            "stable rule lost its install spec — the hazard this guards has changed")
+
+    let source = GitHubReleasesSource(rules: [rule])
+    let version = "0.0.0_nightly-2026-10-13"
+    let nightly = InstalledApp(
+        name: "Secretive", bundleID: bundleID,
+        shortVersion: version, buildVersion: "1.38367930469",
+        path: URL(fileURLWithPath: "/Applications/Secretive.app"),
+        isMASApp: false, sparkleFeedURL: nil,
+        releaseChannel: ReleaseChannel.detect(
+            name: "Secretive", bundleID: bundleID, keystoneChannel: nil, version: version))
+
+    #expect(nightly.releaseChannel == .nightly)
+    // Skipped before any fetch — a network call here would be a bug on its own.
+    #expect(try await source.latestVersion(for: nightly) == nil)
+}
+
