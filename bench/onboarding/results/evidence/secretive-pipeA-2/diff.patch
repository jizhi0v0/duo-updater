+// MARK: - Secretive nightly / one-off: the channel word sits behind an underscore
+
+/// Secretive's CI stamps `CFBundleShortVersionString` with `0.0.0_nightly-<date>`
+/// (`nightly.yml`) or `0.0.0_oneoff-<date>` (`oneoff.yml`) on top of the stable
+/// bundle id, Team and app name. The underscore keeps both out of step 4's
+/// dash-tail pattern, so the assertions below also pin that the dash-tail rule is
+/// NOT what carries them, and that a release version stays stable.
+@Test func secretiveNightlyAndOneOffVersionsAreNotStable() {
+    let id = "com.maxgoedjen.Secretive.Host"
+    #expect(ReleaseChannel.detect(
+        name: "Secretive", bundleID: id,
+        keystoneChannel: nil, version: "0.0.0_nightly-2026-10-14") == .nightly)
+    #expect(ReleaseChannel.detect(
+        name: "Secretive", bundleID: id,
+        keystoneChannel: nil, version: "0.0.0_oneoff-2026-10-14") == .dev)
+    #expect(ReleaseChannel.detect(
+        name: "Secretive", bundleID: id,
+        keystoneChannel: nil, version: "4.0.0") == .stable)
+    #expect(ReleaseChannel.detect(
+        name: "Secretive", bundleID: id,
+        keystoneChannel: nil, version: "3.0.4") == .stable)
+    // Scoped to this bundle id.
+    #expect(ReleaseChannel.detect(
+        name: "Some App", bundleID: "com.example.other",
+        keystoneChannel: nil, version: "0.0.0_nightly-2026-10-14") == .stable)
+}
+
+/// The reason the rule above is worth having: the stable GitHub rule carries a
+/// one-click install spec and the nightly shares its bundle id and Team. Drives
+/// the REAL registry entry, with the version the nightly workflow stamps.
+@Test func secretiveStableRecipeDoesNotReachTheNightly() async throws {
+    let id = "com.maxgoedjen.Secretive.Host"
+    let rule = try #require(GitHubReleaseRegistry.rules.first { $0.bundleID == id })
+    #expect(rule.channel == .stable)
+    // If this stops being true the cross-channel risk goes away with it, and
+    // this test should be re-read rather than deleted.
+    #expect(rule.installAssetPattern != nil,
+            "stable rule lost its install spec — the hazard this guards has changed")
+
+    let source = GitHubReleasesSource(rules: [rule])
+    for version in ["0.0.0_nightly-2026-10-14", "0.0.0_oneoff-2026-10-14"] {
+        let app = InstalledApp(
+            name: "Secretive", bundleID: id,
+            shortVersion: version, buildVersion: "1.38533092908",
+            path: URL(fileURLWithPath: "/Applications/Secretive.app"),
+            isMASApp: false, sparkleFeedURL: nil,
+            releaseChannel: ReleaseChannel.detect(
+                name: "Secretive", bundleID: id, keystoneChannel: nil, version: version))
+        #expect(app.releaseChannel != .stable)
+        // Skipped before any fetch — a network call here would be a bug on its own.
+        #expect(try await source.latestVersion(for: app) == nil)
+    }
+}
