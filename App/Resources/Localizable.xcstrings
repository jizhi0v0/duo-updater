    "On the %@ channel — its version can lead or differ from the stable release.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im %@-Kanal – die Version kann der stabilen Version voraus sein oder von ihr abweichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el canal %@; su versión puede ir por delante de la versión estable o ser distinta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le canal %@ — sa version peut être en avance sur la version stable ou en différer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul canale %@: la sua versione può essere più avanti o diversa dalla release stabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ チャンネルです — バージョンは安定版より進んでいたり異なったりすることがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No canal %@ — a versão pode estar à frente ou diferir da versão estável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На канале %@ — версия может опережать стабильный релиз или отличаться от него."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kanalında — sürümü kararlı sürümün önünde olabilir veya ondan farklı olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处于 %@ 渠道 — 其版本可能领先或不同于稳定版。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 通道——其版本可能領先或不同於正式版。"
          }
        }
      }
    },
