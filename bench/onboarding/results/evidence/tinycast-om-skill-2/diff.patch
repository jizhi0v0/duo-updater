diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift
new file mode 100644
index 0000000..0aed64b
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift
@@ -0,0 +1,213 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// Tinycast (`abue-ammar/tinycast`) ships stable and beta as two apps —
+/// `com.tinycast.app` and `com.tinycast.app.beta` — from one Releases list that
+/// also carries `-sequoia` side builds and a retired `-alpha.N` train. These
+/// tests pin which tags each rule takes, that both stay detection-only, and what
+/// the changelog recipes make of the real release bodies.
+///
+/// See `docs/app-audits/com-tinycast-app.md` for the measurements.
+@Suite struct TinycastGitHubRuleTests {
+
+    /// EVERY rule either bundle id carries, not the first one, so a third rule
+    /// added later cannot slip an install spec past `staysDetectionOnly`.
+    /// Non-empty is required: a lookup that stops finding anything has to fail
+    /// rather than leave the suite green over a rule nobody runs.
+    private static var rules: [GitHubReleaseRule] {
+        get throws {
+            let found = GitHubReleaseRegistry.rules.filter {
+                $0.bundleID == "com.tinycast.app" || $0.bundleID == "com.tinycast.app.beta"
+            }
+            try #require(found.count >= 2, "Tinycast's stable and beta rules are no longer both registered")
+            return found
+        }
+    }
+
+    private static func rule(_ bundleID: String, _ channel: ReleaseChannel) throws -> GitHubReleaseRule {
+        try #require(
+            try rules.first { $0.bundleID == bundleID && $0.channel == channel },
+            "no Tinycast rule for \(bundleID) [\(channel.rawValue)]")
+    }
+
+    private static var stable: GitHubReleaseRule { get throws { try rule("com.tinycast.app", .stable) } }
+    private static var beta: GitHubReleaseRule { get throws { try rule("com.tinycast.app.beta", .beta) } }
+
+    /// Every build is signed with the vendor's self-signed "Tinycast
+    /// Self-Signed" identity and is not notarized (`TeamIdentifier=not set` on
+    /// the 0.11.19 thin and universal zips, 0.11.12, and 0.11.21-beta.120).
+    /// `SignatureVerifier` gate 3 throws `noTeamIdentifier` for such a bundle,
+    /// so an install spec here could only produce an Update button that fails.
+    @Test func staysDetectionOnly() throws {
+        for rule in try Self.rules {
+            #expect(rule.installAssetPattern == nil,
+                    "\(rule.bundleID) (\(rule.channel)): Tinycast is self-signed with no Team ID — an install pattern can only fail gate 3")
+            #expect(rule.installerKind == nil, "\(rule.bundleID) (\(rule.channel)): see above")
+        }
+    }
+
+    /// Every non-prerelease tag the repo had published as of 2026-10-14, plus
+    /// the next major and a two-part tag. `extractVersion` is the call
+    /// `GitHubReleasesSource` makes on every release it walks.
+    @Test(arguments: [
+        "v0.11.19", "v0.11.12", "v0.11.3", "v0.10.23", "v0.10.20", "v0.10.15", "v0.10.5",
+        "v0.10.2", "v0.10.1", "v0.10.0", "v0.9.8", "v0.9.7", "v0.9.5", "v0.9.4", "v0.9.3",
+        "v0.9.1", "v0.9.0", "v0.7.5", "v0.7.4", "v0.7.3", "v1.0.0", "v1.0",
+    ])
+    func stableTagsResolveToTheirVersion(tag: String) throws {
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: try Self.stable.versionPattern)
+                == String(tag.dropFirst()))
+    }
+
+    /// The beta app's `CFBundleShortVersionString` is the tag minus its `v`,
+    /// suffix included (`0.11.21-beta.120` in the real bundle), so the rule must
+    /// capture the suffix or every beta would compare against a shorter string.
+    @Test(arguments: ["v0.11.21-beta.120", "v0.11.20-beta.119", "v0.6.0-beta.23", "v1.0.0-beta.200"])
+    func betaTagsResolveToTheWholeVersion(tag: String) throws {
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: try Self.beta.versionPattern)
+                == String(tag.dropFirst()))
+    }
+
+    /// The anchors at work. `-sequoia` builds are flagged prerelease and live
+    /// under the STABLE bundle id; the unanchored default pattern reads
+    /// `v0.9.7-sequoia` as `0.9.7`. The `rc` tag is one the vendor has never
+    /// cut: if it ever appears unflagged, neither rule may read it as a release.
+    @Test(arguments: [
+        "v0.9.7-sequoia", "v0.5.7-alpha.22", "v0.11.21-beta.120", "v0.12.0-rc.1",
+    ])
+    func stableRejectsEveryOtherTrain(tag: String) throws {
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: try Self.stable.versionPattern) == nil)
+    }
+
+    @Test(arguments: ["v0.9.7-sequoia", "v0.5.7-alpha.22", "v0.11.19", "v0.12.0-rc.1", "v0.11.21-beta.120-1"])
+    func betaRejectsEveryOtherTrain(tag: String) throws {
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: try Self.beta.versionPattern) == nil)
+    }
+
+    /// The failure the stable anchors exist for, spelled out against the
+    /// registry default pattern.
+    @Test func theDefaultPatternWouldReadASequoiaBuildAsStable() {
+        #expect(VendorProbeRecipe.extractVersion(
+            from: "v0.9.7-sequoia", pattern: #"v?([0-9]+(?:\.[0-9]+)+)"#) == "0.9.7")
+    }
+
+    /// Each real bundle lands on the channel its rule serves. The `.beta` bundle
+    /// id suffix decides the beta copy; the stable copy carries no signal at all.
+    /// A `-sequoia` copy (same bundle id as stable, `0.9.7-sequoia`) reads as
+    /// stable too — the audit's known gap, pinned so a change to it is a decision.
+    @Test func realBundlesDetectOntoTheirRulesChannel() {
+        #expect(ReleaseChannel.detect(
+            name: "Tinycast Beta", bundleID: "com.tinycast.app.beta",
+            keystoneChannel: nil, version: "0.11.21-beta.120") == .beta)
+        #expect(ReleaseChannel.detect(
+            name: "Tinycast", bundleID: "com.tinycast.app",
+            keystoneChannel: nil, version: "0.11.19") == .stable)
+        #expect(ReleaseChannel.detect(
+            name: "Tinycast", bundleID: "com.tinycast.app",
+            keystoneChannel: nil, version: "0.9.7-sequoia") == .stable)
+        // The retired alpha app reads as `.alpha`, which no rule serves.
+        #expect(ReleaseChannel.detect(
+            name: "Tinycast Alpha", bundleID: "com.tinycast.app.alpha",
+            keystoneChannel: nil, version: "0.5.7-alpha.22") == .alpha)
+    }
+
+    /// The beta suffix is the workflow run number and only grows, and the
+    /// comparator has to order it numerically across a base bump.
+    @Test func betaVersionsOrderTheWayTheVendorCutsThem() {
+        #expect(VersionComparator.isNewer("0.11.21-beta.120", than: "0.11.20-beta.119"))
+        #expect(VersionComparator.isNewer("0.11.21-beta.121", than: "0.11.21-beta.120"))
+        #expect(VersionComparator.isNewer("0.12.0-beta.100", than: "0.11.21-beta.99"))
+        #expect(!VersionComparator.isNewer("0.11.21-beta.120", than: "0.11.21-beta.120"))
+    }
+}
+
+/// Five real releases from the live list fetched 2026-10-14, bodies cut to
+/// their first bullet. Tags, `prerelease`, `draft` and `published_at` are
+/// verbatim. The sequoia and alpha rows are prerelease-flagged and carry a body,
+/// so the prerelease filter alone would put them on the beta rail.
+private let tinycastReleasesFixture = """
+[
+  {"tag_name": "v0.11.21-beta.120", "prerelease": true, "draft": false,
+   "published_at": "2026-10-13T22:08:37Z",
+   "body": "## What's Changed\\n* Let the version on the About page be selected and copied by @abue-ammar in #1544\\n"},
+  {"tag_name": "v0.11.20-beta.119", "prerelease": true, "draft": false,
+   "published_at": "2026-10-12T22:17:58Z",
+   "body": "## What's Changed\\n* Rework quicklink selected text and add a ⌘C selection fallback by @abue-ammar in #1507\\n"},
+  {"tag_name": "v0.11.19", "prerelease": false, "draft": false,
+   "published_at": "2026-10-10T15:14:51Z",
+   "body": "## What's Changed\\n* Add local Dictation and expand keyboard shortcut capabilities by @Risengan in #1280\\n"},
+  {"tag_name": "v0.9.7-sequoia", "prerelease": true, "draft": false,
+   "published_at": "2026-08-19T20:12:44Z",
+   "body": "## What's Changed\\n* Sequoia build\\n"},
+  {"tag_name": "v0.5.7-alpha.22", "prerelease": true, "draft": false,
+   "published_at": "2026-07-17T21:16:40Z",
+   "body": "## What's Changed\\n* Alpha build\\n"}
+]
+"""
+
+/// Verbatim `v0.11.18-beta.116` body, fetched 2026-10-14: the shape with no
+/// "New Contributors" heading, so the install block (Homebrew and xattr
+/// instructions, two fenced blocks) sits directly under "What's Changed".
+private let beta116Body = #"""
+## What's Changed
+* Fix Quicklink hotkey input focus by @abue-ammar in #1470
+* Restore launcher search focus after closing menus by @abue-ammar in #1473
+* Support createRequire in the extension runtime by @AlexanderWillner in #1471
+* Add Copy Link action and shortcut for quicklinks by @abue-ammar in #1472
+* Fix palette menu clicks and cropping; prefer synchronous code by @abue-ammar in #1475
+* Fix Docker extension HTTP over Unix sockets by @abue-ammar in #1474
+* Fix extension text paste landing in palette search by @abue-ammar in #1476
+* Synchronize asynchronous Swift test fixtures by @quanru in #1457
+* Remove Traditional Chinese emoji keywords by @abue-ammar in #1479
+* Use sparkles for the Quick AI header icon by @abue-ammar in #1480
+
+<!-- tinycast:install -->
+
+**Channel:** beta · **Version:** 0.11.18-beta.116 · **Bundle ID:** `com.tinycast.app.beta`
+Built from 14a5a8696f425d1ba8405561e370a68a7d93ffa8. [Full changelog](https://github.com/abue-ammar/tinycast/compare/v0.11.17-beta.115...v0.11.18-beta.116)
+
+**Recommended:** install via Homebrew — it clears the quarantine flag automatically on every install and update, so there's nothing to run by hand:
+```sh
+brew trust --tap abue-ammar/tinycast
+brew install --cask abue-ammar/tinycast/tinycast@beta
+```
+This build is self-signed. If you download the DMG directly instead of using Homebrew, macOS will refuse to open it until you clear the quarantine flag once:
+```sh
+xattr -dr com.apple.quarantine "/Applications/Tinycast Beta.app"
+```
+"""#
+
+@Suite struct TinycastChangelogRecipeTests {
+
+    private static func recipe(_ bundleID: String, _ channel: ReleaseChannel) throws -> ChangelogRecipe {
+        try #require(
+            ChangelogRecipeRegistry.recipes.first { $0.bundleID == bundleID && $0.channel == channel },
+            "no Tinycast changelog recipe for \(bundleID) [\(channel.rawValue)]")
+    }
+
+    @Test func stableRailTakesOnlyPlainTags() throws {
+        let recipe = try Self.recipe("com.tinycast.app", .stable)
+        let changelog = try #require(ChangelogService.parse(recipe, body: tinycastReleasesFixture))
+        #expect(changelog.entries.map(\.version) == ["0.11.19"])
+    }
+
+    /// Without `tagPattern` the prerelease flag would hand the sequoia and alpha
+    /// rows to the beta app's panel.
+    @Test func betaRailTakesOnlyNumberedBetas() throws {
+        let recipe = try Self.recipe("com.tinycast.app.beta", .beta)
+        let changelog = try #require(ChangelogService.parse(recipe, body: tinycastReleasesFixture))
+        #expect(changelog.entries.map(\.version) == ["0.11.21-beta.120", "0.11.20-beta.119"])
+    }
+
+    /// The real body's ten bullets come through, and nothing from the install
+    /// block below the `tinycast:install` marker does.
+    @Test func theRealBodyYieldsItsBulletsAndNoInstallText() throws {
+        let changelog = try #require(
+            GitHubMarkdownParser.parse(body: beta116Body, version: "0.11.18-beta.116", date: nil))
+        let items = try #require(changelog.entries.first).items
+        #expect(items.count == 10)
+        #expect(items.first?.hasPrefix("Fix Quicklink hotkey input focus") == true)
+        #expect(!items.contains { $0.contains("brew") || $0.contains("xattr") || $0.contains("Channel") })
+    }
+}
