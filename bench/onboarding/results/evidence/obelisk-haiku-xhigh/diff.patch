+import Foundation
+
+enum com_obelisk_app {
+    static let set = AppRecipeSet(
+        family: "com-obelisk-app",
+        changelogs: [
+        // Obelisk — GitHub releases, because the appcast holds ONE item and its
+        // notes are Markdown in a plain `<description>` with no
+        // `sparkle:format="markdown"` attribute. `SparkleAppcastSource` takes that
+        // as HTML, so the pane shows the raw Markdown with no structure.
+        //
+        // `releases/latest/download/appcast-arm64.xml` is the address the bundle
+        // declares in `SUFeedURL`, so `SparkleAppcastSource` already answers for
+        // detection and no `GitHubReleaseRule` is needed. The release body on
+        // api.github.com is the same Markdown, parsed release by release, with
+        // the `## Highlights` heading and the `###` sections kept as headings.
+        //
+        // Stable only: every release is `prerelease: false`, so no channel is
+        // registered and the decoder reads the stable side.
+        ChangelogRecipe(
+            bundleID: "com.obelisk.app",
+            source: URL(
+                string: "https://api.github.com/repos/tommy0103/obelisk/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases),
+        ])
+}
