@@ -0,0 +1,26 @@
+import Foundation
+
+enum com_lokii_app {
+    static let set = AppRecipeSet(
+        family: "com-lokii-app",
+        githubRules: [
+        // Shared rationale for digest-only: Recipes/org-alacritty.swift.
+
+        // Lokii — native file search (Rust core, AppKit shell), huangy7/lokii.
+        // No Sparkle: the app's own `AppUpdater` asks `/releases/latest` and only
+        // opens the dmg's download page. Tags are `v0.1.2`, equal to
+        // CFBundleShortVersionString. Ad-hoc signed, no Team ID, not notarized
+        // (v0.1.0, v0.1.1 and v0.1.2 alike); the seal verifies and the signed identifier
+        // is the bundle id. One dmg per architecture, `Lokii-arm64.dmg` and
+        // `Lokii-x86_64.dmg`, each single-arch. The release workflow signs with a
+        // Developer ID when its secrets are set; the day a release does, installs
+        // of an ad-hoc copy are refused and the user updates by hand once.
+        GitHubReleaseRule(
+            bundleID: "com.lokii.app",
+            owner: "huangy7", repo: "lokii",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^Lokii-(arm64|x86_64)\.dmg$"#,
+            installerKind: .dmg,
+            installTrust: .publishedDigestOnly),
+        ])
+}
