+    // MARK: - Cindy (hotfix.cindy.app/cindy/notice/<platform>/<version>.json)
+
+    /// The app's update-notice dialog shows one locale's `intro`, then each topic
+    /// as its emoji and title over its `text` (`renderer/release-notes/index.ts`);
+    /// this keeps that order, a topic's emoji and title as its heading.
+    ///
+    /// The locale comes from `contentByLocale` (`zh-CN`, `en`, `ja`, `ko` since
+    /// 0.1.38), picked for the reader the way Sparkle notes are
+    /// (`Bundle.preferredLocalizations`). A reader matching none gets `en`, then
+    /// `zh-CN`, as in the app's `selectLocalizedContent`; a file with no usable
+    /// locale falls back to the root `intro`/`topics`, as there too. One measured
+    /// difference: a `zh-Hant` reader gets `en` here (macOS 27.2), where the app
+    /// shows `zh-CN`. A topic counts only with a non-blank title and text, the
+    /// app's `isRenderableTopic`. The legacy `sections` shape (0.1.6 and 0.1.17;
+    /// `topics` by 0.1.30) is not read: no copy is offered a version that old.
+    private struct CindyNotice: Decodable {
+        struct Topic: Decodable {
+            let emoji: String?
+            let title: String?
+            let text: String?
+        }
+        struct Content: Decodable {
+            let intro: String?
+            let topics: [Topic]?
+        }
+        let version: String?
+        let date: String?
+        let intro: String?
+        let topics: [Topic]?
+        let contentByLocale: [String: Content]?
+    }
+
+    static func decodeCindyUpdateNotice(
+        _ body: String, preferredLanguages: [String] = Locale.preferredLanguages
+    ) -> Changelog? {
+        guard let data = body.data(using: .utf8),
+              let file = try? JSONDecoder().decode(CindyNotice.self, from: data),
+              let version = file.version,
+              version.range(of: #"^[0-9]+(?:\.[0-9]+)+$"#, options: .regularExpression) != nil
+        else { return nil }
+
+        func trimmed(_ raw: String?) -> String {
+            (raw ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+        }
+        func topics(_ raw: [CindyNotice.Topic]?) -> [(heading: String, text: String)] {
+            (raw ?? []).compactMap { topic in
+                let title = trimmed(topic.title), text = trimmed(topic.text)
+                guard !title.isEmpty, !text.isEmpty else { return nil }
+                let emoji = trimmed(topic.emoji)
+                return (emoji.isEmpty ? title : "\(emoji) \(title)", text)
+            }
+        }
+        let usable = (file.contentByLocale ?? [:]).filter { !topics($0.value.topics).isEmpty }
+        let ordered = ["en", "zh-CN"].filter { usable[$0] != nil }
+            + usable.keys.filter { $0 != "en" && $0 != "zh-CN" }.sorted()
+        let chosen = Bundle.preferredLocalizations(from: ordered, forPreferences: preferredLanguages)
+            .first.flatMap { usable[$0] }
+        let intro = trimmed(chosen.map(\.intro) ?? file.intro)
+        let notes = topics(chosen.map(\.topics) ?? file.topics)
+        guard !notes.isEmpty else { return nil }
+
+        var items: [String] = []
+        var content: [Changelog.Entry.Block] = []
+        if !intro.isEmpty {
+            items.append(intro)
+            content.append(.note(intro))
+        }
+        for note in notes {
+            items.append(note.text)
+            content.append(.heading(note.heading))
+            content.append(.note(note.text))
+        }
+        return Changelog(entries: [.init(
+            version: version, date: isoDay(file.date), items: items, content: content)])
+    }
+
