+import Foundation
+
+enum com_maxgoedjen_Secretive_Host {
+    static let set = AppRecipeSet(
+        family: "com-maxgoedjen-Secretive-Host",
+        githubRules: [
+        // Secretive — SSH agent keeping keys in the Secure Enclave. No SUFeedURL
+        // in any release v0.1.1–v4.0.0; its own updater GETs this repo's
+        // /releases (no device id, so no staged rollout to be ahead of) and only
+        // opens the release page. v-tags, short == tag; CFBundleVersion is
+        // `1.<run id>`, not comparable. One asset per release, `Secretive.zip`
+        // with `Secretive.app` at the root, universal, Team Z72PRUAWF6,
+        // notarized (not stapled). Nightly/one-off CI builds share this id as
+        // `0.0.0[_…]` and read `.nightly` (ReleaseChannel step 0.10), so this
+        // stable rule skips them. Detection-only: no `installAssetPattern` until
+        // the in-place swap is checked with the resident SecretAgent login item
+        // (LSUIElement, so the Restart flow never relaunches it) and GitHub rules
+        // can read the per-release OS floor (4.0.0 needs macOS 15) — see the audit.
+        GitHubReleaseRule(
+            bundleID: "com.maxgoedjen.Secretive.Host",
+            owner: "maxgoedjen", repo: "secretive",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+        ])
+}
