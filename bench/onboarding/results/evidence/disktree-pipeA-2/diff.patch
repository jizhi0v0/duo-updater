@@ -0,0 +1,41 @@
+import Foundation
+
+enum io_github_tobi_disktree {
+    static let set = AppRecipeSet(
+        family: "io-github-tobi-disktree",
+        githubRules: [
+        // Shared rationale for digest-only: Recipes/org-alacritty.swift.
+
+        // disktree (tobi) — a Rust/gpui disk-usage tree. No Sparkle and no updater
+        // of its own. v-tags; `CFBundleShortVersionString` and `CFBundleVersion`
+        // are both the tag's X.Y.Z (checked 2026-10-14 on 0.10.1 and 0.11.0).
+        //
+        // Ad-hoc signed, no Team ID, not notarized (`spctl` rejects it), so the
+        // Team-ID gate can't apply. It takes `.publishedDigestOnly`: on both
+        // arches of 0.10.1 and 0.11.0 the seal verifies (`codesign --verify
+        // --deep --strict` 0), the signed identifier is io.github.tobi.disktree,
+        // the short version is the tag's, and GitHub publishes a sha256 for every
+        // asset (matches the downloads).
+        //
+        // One zip per arch, `disktree-<v>-aarch64-macos.zip` and
+        // `disktree-<v>-x86_64-macos.zip`; the arch is left to the source's arch
+        // preference. The same release carries Linux and Windows archives and
+        // their `.sha256` files, which the pattern does not match. macOS zips
+        // start at 0.10.0 (0.9.x are Linux tarballs). The zip holds only
+        // `disktree.app`: no nested apps. The vendor's `make install` also
+        // builds an ad-hoc copy in the user's Applications folder with a `disktree`
+        // symlink (in `BINDIR`) into the bundle; the symlink follows an in-place swap, so
+        // there is no command-line tool to track separately.
+        //
+        // The vendor's release workflow signs and notarizes when its Developer
+        // ID secrets are set. The first such release carries a Team ID, the
+        // digest-only identity check refuses it, and ad-hoc installs update by
+        // hand once. Then move this rule to the default `installTrust`.
+        GitHubReleaseRule(
+            bundleID: "io.github.tobi.disktree",
+            owner: "tobi", repo: "disktree",
+            installAssetPattern: #"^disktree-[0-9.]+-(?:aarch64|x86_64)-macos\.zip$"#,
+            installerKind: .zip,
+            installTrust: .publishedDigestOnly),
+        ])
+}
