+import Foundation
+
+enum com_trycua_driver {
+    static let set = AppRecipeSet(
+        family: "com-trycua-driver",
+        githubRules: [
+        // History: docs/app-audits/com-trycua-driver.md#历史与实测
+        //
+        // Cua Driver — `/Applications/CuaDriver.app`, a headless (`LSUIElement`)
+        // bundle around the `cua-driver` CLI, released from the `trycua/cua`
+        // monorepo. The bundle carries no `SUFeedURL` and no electron-builder
+        // config; the vendor's own updater re-runs its install script, which this
+        // rule replaces.
+        //
+        // `usePrereleases: true` on a STABLE rule, and that is not a channel
+        // claim: the vendor marks EVERY `cua-driver-rs-v*` release `prerelease`
+        // on purpose, only to stop the monorepo's repository-wide "Latest"
+        // pointer flipping between products — each release body says so under
+        // "Why GitHub says “Pre-release”", and its own updater treats a plain
+        // SemVer tag as stable. `/releases/latest` therefore names a different
+        // product (`cua-spaces-…`), and the list is the only way in.
+        //
+        // With GitHub's flag carrying no meaning here, the tag pattern is the
+        // ONLY channel gate, so it is anchored at both ends and admits a plain
+        // `x.y.z` and nothing else. That keeps out, from the same list:
+        // `nightly-cua-driver-rs-v<x.y.z>-nightly.<date>.<run>` (the nightly
+        // track — same bundle id, and its bundle is stamped with the bare
+        // `x.y.z`, so nothing on disk tells a nightly copy apart), a future
+        // `cua-driver-rs-v<x.y.z>-rc.N`, the retired Swift driver's
+        // `cua-driver-v*`, and every other product's tags.
+        //
+        // `listPageSize` is the tag depth, not a guess: other products' releases
+        // can push the newest driver tag well down the list (the measured worst
+        // gap and the floor it implies are in `GitHubListPageSizeTests`).
+        // `probesNewestFirst: false` for the reason Bitwarden's says — the
+        // newest release of this repo is usually another product's, so the
+        // one-row probe would mostly just add a request.
+        //
+        // One-click: every macOS tarball (`darwin-arm64`, `-x86_64`,
+        // `-universal`) holds the SAME universal, notarized `CuaDriver.app`
+        // (Developer ID, Team YCK386LBJ7) one directory down, next to loose CLI
+        // files — `ArchiveExtractor` looks one level deep, and the installed CLI
+        // is a symlink into the bundle, so swapping the bundle updates both. The
+        // pattern takes the arm64-named one and excludes
+        // `-darwin-universal-binary.tar.gz`, which has no app in it at all.
+        //
+        // No `ChangelogRecipe`: `.gitHubReleases` keeps only releases whose
+        // `prerelease` flag matches the rule's channel, so for a stable recipe
+        // it would drop every one of these. The newest release's notes still
+        // arrive structured through `GitHubReleasesSource`'s inline parse.
+        // `CuaDriverGitHubRuleTests` pins all of this.
+        GitHubReleaseRule(
+            bundleID: "com.trycua.driver",
+            owner: "trycua", repo: "cua",
+            usePrereleases: true,
+            listPageSize: 30,
+            versionPattern: #"^cua-driver-rs-v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^cua-driver-rs-[0-9.]+-darwin-arm64\.tar\.gz$"#,
+            installerKind: .tarGz,
+            probesNewestFirst: false),
+        ])
+}
