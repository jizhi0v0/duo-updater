@@ -0,0 +1,45 @@
+import Foundation
+
+enum com_swiftvm_app {
+    static let set = AppRecipeSet(
+        family: "com-swiftvm-app",
+        changelogs: [
+        // SwiftVM (Team NYSXATY4AA) — GitHub releases of swiftvm-app/swiftvm.
+        //
+        // Detection is the bundle's own Sparkle feed (stable:
+        // `releases/latest/download/appcast.xml`; beta builds:
+        // `beta-channel/appcast-beta.xml`, see `SwiftVMChannel`). Neither feed
+        // carries notes, only `<sparkle:fullReleaseNotesLink>` to the release
+        // page, so without a recipe the pane has nothing. The release bodies are
+        // GitHub's generated notes run through the vendor's
+        // `scripts/clean-changelog.sh`: one `## What's Changed` over a flat list.
+        //
+        // One repo, one tag scheme: a release is `v1.3.0`, a beta
+        // `v1.4.0-beta.37`, and GitHub's `prerelease` bit is set on exactly the
+        // betas — plus `beta-channel`, the rolling release that only holds
+        // `appcast-beta.xml`. The beta recipe's `tagPattern` keeps that one out.
+        // With the `v` stripped each tag is the `CFBundleShortVersionString` its
+        // build reports, suffix included (checked on 1.2.0, 1.3.0, 1.4.0-beta.35
+        // and 1.4.0-beta.37, 2026-10-14).
+        //
+        // No `includesPromotedStable` on the beta recipe: a beta build's feed
+        // only ever lists betas, so a release entry would describe a build that
+        // copy is never offered.
+        ChangelogRecipe(
+            bundleID: "com.swiftvm.app",
+            source: URL(string: "https://api.github.com/repos/swiftvm-app/swiftvm/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .stable,
+            structuredFormat: .gitHubReleases),
+
+        ChangelogRecipe(
+            bundleID: "com.swiftvm.app",
+            source: URL(string: "https://api.github.com/repos/swiftvm-app/swiftvm/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .beta,
+            structuredFormat: .gitHubReleases,
+            tagPattern: #"^v([0-9]+(?:\.[0-9]+)+-beta\.[0-9]+)$"#),
+        ])
+}
