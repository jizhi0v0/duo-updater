        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa mentre una riga è selezionata, così l’elenco non si sposta sotto il cursore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行を選択している間は一時停止します。リストが手元でずれないようにするためです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado enquanto uma linha está selecionada, para a lista não se mexer sob você"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока строка выделена, обновление приостановлено, чтобы список не уезжал под курсором"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir satır seçiliyken duraklatılır, böylece liste siz bakarken kaymaz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中某一行时暂停刷新，免得列表在你眼皮底下移位"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取某一列時暫停重新整理，免得列表在你操作時移動"
          }
        }
      }
    },
