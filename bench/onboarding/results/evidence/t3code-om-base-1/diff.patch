@@ -0,0 +1,192 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// T3 Code (`pingdotgg/t3code`) — one bundle id, three tracks, and a stable app
+/// literally named "T3 Code (Alpha)". Every fixture below was read off the real
+/// artifacts on 2026-10-14: the release tags and asset names from the Releases
+/// API, and the bundle identity from the mounted v0.0.45 / v0.0.44 arm64 dmgs
+/// and the `Info.plist` inside the nightly and preview arm64 zips.
+@Suite struct T3CodeGitHubRuleTests {
+
+    static let bundleID = "com.t3tools.t3code"
+
+    /// What each track's real bundle reports. `CFBundleName` and
+    /// `CFBundleDisplayName` are identical on every one of them, and
+    /// `CFBundleVersion` equals `CFBundleShortVersionString`.
+    static let realBundles: [(channel: ReleaseChannel, name: String, version: String)] = [
+        (.stable, "T3 Code (Alpha)", "0.0.45"),
+        (.stable, "T3 Code (Alpha)", "0.0.44"),
+        (.nightly, "T3 Code (Nightly)", "0.0.46-nightly.20261014.3105"),
+        (.preview, "T3 Code (Alpha)", "0.0.46-preview.20261010.2909"),
+    ]
+
+    static var rules: [GitHubReleaseRule] {
+        GitHubReleaseRegistry.rules.filter { $0.bundleID == bundleID }
+    }
+
+    static func app(name: String, version: String) -> InstalledApp {
+        InstalledApp(
+            name: name, bundleID: bundleID,
+            shortVersion: version, buildVersion: version,
+            path: URL(fileURLWithPath: "/Applications/\(name).app"),
+            isMASApp: false, sparkleFeedURL: nil,
+            releaseChannel: ReleaseChannel.detect(
+                name: name, bundleID: bundleID, keystoneChannel: nil, version: version,
+                bundleFileName: name))
+    }
+
+    // MARK: - Channel detection
+
+    /// Each real bundle lands on its own track — above all the stable one, which
+    /// the generic display-name step would read as `.alpha`.
+    @Test(arguments: realBundles.map { [$0.channel.rawValue, $0.name, $0.version] })
+    func detectReadsTheTrackFromTheVersion(_ row: [String]) {
+        #expect(ReleaseChannel.detect(
+            name: row[1], bundleID: Self.bundleID, keystoneChannel: nil, version: row[2],
+            bundleFileName: row[1]).rawValue == row[0])
+    }
+
+    /// The trap the 0.9 rule exists for, and its scope: without the bundle id the
+    /// very same name reads as `.alpha`, and a version this rule does not know
+    /// falls through to that too rather than defaulting to stable.
+    @Test func theAlphaNameIsOnlyOverriddenByAStableShapedVersion() {
+        #expect(ReleaseChannel.detect(
+            name: "T3 Code (Alpha)", bundleID: "com.example.other",
+            keystoneChannel: nil, version: "0.0.45") == .alpha)
+        #expect(ReleaseChannel.detect(
+            name: "T3 Code (Alpha)", bundleID: Self.bundleID,
+            keystoneChannel: nil, version: "0.0.46-rc.1") == .alpha)
+    }
+
+    // MARK: - Registry, derived over every track
+
+    /// For every track a real bundle exists for: if the registry has a rule on
+    /// that channel the source must select it, and if it has none the source must
+    /// refuse before any fetch. Derived from the registry, so adding a nightly or
+    /// preview rule later moves that track from "refused" to "selected" here
+    /// without anyone editing a list.
+    @Test func everyTrackIsServedByItsOwnRuleOrRefused() async throws {
+        let ruled = Set(Self.rules.map(\.channel))
+        #expect(ruled.contains(.stable))
+        for bundle in Self.realBundles where !ruled.contains(bundle.channel) {
+            // A rule-less source would make this vacuous; use the real registry.
+            let source = GitHubReleasesSource(rules: Self.rules, session: .refusingAll)
+            let app = Self.app(name: bundle.name, version: bundle.version)
+            #expect(app.releaseChannel == bundle.channel)
+            #expect(try await source.latestVersion(for: app) == nil,
+                    "\(bundle.version) must not be offered another track's build")
+        }
+        for bundle in Self.realBundles where ruled.contains(bundle.channel) {
+            // The refusing session turns "a rule was selected" into a thrown
+            // fetch, which is how this tells selection from a channel-gate nil.
+            let source = GitHubReleasesSource(rules: Self.rules, session: .refusingAll)
+            let app = Self.app(name: bundle.name, version: bundle.version)
+            await #expect(throws: (any Error).self) {
+                _ = try await source.latestVersion(for: app)
+            }
+        }
+    }
+
+    // MARK: - Stable rule
+
+    static var stable: GitHubReleaseRule? { rules.first { $0.channel == .stable } }
+
+    /// Real tags from the repo's release list (2026-10-14). Only the bare stable
+    /// tag extracts; the nightly, preview and the Android-only tag do not.
+    @Test func stableRuleExtractsOnlyTheStableTag() throws {
+        let rule = try #require(Self.stable)
+        #expect(rule.slug == "pingdotgg/t3code")
+        #expect(rule.usePrereleases == false)
+        func extract(_ tag: String) -> String? {
+            VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+        }
+        #expect(extract("v0.0.45") == "0.0.45")
+        #expect(extract("v0.0.44") == "0.0.44")
+        #expect(extract("v0.0.46-nightly.20261014.3105") == nil)
+        #expect(extract("v0.0.46-preview.20261010.2909") == nil)
+        #expect(extract("android-nightly") == nil)
+        // Equal to both version keys the real v0.0.45 bundle reports.
+        #expect(VersionComparator.compare(extract("v0.0.45")!, "0.0.45") == .orderedSame)
+    }
+
+    /// The full v0.0.45 asset list: exactly the arm64 dmg is selected, never the
+    /// zip, x64 build, blockmap, CLI tarball or another platform's installer —
+    /// and none of a nightly's same-prefixed assets.
+    @Test func stableRulePicksTheArm64DmgAndNothingElse() throws {
+        let rule = try #require(Self.stable)
+        let pattern = try #require(rule.installAssetPattern)
+        #expect(rule.installerKind == .dmg)
+        let v045 = [
+            "builder-debug.yml", "latest-linux-arm64.yml", "latest-linux.yml", "latest-mac.yml",
+            "latest.yml", "SHA256SUMS", "t3-0.0.45-darwin-arm64.tar.gz",
+            "t3-0.0.45-linux-arm64.tar.gz", "t3-0.0.45-linux-x64.tar.gz",
+            "t3-0.0.45-win32-arm64.zip", "t3-0.0.45-win32-x64.zip", "T3-Code-0.0.45-amd64.deb",
+            "T3-Code-0.0.45-arm64.AppImage", "T3-Code-0.0.45-arm64.deb", "T3-Code-0.0.45-arm64.dmg",
+            "T3-Code-0.0.45-arm64.dmg.blockmap", "T3-Code-0.0.45-arm64.exe",
+            "T3-Code-0.0.45-arm64.exe.blockmap", "T3-Code-0.0.45-arm64.zip",
+            "T3-Code-0.0.45-arm64.zip.blockmap", "T3-Code-0.0.45-x64.dmg",
+            "T3-Code-0.0.45-x64.dmg.blockmap", "T3-Code-0.0.45-x64.exe",
+            "T3-Code-0.0.45-x64.exe.blockmap", "T3-Code-0.0.45-x64.zip",
+            "T3-Code-0.0.45-x64.zip.blockmap", "T3-Code-0.0.45-x86_64.AppImage",
+        ]
+        let nightly = [
+            "T3-Code-0.0.46-nightly.20261014.3105-arm64.dmg",
+            "T3-Code-0.0.46-nightly.20261014.3105-arm64.zip",
+            "T3-Code-0.0.46-preview.20261010.2909-arm64.dmg",
+        ]
+        func matches(_ name: String) -> Bool {
+            name.range(of: pattern, options: .regularExpression) != nil
+        }
+        #expect(v045.filter(matches) == ["T3-Code-0.0.45-arm64.dmg"])
+        #expect(nightly.filter(matches).isEmpty)
+    }
+
+    // MARK: - Changelog
+
+    /// Trimmed from the real v0.0.45 body: GitHub's generated "What's Changed"
+    /// list, the "New Contributors" roster and the compare link.
+    static let v045Body = """
+    ## What's Changed
+    * fix(shared): merge OpenCode Go limits by credential by @Yash-Singh1 in https://github.com/pingdotgg/t3code/pull/14209
+    * feat(codex): regenerate protocol bindings for Codex 0.159 by @juliusmarminge in https://github.com/pingdotgg/t3code/pull/14311
+    * feat: start threads without a project by @t3dotgg in https://github.com/pingdotgg/t3code/pull/13612
+
+    ## New Contributors
+    * @jakaskerjanc made their first contribution in https://github.com/pingdotgg/t3code/pull/8865
+
+    **Full Changelog**: https://github.com/pingdotgg/t3code/compare/v0.0.44...v0.0.45
+    """
+
+    /// The release body is the changelog `GitHubReleasesSource` attaches; it
+    /// parses to structured items with the PR attribution stripped and the
+    /// contributor roster dropped.
+    @Test func releaseBodyParsesToStructuredItems() throws {
+        let changelog = try #require(GitHubMarkdownParser.parse(
+            body: Self.v045Body, version: "0.0.45", date: "2026-10-02T18:17:31Z"))
+        #expect(changelog.entries.count == 1)
+        #expect(changelog.entries.first?.items == [
+            "fix(shared): merge OpenCode Go limits by credential",
+            "feat(codex): regenerate protocol bindings for Codex 0.159",
+            "feat: start threads without a project",
+        ])
+    }
+}
+
+private extension URLSession {
+    /// A session whose every request fails without touching the network.
+    static var refusingAll: URLSession {
+        let config = URLSessionConfiguration.ephemeral
+        config.protocolClasses = [RefusingURLProtocol.self]
+        return URLSession(configuration: config)
+    }
+}
+
+private final class RefusingURLProtocol: URLProtocol {
+    override class func canInit(with request: URLRequest) -> Bool { true }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+    override func startLoading() {
+        client?.urlProtocol(self, didFailWithError: URLError(.notConnectedToInternet))
+    }
+    override func stopLoading() {}
+}
