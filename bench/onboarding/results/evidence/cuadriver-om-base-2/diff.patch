+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// Cua Driver (`com.trycua.driver`, the `cua-driver-rs` train of the `trycua/cua`
+/// monorepo). Every release in that repo is flagged `prerelease`, stable ones
+/// included, so the tag pattern is the only channel gate this rule has. These
+/// tests pin it, the install asset and the inline changelog against the strings
+/// the vendor actually published.
+///
+/// See `docs/app-audits/com-trycua-driver.md` for the measurements.
+@Suite struct CuaDriverGitHubRuleTests {
+
+    /// Every rule this bundle id carries, not the first one. Non-empty is
+    /// required: a lookup that stops finding the rule must fail rather than
+    /// leave the suite green while it exercises nothing.
+    private static var rules: [GitHubReleaseRule] {
+        get throws {
+            let found = GitHubReleaseRegistry.rules.filter { $0.bundleID == "com.trycua.driver" }
+            try #require(!found.isEmpty, "com.trycua.driver is no longer in GitHubReleaseRegistry")
+            return found
+        }
+    }
+
+    private static var stableRule: GitHubReleaseRule {
+        get throws {
+            try #require(
+                self.rules.first { $0.channel == .stable },
+                "com.trycua.driver has no stable rule any more")
+        }
+    }
+
+    /// The vendor flags its stable releases `prerelease`, so a rule on
+    /// `/releases/latest` would never see one. Reading the list is required,
+    /// not an optimisation.
+    @Test func readsTheListBecauseEveryReleaseIsFlaggedPrerelease() throws {
+        #expect(try Self.stableRule.usePrereleases)
+    }
+
+    /// Real `cua-driver-rs-v` tags read as their version. The plist of the
+    /// mounted 0.35.4 and 0.35.2 apps carries exactly these strings in both
+    /// version fields.
+    @Test(arguments: [
+        ("cua-driver-rs-v0.35.4", "0.35.4"),
+        ("cua-driver-rs-v0.35.2", "0.35.2"),
+        ("cua-driver-rs-v0.1.3", "0.1.3"),
+    ])
+    func realTagsResolveToTheirVersion(tag: String, expected: String) throws {
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: try Self.stableRule.versionPattern)
+                == expected)
+    }
+
+    /// Other tags in the same Releases list, all real except the last: the
+    /// nightly train (same bundle id, stamped with a bare `0.30.5` plist
+    /// version, so nothing downstream could tell it apart), sibling products,
+    /// and the retired Swift `cua-driver-v` train. The last is
+    /// prerelease-shaped and has never been published. It stands for the
+    /// mutation the `$` anchor exists for: without it this would read as a
+    /// stable `0.36.0`, and the `prerelease` flag cannot catch it because the
+    /// vendor sets it on every release.
+    @Test(arguments: [
+        "nightly-cua-driver-rs-v0.30.5-nightly.20260929.36522098176",
+        "cua-spaces-v0.8.1-beta.3",
+        "nightly-lume-v0.6.2-nightly.20261014.38513423832",
+        "cua-driver-v0.2.0",
+        "cua-driver-rs-v0.36.0-rc.1",
+    ])
+    func otherTagsAreRejected(tag: String) throws {
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: try Self.stableRule.versionPattern)
+                == nil)
+    }
+
+    /// The 0.35.4 asset list, verbatim (fetched 2026-10-14). Exactly one asset
+    /// matches, and it is the tarball holding `CuaDriver.app`. Not the
+    /// `-binary` tarballs (no app inside), not a `.sigstore.json` sidecar, and
+    /// not the npm `.tgz` files 0.35.2 also carried.
+    @Test func theInstallPatternPicksTheAppTarball() throws {
+        let rule = try Self.stableRule
+        let pattern = try #require(rule.installAssetPattern)
+        #expect(rule.installerKind == .tarGz)
+        let matching = Self.v0354Assets.filter { $0.range(of: pattern, options: .regularExpression) != nil }
+        #expect(matching == ["cua-driver-rs-0.35.4-darwin-arm64.tar.gz"])
+        #expect("trycua-cua-driver-darwin-arm64-0.35.2.tgz".range(of: pattern, options: .regularExpression) == nil)
+
+        let assets = Self.v0354Assets.map {
+            (name: $0, url: URL(string: "https://example.invalid/\($0)")!, size: Int64?.none)
+        }
+        let picked = GitHubReleaseRule.installableAsset(
+            from: assets, matching: pattern, preferring: .arm64, allowingIntelTranslation: true)
+        #expect(picked?.url.lastPathComponent == "cua-driver-rs-0.35.4-darwin-arm64.tar.gz")
+    }
+
+    /// Why this family carries no `ChangelogRecipe`: the release body is the
+    /// changelog, and the inline parse in `GitHubReleasesSource` already turns
+    /// it into entries. The body also holds an install snippet, a "why
+    /// pre-release" note and a SHA256 block. None of that may leak into the
+    /// items. (A `.gitHubReleases` recipe could add history, but on a stable
+    /// rail it keeps only `prerelease == false`, and this repo has none of
+    /// those. See the audit.)
+    @Test func theRealReleaseBodyParsesToItsFixes() throws {
+        let parsed = try #require(
+            GitHubMarkdownParser.parse(body: Self.v0354Body, version: "0.35.4", date: "2026-10-14"))
+        let entry = try #require(parsed.entries.first)
+        #expect(entry.items.count == 16)
+        #expect(entry.items.first?.hasPrefix("print the named command's help") == true)
+        for item in entry.items {
+            #expect(!item.contains("curl"), "install snippet leaked: \(item)")
+            #expect(!item.contains("SHA256"), "checksum block leaked: \(item)")
+            #expect(item.range(of: "[0-9a-f]{64}", options: .regularExpression) == nil,
+                    "checksum line leaked: \(item)")
+        }
+    }
+
