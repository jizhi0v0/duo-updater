@@ -0,0 +1,83 @@
+import Foundation
+
+enum com_xd_cindy {
+    // Cindy ships two editions from one release pipeline, and they are two apps:
+    // global `com.xd.cindy` (Team SX9RG894L5) and mainland China `com.xd.cindycn`
+    // (Team NTC4BJ542G), the region baked in at build time (`appIdByRegion` in
+    // `packages/maker-shared/src/brandIdentity.ts`). Each has its own update CDN,
+    // the `cdnBaseUrl` of `config/endpoint.global.json` / `config/endpoint.json`,
+    // and its own download page.
+    static let editions: [(bundleID: String, cdn: String, page: String)] = [
+        ("com.xd.cindy", "https://hotfix.cindy.app/cindy", "https://cindy.app/download/"),
+        ("com.xd.cindycn", "https://hotfix.cindy.com.cn/cindy", "https://cindy.cn/download/"),
+    ]
+
+    // Cindy — Electron Forge app with its own updater (makecindy/cindy): no
+    // `SUFeedURL`, no `app-update.yml`. These probes read what that updater reads
+    // on the default channel, `<cdnBaseUrl>/manifest-darwin-<arch>.json`
+    // (`manifestService.ts`): one file per edition and architecture, no device
+    // key, so every copy of that edition on that Mac gets the same answer. Beta
+    // and canary are other files of the same bundle id (`-beta` / `-canary`),
+    // picked by a preference and by the server, and are not read.
+    //
+    // The manifest also lists the agent binaries the app downloads (`codex`,
+    // `claudeCode`, `pi`, …), each with its own `version` and `sha256`, so every
+    // pattern starts inside the `app` object and cannot cross into another one:
+    // a reordered `app` reads nothing rather than a neighbour's value. The
+    // installer is named by a path relative to the edition's CDN, the same path
+    // on both; its `sha256` is the hex digest of that dmg (`hotfix` beside it is
+    // the updater's whole-bundle zip, which one-click doesn't use).
+    //
+    // Both architectures build separate dmgs and separate manifests, so each
+    // gets its own probe and the host requirement keeps only the one this Mac
+    // runs.
+    static func probe(_ bundleID: String, cdn: String, page: String, arch: HostArch) -> VendorProbeRecipe {
+        let key = arch == .arm64 ? "arm64" : "x64"
+        let app = #""app"\s*:\s*\{[^{}]*?"#
+        let installer = app + #""installer"\s*:\s*\{[^{}]*?"#
+        return VendorProbeRecipe(
+            bundleID: bundleID,
+            url: URL(string: "\(cdn)/manifest-darwin-\(key).json")!,
+            mode: .responseBody,
+            versionPattern: app + #""version"\s*:\s*"([0-9]+\.[0-9]+\.[0-9]+)""#,
+            downloadURL: URL(string: page)!,
+            install: VendorInstallSpec(
+                urlSource: .bodyPatternRelative(
+                    installer + #""file"\s*:\s*"(app/darwin-"# + key
+                        + #"/cindy-[0-9]+\.[0-9]+\.[0-9]+-"# + key + #"\.dmg)""#,
+                    base: URL(string: "\(cdn)/")!),
+                kind: .dmg,
+                checksumPattern: installer + #""sha256"\s*:\s*"([0-9a-f]{64})""#,
+                checksumFormat: .sha256Hex),
+            variant: key,
+            hostRequirement: VendorHostRequirement(architectures: [arch]))
+    }
+
+    // The notes are the app's own update notice, one file per version
+    // (`releaseNotesService.ts`; see `StructuredFormat.cindyUpdateNotice`), and
+    // each edition's CDN writes its own. The GitHub release bodies are not used:
+    // their only list is a block of build metadata (`commit:`, `source tag:`,
+    // mobile build numbers), which is what the parser takes from them, and the
+    // notes themselves are paragraphs. The platform key in the path is the
+    // app's `process.platform-process.arch`; the arm64 and x64 files are the same
+    // bytes, so both read arm64's. `source` is the version index, only the fixed
+    // fallback a template recipe needs; it is not a notice and decodes to nothing.
+    static func changelog(_ bundleID: String, cdn: String) -> ChangelogRecipe {
+        ChangelogRecipe(
+            bundleID: bundleID,
+            source: URL(string: "\(cdn)/notice/darwin-arm64/index.json")!,
+            mode: .json,
+            maxEntries: 1,
+            sourceTemplate: "\(cdn)/notice/darwin-arm64/{version}.json",
+            structuredFormat: .cindyUpdateNotice)
+    }
+
+    static let set = AppRecipeSet(
+        family: "com-xd-cindy",
+        probes: editions.flatMap { edition in
+            [HostArch.arm64, .x86_64].map {
+                probe(edition.bundleID, cdn: edition.cdn, page: edition.page, arch: $0)
+            }
+        },
+        changelogs: editions.map { changelog($0.bundleID, cdn: $0.cdn) })
+}
