@@ -0,0 +1,92 @@
+import Foundation
+
+enum com_tinycast_app {
+    static let set = AppRecipeSet(
+        family: "com-tinycast-app",
+        changelogs: [
+        // History: docs/app-audits/com-tinycast-app.md#历史与实测
+        //
+        // Tinycast — the release bodies ARE the changelog: the vendor's
+        // `Scripts/release-notes.sh` writes GitHub's generated "What's Changed"
+        // list (diffed against the previous tag OF THE SAME CHANNEL) above a
+        // `<!-- tinycast:install -->` marker, and install boilerplate below it.
+        // The boilerplate is paragraphs and a fenced block, never a bullet, so the
+        // bullet pass stops at the list and never reaches it.
+        //
+        // Two recipes because the two tracks are two bundle ids
+        // (`com.tinycast.app` / `com.tinycast.app.beta`), same shape as Cline's
+        // pair (`Recipes/bot-cline-app.swift`), and for the same reason
+        // `includesPromotedStable` stays false on the beta one: a stable release
+        // is a different app on disk, never a build the beta row is offered.
+        //
+        // `tagPattern` is a filter here, not a version extractor: the repo also
+        // carries `v*-sequoia` prereleases (macOS 15 side builds, last one
+        // 2026-08-19) and one `v0.5.7-alpha.22`, all flagged prerelease, so the
+        // beta rail would render them as betas without it.
+        ChangelogRecipe(
+            bundleID: "com.tinycast.app",
+            source: URL(string: "https://api.github.com/repos/abue-ammar/tinycast/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .stable,
+            structuredFormat: .gitHubReleases,
+            tagPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#),
+
+        ChangelogRecipe(
+            bundleID: "com.tinycast.app.beta",
+            source: URL(string: "https://api.github.com/repos/abue-ammar/tinycast/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .beta,
+            structuredFormat: .gitHubReleases,
+            tagPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+-beta\.[0-9]+)$"#),
+        ],
+        githubRules: [
+        // Tinycast — an open-source launcher (`abue-ammar/tinycast`) whose own
+        // updater reads this same Releases list (`ReleaseFeed.swift`); the bundle
+        // carries no `SUFeedURL` and Homebrew core has no cask (only the vendor's
+        // own tap). The release workflow builds each channel as a separate
+        // side-by-side app: stable `Tinycast.app` / `com.tinycast.app`, beta
+        // `Tinycast Beta.app` / `com.tinycast.app.beta` — Pattern A, so each rule
+        // is keyed on its own bundle id and never has to tell the tracks apart
+        // inside one id.
+        //
+        // `MARKETING_VERSION` is the full tag minus `v` and `CURRENT_PROJECT_VERSION`
+        // is the workflow run number, so `CFBundleShortVersionString` equals the
+        // captured version on both tracks (`0.11.19`, `0.11.21-beta.120` on the
+        // mounted dmgs) and nothing needs `versionIsBuild`.
+        //
+        // Detection-only, permanently, and not a backlog item: every release is
+        // signed with a self-signed certificate ("Tinycast Self-Signed",
+        // `--timestamp=none`), never notarized — the release bodies say so. The
+        // mounted bundles read `TeamIdentifier=not set` and `spctl` rejects them,
+        // so `SignatureVerifier` gate 3 (`noTeamIdentifier`) would refuse every
+        // swap. An `installAssetPattern` here could only produce an Update button
+        // that always fails. `TinycastGitHubRuleTests` pins that.
+        //
+        // Stable reads `/releases/latest`. The anchors matter: the `-sequoia`
+        // side builds are flagged prerelease today, so `/releases/latest` never
+        // returns one, but an unanchored pattern would read `v0.9.7-sequoia` as
+        // `0.9.7` the day one is published unflagged.
+        GitHubReleaseRule(
+            bundleID: "com.tinycast.app",
+            owner: "abue-ammar", repo: "tinycast",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#),
+
+        // Tinycast Beta — the vendor's beta channel accepts prereleases only
+        // (`ReleaseChannel.accepts(prerelease:)` in its source) and a beta never
+        // graduates onto stable, because stable is a different bundle id. So the
+        // pattern requires `-beta.<N>` and drops `-sequoia` / `-alpha` tags.
+        //
+        // listPageSize stays at the default 20, above the measured floor of 5
+        // registered in `GitHubListPageSizeTests.measuredMinimumDepth` (History
+        // has the walk). The newest release is a beta on most rounds, so
+        // `probesNewestFirst` usually answers with a page of one.
+        GitHubReleaseRule(
+            bundleID: "com.tinycast.app.beta",
+            owner: "abue-ammar", repo: "tinycast",
+            usePrereleases: true,
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+-beta\.[0-9]+)$"#,
+            channel: .beta),
+        ])
+}
