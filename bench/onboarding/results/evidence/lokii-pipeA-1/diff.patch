@@ -0,0 +1,37 @@
+import Foundation
+
+enum com_lokii_app {
+    static let set = AppRecipeSet(
+        family: "com-lokii-app",
+        githubRules: [
+        // Shared rationale for digest-only: Recipes/org-alacritty.swift.
+
+        // Lokii — native file search (Rust core + AppKit). No SUFeedURL and no
+        // Sparkle framework; the in-app "check for updates" (`AppUpdater.swift`)
+        // reads this same `/releases/latest` and opens the download page, so it
+        // installs nothing and cannot race the swap. Tags are `vX.Y.Z`;
+        // `scripts/build.sh` stamps CFBundleShortVersionString from
+        // `lokii-core/Cargo.toml` (the release workflow refuses a tag that
+        // differs), so short == tag. CFBundleVersion is a commit count and has
+        // read `1` on every build seen, so it is not compared.
+        //
+        // Assets: one dmg per architecture, `Lokii-arm64.dmg` and
+        // `Lokii-x86_64.dmg` (single-arch binaries, not universal). The pattern
+        // takes both and `installableAsset` picks the one built for this Mac.
+        //
+        // Ad-hoc signed, no Team ID, not notarized: the release workflow only
+        // signs with a Developer ID when the repo has the secrets, and every
+        // published build (v0.1.0, v0.1.1, v0.1.2) was made without them. The
+        // seal verifies (`codesign --verify --deep --strict`), the
+        // signed identifier is the bundle id and the version is the tag's, so
+        // this takes `.publishedDigestOnly`: one-click only when the user allows
+        // it, checked against the SHA-256 GitHub publishes for the asset.
+        GitHubReleaseRule(
+            bundleID: "com.lokii.app",
+            owner: "huangy7", repo: "lokii",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^Lokii-(?:arm64|x86_64)\.dmg$"#,
+            installerKind: .dmg,
+            installTrust: .publishedDigestOnly),
+        ])
+}
