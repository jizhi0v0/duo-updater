    "Every request and every running total goes. The Downloads tab is not affected.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Anfragen und alle laufenden Summen werden gelöscht. Der Tab „Downloads“ bleibt unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borran todas las solicitudes y todos los totales acumulados. La pestaña Descargas no se ve afectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les requêtes et tous les totaux cumulés sont supprimés. L’onglet Téléchargements n’est pas affecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのリクエストと累計が削除されます。「ダウンロード」タブには影響しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляются все запросы и все накопленные итоги. Вкладка «Загрузки» не затрагивается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有请求和累计总量都会删除。「下载」标签页不受影响。"
          }
        }
      }
    },
