    "Opened %@ — its own updater is applying the update.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geöffnet – der eigene Updater der App spielt das Update ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abrió %@: su propio actualizador está aplicando la actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvert — son propre programme de mise à jour applique la mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aperta: il suo programma di aggiornamento sta applicando l’aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を開きました。アプリ自身のアップデータが更新を適用します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aberto — o atualizador dele está aplicando a atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открыт — собственный апдейтер приложения устанавливает обновление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ açıldı — güncellemeyi kendi güncelleyicisi uyguluyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打开 %@ —— 由它自带的更新器来安装此次更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已打開 %@——由它自己的更新程式套用更新。"
          }
        }
      }
    },
    "Opened the installer for %@ %@ — finish it there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsprogramm für %@ %@ geöffnet – schließe es dort ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abrió el instalador de %@ %@: termina allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme d’installation de %@ %@ ouvert — termine l’opération là-bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperto il programma di installazione di %@ %@: completalo lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ のインストーラを開きました。そちらで完了してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalador de %@ %@ aberto — conclua por lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыт установщик %@ %@ — завершите установку там."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ için yükleyici açıldı — işlemi orada bitirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打开 %@ %@ 的安装器 —— 请在那里完成安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已打開 %@ %@ 的安裝程式——請在那裡完成安裝。"
          }
        }
      }
    },
    "Opens %@ in the App Store. Turn on the background helper in Settings to install App Store updates in one click.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet %@ im App Store. Aktiviere den Hintergrund-Helper in den Einstellungen, um App-Store-Updates mit einem Klick zu installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre %@ en la App Store. Activa el asistente en segundo plano en Ajustes para instalar las actualizaciones de la App Store con un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre %@ dans l'App Store. Activez l'assistant en arrière-plan dans les Réglages pour installer les mises à jour de l'App Store en un clic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre %@ nell’App Store. Attiva l’helper in background in Impostazioni per installare gli aggiornamenti App Store con un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeで%@を開きます。設定でバックグラウンドヘルパーを有効にすると、App Storeの更新をワンクリックでインストールできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre %@ na App Store. Ative o auxiliar em segundo plano nos Ajustes para instalar atualizações da App Store com um clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает %@ в App Store. Включите фоновый помощник в настройках, чтобы устанавливать обновления App Store в один клик."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasını App Store’da açar. App Store güncellemelerini tek tıkla yüklemek için Ayarlar’da arka plan yardımcısını açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App Store 中打开 %@。请在设置中启用后台助理，以便一键安装 App Store 更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App Store 中打開 %@。在「設定」中開啟背景輔助程式，即可一鍵安裝 App Store 更新。"
          }
        }
      }
    },
