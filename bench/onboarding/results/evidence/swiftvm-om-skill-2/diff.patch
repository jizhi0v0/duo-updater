diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SwiftVMChannelTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SwiftVMChannelTests.swift
new file mode 100644
index 0000000..b12d1cc
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SwiftVMChannelTests.swift
@@ -0,0 +1,150 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// `SwiftVMChannel`: a build declaring the beta appcast is a beta copy, whose
+/// feed tags every item `beta`; any other build is left to the untagged feed.
+@Suite struct SwiftVMChannelTests {
+    private static let stableFeed = URL(string: "https://github.com/swiftvm-app/swiftvm/releases/latest/download/appcast.xml")!
+
+    /// Two items of the live `appcast-beta.xml` (fetched 2026-10-14), with the
+    /// signatures and the per-item elements the source does not read cut out.
+    private static let betaAppcast = #"""
+    <?xml version="1.0" encoding="utf-8"?>
+    <rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" xmlns:dc="http://purl.org/dc/elements/1.1/">
+      <channel>
+        <title>SwiftVM Updates (beta)</title>
+        <item>
+          <title>Version 1.4.0-beta.37</title>
+          <sparkle:channel>beta</sparkle:channel>
+          <sparkle:version>37</sparkle:version>
+          <sparkle:shortVersionString>1.4.0-beta.37</sparkle:shortVersionString>
+          <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
+          <enclosure url="https://github.com/swiftvm-app/swiftvm/releases/download/v1.4.0-beta.37/SwiftVM-1.4.0-beta.37.dmg" sparkle:edSignature="x" length="6096786" type="application/octet-stream" />
+        </item>
+        <item>
+          <title>Version 1.4.0-beta.35</title>
+          <sparkle:channel>beta</sparkle:channel>
+          <sparkle:version>35</sparkle:version>
+          <sparkle:shortVersionString>1.4.0-beta.35</sparkle:shortVersionString>
+          <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
+          <enclosure url="https://github.com/swiftvm-app/swiftvm/releases/download/v1.4.0-beta.35/SwiftVM-1.4.0-beta.35.dmg" sparkle:edSignature="x" length="6005437" type="application/octet-stream" />
+        </item>
+      </channel>
+    </rss>
+    """#
+
+    private func offered(installed version: String, build: String) -> String? {
+        let bound = SwiftVMChannel.resolve(bundleFeeds: ["SUFeedURL": SwiftVMChannel.betaFeed])
+        let app = InstalledApp(
+            name: "SwiftVM", bundleID: SwiftVMChannel.bundleID,
+            shortVersion: version, buildVersion: build,
+            path: URL(fileURLWithPath: "/Applications/ZZFixture-SwiftVM.app"),
+            isMASApp: false,
+            sparkleFeedURL: SwiftVMChannel.betaFeed,
+            sparkleChannelNames: bound?.sparkleChannelNames ?? [],
+            sparkleEdPublicKey: "key",
+            releaseChannel: bound?.channel ?? .stable,
+            channelIsAuthoritative: bound != nil)
+        return SparkleAppcastSource.bestItem(
+            for: app, from: SparkleAppcastParser.parse(Data(Self.betaAppcast.utf8)),
+            osVersion: "27.0", hostArch: .arm64, allowingIntelTranslation: true
+        )?.shortVersionString
+    }
+
+    /// Mutation that turns this red: dropping the resolution, or resolving
+    /// `.stable`. `1.4.0-beta.33` is not in the feed, so nothing can be inferred
+    /// from the copy's own item.
+    @Test func aBetaCopyTheFeedNoLongerListsIsOfferedTheNewestBeta() {
+        #expect(offered(installed: "1.4.0-beta.33", build: "33") == "1.4.0-beta.37")
+    }
+
+    @Test func onlyTheBetaFeedResolves() {
+        #expect(SwiftVMChannel.resolve(bundleFeeds: ["SUFeedURL": SwiftVMChannel.betaFeed])
+            == ResolvedChannel(channel: .beta))
+        #expect(SwiftVMChannel.resolve(bundleFeeds: ["SUFeedURL": Self.stableFeed]) == nil)
+        #expect(SwiftVMChannel.resolve(bundleFeeds: [:]) == nil)
+    }
+
+    @Test func swiftVMHasAResolverButNoPreferenceToWatch() {
+        #expect(ChannelBinding.hasResolver(bundleID: SwiftVMChannel.bundleID))
+        #expect(!ChannelBinding.boundBundleIDs.contains(SwiftVMChannel.bundleID.lowercased()))
+    }
+}
+
+/// Both tracks read one Releases list (`swiftvm-app/swiftvm`). The fixture is
+/// six real releases from the live `per_page=40` page fetched 2026-10-14,
+/// verbatim, including `v1.0.0` (no body) and the rolling `beta-channel`
+/// release that only hosts the beta appcast.
+private let swiftVMReleasesFixture = #"""
+[
+  {
+    "tag_name": "v1.4.0-beta.37",
+    "prerelease": true,
+    "draft": false,
+    "published_at": "2026-10-14T10:55:58Z",
+    "body": "## What's Changed\n* Add optional disk compression for Linux virtual machines"
+  },
+  {
+    "tag_name": "v1.3.0",
+    "prerelease": false,
+    "draft": false,
+    "published_at": "2026-10-13T11:24:47Z",
+    "body": "## What's Changed\n* Keep machines on any disk, and open up settings that were fixed"
+  },
+  {
+    "tag_name": "v1.3.0-beta.30",
+    "prerelease": true,
+    "draft": false,
+    "published_at": "2026-10-13T11:07:29Z",
+    "body": "## What's Changed\n* Keep machines on any disk, and open up settings that were fixed"
+  },
+  {
+    "tag_name": "v1.2.0",
+    "prerelease": false,
+    "draft": false,
+    "published_at": "2026-10-12T18:41:07Z",
+    "body": "## What's Changed\n* Add guest automation: exec, cp, screenshot, and ui commands through the guest tools"
+  },
+  {
+    "tag_name": "v1.0.0",
+    "prerelease": false,
+    "draft": false,
+    "published_at": "2026-10-11T16:48:47Z",
+    "body": null
+  },
+  {
+    "tag_name": "beta-channel",
+    "prerelease": true,
+    "draft": false,
+    "published_at": "2026-10-11T15:05:52Z",
+    "body": "Rolling Sparkle appcast for the beta channel. Do not delete."
+  }
+]
+"""#
+
+private func swiftVMRecipe(_ channel: ReleaseChannel) throws -> ChangelogRecipe {
+    try #require(ChangelogRecipeRegistry.recipes.first {
+        $0.bundleID == "com.swiftvm.app" && $0.channel == channel
+    })
+}
+
+@Test func swiftVMStableChangelogReadsOnlyStableReleases() throws {
+    let changelog = try #require(ChangelogService.parse(try swiftVMRecipe(.stable), body: swiftVMReleasesFixture))
+    #expect(Array(changelog.entries.map(\.version).prefix(2)) == ["1.3.0", "1.2.0"])
+    #expect(!changelog.entries.contains { $0.version.contains("beta") })
+    #expect(changelog.entries.first?.date == "2026-10-13")
+    #expect(changelog.entries.first?.items
+        == ["Keep machines on any disk, and open up settings that were fixed"])
+}
+
+/// The rolling `beta-channel` release is a prerelease too; the tag pattern is
+/// what keeps its one line of housekeeping out of the beta notes.
+@Test func swiftVMBetaChangelogReadsOnlyNumberedBetas() throws {
+    let recipe = try swiftVMRecipe(.beta)
+    #expect(recipe.includesPromotedStable == false)
+    let changelog = try #require(ChangelogService.parse(recipe, body: swiftVMReleasesFixture))
+    #expect(changelog.entries.map(\.version) == ["1.4.0-beta.37", "1.3.0-beta.30"])
+    #expect(changelog.entries.first?.items
+        == ["Add optional disk compression for Linux virtual machines"])
+}
