diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/LokiiGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/LokiiGitHubRuleTests.swift
new file mode 100644
index 0000000..4c51aa6
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/LokiiGitHubRuleTests.swift
@@ -0,0 +1,113 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Lokii (`Recipes/com-lokii-app.swift`): stable tags only, the anchored version
+/// pattern, and the arm64 dmg as the one-click asset.
+@Suite struct LokiiGitHubRuleTests {
+
+    private static func rule() -> GitHubReleaseRule? {
+        GitHubReleaseRegistry.rules.first { $0.bundleID == "com.lokii.app" }
+    }
+
+    @Test func ruleReadsTheBareTagAndTheArm64DmgOnly() throws {
+        let rule = try #require(Self.rule())
+        #expect(rule.owner == "huangy7" && rule.repo == "lokii")
+        #expect(rule.channel == .stable && !rule.usePrereleases)
+        #expect(rule.installerKind == .dmg)
+        #expect(rule.installTrust == .publishedDigestOnly)
+        let pattern = try #require(rule.installAssetPattern)
+        func extract(_ tag: String) -> String? {
+            VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+        }
+        func matches(_ name: String) -> Bool {
+            name.range(of: pattern, options: .regularExpression) != nil
+        }
+
+        // Every tag the vendor has published, and the shapes it might still cut.
+        #expect(extract("v0.1.0") == "0.1.0")
+        #expect(extract("v0.1.1") == "0.1.1")
+        #expect(extract("v0.1.2") == "0.1.2")
+        // No major pin: the next major, and a two-part tag, must still read.
+        #expect(extract("v1.0.0") == "1.0.0")
+        #expect(extract("v0.2") == "0.2")
+        #expect(extract("v0.2.0-rc.1") == nil)
+        #expect(extract("v0.2.0-beta.1") == nil)
+
+        #expect(matches("Lokii-arm64.dmg"))
+        #expect(!matches("Lokii-x86_64.dmg"))
+    }
+
+    // MARK: - An un-flagged rc as `/releases/latest`
+
+    /// Newest first, as `(tag, assetNames)`, every one `prerelease: false`. The
+    /// rc's asset has the same name as a stable release's: the asset name carries
+    /// no version, so the asset pattern cannot tell the rc apart.
+    private static let releases: [(String, [String])] = [
+        ("v0.1.3-rc.1", ["Lokii-arm64.dmg", "Lokii-x86_64.dmg"]),
+        ("v0.1.2", ["Lokii-arm64.dmg", "Lokii-x86_64.dmg"]),
+        ("v0.1.1", ["Lokii-arm64.dmg", "Lokii-x86_64.dmg"]),
+    ]
+
+    final class StubReleases: URLProtocol, @unchecked Sendable {
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+        override func startLoading() {
+            let url = request.url?.absoluteString ?? ""
+            let all = LokiiGitHubRuleTests.releases
+            if url.contains("/releases/latest") {
+                respond(Data("{\(Self.fields(all[0]))}".utf8))
+                return
+            }
+            let perPage = URLComponents(string: url)?.queryItems?
+                .first { $0.name == "per_page" }?.value.flatMap(Int.init) ?? all.count
+            let page = all.prefix(perPage).map { "{\(Self.fields($0))}" }
+            respond(Data("[\(page.joined(separator: ","))]".utf8))
+        }
+
+        private static func fields(_ release: (String, [String])) -> String {
+            let assets = release.1.map {
+                """
+                {"name":"\($0)","browser_download_url":\
+                "https://github.com/huangy7/lokii/releases/download/\(release.0)/\($0)",\
+                "size":1000}
+                """
+            }
+            return """
+            "tag_name":"\(release.0)","name":"Lokii \(release.0)","draft":false,\
+            "prerelease":false,"published_at":"2026-10-13T00:00:00Z",\
+            "html_url":"https://github.com/huangy7/lokii/releases/tag/\(release.0)",\
+            "body":"See the assets to download this version and install.",\
+            "assets":[\(assets.joined(separator: ","))]
+            """
+        }
+
+        private func respond(_ data: Data) {
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: 200, httpVersion: "HTTP/1.1",
+                headerFields: ["Content-Type": "application/json"])!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: data)
+            client?.urlProtocolDidFinishLoading(self)
+        }
+
+        override func stopLoading() {}
+    }
+
+    /// The version anchor is what refuses the rc. Its dmg matches the asset
+    /// pattern, so the source does not leave `/releases/latest` for the list, and
+    /// its tag yields no version. The answer is no answer: not 0.1.3, and not a
+    /// walk back to 0.1.2, which would hide that the newest release is an rc.
+    @Test func anUnflaggedReleaseCandidateIsNotReadAsAVersion() async throws {
+        let rule = try #require(Self.rule())
+        let config = URLSessionConfiguration.ephemeral
+        config.protocolClasses = [StubReleases.self]
+        let source = GitHubReleasesSource(
+            rules: [rule], session: URLSession(configuration: config))
+        let outcome = await source.resolveDiagnostic(
+            rule, preferring: .arm64, allowingIntelTranslation: false)
+        #expect(outcome.remote == nil)
+    }
+}
