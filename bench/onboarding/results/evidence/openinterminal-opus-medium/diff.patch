@@ -0,0 +1,26 @@
+import Foundation
+
+enum wang_jianing_app_OpenInTerminal {
+    static let set = AppRecipeSet(
+        family: "wang-jianing-app-OpenInTerminal",
+        githubRules: [
+        // OpenInTerminal — Finder toolbar app, no SUFeedURL and no updater of its
+        // own. The repo ALSO releases OpenInTerminal-Lite / OpenInEditor-Lite
+        // (separate bundle ids) under the same bare `v` tags: the full app is
+        // v2.x, the Lite pair v1.x, cut minutes apart. The asset pattern is what
+        // keeps a Lite release from being read as this app's version: a
+        // `/releases/latest` that lands on a Lite tag carries no `OpenInTerminal.zip`,
+        // so the source falls back to the stable list and walks to the v2 tag.
+        // Asset was `OpenInTerminal.app.zip` up to v2.3.6, `OpenInTerminal.zip`
+        // since; universal. short == tag; CFBundleVersion is a constant `1`.
+        // One-click: Team C8VX3ZLX5U, notarized + stapled, from v2.3.9. v2.3.8
+        // and earlier are signed by Team Q33U8R4U57 (same developer name), so
+        // VendorInstaller's same-Team gate refuses one-click from those.
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.app.OpenInTerminal",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^OpenInTerminal(?:\.app)?\.zip$"#,
+            installerKind: .zip),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift
