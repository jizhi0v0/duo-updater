@@ -0,0 +1,57 @@
+import Foundation
+
+enum rocks_spotifast_Spotifast {
+    static let set = AppRecipeSet(
+        family: "rocks-spotifast-Spotifast",
+        changelogs: [
+        // Spotifast — release bodies from the releases API. The GitHub rules below
+        // carry only the newest body, and the project ships every few days, so a
+        // copy a few versions behind would see one version's notes. Bodies are
+        // Markdown with `##` sections (New / Fixed / Changed / Known limitations /
+        // Thanks). The release-candidate entries are flagged `prerelease`, which
+        // the `.gitHubReleases` decoder drops for the stable channel.
+        ChangelogRecipe(
+            bundleID: "rocks.spotifast.Spotifast",
+            source: URL(string: "https://api.github.com/repos/crmne/spotifast/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .stable,
+            structuredFormat: .gitHubReleases),
+        ],
+        githubRules: [
+        // Spotifast (`crmne/spotifast`, formerly `crmne/fastpotify`; GitHub
+        // redirects the old name). No Sparkle and no electron-builder config: its
+        // own updater (`fastframe-update`) reads this repo's `/releases/latest`,
+        // so the rules read exactly what the vendor's updater reads. The vendor
+        // tap's cask is not in Homebrew's catalog, so nothing else answers.
+        //
+        // Single track. The `-rcN` tags (0.4.0 and 0.5.0 era) are flagged
+        // prerelease, and the vendor's updater never offers prereleases. The tag
+        // pattern is anchored so an rc published without the flag still can't
+        // read as a plain `X.Y.Z`. Tag `vX.Y.Z` == `CFBundleShortVersionString`.
+        //
+        // One-click: one universal dmg per release, `rocks.spotifast.Spotifast`,
+        // Team JPL7999US3, notarized (0.10.0 and later; 0.12.0 and 0.13.0
+        // measured). The pattern excludes the `fastpotify-…` twin older releases
+        // attach and every non-mac asset. GitHub publishes a sha256 digest for
+        // each asset and the install checks it.
+        GitHubReleaseRule(
+            bundleID: "rocks.spotifast.Spotifast",
+            owner: "crmne", repo: "spotifast",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^spotifast-v[0-9]+\.[0-9]+\.[0-9]+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+
+        // No rule for the old id `me.paolino.fastpotify` (0.9.1 and earlier), and that
+        // is a gap, not a choice. `GitHubReleasesSource` looks a rule up by the id on
+        // disk, not by `recipeBundleID`, so those copies would need a rule of their
+        // own; but `GitHubReleaseRule.recipeID` is `github:<owner>/<repo>:<channel>`
+        // with no bundle id in it, so a second rule on this repo would share the
+        // first one's health entry and verify baseline (and fail
+        // `RecipeHealthKeyTests.rulesSharingASlugRecordSeparateHealthEntries`).
+        // Zed and Tinycast get away with two rules on one repo only because their
+        // channels differ. The way out is a lookup by `recipeBundleID` in the source,
+        // which would also hand these copies this rule's `installAssetPattern`; the
+        // audit says why that waits for an old-id install run.
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SpotifastCoverageTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SpotifastCoverageTests.swift
