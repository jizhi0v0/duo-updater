+import Foundation
+
+enum com_obelisk_app {
+    static let set = AppRecipeSet(
+        family: "com-obelisk-app",
+        changelogs: [
+        // Obelisk — GitHub releases, because the appcast keeps only the newest.
+        //
+        // The bundle names its own `SUFeedURL` (`releases/latest/download/
+        // appcast-<arch>.xml`), so `SparkleAppcastSource` answers for the app and
+        // needs no recipe. What it cannot do is structure the notes: the item's
+        // `<description>` is the release body as bare Markdown, with no
+        // `sparkle:format="markdown"`, so it is neither HTML nor recognised
+        // Markdown and the pane shows it raw. The feed also holds exactly one
+        // item, so there is no history behind it.
+        //
+        // github.com/tommy0103/obelisk/releases carries that same body (byte-
+        // identical to the appcast `<description>` for v0.2.5) for every release,
+        // each with its published date, and goes through the decoder every other
+        // GitHub-sourced app uses. `skipSections` drops three headings the decoder
+        // would otherwise turn into change notes: "Included work" (merged PRs and
+        // their authors: credit, not a change), "Downloads" (v0.2.0-v0.2.2 list
+        // the asset file names as bullets) and "Installation" (v0.2.4/v0.2.5; plain
+        // paragraphs today, so it only guards a future bulleted one). The decoder's
+        // own skip list is just contributors / full changelog.
+        ChangelogRecipe(
+            bundleID: "com.obelisk.app",
+            source: URL(string: "https://api.github.com/repos/tommy0103/obelisk/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["Included work", "Downloads", "Installation"]),
+        ],
+        githubRules: [
+        // Obelisk — detection for the copies that predate the updater. v0.2.4 is
+        // the first release whose bundle names a `SUFeedURL`; the published
+        // v0.1.0, v0.2.0, v0.2.1 and v0.2.2 bundles have none (v0.2.2 also has no
+        // `app-update.yml`) and are ad-hoc signed, all under the same bundle id, so
+        // nothing else resolves them. From 0.2.4 on Sparkle answers first and this
+        // rule is never reached. Detection only: those old copies carry no Team ID, and the Team
+        // ID check refuses to replace an install without one on either route
+        // (`noTeamIdentifier` on the default route, `teamIdentifierAppeared` on the
+        // hash-only route). v-tags equal `CFBundleShortVersionString`; one stable
+        // track.
+        GitHubReleaseRule(
+            bundleID: "com.obelisk.app",
+            owner: "tommy0103", repo: "obelisk",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+        ])
+}
