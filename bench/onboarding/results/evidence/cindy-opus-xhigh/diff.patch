     /// The feed is a flat JSON array, newest-first, of `{name, notes, pub_date,
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyCoverageTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyCoverageTests.swift
new file mode 100644
index 0000000..fef94bc
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyCoverageTests.swift
@@ -0,0 +1,282 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// Cindy (`Recipes/com-xd-cindy.swift`): two editions, global `com.xd.cindy` and
+/// mainland China `com.xd.cindycn`, each with a probe per architecture on its own
+/// CDN's update manifest and a `.cindyUpdateNotice` changelog recipe. What is
+/// pinned: each edition and architecture reads its own manifest; the probe takes
+/// the app's version, dmg and digest, never one of the agent binaries the same
+/// manifest lists; the notes come out of the app's own update notice in the
+/// reader's language.
+///
+/// See `docs/app-audits/com-xd-cindy.md` for the measurements.
+@Suite struct CindyCoverageTests {
+
+    static let editions = [
+        ("com.xd.cindy", "https://hotfix.cindy.app/cindy", "https://cindy.app/download/"),
+        ("com.xd.cindycn", "https://hotfix.cindy.com.cn/cindy", "https://cindy.cn/download/"),
+    ]
+
+    private static func probe(_ bundleID: String, _ arch: HostArch) throws -> VendorProbeRecipe {
+        let found = VendorProbeRegistry.recipes.filter {
+            $0.bundleID == bundleID && $0.hostRequirement?.architectures == [arch]
+        }
+        try #require(found.count == 1, "\(bundleID) should have exactly one \(arch) probe")
+        return found[0]
+    }
+
+    @Test(arguments: editions)
+    func eachEditionAndArchitectureReadsItsOwnManifest(bundleID: String, cdn: String, page: String) throws {
+        let all = VendorProbeRegistry.recipes.filter { $0.bundleID == bundleID }
+        #expect(all.count == 2)
+        #expect(Set(all.map(\.recipeID)) == ["vendor:\(bundleID):stable:arm64", "vendor:\(bundleID):stable:x64"])
+        for (arch, key) in [(HostArch.arm64, "arm64"), (.x86_64, "x64")] {
+            let recipe = try Self.probe(bundleID, arch)
+            #expect(recipe.url.absoluteString == "\(cdn)/manifest-darwin-\(key).json")
+            #expect(recipe.channel == .stable)
+            #expect(recipe.downloadURL?.absoluteString == page)
+            #expect(recipe.hostRequirement?.isSatisfied(byOS: "15.0", arch: arch) == true)
+            #expect(recipe.hostRequirement?.isSatisfied(byOS: "15.0", arch: arch == .arm64 ? .x86_64 : .arm64) == false)
+            let install = try #require(recipe.install)
+            #expect(install.kind == .dmg)
+            #expect(install.checksumFormat == .sha256Hex)
+        }
+    }
+
+    /// `manifest-darwin-arm64.json` as hotfix.cindy.app served it (2026-10-14),
+    /// byte for byte. The app is the third object; the agent binaries around it
+    /// carry their own `version`, `file` and `sha256`.
+    static let manifest = #"""
+    {
+      "codex": {
+        "version": "0.145.0",
+        "file": "codex/0.145.0/darwin-arm64/codex.gz",
+        "sha256": "752de083922a77807072d4fecc8c52634a888b07ea513b1df32b348567b50889",
+        "size": 102106034,
+        "binarySha256": "1da3f4e0e96028b8a771814293c3033dafd1971f943f6c7e79b0897fe705f590"
+      },
+      "claudeCode": {
+        "version": "2.1.296",
+        "file": "claude-code/2.1.296/darwin-arm64/claude.gz",
+        "sha256": "55d0a80f327670eb52fdce8b304ae89cc6d6b88f1834ece242a94cf81bf2a075",
+        "size": 105099541,
+        "binarySha256": "c9b5341637becbd423ddffc5b254afb645682a3868cb708bbc6cc0e7bb419937"
+      },
+      "app": {
+        "version": "0.1.104",
+        "installer": {
+          "file": "app/darwin-arm64/cindy-0.1.104-arm64.dmg",
+          "sha256": "9e8ac572b919694510ab583d39cb1f4b582bcd8d7fa82fa681b4430a8b69eaeb",
+          "size": 305191277
+        },
+        "hotfix": {
+          "file": "hotfix/darwin-arm64/cindy-0.1.104-arm64-hotfix.zip",
+          "sha256": "929d40b3b38c8fb6a0d44a3e557f7a4b950e39cec2e3da23d6574d0dec1fdd98",
+          "size": 278778019
+        }
+      },
+      "pi": {
+        "version": "1.0.2",
+        "file": "pi/1.0.2/darwin-arm64/pi.dist.tar.gz",
+        "sha256": "33408a2f5cf2f51661b59fc3faa9eaaeebfde1bf110bb30cb56cd314e481e7d2",
+        "size": 31694994
+      },
+      "codexPackage": {
+        "version": "0.159.2",
+        "file": "codex-package/0.159.2/darwin-arm64/codex-package.dist.tar.gz",
+        "sha256": "a1e58a10ac3c7e5345342f93504a7628e98283d91a91bddab747c40b1c1981bc",
+        "size": 133851150
+      }
+    }
+    """#
+
+    static let installerSHA256 = "9e8ac572b919694510ab583d39cb1f4b582bcd8d7fa82fa681b4430a8b69eaeb"
+
+    /// End to end through the probe: the version, dmg and digest are the app's.
+    /// The dmg's real download had exactly this SHA-256 (and so did GitHub's
+    /// copy), and the cn edition resolves the same relative path on its own CDN.
+    @Test(arguments: editions)
+    func theProbeTakesTheAppsVersionDmgAndDigest(bundleID: String, cdn: String, page: String) async throws {
+        let server = try RecipeVerificationTests.StubServer(body: Self.manifest)
+        defer { server.stop() }
+        let outcome = await VendorProbeSource().probeDiagnostic(
+            try Self.probe(bundleID, .arm64).with(url: server.url))
+        #expect(outcome.failure == nil)
+        #expect(outcome.remote?.shortVersion == "0.1.104")
+        #expect(outcome.remote?.downloadURL?.absoluteString
+                == "\(cdn)/app/darwin-arm64/cindy-0.1.104-arm64.dmg")
+        #expect(outcome.remote?.expectedSHA256 == Self.installerSHA256)
+        #expect(!outcome.warnings.contains(.checksumPatternNoMatch))
+    }
+
+    /// The x64 probe never takes the arm64 manifest's dmg.
+    @Test func theIntelProbeTakesNoArm64Dmg() throws {
+        let install = try #require(try Self.probe("com.xd.cindy", .x86_64).install)
+        guard case .bodyPatternRelative(let pattern, _) = install.urlSource else {
+            Issue.record("the install URL should be a path relative to the CDN"); return
+        }
+        #expect(VendorProbeRecipe.extractVersion(from: Self.manifest, pattern: pattern) == nil)
+        #expect(VendorProbeRecipe.extractVersion(
+            from: Self.manifest.replacingOccurrences(of: "arm64", with: "x64"), pattern: pattern)
+            == "app/darwin-x64/cindy-0.1.104-x64.dmg")
+    }
+
+    /// Why every pattern starts inside `app`: without it the first `version` and
+    /// `sha256` in the file are codex's.
+    @Test func theAnchorOnAppIsLoadBearing() throws {
+        let recipe = try Self.probe("com.xd.cindy", .arm64)
+        #expect(VendorProbeRecipe.extractVersion(from: Self.manifest, pattern: recipe.versionPattern) == "0.1.104")
+        #expect(VendorProbeRecipe.extractVersion(
+            from: Self.manifest, pattern: #""version"\s*:\s*"([0-9]+\.[0-9]+\.[0-9]+)""#) == "0.145.0")
+        let checksum = try #require(recipe.install?.checksumPattern)
+        #expect(VendorProbeRecipe.extractVersion(from: Self.manifest, pattern: checksum) == Self.installerSHA256)
+    }
+
+    /// A reordered `app` reads nothing rather than a neighbour's value: with
+    /// `hotfix` ahead of `installer`, no dmg and no digest (never the zip's);
+    /// with `installer` ahead of `version`, no version (never an agent's).
+    @Test func aReorderedAppReadsNothingRatherThanANeighbour() throws {
+        let recipe = try Self.probe("com.xd.cindy", .arm64)
+        let install = try #require(recipe.install)
+        guard case .bodyPatternRelative(let urlPattern, _) = install.urlSource else {
+            Issue.record("the install URL should be a path relative to the CDN"); return
+        }
+        let checksum = try #require(install.checksumPattern)
+
+        let installer = #"""
+            "installer": {
+              "file": "app/darwin-arm64/cindy-0.1.104-arm64.dmg",
+              "sha256": "9e8ac572b919694510ab583d39cb1f4b582bcd8d7fa82fa681b4430a8b69eaeb",
+              "size": 305191277
+            },
+        """#
+        #expect(Self.manifest.contains(installer))
+        let hotfixFirst = Self.manifest
+            .replacingOccurrences(of: installer, with: "")
+            .replacingOccurrences(of: "      \"size\": 278778019\n    }",
+                                  with: "      \"size\": 278778019\n    },\n" + installer.dropLast())
+        let hotfixAt = try #require(hotfixFirst.range(of: #""hotfix""#)?.lowerBound)
+        let installerAt = try #require(hotfixFirst.range(of: #""installer""#)?.lowerBound)
+        #expect(hotfixAt < installerAt && hotfixFirst.contains(Self.installerSHA256))
+        #expect(VendorProbeRecipe.extractVersion(from: hotfixFirst, pattern: urlPattern) == nil)
+        #expect(VendorProbeRecipe.extractVersion(from: hotfixFirst, pattern: checksum) == nil)
+
+        let installerFirst = Self.manifest.replacingOccurrences(
+            of: "    \"version\": \"0.1.104\",\n" + installer,
+            with: installer + "\n    \"version\": \"0.1.104\",")
+        #expect(installerFirst != Self.manifest)
+        #expect(VendorProbeRecipe.extractVersion(from: installerFirst, pattern: recipe.versionPattern) == nil)
+    }
+
+    // MARK: - Changelog
+
+    @Test(arguments: [("com.xd.cindy", "https://hotfix.cindy.app/cindy"),
+                      ("com.xd.cindycn", "https://hotfix.cindy.com.cn/cindy")])
+    func eachEditionReadsItsOwnCDNsNotice(bundleID: String, cdn: String) throws {
+        let recipe = try #require(ChangelogRecipeRegistry.recipe(
+            forBundleID: bundleID, channel: .stable, version: "0.1.104"))
+        #expect(recipe.structuredFormat == .cindyUpdateNotice)
+        #expect(recipe.resolvedSource(forVersion: "0.1.104").absoluteString
+                == "\(cdn)/notice/darwin-arm64/0.1.104.json")
+    }
+
