diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/rocks-spotifast-Spotifast.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/rocks-spotifast-Spotifast.swift
new file mode 100644
index 0000000..e61d327
--- /dev/null
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/rocks-spotifast-Spotifast.swift
@@ -0,0 +1,68 @@
+import Foundation
+
+enum rocks_spotifast_Spotifast {
+    static let set = AppRecipeSet(
+        family: "rocks-spotifast-Spotifast",
+        changelogs: [
+        // Spotifast — release bodies from the releases API. The GitHub rule below
+        // carries only the newest body, so a copy a few versions behind would see
+        // one version's notes (releases come every few days). Bodies are Markdown,
+        // written by hand per release (`packaging/release-notes/vX.Y.Z.md` in the
+        // repo): an opening paragraph, a `**Download Spotifast:**` line of links,
+        // then `## New` / `## Fixed` / `## Changed` sections. No `skipSections`:
+        // the closing `## Thanks` roster is a paragraph, so it yields no items
+        // (removing the setting changed nothing in the test below).
+        //
+        // Entries are filed under the tag minus its `v`, which is what the app
+        // reports. Tags with a suffix are prereleases (the workflow flags every tag
+        // containing `-`) and the decoder drops them.
+        ChangelogRecipe(
+            bundleID: "rocks.spotifast.Spotifast",
+            source: URL(string: "https://api.github.com/repos/crmne/spotifast/releases?per_page=20")!,
+            mode: .json,
+            maxEntries: 10,
+            structuredFormat: .gitHubReleases),
+        ],
+        githubRules: [
+        // Spotifast (crmne/spotifast, formerly Fastpotify) — a Rust/egui Spotify
+        // client. The macOS app has its own updater (`src/updates.rs`, the
+        // fastframe-update crate: reads `crmne/spotifast` releases, requires an
+        // Ed25519 signature on `checksums.txt`); no `SUFeedURL`, no Sparkle. The
+        // vendor's own tap carries a cask (`crmne/tap/spotifast`, no
+        // `auto_updates`), but `HomebrewCaskCatalog` reads only the official
+        // catalog, so `/releases/latest` is the source that answers.
+        //
+        // Versions: tag `vX.Y.Z` equals `CFBundleShortVersionString` and
+        // `CFBundleVersion` (0.12.0 and 0.13.0 measured). The release workflow
+        // flags any tag containing `-` as a prerelease; both patterns are anchored
+        // anyway, so an un-flagged `vX.Y.Z-rcN` could not be offered as "X.Y.Z".
+        //
+        // One-click: the `macos-universal.dmg` (x86_64 + arm64), Developer ID,
+        // Team JPL7999US3, notarized, the same Team on 0.12.0 and 0.13.0. A single
+        // `Spotifast.app`, no nested helpers or login items. The app's own updater
+        // may offer the same release; whichever installs first is harmless.
+        GitHubReleaseRule(
+            bundleID: "rocks.spotifast.Spotifast",
+            owner: "crmne", repo: "spotifast",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^spotifast-v[0-9]+\.[0-9]+\.[0-9]+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+
+        // The same app through 0.9.1 (Fastpotify): bundle id `me.paolino.fastpotify`,
+        // executable `fastpotify`; 0.10.0 is the first `rocks.spotifast.Spotifast`
+        // (`BundleIDMigration`). The vendor's own updater carries these copies over
+        // (0.9.1 notes: it "accepts the new archive and macOS bundle identities
+        // used by future releases"), so an old-id copy is the same app and gets
+        // detection here and, through the migration entry, the changelog.
+        //
+        // DETECTION ONLY, on purpose. The 0.12.0 notes say settings and sign-ins
+        // from 0.9.0 or older "are no longer moved over: if you update straight
+        // from one of those, you start fresh", and a rule cannot tell a 0.9.1 copy
+        // (profile already moved) from a 0.8.0 one. Copies at 0.7.1 and below are
+        // ad-hoc signed, so the Team gate would refuse them anyway.
+        GitHubReleaseRule(
+            bundleID: "me.paolino.fastpotify",
+            owner: "crmne", repo: "spotifast",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#),
+        ])
+}
diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
index b463f16..3beee7e 100644
--- a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
@@ -423,7 +423,16 @@ public extension GitHubReleaseRule {
     /// decides a row is orphaned when no rule produces its key. A second,
     /// separately-maintained spelling of this string would make the prune delete
     /// live rows the first time the two drifted.
-    var recipeID: String { "github:\(slug):\(channel.rawValue)" }
+    ///
+    /// When another registry rule has the same repo and channel under a DIFFERENT
+    /// bundle id (an app that renamed its bundle id and keeps both detected:
+    /// Spotifast / Fastpotify), the bundle id is appended so each keeps its own
+    /// health row and baseline entry. Every other rule's key is unchanged.
+    var recipeID: String {
+        let base = "github:\(slug):\(channel.rawValue)"
+        return GitHubReleaseRegistry.slugsSharedAcrossBundleIDs.contains(base)
+            ? "\(base):\(bundleID)" : base
+    }
 }
 
 /// Resolves updates for apps distributed through GitHub Releases. Kept separate
@@ -1610,4 +1619,11 @@ public enum GitHubReleaseRegistry {
     // `FreeCAD_<ver>-macOS-arm64-py<n>.dmg`. Check the shipped plist, not the
     // release notes.
     public static let rules: [GitHubReleaseRule] = AppRecipeIndex.all.flatMap(\.githubRules)
+
+    /// The `github:<slug>:<channel>` bases that more than one bundle id's rule
+    /// files under; see `GitHubReleaseRule.recipeID`.
+    static let slugsSharedAcrossBundleIDs: Set<String> = {
+        let byBase = Dictionary(grouping: rules) { "github:\($0.slug):\($0.channel.rawValue)" }
+        return Set(byBase.filter { Set($0.value.map(\.bundleID)).count > 1 }.keys)
+    }()
 }
