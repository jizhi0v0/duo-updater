    "Every fetch DuoUpdater makes itself: update checks, release notes, and the downloads it installs for you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Abruf, den DuoUpdater selbst durchführt: Update-Prüfungen, Versionshinweise und die Downloads, die es für Sie installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
