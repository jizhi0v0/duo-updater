    "Not recorded against one app — either a shared fetch (the Homebrew catalog, our own update) or a request logged before per-app attribution shipped.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner einzelnen App zugeordnet — entweder ein gemeinsamer Abruf (der Homebrew-Katalog, unser eigenes Update) oder eine Anfrage, die vor der App-Zuordnung aufgezeichnet wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No atribuida a una sola app: o bien es una descarga compartida (el catálogo de Homebrew, nuestra propia actualización) o una solicitud registrada antes de que existiera la atribución por app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non rattachée à une app précise : soit une requête partagée (le catalogue Homebrew, notre propre mise à jour), soit une requête enregistrée avant l’arrivée de l’attribution par app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定の App に紐づいていません。共有の取得（Homebrew カタログ、自身の更新）か、App 単位の記録が入る前のリクエストです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не отнесён к одному приложению — это либо общий запрос (каталог Homebrew, наше собственное обновление), либо запрос, записанный до появления привязки к приложению."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有归到某个 App——要么是共享的请求（Homebrew 目录、我们自己的更新），要么是记录于按 App 归属上线之前。"
          }
        }
      }
    },
