+import Foundation
+
+enum com_obelisk_app {
+    static let set = AppRecipeSet(
+        family: "com-obelisk-app",
+        changelogs: [
+        // History: docs/app-audits/com-obelisk-app.md#历史与实测
+        // Obelisk — GitHub releases, because the appcast's notes are Markdown that
+        // the feed does not mark as Markdown.
+        //
+        // Detection needs no recipe. From 0.2.4 on the bundle declares its own
+        // `SUFeedURL`, one feed per architecture
+        // (`github.com/tommy0103/obelisk/releases/latest/download/appcast-<arch>.xml`),
+        // so `SparkleAppcastSource` answers. The release script
+        // (`app/scripts/update-release.mjs`) writes each feed fresh per release with
+        // ONE `<item>`, so it has no history for a version rail, and that item's
+        // `<description>` is the GitHub release body — Markdown, but with no
+        // `sparkle:format="markdown"`, so it is read as HTML, has no list markup to
+        // convert, and the pane shows it as raw text.
+        //
+        // The repo's Releases carry the same body (the script copies it into the
+        // feed) plus the history. Every release there is the desktop app's — the CLI
+        // ships through npm, not Releases — so no `tagPattern`: the tag is `v` + the
+        // version, the release workflow refuses a tag that differs from
+        // `app/package.json`'s version, and electron-builder stamps that same string
+        // as `CFBundleShortVersionString`.
+        //
+        // `skipSections` names the two headings whose bullets are not changes:
+        // `Included work` is a per-contributor roster of the merged PRs, restating
+        // the sections above it, and `Downloads` (older releases) lists asset file
+        // names. `Installation` is not listed because it holds prose and a code
+        // block, never a top-level bullet, so it yields nothing anyway.
+        ChangelogRecipe(
+            bundleID: "com.obelisk.app",
+            source: URL(string: "https://api.github.com/repos/tommy0103/obelisk/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["Included work", "Downloads"]),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/ObeliskChangelogRecipeTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/ObeliskChangelogRecipeTests.swift
