diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift
new file mode 100644
index 0000000..931e19b
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift
@@ -0,0 +1,197 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// OpenInTerminal (`wang.jianing.app.OpenInTerminal`, `Ji4n1ng/OpenInTerminal`)
+/// shares its repo with two Lite apps that publish together under their own `v1.x`
+/// tags, and the repo's release procedure moves GitHub's "Latest" badge back to the
+/// main app by hand — so `/releases/latest` is sometimes the Lite release and, for a
+/// Lite rule, always the main one. What keeps the three rules apart is the asset
+/// name and the tag's major, both pinned here against what the vendor published.
+///
+/// See `docs/app-audits/wang-jianing-app-OpenInTerminal.md` for the measurements.
+@Suite(.serialized) struct OpenInTerminalGitHubRuleTests {
+
+    private static let mainID = "wang.jianing.app.OpenInTerminal"
+    private static let terminalLiteID = "wang.jianing.app.OpenInTerminal-Lite"
+    private static let editorLiteID = "wang.jianing.app.OpenInEditor-Lite"
+
+    private static func rule(_ bundleID: String) throws -> GitHubReleaseRule {
+        let found = GitHubReleaseRegistry.rules.filter { $0.bundleID == bundleID }
+        try #require(found.count == 1, "\(bundleID) must carry exactly one rule")
+        return found[0]
+    }
+
+    private static func assets(_ names: [String]) -> [(name: String, url: URL, size: Int64?)] {
+        names.map { (name: $0, url: URL(string: "https://example.invalid/\($0)")!, size: Int64?.none) }
+    }
+
+    private static func carries(_ bundleID: String, _ names: [String]) throws -> Bool {
+        let pattern = try #require(try rule(bundleID).installAssetPattern)
+        return GitHubReleaseRule.carriesInstallableAsset(from: assets(names), matching: pattern)
+    }
+
+    @Test func tagsReadAsTheMarketingVersionOfTheirOwnSeries() throws {
+        let main = try Self.rule(Self.mainID).versionPattern
+        let lite = try Self.rule(Self.terminalLiteID).versionPattern
+        #expect(VendorProbeRecipe.extractVersion(from: "v2.3.9", pattern: main) == "2.3.9")
+        #expect(VendorProbeRecipe.extractVersion(from: "v1.2.8", pattern: lite) == "1.2.8")
+        // Neither rule reads the other series' tags (they would end up in its history).
+        #expect(VendorProbeRecipe.extractVersion(from: "v1.2.8", pattern: main) == nil)
+        #expect(VendorProbeRecipe.extractVersion(from: "v2.3.9", pattern: lite) == nil)
+        #expect(try Self.rule(Self.editorLiteID).versionPattern == lite)
+    }
+
+    /// v2.3.9 carries `OpenInTerminal.zip`; v1.2.8 carries the two Lite zips;
+    /// v2.3.6 used a name no rule installs.
+    @Test func eachRuleAcceptsOnlyItsOwnZip() throws {
+        #expect(try Self.carries(Self.mainID, ["OpenInTerminal.zip"]))
+        #expect(try Self.carries(Self.terminalLiteID, ["OpenInEditor-Lite.zip", "OpenInTerminal-Lite.zip"]))
+        #expect(try Self.carries(Self.editorLiteID, ["OpenInEditor-Lite.zip", "OpenInTerminal-Lite.zip"]))
+
+        #expect(!(try Self.carries(Self.mainID, ["OpenInEditor-Lite.zip", "OpenInTerminal-Lite.zip"])))
+        #expect(!(try Self.carries(Self.terminalLiteID, ["OpenInTerminal.zip"])))
+        #expect(!(try Self.carries(Self.editorLiteID, ["OpenInTerminal.zip"])))
+        #expect(!(try Self.carries(Self.terminalLiteID, ["OpenInEditor-Lite.zip"])))
+        #expect(!(try Self.carries(Self.editorLiteID, ["OpenInTerminal-Lite.zip"])))
+        #expect(!(try Self.carries(Self.mainID, ["OpenInTerminal.app.zip"])))
+        for id in [Self.mainID, Self.terminalLiteID, Self.editorLiteID] {
+            let kind = try Self.rule(id).installerKind
+            #expect(kind == .zip)
+        }
+    }
+
+    /// Three same-channel rules on one repo must not share a health row or a baseline
+    /// entry; a rule alone on its repo and channel keeps the key it always had.
+    @Test func siblingsKeepSeparateRecipeIDsAndLoneRulesKeepTheirs() throws {
+        let ids = try [Self.mainID, Self.terminalLiteID, Self.editorLiteID]
+            .map { try Self.rule($0).recipeID }
+        #expect(Set(ids).count == 3)
+        #expect(ids[0] == "github:Ji4n1ng/OpenInTerminal:stable:wang.jianing.app.OpenInTerminal")
+        let zed = try #require(GitHubReleaseRegistry.rules.first {
+            $0.bundleID == "dev.zed.Zed" && $0.channel == .stable
+        })
+        #expect(zed.recipeID == "github:zed-industries/zed:stable")
+    }
+
+    /// The body of v2.3.9, verbatim. A flat `Changes:` list: the vendor writes no
+    /// section headings, so the structured entry has bullets and no heading.
+    @Test func theReleaseBodyParsesIntoItems() throws {
+        let body = """
+        Changes:
+
+        - Security: Fixed an AppleScript/command injection vulnerability that allowed arbitrary command execution via a crafted folder name when opening it in a non-default terminal or an editor. Thanks to Paul Gerste ([Sonar](https://www.sonarsource.com)) for the responsible disclosure.
+        - Added support for Zed, Emacs, Kakoune, GitKraken, and cmux.
+        - Added an option to limit global keyboard shortcuts to Finder-only shortcuts. (#251, #243)
+        - Introduced a new default app icon with automatic light/dark mode support.
+        - Added an option to display the Finder context menu items in a submenu.
+        - Fixed the Finder extension icon being rendered as a template icon.
+        - Improved startup responsiveness by fetching installed applications on a background thread.
+        - Fixed the keyboard shortcut overlapping the "Open in ..." title in the status bar menu.
+        """
+        let changelog = try #require(
+            GitHubMarkdownParser.parse(body: body, version: "2.3.9", date: nil))
+        let entry = try #require(changelog.entries.first)
+        #expect(entry.items.count == 8)
+        #expect(!entry.content.contains { if case .heading = $0 { true } else { false } })
+        #expect(entry.version == "2.3.9")
+    }
+
+    // MARK: - The whole resolve, against a fixture shaped like the repo
+
+    /// Releases alternate main / Lite, as the repo does. `latest` is configurable
+    /// because which one holds the badge is the thing that varies.
+    private final class FixtureProtocol: URLProtocol, @unchecked Sendable {
+        nonisolated(unsafe) static var latestTag = "v2.3.9"
+
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+        private static let main = ["OpenInTerminal.zip"]
+        private static let lite = ["OpenInEditor-Lite.zip", "OpenInTerminal-Lite.zip"]
+        private static let releases: [(tag: String, assets: [String])] = [
+            ("v2.3.9", main), ("v1.2.8", lite), ("v2.3.8", main), ("v1.2.7", lite),
+        ]
+
+        private static func release(_ tag: String, _ assets: [String]) -> String {
+            let list = assets.map {
+                """
+                {"name":"\($0)","size":1000,"browser_download_url":"https://github.com/Ji4n1ng/OpenInTerminal/releases/download/\(tag)/\($0)"}
+                """
+            }.joined(separator: ",")
+            return """
+            {"tag_name":"\(tag)","prerelease":false,"draft":false,
+             "published_at":"2026-07-13T12:08:34Z",
+             "html_url":"https://github.com/Ji4n1ng/OpenInTerminal/releases/tag/\(tag)",
+             "body":"Changes:\\n\\n- A change in \(tag).","assets":[\(list)]}
+            """
+        }
+
+        override func startLoading() {
+            let path = request.url?.path ?? ""
+            let body: String
+            let status: Int
+            switch path {
+            case "/repos/Ji4n1ng/OpenInTerminal/releases/latest":
+                let hit = Self.releases.first { $0.tag == Self.latestTag }!
+                (status, body) = (200, Self.release(hit.tag, hit.assets))
+            case "/repos/Ji4n1ng/OpenInTerminal/releases":
+                (status, body) = (200, "[" + Self.releases.map { Self.release($0.tag, $0.assets) }
+                    .joined(separator: ",") + "]")
+            default:
+                (status, body) = (404, #"{"message":"Not Found"}"#)
+            }
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: status, httpVersion: "HTTP/1.1", headerFields: nil)!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: Data(body.utf8))
+            client?.urlProtocolDidFinishLoading(self)
+        }
+
+        override func stopLoading() {}
+    }
+
+    private func answer(for bundleID: String, installed: String, latest: String) async throws
+        -> RemoteVersion?
+    {
+        FixtureProtocol.latestTag = latest
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.protocolClasses = [FixtureProtocol.self]
+        let source = GitHubReleasesSource(
+            rules: GitHubReleaseRegistry.rules.filter { $0.bundleID == bundleID },
+            session: URLSession(configuration: configuration), channelStore: nil)
+        let app = InstalledApp(
+            name: "App", bundleID: bundleID, shortVersion: installed, buildVersion: nil,
+            path: URL(fileURLWithPath: "/Applications/App.app"),
+            isMASApp: false, isToolboxManaged: false, sparkleFeedURL: nil)
+        return try await source.latestVersion(for: app)
+    }
+
+    @Test(arguments: ["v2.3.9", "v1.2.8"])
+    func theMainAppReadsItsOwnSeriesWhicheverReleaseHoldsTheBadge(latest: String) async throws {
+        let remote = try #require(try await answer(
+            for: Self.mainID, installed: "2.3.8", latest: latest))
+        #expect(remote.displayVersion == "2.3.9")
+        #expect(remote.downloadURL?.absoluteString
+                == "https://github.com/Ji4n1ng/OpenInTerminal/releases/download/v2.3.9/OpenInTerminal.zip")
+        #expect(remote.vendorInstallerKind == .zip)
+        // Only its own series reaches the timeline, even when the list was walked.
+        #expect(remote.releaseHistory.map(\.version).allSatisfy { $0.hasPrefix("2.") })
+    }
+
+    @Test(arguments: [
+        (OpenInTerminalGitHubRuleTests.terminalLiteID, "OpenInTerminal-Lite.zip"),
+        (OpenInTerminalGitHubRuleTests.editorLiteID, "OpenInEditor-Lite.zip"),
+    ], ["v2.3.9", "v1.2.8"])
+    func aLiteAppReadsTheLiteSeriesWhicheverReleaseHoldsTheBadge(
+        _ app: (id: String, asset: String), latest: String
+    ) async throws {
+        let remote = try #require(try await answer(
+            for: app.id, installed: "1.2.7", latest: latest))
+        #expect(remote.displayVersion == "1.2.8")
+        #expect(remote.downloadURL?.absoluteString
+                == "https://github.com/Ji4n1ng/OpenInTerminal/releases/download/v1.2.8/\(app.asset)")
+        #expect(remote.vendorInstallerKind == .zip)
+        #expect(remote.releaseHistory.map(\.version).allSatisfy { $0.hasPrefix("1.") })
+    }
+}
