          "stringUnit": {
            "state": "translated",
            "value": "GitHub CLI установлен, но вы не вошли в систему. Выполните `gh auth login` или вставьте токен ниже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub CLI yüklü ancak oturum açılmamış. `gh auth login` komutunu çalıştırın veya aşağıya bir token yapıştırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装 GitHub CLI，但尚未登录。请运行 `gh auth login`，或在下方粘贴令牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub CLI 已安裝但尚未登入。請執行 `gh auth login`，或在下方貼上權杖。"
          }
        }
      }
    },
