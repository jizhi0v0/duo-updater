    "Nothing is read, and beta rows say detection is off instead of guessing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts gelesen, und die Beta-Zeilen sagen, dass die Erkennung aus ist, statt zu raten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se lee nada, y las filas de betas indican que la detección está desactivada en lugar de adivinar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est lu, et les lignes des bêtas indiquent que la détection est désactivée au lieu de deviner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene letto nulla e le righe delle beta indicano che il rilevamento è disattivato invece di tirare a indovinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も読み取りません。ベータ版の行は推測せず、検出がオフであることを表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é lido, e as linhas de betas dizem que a detecção está desativada em vez de adivinhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не читается, и строки бета-версий сообщают, что обнаружение выключено, вместо догадок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey okunmaz; beta satırları tahmin yürütmek yerine algılamanın kapalı olduğunu söyler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
