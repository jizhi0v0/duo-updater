@@ -0,0 +1,92 @@
+import Foundation
+
+enum com_tinycast_app {
+    static let set = AppRecipeSet(
+        family: "com-tinycast-app",
+        githubRules: [
+        // History: docs/app-audits/com-tinycast-app.md#历史与实测
+        //
+        // Tinycast — an open-source launcher / hotkeys / clipboard app published
+        // only through this repo's Releases (plus a vendor Homebrew TAP whose casks
+        // are all `auto_updates true` and which is not in homebrew/cask, so
+        // `HomebrewCaskSource` has nothing to read). No Sparkle: the app has its
+        // own updater that reads this same releases list
+        // (`Tinycast/Features/Updates/Model/ReleaseFeed.swift`), and the bundle
+        // carries no `SUFeedURL`.
+        //
+        // **The channels are separate apps**, settled from source rather than
+        // inferred: `release.yml` builds stable as `Tinycast.app` /
+        // `com.tinycast.app` and beta as `Tinycast Beta.app` /
+        // `com.tinycast.app.beta`, side by side, and the vendor's `ReleaseChannel`
+        // derives the track from the bundle id and nothing else — stable takes
+        // only releases GitHub does NOT flag prerelease, beta only ones it does.
+        // These two rules restate that split; neither ever reads the other's tags.
+        //
+        // Stable tags are `vMAJOR.MINOR.PATCH`, and the bundle's
+        // `CFBundleShortVersionString` is exactly that string (`CFBundleVersion`
+        // is the Actions run number and is not compared here). Anchored at both
+        // ends although `/releases/latest` already excludes prereleases: this repo
+        // also carries `-sequoia` and `-alpha.<N>` tags (History), all flagged
+        // prerelease today, and the anchors keep a mis-flagged one from reading as
+        // a plain stable version. The vendor's own updater refuses a release whose
+        // tag disagrees with its flag for the same reason.
+        //
+        // ⚠️ The `-sequoia` builds are the gap this rule does NOT close. They are
+        // a frozen macOS 15 line (`LSMinimumSystemVersion` 15.0) shipped under the
+        // SAME bundle id with a short version like `0.9.7-sequoia`, which
+        // `ReleaseChannel.detect` reads as `.stable`. Such a copy is therefore
+        // served this rule and shown the mainline release, whose bundle declares
+        // macOS 26.0 — a version it may not be able to run. A `GitHubReleaseRule`
+        // has no OS-floor field to state that with; detection-only keeps it to a
+        // row that names a newer version, never an install. History has the
+        // measured bundle.
+        //
+        // Detection-only, and not as a backlog item: every package is signed with
+        // the vendor's own certificate ("Tinycast Self-Signed"), not a Developer
+        // ID, so it carries no Team Identifier and no notarization ticket.
+        // `SignatureVerifier` gate 3 throws `noTeamIdentifier` on such a bundle,
+        // so an `installAssetPattern` here could only ever produce an Update
+        // button that fails. `TinycastGitHubRuleTests` pins that for both rules.
+        //
+        // Notes: the bodies are GitHub's generated "What's Changed" list, then a
+        // `<!-- tinycast:install -->` marker and Homebrew / quarantine text in
+        // prose and fenced code. `GitHubMarkdownParser`'s strict pass takes only
+        // the top-level bullets and skips "New Contributors", so the inline parse
+        // already yields the changelog and nothing below the marker; no
+        // `ChangelogRecipe`.
+        GitHubReleaseRule(
+            bundleID: "com.tinycast.app",
+            owner: "abue-ammar", repo: "tinycast",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#),
+
+        // Tinycast Beta — its own bundle id, so `ReleaseChannel.detect` reads it
+        // as `.beta` from the `.beta` suffix (checked on the real
+        // v0.11.21-beta.120 artifact) and this rule can never reach a stable copy.
+        //
+        // The pattern KEEPS the `-beta.<N>` tail because the bundle does:
+        // `CFBundleShortVersionString` reads `0.11.21-beta.120`, the tag minus its
+        // `v`. `<N>` is the Actions run number, shared by both trains and only
+        // ever rising, and no two beta tags share a base (History), so the
+        // captured strings order the same way the vendor's semver comparison
+        // does.
+        //
+        // Beta-only on purpose, unlike WhatCable's beta rule: this vendor's beta
+        // app never takes a stable release (its `accepts(prerelease:)` says so),
+        // and a stable build would be a different app with a different bundle
+        // id anyway. The cost is the usual fuse: if the beta train pauses for
+        // longer than the page holds, the rule misses (`.unknown`, a red
+        // `duo verify`), not a wrong answer.
+        //
+        // listPageSize: 8 against a floor of 6 — every release on the repo walked,
+        // worst gap 5 between consecutive beta tags; registered in
+        // `GitHubListPageSizeTests.measuredMinimumDepth`. The newest release is a
+        // beta on most days, so `probesNewestFirst` stays at its default.
+        GitHubReleaseRule(
+            bundleID: "com.tinycast.app.beta",
+            owner: "abue-ammar", repo: "tinycast",
+            usePrereleases: true,
+            listPageSize: 8,
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+-beta\.[0-9]+)$"#,
+            channel: .beta),
+        ])
+}
