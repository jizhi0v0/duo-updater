diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SwiftVMChangelogRecipeTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SwiftVMChangelogRecipeTests.swift
