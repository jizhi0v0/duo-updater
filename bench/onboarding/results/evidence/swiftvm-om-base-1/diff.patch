diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift
new file mode 100644
index 0000000..e185ae5
--- /dev/null
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift
@@ -0,0 +1,38 @@
+import Foundation
+
+/// SwiftVM (`com.swiftvm.app`) — a Sparkle app whose beta builds read a feed of
+/// their own in which EVERY item is tagged `<sparkle:channel>beta</sparkle:channel>`.
+///
+/// The contract, settled from source (`swiftvm-app/swiftvm` on `main`): the app's
+/// `SPUUpdaterDelegate.allowedChannels` returns `["beta"]` when its own version
+/// contains `-beta.` and nothing otherwise (`App/Updates/UpdateService.swift`,
+/// `UpdateChannel.channels(forVersion:)`). There is no setting: a copy's channel is
+/// the build it is. The release workflows bake the matching feed into each build —
+/// `release.yml` passes `releases/latest/download/appcast.xml` (untagged items),
+/// `release-beta.yml` passes `releases/download/beta-channel/appcast-beta.xml`
+/// (`CHANNEL=beta`, so every item is tagged) — and both are read here through the
+/// bundle's own `SUFeedURL`, the one per-build fact a resolver is handed.
+///
+/// Why a binding: without one, `SparkleAppcastSource.allowedChannels` infers the
+/// channel from the installed build's own item in the beta feed. That works while
+/// the feed lists the build (it lists all seven betas published so far, checked
+/// 2026-10-14), but a beta copy the feed stops listing would fall back to the
+/// default channel, match nothing in an all-tagged feed, and read unknown.
+///
+/// The tag is derived (`ReleaseChannel.beta.rawValue` == "beta", the spelling the
+/// vendor's `generate-appcast.sh` writes), so no tag is declared by hand. A stable
+/// build resolves nil: the build-inferred default channel already reads its
+/// untagged items, which is all SwiftVM's own updater allows it.
+///
+/// Not in `boundBundleIDs`, same as CodeEdit: nothing a user sets changes the answer.
+enum SwiftVMChannel {
+    static let bundleID = "com.swiftvm.app"
+
+    /// The feed every SwiftVM beta build declares as its `SUFeedURL`.
+    static let betaFeed = URL(
+        string: "https://github.com/swiftvm-app/swiftvm/releases/download/beta-channel/appcast-beta.xml")!
+
+    static func resolve(bundleFeeds: [String: URL]) -> ResolvedChannel? {
+        bundleFeeds["SUFeedURL"] == betaFeed ? ResolvedChannel(channel: .beta) : nil
+    }
+}
