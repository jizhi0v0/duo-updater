          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：サインインの有効期限切れ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: sessão expirada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: срок входа истёк"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: oturumun süresi doldu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：登录已过期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：登入已過期"
          }
        }
      }
    },
    "Apple ended your Apple Developer sign-in. Sign in again to update Xcode — nothing is downloaded until you click Update.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat deine Apple-Developer-Anmeldung beendet. Melde dich erneut an, um Xcode zu aktualisieren – geladen wird erst, wenn du auf „Aktualisieren“ klickst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ha cerrado tu sesión de Apple Developer. Vuelve a iniciar sesión para actualizar Xcode; no se descarga nada hasta que hagas clic en Actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a mis fin à votre connexion Apple Developer. Reconnectez-vous pour mettre à jour Xcode — rien n’est téléchargé avant que vous cliquiez sur Mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ha chiuso la tua sessione Apple Developer. Accedi di nuovo per aggiornare Xcode: non viene scaricato nulla finché non fai clic su Aggiorna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple DeveloperのサインインがAppleによって終了されました。Xcodeをアップデートするには再度サインインしてください。「アップデート」をクリックするまで何もダウンロードされません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple encerrou sua sessão do Apple Developer. Inicie sessão de novo para atualizar o Xcode — nada é baixado até você clicar em Atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple завершила ваш вход в Apple Developer. Войдите снова, чтобы обновить Xcode, — ничего не загрузится, пока вы не нажмёте «Обновить»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple, Apple Developer oturumunuzu sonlandırdı. Xcode’u güncellemek için yeniden oturum açın — Güncelle’ye tıklayana kadar hiçbir şey indirilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已结束你的 Apple Developer 登录。请重新登录以更新 Xcode——在你点击“更新”之前不会下载任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已結束你的 Apple Developer 登入。請重新登入以更新 Xcode——在你按下「更新」之前不會下載任何內容。"
          }
        }
      }
    },
