@@ -0,0 +1,35 @@
+import Foundation
+
+enum rocks_spotifast_Spotifast {
+    static let set = AppRecipeSet(
+        family: "rocks-spotifast-Spotifast",
+        githubRules: [
+        // Spotifast — a Rust/egui Spotify client (crmne/spotifast, MIT), until 0.9.1 named
+        // Fastpotify. No SUFeedURL, no Sparkle framework; its own updater
+        // (fastframe-update, user-triggered) reads this same `/releases/latest`, so the
+        // GitHub release is the source. Tags are `vX.Y.Z`; `packaging/macos/bundle.sh`
+        // stamps CFBundleShortVersionString with the full version and CFBundleVersion with
+        // the numeric part, so short == tag on stable.
+        //
+        // `release.yml` flags any tag with a `-` as a prerelease (every `-rcN` tag is),
+        // so the default rule never sees a release candidate. The dmg is named
+        // `spotifast-vX.Y.Z-macos-universal.dmg` (note the `v`). 0.8.0–0.9.1 also carry a
+        // `fastpotify-…` copy of every asset, byte-identical to the `spotifast-…` one; the
+        // `spotifast-` anchor leaves the copies out, and the single macOS dmg is the only
+        // candidate either way.
+        //
+        // Copies on the old id: 0.1.0–0.9.1 are `me.paolino.fastpotify` (0.8.0–0.9.1 ship a
+        // Spotifast.app and a Fastpotify.app, both on that id); 0.10.0 is the first
+        // `rocks.spotifast.Spotifast`. This rule is keyed by the new id and found for them
+        // through `BundleIDMigration` (`InstalledApp.recipeBundleID`), which also lets the
+        // swap gate accept the new id over a 0.8.0–0.9.1 copy (same Team, JPL7999US3).
+        // 0.1.0–0.7.1 are ad-hoc signed with no Team ID: gate 3 refuses them, so those
+        // copies see the update but install by hand.
+        // One-click: rocks.spotifast.Spotifast, Team JPL7999US3, notarized.
+        GitHubReleaseRule(
+            bundleID: "rocks.spotifast.Spotifast",
+            owner: "crmne", repo: "spotifast",
+            installAssetPattern: #"^spotifast-v[0-9]+\.[0-9]+\.[0-9]+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
