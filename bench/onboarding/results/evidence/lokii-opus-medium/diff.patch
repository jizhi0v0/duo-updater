+import Foundation
+
+enum com_lokii_app {
+    static let set = AppRecipeSet(
+        family: "com-lokii-app",
+        githubRules: [
+        // Shared rationale for digest-only: Recipes/org-alacritty.swift.
+
+        // Lokii — Rust + AppKit menu-bar file search (huangy7/lokii). No
+        // `SUFeedURL`: its own `AppUpdater.swift` only reads `/releases/latest`
+        // and opens the dmg in the browser, so it never swaps the bundle itself.
+        // The tap cask (huangy7/homebrew-tap) is not in homebrew-cask. Every
+        // release is stable; the release workflow refuses a tag that is not
+        // `v` + the crate version, which the build stamps into
+        // CFBundleShortVersionString. short == tag without the `v`.
+        //
+        // One-click is digest-only: CI has no signing secrets, so both per-arch
+        // dmgs are ad-hoc (no Team ID, not notarized), with a sealed signature
+        // that passes `codesign --verify --deep --strict` and the signed
+        // identifier `com.lokii.app` (0.1.1 and 0.1.2). Asset names carry no
+        // version, one dmg per architecture. No nested apps.
+        //
+        // No changelog recipe: every release body is the workflow's placeholder
+        // ("See the assets to download this version and install."), and the repo
+        // and site carry no notes.
+        GitHubReleaseRule(
+            bundleID: "com.lokii.app",
+            owner: "huangy7", repo: "lokii",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^Lokii-(arm64|x86_64)\.dmg$"#,
+            installerKind: .dmg,
+            installTrust: .publishedDigestOnly),
+        ])
+}
