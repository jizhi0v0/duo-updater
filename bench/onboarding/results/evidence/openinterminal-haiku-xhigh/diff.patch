+enum wang_jianing_app_OpenInTerminal {
+    static let set = AppRecipeSet(
+        family: "wang-jianing-app-OpenInTerminal",
+        githubRules: [
+        // OpenInTerminal — Finder toolbar app. No SUFeedURL, no Sparkle, no update
+        // endpoint. v-tags, single stable track (every release is prerelease=false).
+        // The same repo ships OpenInTerminal-Lite and OpenInEditor-Lite under v1.2.x
+        // tags, as separate bundle ids; `^v(2…)` keeps those tags from answering.
+        // Detection only: 2.3.9 is signed by Team C8VX3ZLX5U, while 2.3.8 was signed
