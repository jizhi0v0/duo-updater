    "%@ is back at the earlier version, but its dictionary and settings are not — this rollback point has no copy of them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist wieder auf der früheren Version, sein Wörterbuch und seine Einstellungen jedoch nicht – dieser Wiederherstellungspunkt enthält keine Kopie davon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ volvió a la versión anterior, pero su diccionario y su configuración no: este punto de restauración no tiene una copia de ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est revenu à la version précédente, mais pas son dictionnaire ni ses réglages : ce point de restauration n’en contient aucune copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è tornata alla versione precedente, ma il suo dizionario e le sue impostazioni no: questo punto di ripristino non ne ha una copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は以前のバージョンに戻りましたが、辞書と設定は戻っていません。このロールバックポイントにはそれらのコピーがありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voltou à versão anterior, mas o dicionário e os ajustes dele não — este ponto de reversão não tem cópia deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вернулся к прежней версии, а его словарь и настройки — нет: в этой точке отката их копии нет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ önceki sürüme döndü, ancak sözlüğü ve ayarları dönmedi — bu geri alma noktasında onların kopyası yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已回退到旧版本，但词库和设置没有——这个回退点里没有它们的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已回到較早的版本，但它的詞庫和設定沒有——這個還原點沒有它們的拷貝。"
          }
        }
      }
    },
    "%@ is back at the earlier version, but restoring its dictionary and settings failed — they are still what the newer version left.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist wieder auf der früheren Version, aber das Wiederherstellen von Wörterbuch und Einstellungen ist fehlgeschlagen – sie sind weiterhin das, was die neuere Version hinterlassen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ volvió a la versión anterior, pero no se pudieron restaurar su diccionario y su configuración: siguen siendo los que dejó la versión más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est revenu à la version précédente, mais la restauration de son dictionnaire et de ses réglages a échoué : ils restent ceux laissés par la version plus récente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è tornata alla versione precedente, ma il ripristino del suo dizionario e delle sue impostazioni non è riuscito: sono ancora quelli lasciati dalla versione più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は以前のバージョンに戻りましたが、辞書と設定の復元に失敗しました。新しいバージョンが残したままの状態です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voltou à versão anterior, mas a restauração do dicionário e dos ajustes dele falhou — eles continuam como a versão mais nova deixou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вернулся к прежней версии, но восстановить его словарь и настройки не удалось — они остались такими, какими их оставила новая версия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ önceki sürüme döndü, ancak sözlüğünün ve ayarlarının geri yüklenmesi başarısız oldu — hâlâ yeni sürümün bıraktığı gibiler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已回退到旧版本，但词库和设置恢复失败——它们仍是新版本留下的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已回到較早的版本，但還原它的詞庫和設定失敗——它們仍是新版本留下的內容。"
          }
        }
      }
    },
