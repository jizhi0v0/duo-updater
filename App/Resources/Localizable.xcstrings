          "stringUnit": {
            "state": "translated",
            "value": "xcodereleases.comから・%@に更新。サインインすると、新しいリリースがいち早く載るApple自身のリストも含めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De xcodereleases.com · atualizado %@. Inicie sessão para incluir a lista da própria Apple, que traz as novas versões primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С xcodereleases.com · обновлено %@. Войдите, чтобы добавить список Apple — новые версии появляются там первыми."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "xcodereleases.com’dan · güncellenme: %@. Yeni sürümleri ilk sunan Apple’ın kendi listesini eklemek için oturum açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 xcodereleases.com · %@更新。登录后会同时包含 Apple 自己的列表，新版本会最先出现在那里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 xcodereleases.com · 更新時間：%@。登入後可一併納入 Apple 自己的列表，新版本會最先出現在那裡。"
          }
        }
      }
    },
