+    /// The fixture's bodies read line by line, independently of the recipe's
+    /// regexes: each `### ` line is a heading and the line under it is the change,
+    /// minus the `@handle` credits that end it.
+    private static func expectedSections(version: String) throws -> [(heading: String, note: String)] {
+        let releases = try #require(
+            try JSONSerialization.jsonObject(with: Data(releasesFixture.utf8)) as? [[String: Any]])
+        let release = try #require(releases.first { ($0["tag_name"] as? String) == "v\(version)" })
+        let lines = try #require(release["body"] as? String).components(separatedBy: "\n")
+        return lines.indices.compactMap { i in
+            guard lines[i].hasPrefix("### ") else { return nil }
+            let note = lines[i + 1].replacingOccurrences(
+                of: #"(?:\s+@[A-Za-z0-9][A-Za-z0-9_.-]*)+\s*$"#, with: "",
+                options: .regularExpression)
+            return (String(lines[i].dropFirst(4)), note)
+        }
+    }
