+        // `latest` track, v0.0.45 and v0.0.44 zips.
+        ("T3 Code (Alpha)", "0.0.45", .stable),
+        ("T3 Code (Alpha)", "0.0.44", .stable),
+        // Nightly, v0.0.46-nightly.20261014.3105 zip.
+        ("T3 Code (Nightly)", "0.0.46-nightly.20261014.3105", .nightly),
+        // Maintainer preview, tag v0.0.46-preview.20261010.2909. Not downloaded:
+        // the vendor's build script gives every non-nightly version the package.json
+        // product name, so it is "T3 Code (Alpha)" too — which is exactly why the
+        // version, not the name, has to decide it.
+        ("T3 Code (Alpha)", "0.0.46-preview.20261010.2909", .preview),
+    ]
