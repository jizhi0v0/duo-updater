--- /dev/null
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-xd-cindy.swift
@@ -0,0 +1,57 @@
+import Foundation
+
+enum com_xd_cindy {
+    static let set = AppRecipeSet(
+        family: "com-xd-cindy",
+        changelogs: [
+        // Cindy — the stable release bodies, which both builds share. Each is
+        // `Desktop release <ver>`, a `## 更新说明` of `###` topics written as one
+        // paragraph each (so the parser's prose pass reads them, headings kept),
+        // then `## PRs` with a `---` build footer of bullets (commit, source tag,
+        // mobile builds). "PRs" is skipped, which drops that footer with it.
+        // Bodies before 0.1.88 have no `## PRs`, so their footer bullets sit
+        // under 更新说明 and would win the bullet pass; `maxEntries: 9` keeps
+        // the window inside 0.1.88+ (measured over the newest 20, 2026-10-14).
+        ChangelogRecipe(
+            bundleID: "com.xd.cindy",
+            source: URL(string: "https://api.github.com/repos/makecindy/cindy/releases?per_page=20")!,
+            mode: .json,
+            maxEntries: 9,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["PRs"]),
+        ChangelogRecipe(
+            bundleID: "com.xd.cindycn",
+            source: URL(string: "https://api.github.com/repos/makecindy/cindy/releases?per_page=20")!,
+            mode: .json,
+            maxEntries: 9,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["PRs"]),
+        ],
+        githubRules: [
+        // Cindy — Electron AI agent app (makecindy/cindy). No SUFeedURL and no
+        // app-update.yml: it updates itself from a regional CDN manifest
+        // (`manifestService.ts`), whose installer sha256 for 0.1.104 equals the
+        // GitHub cn dmg's digest. Every release ships two builds per arch, which
+        // are two products to us: `-global` is com.xd.cindy, Team SX9RG894L5;
+        // `-cn` is com.xd.cindycn, Team NTC4BJ542G (mounted 0.1.103 and 0.1.104
+        // of both, all notarized, short == build == tag). The asset suffix keeps
+        // each rule on its own build, so the Team-ID gate never sees the other.
+        //
+        // Stable only. `-beta` tags are GitHub prereleases on the same bundle
+        // id, picked by a device setting in userData (`updateChannelStore.ts`)
+        // or an account-level canary flag: nothing in the bundle says which, so
+        // /releases/latest plus the anchored tag is the whole rule.
+        GitHubReleaseRule(
+            bundleID: "com.xd.cindy",
+            owner: "makecindy", repo: "cindy",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^cindy-[0-9.]+-darwin-(?:arm64|x64)-global\.dmg$"#,
+            installerKind: .dmg),
+        GitHubReleaseRule(
+            bundleID: "com.xd.cindycn",
+            owner: "makecindy", repo: "cindy",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^cindy-[0-9.]+-darwin-(?:arm64|x64)-cn\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
index b463f16..a77a518 100644
--- a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
@@ -423,7 +423,15 @@ public extension GitHubReleaseRule {
     /// decides a row is orphaned when no rule produces its key. A second,
     /// separately-maintained spelling of this string would make the prune delete
     /// live rows the first time the two drifted.
-    var recipeID: String { "github:\(slug):\(channel.rawValue)" }
+    ///
+    /// Repo and channel are enough until two products share both: Cindy's
+    /// global and cn builds are one repo, one stable track, two bundle ids. Only
+    /// such a pair gets the bundle id appended, so each keeps its own health row
+    /// and baseline entry and every other rule's key is untouched.
+    var recipeID: String {
+        let base = "github:\(slug):\(channel.rawValue)"
+        return GitHubReleaseRegistry.keysSharedByProducts.contains(base) ? "\(base):\(bundleID)" : base
+    }
 }
 
 /// Resolves updates for apps distributed through GitHub Releases. Kept separate
@@ -1610,4 +1618,11 @@ public enum GitHubReleaseRegistry {
     // `FreeCAD_<ver>-macOS-arm64-py<n>.dmg`. Check the shipped plist, not the
     // release notes.
     public static let rules: [GitHubReleaseRule] = AppRecipeIndex.all.flatMap(\.githubRules)
+
+    /// `github:<slug>:<channel>` keys that more than one bundle id's rules
+    /// share — the case `recipeID` disambiguates by bundle id.
+    static let keysSharedByProducts: Set<String> = Set(
+        Dictionary(grouping: rules, by: { "github:\($0.slug):\($0.channel.rawValue)" })
+            .filter { Set($0.value.map(\.bundleID)).count > 1 }
+            .keys)
 }
