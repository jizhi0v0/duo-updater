diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift
new file mode 100644
index 0000000..cf3f33e
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift
@@ -0,0 +1,157 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// Tinycast (`abue-ammar/tinycast`) ships two side-by-side apps from one
+/// Releases list — `com.tinycast.app` (stable) and `com.tinycast.app.beta` —
+/// plus a retired `-sequoia` side track and one early `-alpha` tag. Every
+/// release is self-signed and not notarized, so both rules are detection-only.
+/// These pin the decisions that are easy to undo by accident, against the
+/// strings the vendor actually publishes.
+///
+/// See `docs/app-audits/com-tinycast-app.md` for the measurements.
+@Suite struct TinycastGitHubRuleTests {
+
+    private static let bundleIDs = ["com.tinycast.app", "com.tinycast.app.beta"]
+
+    /// EVERY rule either bundle id carries, so a third rule (say a second beta
+    /// endpoint) cannot slip past the detection-only guard by not being first.
+    /// Non-empty is required: a typo'd id or an unregistered family must fail
+    /// here rather than leave the suite green over nothing.
+    private static var rules: [GitHubReleaseRule] {
+        get throws {
+            let found = GitHubReleaseRegistry.rules.filter { bundleIDs.contains($0.bundleID) }
+            try #require(!found.isEmpty, "Tinycast is no longer in GitHubReleaseRegistry")
+            return found
+        }
+    }
+
+    private static func rule(_ bundleID: String, _ channel: ReleaseChannel) throws -> GitHubReleaseRule {
+        try #require(
+            GitHubReleaseRegistry.rules.first { $0.bundleID == bundleID && $0.channel == channel },
+            "\(bundleID) has no \(channel) rule any more")
+    }
+
+    /// Every artifact is signed "Tinycast Self-Signed" and carries no Team
+    /// Identifier (mounted v0.11.19, v0.11.12, v0.11.21-beta.120,
+    /// v0.11.20-beta.119), so `SignatureVerifier` gate 3 refuses the swap with
+    /// `noTeamIdentifier`. An install pattern could only produce an Update
+    /// button that always fails.
+    @Test func tinycastStaysDetectionOnly() throws {
+        let rules = try Self.rules
+        #expect(rules.count == 2, "expected one stable and one beta rule, found \(rules.count)")
+        for rule in rules {
+            #expect(rule.installAssetPattern == nil,
+                    "\(rule.bundleID) (\(rule.channel)): Tinycast is self-signed — an install pattern can only fail the Team-ID gate")
+            #expect(rule.installerKind == nil, "\(rule.bundleID) (\(rule.channel)): see above")
+        }
+    }
+
+    /// Each track is its own bundle id, and each rule must be on the channel
+    /// production detects for that id — otherwise the channel gate refuses
+    /// the rule and the row reads "Failed" forever. `detect` is fed the real
+    /// identity read off the mounted dmgs (name, bundle id, short version).
+    @Test(arguments: [
+        ("Tinycast", "com.tinycast.app", "0.11.19", ReleaseChannel.stable),
+        ("Tinycast Beta", "com.tinycast.app.beta", "0.11.21-beta.120", ReleaseChannel.beta),
+    ])
+    func eachBundleIsDetectedOnItsRulesChannel(
+        name: String, bundleID: String, version: String, channel: ReleaseChannel
+    ) throws {
+        let detected = ReleaseChannel.detect(
+            name: name, bundleID: bundleID, keystoneChannel: nil, version: version)
+        #expect(detected == channel)
+        _ = try Self.rule(bundleID, channel)
+    }
+
+    /// Real tags as published on 2026-10-14, and what each rule reads out of
+    /// them — `extractVersion` is the call `GitHubReleasesSource` makes on every
+    /// release it walks. The captured version must equal the bundle's
+    /// `CFBundleShortVersionString`, which carries the full `-beta.N` suffix.
+    @Test(arguments: [
+        ("v0.11.19", "0.11.19", "nil-beta"),
+        ("v0.11.12", "0.11.12", "nil-beta"),
+        ("v0.11.21-beta.120", "nil-stable", "0.11.21-beta.120"),
+        ("v0.11.20-beta.119", "nil-stable", "0.11.20-beta.119"),
+        // The retired macOS 15 side track and the one early alpha: flagged
+        // prerelease on GitHub, and neither rule may read them.
+        ("v0.9.7-sequoia", "nil-stable", "nil-beta"),
+        ("v0.5.7-alpha.22", "nil-stable", "nil-beta"),
+    ])
+    func realTagsResolveOnlyOnTheirOwnTrack(tag: String, stable: String, beta: String) throws {
+        let stableRule = try Self.rule("com.tinycast.app", .stable)
+        let betaRule = try Self.rule("com.tinycast.app.beta", .beta)
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: stableRule.versionPattern)
+                == (stable.hasPrefix("nil") ? nil : stable))
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: betaRule.versionPattern)
+                == (beta.hasPrefix("nil") ? nil : beta))
+    }
+
+    /// The mutation the anchors exist for: with the registry's default
+    /// unanchored pattern a `-sequoia` tag reads as plain `0.9.7`, a macOS 15
+    /// build offered under the stable id.
+    @Test func theDefaultPatternWouldReadASequoiaTag() {
+        #expect(VendorProbeRecipe.extractVersion(
+            from: "v0.9.7-sequoia", pattern: #"v?([0-9]+(?:\.[0-9]+)+)"#) == "0.9.7")
+    }
+
+    /// The beta rule reads the list; the stable rule reads `/releases/latest`,
+    /// which GitHub computes with prereleases (every beta, every `-sequoia`)
+    /// excluded.
+    @Test func onlyTheBetaRuleReadsPrereleases() throws {
+        #expect(try Self.rule("com.tinycast.app", .stable).usePrereleases == false)
+        #expect(try Self.rule("com.tinycast.app.beta", .beta).usePrereleases == true)
+    }
+
+    // MARK: - Changelog
+
+    /// A cut-down page of the real `releases?per_page=40` response
+    /// (2026-10-14): the newest beta, the newest stable, a "Maintenance" beta,
+    /// and a `-sequoia` prerelease. Bodies are verbatim apart from the
+    /// What's Changed list being shortened.
+    private static let releasesFixture = #"""
+    [
+      {"tag_name": "v0.11.21-beta.120", "prerelease": true, "draft": false,
+       "published_at": "2026-10-13T22:08:37Z",
+       "body": "## What's Changed\n* Fix palette menu clicks and cropping; prefer synchronous code by @abue-ammar in #1475\n* Load bundled extension dependencies by @szupzj18 in #1489\n\n<!-- tinycast:install -->\n\n**Channel:** beta · **Version:** 0.11.21-beta.120 · **Bundle ID:** `com.tinycast.app.beta`\n\n**Recommended:** install via Homebrew:\n```sh\nbrew install --cask abue-ammar/tinycast/tinycast@beta\n```\nThis build is self-signed.\n"},
+      {"tag_name": "v0.11.19", "prerelease": false, "draft": false,
+       "published_at": "2026-10-10T15:14:51Z",
+       "body": "## What's Changed\n* Add local Dictation and expand keyboard shortcut capabilities by @Risengan in #1280\n* Close AI Chat with Escape by @abue-ammar in #1309\n\n## New Contributors\n* @barissglc made their first contribution in #1284\n\n<!-- tinycast:install -->\n\n**Channel:** stable · **Version:** 0.11.19 · **Bundle ID:** `com.tinycast.app`\n\n**Recommended:** install via Homebrew:\n```sh\nbrew install --cask abue-ammar/tinycast/tinycast\n```\nOn an **Intel** Mac, install `abue-ammar/tinycast/tinycast-universal` instead — same app, built with both slices.\nThis build is self-signed.\n"},
+      {"tag_name": "v0.10.14-beta.82", "prerelease": true, "draft": false,
+       "published_at": "2026-09-06T19:34:09Z",
+       "body": "Maintenance and internal changes.\n\n<!-- tinycast:install -->\n\n**Channel:** beta · **Version:** 0.10.14-beta.82 · **Bundle ID:** `com.tinycast.app.beta`\n"},
+      {"tag_name": "v0.9.7-sequoia", "prerelease": true, "draft": false,
+       "published_at": "2026-08-19T20:12:44Z",
+       "body": "**Channel:** stable · macOS 15 Sequoia\n**Version:** 0.9.7-sequoia\n\nThis is the **macOS 15 (Sequoia)** build.\n"}
+    ]
+    """#
+
+    private static func changelog(for bundleID: String, _ channel: ReleaseChannel) throws -> Changelog {
+        let recipe = try #require(ChangelogRecipeRegistry.recipe(forBundleID: bundleID, channel: channel))
+        #expect(recipe.bundleID == bundleID && recipe.channel == channel,
+                "\(bundleID) resolved to another app's or channel's recipe")
+        let format = try #require(recipe.structuredFormat)
+        return try #require(StructuredChangelogDecoder.decode(
+            releasesFixture, format: format, channel: recipe.channel,
+            maxEntries: recipe.maxEntries, skipSections: recipe.skipSections,
+            includesPromotedStable: recipe.includesPromotedStable, tagPattern: recipe.tagPattern))
+    }
+
+    /// Each app sees only its own track, and the `-sequoia` prerelease reaches
+    /// neither: without `tagPattern` the beta rail would list it as a beta.
+    @Test func eachRailListsOnlyItsOwnTags() throws {
+        #expect(try Self.changelog(for: "com.tinycast.app", .stable).entries.map(\.version)
+                == ["0.11.19"])
+        #expect(try Self.changelog(for: "com.tinycast.app.beta", .beta).entries.map(\.version)
+                == ["0.11.21-beta.120", "0.10.14-beta.82"])
+    }
+
+    /// The What's Changed bullets become the entry; New Contributors and the
+    /// install boilerplate under `<!-- tinycast:install -->` do not.
+    @Test func theInstallBoilerplateIsNotAChange() throws {
+        let entry = try #require(Self.changelog(for: "com.tinycast.app", .stable).entries.first)
+        #expect(entry.items.count == 2, "\(entry.items)")
+        #expect(entry.items.first?.hasPrefix("Add local Dictation") == true)
+        #expect(!entry.items.contains { $0.contains("Homebrew") || $0.contains("first contribution") })
+    }
+}
