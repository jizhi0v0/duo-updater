+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// Secretive (`com.maxgoedjen.Secretive.Host`, `maxgoedjen/secretive`) is read
+/// from GitHub Releases and installed from the single `Secretive.zip` asset.
+/// The tag shapes, the asset name and the changelog body are pinned here
+/// against the strings the vendor publishes.
+///
+/// See `docs/app-audits/com-maxgoedjen-Secretive-Host.md` for the measurements.
+@Suite struct SecretiveGitHubRuleTests {
+
+    private static var rule: GitHubReleaseRule {
+        get throws {
+            let found = GitHubReleaseRegistry.rules.filter { $0.bundleID == "com.maxgoedjen.Secretive.Host" }
+            try #require(found.count == 1, "expected exactly one Secretive rule, found \(found.count)")
+            return found[0]
+        }
+    }
+
+    /// Real tags (fetched 2026-10-14). The tag minus `v` is what `release.yml`
+    /// stamps into CFBundleShortVersionString.
+    @Test(arguments: [("v4.0.0", "4.0.0"), ("v3.0.4", "3.0.4"), ("v2.4.1", "2.4.1")])
+    func realTagsResolveToTheirVersion(tag: String, expected: String) throws {
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: try Self.rule.versionPattern)
+                == expected)
+    }
+
+    /// The vendor's own `SemVer` documents `1.2.3_beta1` for betas and
+    /// `0.0.0_nightly-<date>` for nightlies. Neither may read as a stable version.
+    @Test(arguments: ["v4.1.0_beta1", "v0.0.0_nightly-2026-10-13"])
+    func previewShapedTagsAreRejected(tag: String) throws {
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: try Self.rule.versionPattern)
+                == nil)
+    }
+
+    /// Every release since v0.1.1 ships exactly one asset, `Secretive.zip`.
+    @Test func installsTheZipAsset() throws {
+        let rule = try Self.rule
+        #expect(rule.installerKind == .zip)
+        let pattern = try #require(rule.installAssetPattern)
+        #expect("Secretive.zip".range(of: pattern, options: .regularExpression) != nil)
+        #expect("Secretive.zip.sha256".range(of: pattern, options: .regularExpression) == nil)
+    }
+
+    /// The release body parses into its Features/Fixes bullets; the OS floor,
+    /// build and attestation links and the contributor list do not become items.
+    /// v4.0.0 body, fetched 2026-10-14, trimmed to a few bullets per section.
+    @Test func releaseBodyBecomesStructuredChangelog() throws {
+        let changelog = try #require(GitHubMarkdownParser.parse(
+            body: Self.v400Body, version: "4.0.0", date: "2026-09-21T03:08:01Z"))
+        let entry = try #require(changelog.entries.first)
+        #expect(entry.version == "4.0.0")
+        // A lone trailing `(#NNN)` is stripped by the shared parser; a list of
+        // several refs is kept.
+        #expect(entry.items == [
+            "macOS 27 Support",
+            "OpenSSH protocol cleanup",
+            "SSH Certificate UI (#798, #802)",
+            "Fix macOS 27 UI issues (#814, #774)",
+            "Fix SSH ECDSA signature mpint encoding",
+        ])
+    }
+
+    private static let v400Body = """
+    Secretive 4 is here with big improvements in stacked requests, request usage attribution, first class SSH Certificate support, and support for macOS 27.
+
+    ## Features
+    - macOS 27 Support
+    - OpenSSH protocol cleanup (#775)
+    - SSH Certificate UI (#798, #802)
+
+    ## Fixes
+    - Fix macOS 27 UI issues (#814, #774)
+    - Fix SSH ECDSA signature mpint encoding (#772)
+
+    ## Minimum macOS Version
+    15.0.0
+
+    ## Build
+    https://github.com/maxgoedjen/secretive/actions/runs/35554366823
+
+    ## Attestation
+    https://github.com/maxgoedjen/secretive/attestations/48827601
+
+    ## New Contributors
+    * @jamieQ made their first contribution in https://github.com/maxgoedjen/secretive/pull/769
+
+    ## Full Changelog
+    https://github.com/maxgoedjen/secretive/compare/v3.0.4...v4.0.0
+    """
+}
