@@ -0,0 +1,78 @@
+import Foundation
+
+enum wang_jianing_app_OpenInTerminal {
+    static let set = AppRecipeSet(
+        family: "wang-jianing-app-OpenInTerminal",
+        githubRules: [
+        // History: docs/app-audits/wang-jianing-app-OpenInTerminal.md#历史与实测
+        // OpenInTerminal — ONE repo, THREE apps, two interleaved release trains,
+        // one GitHub Releases list. Main (`OpenInTerminal.zip`) is tag `v2.x`;
+        // Lite and Editor-Lite share a single release (`v1.x`, assets
+        // `OpenInTerminal-Lite.zip` + `OpenInEditor-Lite.zip`). No SUFeedURL, no
+        // Sparkle, no in-app updater; tag == CFBundleShortVersionString,
+        // CFBundleVersion is always 1. Single stable track (the only prerelease
+        // is 0.9.0, 2019). Casks answer brew-installed copies first.
+        //
+        // DETECTION ONLY, on every rule here, on purpose: the vendor moved Team
+        // Q33U8R4U57 -> C8VX3ZLX5U with 2.3.9 / 1.2.8 and the install gate has no
+        // transition allowlist, so one-click would download and then refuse every
+        // outdated copy. Add `installAssetPattern` (`^OpenInTerminal\.zip$`,
+        // `.zip`) only after a release past 2.3.9 / 1.2.8 signed by C8VX3ZLX5U has
+        // been installed end to end.
+        //
+        // Main reads `/releases/latest`: the vendor keeps main as Latest BY HAND
+        // (`gh release edit --latest`; the Lite release is published second and
+        // would otherwise win). The `2.` anchor means a slipped marker reads Lite
+        // as a health miss, never as a wrong version. The anchor is a known
+        // fragility: a main 3.x or a Lite 2.x needs the pattern revisited.
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.app.OpenInTerminal",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            versionPattern: #"^v(2\.[0-9]+\.[0-9]+)$"#),
+
+        // Pre-2.1.1 main id (last old id 2.0.5; era-A development-signed,
+        // unnotarized). Detection-only for good: the successor build has a
+        // different signed bundle id, so install gate 4 refuses it.
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.OpenInTerminal",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            versionPattern: #"^v(2\.[0-9]+\.[0-9]+)$"#),
+
+        // Lite and Editor-Lite — these CAN'T read `/releases/latest` (that is
+        // main), so they read the list and take the first `v1.x` tag, the
+        // Bitwarden shape. A page of 10 leaves margin over the gap between
+        // consecutive `v1.x` tags (History has the measurement);
+        // `probesNewestFirst: false` because the newest row is usually main. `usePrereleases: true` drops GitHub's
+        // stable-only filter, which is safe here: the one prerelease ever is
+        // 2019's 0.9.0, far off the page, and `$` rejects any suffixed tag.
+        // Two ids each: current (1.0.3+) and pre-1.0.3 (detection-only for good).
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.app.OpenInTerminal-Lite",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            usePrereleases: true,
+            listPageSize: 10,
+            versionPattern: #"^v(1\.[0-9]+\.[0-9]+)$"#,
+            probesNewestFirst: false),
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.app.OpenInEditor-Lite",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            usePrereleases: true,
+            listPageSize: 10,
+            versionPattern: #"^v(1\.[0-9]+\.[0-9]+)$"#,
+            probesNewestFirst: false),
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.OpenInTerminal-Lite",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            usePrereleases: true,
+            listPageSize: 10,
+            versionPattern: #"^v(1\.[0-9]+\.[0-9]+)$"#,
+            probesNewestFirst: false),
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.OpenInEditor-Lite",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            usePrereleases: true,
+            listPageSize: 10,
+            versionPattern: #"^v(1\.[0-9]+\.[0-9]+)$"#,
+            probesNewestFirst: false),
+        ])
+}
diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
index 69eb47c..5410ab2 100644
--- a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
@@ -404,7 +404,29 @@ public extension GitHubReleaseRule {
     /// decides a row is orphaned when no rule produces its key. A second,
     /// separately-maintained spelling of this string would make the prune delete
     /// live rows the first time the two drifted.
-    var recipeID: String { "github:\(slug):\(channel.rawValue)" }
+    ///
+    /// One repo can ship several apps on ONE channel (OpenInTerminal: the main app
+    /// and two Lite apps, each its own bundle id, all stable). Keyed by slug and
+    /// channel alone they would share a single row, so one rule's success would
+    /// mask another's miss in `RecipeHealth` and their `lastGoodVersion`s would
+    /// overwrite each other in the baseline. So a rule that has a registry sibling
+    /// with the same slug AND channel gets `:<bundleID>` appended. Every rule
+    /// without such a sibling keeps the bare key, so no existing baseline row is
+    /// orphaned.
+    ///
+    /// ⚠️ The suffix depends on the whole registry, not on the rule alone: the day
+    /// someone adds a second rule on a slug+channel that already has exactly one,
+    /// the existing rule's key silently gains the suffix, its baseline row is
+    /// pruned and its `lastGoodVersion` history restarts. That is deliberate (a
+    /// stable key per rule would need a new field) and is why
+    /// `RecipeHealthKeyTests` pins the ids as unique and the baseline keys as live.
+    var recipeID: String {
+        let base = "github:\(slug):\(channel.rawValue)"
+        let shared = GitHubReleaseRegistry.rules.contains {
+            $0.slug == slug && $0.channel == channel && $0.bundleID != bundleID
+        }
+        return shared ? "\(base):\(bundleID)" : base
+    }
 }
 
 /// Resolves updates for apps distributed through GitHub Releases. Kept separate
