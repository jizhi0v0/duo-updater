@@ -0,0 +1,136 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Cindy (`Recipes/com-xd-cindy.swift`): the global edition, `com.xd.cindy`. The
+/// tag and asset shapes are from the real release listing (measured 2026-10-14);
+/// the last test replays the newest stable release through the source.
+@Suite struct ComXdCindyGitHubRuleTests {
+
+    /// Every non-prerelease release on makecindy/cindy, newest first. `v1.0.0` is
+    /// the July release with no assets; it stays in because the pattern must not
+    /// pin the major version.
+    static let stableTags = [
+        "v0.1.104", "v0.1.103", "v0.1.101", "v0.1.97", "v0.1.95", "v0.1.94", "v0.1.93", "v0.1.92",
+        "v0.1.90", "v0.1.88", "v0.1.85", "v0.1.86", "v0.1.83", "v0.1.82", "v0.1.79", "v0.1.76",
+        "v0.1.73", "v0.1.72", "v0.1.71", "v0.1.69", "v0.1.66", "v0.1.64", "v0.1.61", "v0.1.58",
+        "v0.1.55", "v0.1.52", "v0.1.51", "v0.1.50", "v0.1.49", "v0.1.48", "v0.1.46", "v0.1.45",
+        "v0.1.44", "v0.1.43", "v0.1.38", "v0.1.37", "v0.1.36", "v0.1.35", "v0.1.33", "v0.1.31",
+        "v0.1.30", "v0.1.28", "v0.1.27", "v0.1.26", "v0.1.25", "v0.1.23", "v0.1.22", "v0.1.21",
+        "v0.1.20", "v0.1.18", "v0.1.17", "v1.0.0",
+    ]
+
+    /// Prereleases on the same repo. The stable rule must never read these.
+    static let betaTags = ["v0.1.106-beta", "v0.1.105-beta", "v0.1.96-beta", "v0.1.91-beta"]
+
+    /// The eight assets of v0.1.104: both editions as arm64 and x64, plus Windows
+    /// and Linux.
+    static let v0104Assets: [(name: String, url: URL, size: Int64?)] = [
+        "cindy-0.1.104-darwin-arm64-cn.dmg",
+        "cindy-0.1.104-darwin-arm64-global.dmg",
+        "cindy-0.1.104-darwin-x64-cn.dmg",
+        "cindy-0.1.104-darwin-x64-global.dmg",
+        "cindy-0.1.104-linux-x64-cn.deb",
+        "cindy-0.1.104-linux-x64-global.deb",
+        "cindy-0.1.104-win32-x64-cn.exe",
+        "cindy-0.1.104-win32-x64-global.exe",
+    ].enumerated().map { index, name in
+        (name, URL(string: "https://github.com/makecindy/cindy/releases/download/v0.1.104/\(name)")!, Int64(index) * 1000)
+    }
+
+    private static var rule: GitHubReleaseRule? {
+        GitHubReleaseRegistry.rules.first { $0.bundleID == "com.xd.cindy" }
+    }
+
+    @Test func ruleIsStableAndReadsOnlyTheGlobalArm64Dmg() throws {
+        let rule = try #require(Self.rule, "no GitHubReleaseRule for com.xd.cindy")
+        #expect(rule.owner == "makecindy" && rule.repo == "cindy")
+        #expect(rule.channel == .stable && !rule.usePrereleases)
+        #expect(rule.installerKind == .dmg)
+        let pattern = try #require(rule.installAssetPattern)
+        func matches(_ name: String) -> Bool {
+            name.range(of: pattern, options: .regularExpression) != nil
+        }
+
+        #expect(matches("cindy-0.1.104-darwin-arm64-global.dmg"))
+        #expect(matches("cindy-0.1.103-darwin-arm64-global.dmg"))
+        // The cn edition (its own bundle id), the x64 build, and the Windows and
+        // Linux builds.
+        #expect(!matches("cindy-0.1.104-darwin-arm64-cn.dmg"))
+        #expect(!matches("cindy-0.1.104-darwin-x64-global.dmg"))
+        #expect(!matches("cindy-0.1.104-win32-x64-global.exe"))
+        #expect(!matches("cindy-0.1.104-linux-x64-global.deb"))
+    }
+
+    @Test func versionPatternReadsEveryStableTagAndNoBetaTag() throws {
+        let rule = try #require(Self.rule)
+        func extract(_ tag: String) -> String? {
+            VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+        }
+
+        for tag in Self.stableTags {
+            #expect(extract(tag) == String(tag.dropFirst()), "\(tag)")
+        }
+        for tag in Self.betaTags {
+            #expect(extract(tag) == nil, "\(tag)")
+        }
+        // The major is not pinned: the next major still reads.
+        #expect(extract("v2.0.0") == "2.0.0")
+    }
+
+    @Test func thisHostPicksTheGlobalArm64Dmg() throws {
+        let rule = try #require(Self.rule)
+        let pattern = try #require(rule.installAssetPattern)
+        let pick = GitHubReleaseRule.installableAsset(
+            from: Self.v0104Assets, matching: pattern,
+            preferring: .arm64, allowingIntelTranslation: false)
+        #expect(pick?.url.lastPathComponent == "cindy-0.1.104-darwin-arm64-global.dmg")
+    }
+
+    // MARK: - The newest stable release, as `/releases/latest` answers it
+
+    final class StubLatest: URLProtocol, @unchecked Sendable {
+        static let body: String = {
+            let assets = ComXdCindyGitHubRuleTests.v0104Assets.map {
+                """
+                {"name":"\($0.name)","browser_download_url":"\($0.url.absoluteString)","size":1000}
+                """
+            }
+            return """
+            {"tag_name":"v0.1.104","name":"Desktop release 0.1.104","draft":false,\
+            "prerelease":false,"published_at":"2026-10-12T04:56:47Z",\
+            "html_url":"https://github.com/makecindy/cindy/releases/tag/v0.1.104",\
+            "body":"notes","assets":[\(assets.joined(separator: ","))]}
+            """
+        }()
+
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+        override func startLoading() {
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: 200, httpVersion: "HTTP/1.1",
+                headerFields: ["Content-Type": "application/json"])!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: Data(Self.body.utf8))
+            client?.urlProtocolDidFinishLoading(self)
+        }
+
+        override func stopLoading() {}
+    }
+
+    @Test func latestStableReleaseResolvesToTheGlobalDmg() async throws {
+        let rule = try #require(Self.rule)
+        let config = URLSessionConfiguration.ephemeral
+        config.protocolClasses = [StubLatest.self]
+        let source = GitHubReleasesSource(
+            rules: [rule], session: URLSession(configuration: config))
+        let outcome = await source.resolveDiagnostic(
+            rule, preferring: .arm64, allowingIntelTranslation: false)
+        #expect(outcome.failure == nil)
+        #expect(outcome.remote?.shortVersion == "0.1.104")
+        #expect(outcome.remote?.downloadURL?.lastPathComponent
+                == "cindy-0.1.104-darwin-arm64-global.dmg")
+    }
+}
