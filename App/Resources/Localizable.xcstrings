    },
    "The update is installed; Update All is waiting to relaunch apps until the batch finishes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update ist installiert; „Alle aktualisieren“ wartet mit dem Neustart der Apps, bis der Stapel abgeschlossen ist"
