          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有發布我們能讀取的更新記錄。"
          }
        }
      }
    },
    "%@ downloaded %@ on its own. Relaunch to apply it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat %@ selbstständig heruntergeladen. Zum Anwenden neu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ descargó %@ por su cuenta. Reabre para aplicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a téléchargé %@ tout seul. Relancez pour l'appliquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha scaricato %@ da sola. Riapri per applicarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が %@ を自動的にダウンロードしました。再起動して適用してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ baixou %@ por conta própria. Reabra para aplicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ самостоятельно загрузило %@. Перезапустите, чтобы применить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ sürümünü kendisi indirdi. Uygulamak için yeniden başlatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已自行下载 %@。重新启动以应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已自行下載 %@。重新開啟即可套用。"
          }
        }
      }
    },
    "%@ has already downloaded %@ and will apply it when you quit it — installing now would be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat %@ bereits heruntergeladen und installiert es beim Beenden – eine Installation jetzt würde überschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya descargó %@ y lo instalará cuando lo cierres: instalarlo ahora quedaría sobrescrito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a déjà téléchargé %@ et l’installera à sa fermeture — installer maintenant serait écrasé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha già scaricato %@ e lo applicherà quando la chiuderai: installarlo ora verrebbe annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに %@ をダウンロード済みで、終了時に適用します。今インストールしても上書きされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já baixou %@ e vai aplicá-la quando você o encerrar — instalar agora seria desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже загрузил %@ и установит его при выходе — установка сейчас будет перезаписана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ sürümünü zaten indirdi ve siz uygulamadan çıktığınızda uygulayacak — şimdi yüklerseniz bu geri alınır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已经下载好 %@，会在你退出它时安装 —— 现在装会被覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下載 %@，會在你結束它時套用——現在安裝會被它蓋掉。"
          }
        }
      }
    },
    "%@ has already downloaded %@ and will apply it the next time you open it — installing now would be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat %@ bereits heruntergeladen und installiert es beim nächsten Öffnen – eine Installation jetzt würde überschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya descargó %@ y lo instalará la próxima vez que lo abras: instalarlo ahora quedaría sobrescrito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a déjà téléchargé %@ et l’installera à sa prochaine ouverture — installer maintenant serait écrasé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha già scaricato %@ e lo applicherà alla prossima apertura: installarlo ora verrebbe annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに %@ をダウンロード済みで、次回起動時に適用します。今インストールしても上書きされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já baixou %@ e vai aplicá-la na próxima vez que você o abrir — instalar agora seria desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже загрузил %@ и установит его при следующем запуске — установка сейчас будет перезаписана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ sürümünü zaten indirdi ve uygulamayı bir sonraki açışınızda uygulayacak — şimdi yüklerseniz bu geri alınır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已经下载好 %@，会在你下次打开它时安装 —— 现在装会被覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下載 %@，會在你下次打開它時套用——現在安裝會被它蓋掉。"
          }
        }
      }
    },
    "%@ has an update.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ ist ein Update verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una actualización para %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise à jour est disponible pour %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile un aggiornamento per %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にアップデートがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem uma atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ доступно обновление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için bir güncelleme var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有可用更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有可用的更新。"
          }
        }
      }
    },
    "%@ has its own update (%@) downloaded and waiting for the app to quit. Relaunching from here would install that one over the version now on disk, so it wasn't relaunched — quit %@ yourself when you're ready to take theirs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat ein eigenes Update (%@) heruntergeladen und wartet darauf, dass die App beendet wird. Ein Neustart von hier aus würde dieses über die Version installieren, die jetzt auf der Festplatte liegt – deshalb wurde nicht neu gestartet. Beende %@ selbst, wenn du deren Update übernehmen möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya ha descargado su propia actualización (%@) y espera a que la app se cierre. Reabrir desde aquí instalaría esa por encima de la versión que hay ahora en el disco, así que no se reabrió: cierra %@ tú cuando quieras aceptar la suya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a téléchargé sa propre mise à jour (%@) et attend que l’app soit quittée. Relancer depuis ici installerait celle-ci par-dessus la version actuellement sur le disque, donc rien n’a été relancé — quitte %@ toi-même quand tu veux prendre la leur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha già scaricato un proprio aggiornamento (%@), in attesa che l’app venga chiusa. Riaprirla da qui installerebbe quello sopra la versione ora sul disco, quindi non è stata riaperta: chiudi tu %@ quando vuoi applicare il loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は自前の更新（%@）をダウンロード済みで、アプリの終了を待っています。ここから再起動すると、現在ディスクにあるバージョンの上にそれが上書きされるため、再起動はしていません。相手側の更新を適用したくなったら、%@ を自分で終了してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já baixou a própria atualização (%@) e está esperando o app ser encerrado. Reabrir daqui instalaria essa por cima da versão que está no disco agora, então ele não foi reaberto — encerre %@ você mesmo quando quiser ficar com a deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже скачало собственное обновление (%@) и ждёт, когда приложение будет закрыто. Перезапуск отсюда установил бы его поверх версии, которая сейчас на диске, поэтому перезапуск не выполнен — закройте %@ сами, когда захотите принять их обновление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kendi güncellemesini (%@) indirdi ve uygulamanın kapanmasını bekliyor. Buradan yeniden başlatmak o güncellemeyi diskteki sürümün üzerine yükleyecekti; bu yüzden yeniden başlatılmadı — onların sürümüne geçmeye hazır olduğunuzda %@ uygulamasından kendiniz çıkın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已经下载好它自己的更新（%@），正等着这个 app 退出。从这里重新启动会把那份更新覆盖到当前磁盘上的版本，所以没有重新启动 —— 想用它们那份的时候，请自己退出 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下載它自己的更新（%@），正在等這個 App 結束。從這裡重新開啟會讓那份更新蓋過目前磁碟上的版本，所以沒有重新開啟——想改用它那一份時，請自行結束 %@。"
          }
        }
      }
    },
    "%@ is already downloaded — opens it in macOS's installer (asks for admin). Nothing is downloaded again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde bereits heruntergeladen – öffnet es im macOS-Installationsprogramm (erfordert Administratorrechte). Es wird nichts erneut heruntergeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está descargada; se abre en el instalador de macOS (pide permisos de administrador). No se descarga de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà téléchargée — l'ouvre dans l'installateur macOS (demande les droits admin). Rien n'est téléchargé à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già stato scaricato: si apre nel programma di installazione di macOS (richiede i privilegi di amministratore). Non viene scaricato nulla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでにダウンロード済みです — macOSのインストーラーで開きます（管理者権限が必要）。再度ダウンロードされることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já foi baixado — abre no instalador do macOS (pede senha de administrador). Nada é baixado de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже загружено — открывает его в установщике macOS (потребуются права администратора). Повторная загрузка не выполняется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zaten indirildi — macOS yükleyicisinde açılır (yönetici izni ister). Hiçbir şey yeniden indirilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下载 — 会在 macOS 安装程序中打开它（需要管理员权限）。不会再次下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下載 — 會在 macOS 的安裝程式中打開（需要管理者權限）。不會重新下載。"
          }
        }
      }
    },
    "%@ is an iPhone/iPad app running on Apple Silicon. Its latest version%@ no longer supports Mac, so the App Store won't install it on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist eine iPhone/iPad-App, die auf Apple Silicon läuft. Ihre neueste Version%@ unterstützt Mac nicht mehr, daher installiert der App Store sie nicht auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es una app de iPhone/iPad que se ejecuta en Apple Silicon. Su última versión%@ ya no admite Mac, por lo que la App Store no la instalará en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est une application iPhone/iPad exécutée sur Apple Silicon. Sa dernière version%@ ne prend plus en charge le Mac, donc l'App Store ne l'installera pas sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è un’app per iPhone/iPad in esecuzione su Apple silicon. La sua versione più recente%@ non supporta più il Mac, quindi l’App Store non la installerà su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はApple SiliconのMacで動作しているiPhone/iPad用アプリです。その最新バージョン%@ はMacをサポートしなくなったため、App Storeはこのデバイスにインストールしません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é um app de iPhone/iPad executado em Apple Silicon. A versão mais recente%@ não é mais compatível com Mac, então a App Store não vai instalá-la neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — приложение для iPhone/iPad, запущенное на Apple Silicon. Его последняя версия%@ больше не поддерживает Mac, поэтому App Store не установит его на это устройство."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, Apple Silicon üzerinde çalışan bir iPhone/iPad uygulaması. En son sürümü%@ artık Mac’i desteklemiyor, bu yüzden App Store onu bu aygıta yüklemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是运行在 Apple 芯片上的 iPhone/iPad 应用。其最新版本%@ 已不再支持 Mac，因此 App Store 不会在此设备上安装它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是在 Apple 晶片上執行的 iPhone/iPad App。它的最新版本%@ 已不再支援 Mac，因此 App Store 不會在這台裝置上安裝它。"
          }
        }
      }
    },
    "%@ is downloaded — Install re-opens it in macOS’s installer, nothing is downloaded again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits geladen – „Installieren“ öffnet nur wieder das Installationsprogramm von macOS, es wird nichts erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está descargado: «Instalar» vuelve a abrir el instalador de macOS, no se descarga nada de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà téléchargé — « Installer » rouvre simplement le programme d’installation de macOS, rien n’est retéléchargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato scaricato: Installa lo riapre nel programma di installazione di macOS, non viene scaricato nulla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はダウンロード済みです —「インストール」は macOS のインストーラを開き直すだけで、再ダウンロードはしません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já foi baixado — Instalar reabre no instalador do macOS; nada é baixado de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже загружено — «Установить» лишь снова откроет установщик macOS, повторной загрузки не будет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ indirildi — Yükle onu macOS yükleyicisinde yeniden açar, hiçbir şey yeniden indirilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下载完成 —「安装」只是重新打开 macOS 安装器，不会再下载一遍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下載 — 「安裝」會在 macOS 的安裝程式中重新打開它，不會重新下載。"
          }
        }
      }
    },
    "%@ is downloading this update itself — left it to finish rather than fetching the same bytes twice.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lädt dieses Update selbst herunter – wir lassen es zu Ende laufen, statt dieselben Daten ein zweites Mal zu holen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está descargando esta actualización por su cuenta: la dejamos terminar en vez de descargar los mismos datos dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ télécharge lui-même cette mise à jour — nous le laissons terminer plutôt que de récupérer deux fois les mêmes données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sta scaricando questo aggiornamento da sola: l’abbiamo lasciata finire invece di scaricare due volte gli stessi dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が自身でこの更新をダウンロード中です。同じデータを二重に取得せず、完了を待ちます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está baixando esta atualização sozinho — deixamos terminar em vez de baixar os mesmos dados duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже загружает это обновление сам — не стали качать те же данные во второй раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu güncellemeyi kendisi indiriyor — aynı baytları iki kez indirmek yerine bitirmesi beklendi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在自己下载此次更新 —— 交给它完成，避免重复下载同一份数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在自行下載這次更新 — 交給它完成，免得同一份資料下載兩次。"
          }
        }
      }
    },
    "%@ is running — brought it to the front so its own updater applies the update. Quit it (or switch to “Always replace” in Settings) to install directly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft gerade – es wurde in den Vordergrund geholt, damit sein eigener Updater das Update einspielt. Beende es (oder stelle in den Einstellungen auf „Immer ersetzen“ um), um direkt zu installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está en ejecución: se ha traído al frente para que su propio actualizador aplique la actualización. Ciérrala (o cambia a «Reemplazar siempre» en Ajustes) para instalar directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en cours d’exécution — l’app a été mise au premier plan pour que son propre programme de mise à jour applique la mise à jour. Quitte-la (ou passe sur « Toujours remplacer » dans les réglages) pour installer directement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è in esecuzione: l’abbiamo portata in primo piano affinché il suo programma di aggiornamento applichi l’aggiornamento. Chiudila (o scegli “Sostituisci sempre” in Impostazioni) per installare direttamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は実行中です。アプリ自身のアップデータが更新を適用できるよう、前面に出しました。直接置き換えてインストールするには、アプリを終了するか、設定で「常に置き換える」に切り替えてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está em execução — foi trazido para a frente para que o atualizador dele aplique a atualização. Encerre-o (ou escolha “Sempre substituir” nos Ajustes) para instalar diretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запущено — приложение выведено на передний план, чтобы его собственный апдейтер установил обновление. Закройте его (или переключитесь на «Всегда заменять» в настройках), чтобы установить напрямую."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ çalışıyor — güncellemeyi kendi güncelleyicisi uygulasın diye öne getirildi. Doğrudan yüklemek için uygulamadan çıkın (veya Ayarlar’da “Her zaman değiştir” seçeneğine geçin)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在运行 —— 已把它切到前台，让它自带的更新器来安装。想直接替换安装，请退出它（或在设置里改为「始终替换」）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在執行 — 已將它移到最前面，讓它自己的更新程式套用更新。結束它（或在「設定」中改為「一律替換」）即可直接安裝。"
          }
        }
      }
    },
    "%@ is running — open it and let its own updater apply %@. Quit it, or pick “Always replace” in Settings, to install directly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft – öffnen und das integrierte Update-Tool %@ anwenden lassen. Zum direkten Installieren die App beenden oder in den Einstellungen „Immer ersetzen“ wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se está ejecutando; ábrela para que su propio actualizador aplique %@. Ciérrala, o elige «Reemplazar siempre» en Ajustes, para instalar directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en cours d'exécution — ouvrez-la pour laisser son propre outil appliquer %@. Quittez-la, ou choisissez « Toujours remplacer » dans les Réglages, pour installer directement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è in esecuzione: aprila e lascia che il suo programma di aggiornamento applichi %@. Chiudila, o scegli “Sostituisci sempre” in Impostazioni, per installare direttamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は実行中です — 開いて、独自の更新機能で %@ を適用してください。終了するか、設定で「常に置き換える」を選ぶと直接インストールできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está em execução — abra-o e deixe o atualizador dele aplicar %@. Encerre-o, ou escolha “Sempre substituir” nos Ajustes, para instalar diretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запущено — откройте его, чтобы его собственный обновитель применил %@. Закройте его или выберите «Всегда заменять» в настройках, чтобы установить напрямую."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ çalışıyor — açın ve %@ sürümünü kendi güncelleyicisi uygulasın. Doğrudan yüklemek için uygulamadan çıkın veya Ayarlar’da “Her zaman değiştir” seçeneğini belirleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在运行 — 打开它，让它自己的更新程序应用 %@。退出它，或在设置中选择“始终替换”，即可直接安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在執行 — 打開它，讓它自己的更新程式套用 %@。結束它，或在「設定」中選擇「一律替換」，即可直接安裝。"
          }
        }
      }
    },
