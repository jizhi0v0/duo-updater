+
+    private static func headings(_ entry: Changelog.Entry) -> [String] {
+        entry.content.compactMap { block -> String? in
+            if case .heading(let h) = block { return h }
+            return nil
+        }
+    }
+
+    @Test func theNoticeIsTheIntroThenOneHeadingPerTopic() throws {
+        let changelog = try #require(StructuredChangelogDecoder.decodeCindyUpdateNotice(
+            Self.notice, preferredLanguages: ["en-US"]))
+        let entry = try #require(changelog.entries.first)
+        #expect(changelog.entries.count == 1)
+        #expect(entry.version == "0.1.104")
+        #expect(entry.date == "2026-10-12")
+        #expect(Self.headings(entry) == [
+            "🗂️ Provider Groups Phase 2: Same-Account Direct and Sharing Relay",
+            "🖥️ Run Orca Workers on Another Computer",
+        ])
+        #expect(entry.items.count == 3)
+        #expect(entry.items.first?.hasPrefix("This update includes 172") == true)
+        guard case .note(let first) = entry.content.first else {
+            Issue.record("the intro should come first, before any heading"); return
+        }
+        #expect(first == entry.items[0])
+    }
+
+    /// `Bundle.preferredLocalizations` measured on macOS 27.2, mirroring the app's
+    /// own fallback (`en`, then `zh-CN`) for a reader it has no notes for.
+    @Test(arguments: [
+        (["zh-Hans-CN"], "🗂️ 供应商组第二期：同账号直连与分享中转"),
+        (["ja-JP"], "🗂️ プロバイダーグループ第 2 期：同一アカウントの直接接続と共有の中継"),
+        (["fr-FR", "zh-Hans-CN"], "🗂️ 供应商组第二期：同账号直连与分享中转"),
+        (["fr-FR"], "🗂️ Provider Groups Phase 2: Same-Account Direct and Sharing Relay"),
+        ([String](), "🗂️ Provider Groups Phase 2: Same-Account Direct and Sharing Relay"),
+    ])
+    func theReadersLanguageIsPicked(preferred: [String], firstHeading: String) throws {
+        let entry = try #require(StructuredChangelogDecoder.decodeCindyUpdateNotice(
+            Self.notice, preferredLanguages: preferred)?.entries.first)
+        #expect(Self.headings(entry).first == firstHeading)
+    }
+
+    @Test func withoutLocalesTheRootIsRead() throws {
+        var object = try #require(
+            JSONSerialization.jsonObject(with: Data(Self.notice.utf8)) as? [String: Any])
+        object["contentByLocale"] = nil
+        let body = String(decoding: try JSONSerialization.data(withJSONObject: object), as: UTF8.self)
+        let entry = try #require(StructuredChangelogDecoder.decodeCindyUpdateNotice(
+            body, preferredLanguages: ["en-US"])?.entries.first)
+        #expect(Self.headings(entry).first == "🗂️ 供应商组第二期：同账号直连与分享中转")
+    }
+
+    @Test func aNoticeWithNothingToShowIsNotRead() {
+        let blank = #"{"version":"0.1.104","topics":[{"title":"Only a title","text":"  "}]}"#
+        #expect(StructuredChangelogDecoder.decodeCindyUpdateNotice(blank, preferredLanguages: []) == nil)
+        let versionless = #"{"version":"latest","topics":[{"title":"A","text":"B"}]}"#
+        #expect(StructuredChangelogDecoder.decodeCindyUpdateNotice(versionless, preferredLanguages: []) == nil)
+        let index = #"["0.1.103","0.1.104"]"#
+        #expect(StructuredChangelogDecoder.decode(
+            index, format: .cindyUpdateNotice, channel: nil, maxEntries: 1) == nil)
+    }
+}
