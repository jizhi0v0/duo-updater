+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SpotifastCoverageTests.swift
@@ -0,0 +1,73 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Spotifast renamed its bundle id between 0.9.1 and 0.10.0. The family carries one
+/// GitHub rule, for the new id: a second rule on the same repo and channel would share
+/// its `recipeID` (and so its health entry and verify baseline). These tests pin that
+/// rule, the anchor that keeps release candidates out, and the rename table row. See
+/// `docs/app-audits/rocks-spotifast-Spotifast.md`.
+@Suite struct SpotifastCoverageTests {
+
+    private static let newID = "rocks.spotifast.Spotifast"
+    private static let oldID = "me.paolino.fastpotify"
+
+    private func rule() throws -> GitHubReleaseRule {
+        let found = GitHubReleaseRegistry.rules.filter { $0.bundleID == Self.newID }
+        try #require(found.count == 1, "expected exactly one rule for \(Self.newID)")
+        return try #require(found.first)
+    }
+
+    @Test func theRuleReadsTheVendorsRepoOnTheStableTrack() throws {
+        let rule = try rule()
+        #expect(rule.owner == "crmne" && rule.repo == "spotifast")
+        #expect(rule.channel == .stable)
+        #expect(rule.usePrereleases == false)
+    }
+
+    /// The anchor refuses `-rcN` tags, so an rc published without the prerelease
+    /// flag can't read as a plain `X.Y.Z`.
+    @Test func theTagPatternTakesReleasesAndRefusesCandidates() throws {
+        let pattern = try rule().versionPattern
+        #expect(VendorProbeRecipe.extractVersion(from: "v0.13.0", pattern: pattern) == "0.13.0")
+        #expect(VendorProbeRecipe.extractVersion(from: "v0.5.0-rc2", pattern: pattern) == nil)
+        #expect(VendorProbeRecipe.extractVersion(from: "v0.4.0-rc1", pattern: pattern) == nil)
+    }
+
+    @Test func theInstallPatternTakesTheMacDmgOnly() throws {
+        let rule = try rule()
+        let asset = try #require(rule.installAssetPattern)
+        #expect(rule.installerKind == .dmg)
+        #expect(Self.matches(asset, "spotifast-v0.13.0-macos-universal.dmg"))
+        // The `fastpotify-…` twin older releases attach, and the non-mac assets.
+        #expect(!Self.matches(asset, "fastpotify-v0.9.1-macos-universal.dmg"))
+        #expect(!Self.matches(asset, "spotifast-v0.13.0-source.tar.gz"))
+        #expect(!Self.matches(asset, "spotifast-v0.13.0-x86_64.flatpak"))
+    }
+
+    /// The old id has no rule: a second rule on this repo and channel would share
+    /// `recipeID` with the first. Delete this test when the source looks rules up by
+    /// `recipeBundleID` (see the audit), and run the old-id install first.
+    @Test func theOldIdHasNoGitHubRule() {
+        #expect(!GitHubReleaseRegistry.rules.contains { $0.bundleID == Self.oldID })
+    }
+
+    @Test func anOldIdCopyIsFiledUnderTheNewIdBelowTheBound() {
+        for version in ["0.9.1", "0.5.0-rc2", "0.1.0"] {
+            #expect(BundleIDMigration.recipeBundleID(for: Self.oldID, installedVersion: version) == Self.newID)
+        }
+        #expect(BundleIDMigration.recipeBundleID(for: Self.oldID, installedVersion: "0.10.0") == Self.oldID)
+        #expect(BundleIDMigration.recipeBundleID(for: Self.oldID, installedVersion: nil) == Self.oldID)
+    }
+
+    @Test func theChangelogRecipeIsKeyedByTheNewIdOnly() {
+        let ids = ChangelogRecipeRegistry.recipes.map(\.bundleID)
+        #expect(ids.contains(Self.newID))
+        #expect(!ids.contains(Self.oldID))
+    }
+
+    private static func matches(_ pattern: String, _ name: String) -> Bool {
+        name.range(of: pattern, options: .regularExpression) != nil
+    }
+}
