          "stringUnit": {
            "state": "translated",
            "value": "Собственная версия DuoUpdater."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DuoUpdater’ın kendi sürümü."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DuoUpdater 自身的版本。"
          }
        },
