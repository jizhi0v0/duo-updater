+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/WhatCableGitHubRulesTests.swift
@@ -0,0 +1,272 @@
+import Foundation
+import Testing
+@testable import DuoUpdaterCore
+
+/// WhatCable: Stable and Beta share `uk.whatcable.whatcable`, the app name and the
+/// asset name (`WhatCable.zip`); the only local channel signal is the beta's
+/// marketing version, which is its tag verbatim (`1.5.0-beta.10`). Pre-0.6.0
+/// copies carry the old id `com.bitmoor.whatcable`.
+///
+/// Tags and bundle facts are real (Releases API and mounted zips, 2026-10-14).
+@Suite(.serialized)
+struct WhatCableGitHubRulesTests {
+    private static let slug = "darrylmorley/whatcable"
+    private static var rules: [GitHubReleaseRule] {
+        GitHubReleaseRegistry.rules.filter { $0.slug == slug }
+    }
+
+    private func rule(_ bundleID: String, _ channel: ReleaseChannel) throws -> GitHubReleaseRule {
+        try #require(Self.rules.first { $0.bundleID == bundleID && $0.channel == channel })
+    }
+
+    // MARK: - Patterns
+
+    /// Every rule for this repo, stable or beta, current id or old: each real
+    /// stable tag reads as itself, and nothing reads an rc the vendor forgot to
+    /// flag, a CLI-only tag, or a two-part tag as a different version.
+    @Test func everyRuleReadsEveryStableTagShape() throws {
+        #expect(Self.rules.count == 3)
+        let stableTags = ["v1.5.0", "v1.4.0", "v1.2.1", "v1.0.0", "v0.99.3", "v0.10.13",
+                          "v0.5.14", "v0.2.0", "v2.0.0", "v1.6", "v10.0.0"]
+        for rule in Self.rules {
+            for tag in stableTags {
+                #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+                        == String(tag.dropFirst()), "\(rule.bundleID) [\(rule.channel)] on \(tag)")
+            }
+            for tag in ["v1.6.0-rc.1", "v1.6.0-alpha.1", "cli-v1.5.0", "1.5.0x", "v1.5.0-beta"] {
+                #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+                        == nil, "\(rule.bundleID) [\(rule.channel)] read \(tag)")
+            }
+        }
+    }
+
+    @Test func onlyTheBetaRuleReadsBetaTags() throws {
+        for rule in Self.rules {
+            let read = VendorProbeRecipe.extractVersion(
+                from: "v1.5.0-beta.10", pattern: rule.versionPattern)
+            #expect(read == (rule.channel == .beta ? "1.5.0-beta.10" : nil),
+                    "\(rule.bundleID) [\(rule.channel)]")
+        }
+        let beta = try rule("uk.whatcable.whatcable", .beta)
+        #expect(beta.usePrereleases)
+        #expect(beta.candidateScope == .newest)
+        #expect(try rule("uk.whatcable.whatcable", .stable).usePrereleases == false)
+    }
+
+    @Test func oneClickPinsTheAppZipNotTheCLIZip() throws {
+        for channel in [ReleaseChannel.stable, .beta] {
+            let r = try rule("uk.whatcable.whatcable", channel)
+            let pattern = try #require(r.installAssetPattern)
+            #expect("WhatCable.zip".range(of: pattern, options: .regularExpression) != nil)
+            #expect("whatcable-cli-1.5.0.zip".range(of: pattern, options: .regularExpression) == nil)
+            #expect("whatcable-cli-1.5.0-beta.10.zip".range(of: pattern, options: .regularExpression) == nil)
+            #expect(r.installerKind == .zip)
+        }
+        // The old id can never pass the install gate's bundle-id check.
+        let legacy = try rule("com.bitmoor.whatcable", .stable)
+        #expect(legacy.installAssetPattern == nil)
+        #expect(legacy.installerKind == nil)
+    }
+
+    /// The version comparisons the beta rule's whole argument rests on.
+    @Test func versionOrderingMatchesTheVendors() {
+        #expect(VersionComparator.isNewer("1.5.0", than: "1.5.0-beta.10"))
+        #expect(VersionComparator.isNewer("1.5.0-beta.10", than: "1.5.0-beta.9"))
+        #expect(VersionComparator.isNewer("1.6.0-beta.1", than: "1.5.0"))
+        #expect(VersionComparator.isNewer("1.5.0-beta.1", than: "1.4.0"))
+    }
+
+    /// The opening of the real v1.5.0 release body, verbatim: a title, a prose
+    /// lead-in, then `##` sections of top-level bullets. The lead-in must not
+    /// become an item, and the bullets must, or the row falls back to a web view.
+    @Test func theRealReleaseBodyParsesIntoItems() throws {
+        let body = """
+        # Devices in the right box, displays read from macOS, and live charging
+
+        A big one. Ten betas went into this, and most of what changed started with a tester's report. Credits inline.
+
+        ## Connected devices
+
+        - **Devices on a Thunderbolt chain show under a dock or display only when the hardware proves they are inside it.** Before, a device could look as if it sat in the first box in the chain just because nothing said otherwise. Anything unproven now appears under "Other USB devices on this port", and a dock's own hubs nest where they belong.
+        - **Thunderbolt 5 daisy chains are sorted.** On a Mac to display to dock chain, a drive in the dock used to render under the display. WhatCable now works out which box each hub belongs to from the fabric's own routing data, and leaves the tree alone if the answer does not check out.
+        - **Devices behind TB3-era docks and displays are attributed to a port again.** LG UltraFine 5K, CalDigit TS3+ and others of that generation bring their own USB controller, and everything behind them used to vanish as soon as two Thunderbolt things were connected.
+        """
+        let changelog = try #require(
+            GitHubMarkdownParser.parse(body: body, version: "1.5.0", date: "2026-10-13T18:56:00Z"))
+        let items = try #require(changelog.entries.first?.items)
+        #expect(items.count == 3)
+        #expect(items.first?.contains("Devices on a Thunderbolt chain") == true)
+        #expect(!items.contains { $0.contains("Ten betas went into this") })
+        #expect(changelog.itemSyntax == .markdown)
+    }
+
+    // MARK: - Channel detection on the real plist values
+
+    @Test func theInstalledVersionNamesTheChannel() {
+        func detect(_ version: String) -> ReleaseChannel {
+            ReleaseChannel.detect(
+                name: "WhatCable", bundleID: "uk.whatcable.whatcable",
+                keystoneChannel: nil, version: version, bundleFileName: "WhatCable.app")
+        }
+        #expect(detect("1.5.0-beta.10") == .beta)
+        #expect(detect("1.5.0") == .stable)
+        #expect(detect("0.99.0") == .stable)
+    }
+
+    // MARK: - Channel proof
+
+    @Test func theBetaProofHoldsAndFailsOnTheStableSibling() throws {
+        let beta = try rule("uk.whatcable.whatcable", .beta)
+        let stableArtifact = RemoteVersion(
+            shortVersion: "1.5.0", version: nil,
+            downloadURL: URL(string:
+                "https://github.com/darrylmorley/whatcable/releases/download/v1.5.0/WhatCable.zip"),
+            sourceName: "GitHub")
+        #expect(RecipeSanity.crossChannelArtifact(rule: beta, remote: stableArtifact) == nil)
+
+        // The same anchor over the stable sibling's pattern must complain, or it
+        // could never fail.
+        let tightened = GitHubReleaseRule(
+            bundleID: beta.bundleID, owner: beta.owner, repo: beta.repo,
+            usePrereleases: true, listPageSize: beta.listPageSize,
+            versionPattern: try rule("uk.whatcable.whatcable", .stable).versionPattern,
+            installAssetPattern: beta.installAssetPattern, installerKind: beta.installerKind,
+            channel: .beta)
+        #expect(RecipeSanity.crossChannelArtifact(rule: tightened, remote: stableArtifact) != nil)
+        // And so must a beta-only pattern, which strands testers at graduation.
+        let betaOnly = GitHubReleaseRule(
+            bundleID: beta.bundleID, owner: beta.owner, repo: beta.repo,
+            usePrereleases: true, listPageSize: beta.listPageSize,
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+-beta\.[0-9]+)$"#,
+            installAssetPattern: beta.installAssetPattern, installerKind: beta.installerKind,
+            channel: .beta)
+        #expect(RecipeSanity.crossChannelArtifact(rule: betaOnly, remote: stableArtifact) != nil)
+    }
+
+    // MARK: - Through the real source
+
+    private final class FixtureProtocol: URLProtocol, @unchecked Sendable {
+        /// Newest first, as GitHub lists them. `newestIsBeta` puts an unreleased
+        /// 1.6.0-beta.1 on top, the state the repo is in between graduations.
+        nonisolated(unsafe) static var newestIsBeta = false
+
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+        override func startLoading() {
+            let url = request.url!
+            var list: [(String, Bool)] = [
+                ("v1.5.0", false), ("v1.5.0-beta.10", true), ("v1.5.0-beta.9", true),
+                ("v1.4.0", false), ("v1.4.0-beta.2", true),
+            ]
+            if Self.newestIsBeta { list.insert(("v1.6.0-beta.1", true), at: 0) }
+            let status: Int
+            let body: String
+            switch url.path {
+            case "/repos/darrylmorley/whatcable/releases/latest":
+                status = 200
+                body = Self.release(tag: "v1.5.0", prerelease: false)
+            case "/repos/darrylmorley/whatcable/releases":
+                let perPage = URLComponents(url: url, resolvingAgainstBaseURL: false)?
+                    .queryItems?.first { $0.name == "per_page" }?.value.flatMap(Int.init)
+                    ?? list.count
+                status = 200
+                body = "[" + list.prefix(perPage)
+                    .map { Self.release(tag: $0.0, prerelease: $0.1) }
+                    .joined(separator: ",") + "]"
+            default:
+                status = 404
+                body = #"{"message":"Not Found"}"#
+            }
+            let response = HTTPURLResponse(
+                url: url, statusCode: status, httpVersion: "HTTP/1.1", headerFields: nil)!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: Data(body.utf8))
+            client?.urlProtocolDidFinishLoading(self)
+        }
+
+        override func stopLoading() {}
+
+        private static func release(tag: String, prerelease: Bool) -> String {
+            let v = tag.dropFirst()
+            return """
+            {
+              "tag_name":"\(tag)",
+              "prerelease":\(prerelease),
+              "draft":false,
+              "published_at":"2026-10-13T18:56:00Z",
+              "html_url":"https://github.com/darrylmorley/whatcable/releases/tag/\(tag)",
+              "body":"## Connected devices\\n\\n- Notes for \(v)",
+              "assets":[
+                {"name":"whatcable-cli-\(v).zip",
+                 "browser_download_url":"https://github.com/darrylmorley/whatcable/releases/download/\(tag)/whatcable-cli-\(v).zip",
+                 "size":8559849},
+                {"name":"WhatCable.zip",
+                 "browser_download_url":"https://github.com/darrylmorley/whatcable/releases/download/\(tag)/WhatCable.zip",
+                 "size":22571575}
+              ]
+            }
+            """
+        }
+    }
+
+    private func source() -> GitHubReleasesSource {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.protocolClasses = [FixtureProtocol.self]
+        return GitHubReleasesSource(
+            rules: Self.rules, session: URLSession(configuration: configuration))
+    }
+
+    private func app(
+        _ version: String, bundleID: String = "uk.whatcable.whatcable"
+    ) -> InstalledApp {
+        InstalledApp(
+            name: "WhatCable", bundleID: bundleID,
+            shortVersion: version, buildVersion: nil,
+            path: URL(fileURLWithPath: "/Applications/WhatCable.app"),
+            isMASApp: false, isToolboxManaged: false, sparkleFeedURL: nil,
+            releaseChannel: ReleaseChannel.detect(
+                name: "WhatCable", bundleID: bundleID, keystoneChannel: nil, version: version))
+    }
+
+    @Test func aStableCopyIsOfferedStableWithOneClick() async throws {
+        FixtureProtocol.newestIsBeta = true
+        let remote = try #require(try await source().latestVersion(for: app("1.4.0")))
+        #expect(remote.displayVersion == "1.5.0")
+        #expect(remote.releaseChannel == .stable)
+        #expect(remote.requiresManualInstaller == false)
+        #expect(remote.vendorInstallerKind == .zip)
+        #expect(remote.downloadURL?.absoluteString
+                == "https://github.com/darrylmorley/whatcable/releases/download/v1.5.0/WhatCable.zip")
+        let items = try #require(remote.structuredChangelog?.entries.first?.items)
+        #expect(items == ["Notes for 1.5.0"])
+    }
+
+    /// The case a beta-only rule gets wrong: the tester's line graduated.
+    @Test func aBetaCopyWhoseLineGraduatedIsOfferedTheStable() async throws {
+        FixtureProtocol.newestIsBeta = false
+        let remote = try #require(try await source().latestVersion(for: app("1.5.0-beta.10")))
+        #expect(remote.displayVersion == "1.5.0")
+        #expect(remote.releaseChannel == .beta)
+        #expect(remote.requiresManualInstaller == false)
+        #expect(remote.downloadURL?.absoluteString
+                == "https://github.com/darrylmorley/whatcable/releases/download/v1.5.0/WhatCable.zip")
+    }
+
+    @Test func aBetaCopyIsOfferedTheNextBeta() async throws {
+        FixtureProtocol.newestIsBeta = true
+        let remote = try #require(try await source().latestVersion(for: app("1.5.0-beta.9")))
+        #expect(remote.displayVersion == "1.6.0-beta.1")
+        #expect(remote.downloadURL?.absoluteString
+                == "https://github.com/darrylmorley/whatcable/releases/download/v1.6.0-beta.1/WhatCable.zip")
+    }
+
+    @Test func aPreRenameCopyIsDetectedButNotOneClick() async throws {
+        FixtureProtocol.newestIsBeta = true
+        let remote = try #require(try await source().latestVersion(
+            for: app("0.5.14", bundleID: "com.bitmoor.whatcable")))
+        #expect(remote.displayVersion == "1.5.0")
+        #expect(remote.requiresManualInstaller == true)
+        #expect(remote.vendorInstallerKind == nil)
+    }
+}
