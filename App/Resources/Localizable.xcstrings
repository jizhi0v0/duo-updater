    "Couldn’t back up the current version — this update will be applied without a rollback point.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Version konnte nicht gesichert werden – dieses Update wird ohne Rücksetzpunkt eingespielt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo hacer una copia de seguridad de la versión actual: esta actualización se aplicará sin punto de reversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sauvegarder la version actuelle — cette mise à jour sera appliquée sans point de restauration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバージョンをバックアップできませんでした。この更新はロールバック先なしで適用されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сделать резервную копию текущей версии — обновление будет установлено без точки отката."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
