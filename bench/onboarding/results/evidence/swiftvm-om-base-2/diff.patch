diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift
new file mode 100644
index 0000000..ef860e6
--- /dev/null
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/SwiftVMChannel.swift
@@ -0,0 +1,42 @@
+import Foundation
+
+/// SwiftVM (`com.swiftvm.app`) — a Sparkle app whose beta builds carry their own
+/// feed, every item of which is tagged `<sparkle:channel>beta</sparkle:channel>`.
+///
+/// The contract, settled from source (`swiftvm-app/swiftvm`, `main`, 2026-10-14):
+/// `.github/workflows/release-beta.yml` builds a beta with the version
+/// `<BETA_VERSION>-beta.<commit count>` and bakes `SUFeedURL` =
+/// `releases/download/beta-channel/appcast-beta.xml`, whose items
+/// `scripts/generate-appcast.sh` tags `beta` (`CHANNEL: beta`). A release build
+/// bakes `releases/latest/download/appcast.xml`, untagged. The app's own
+/// `SPUUpdaterDelegate.allowedChannels` returns `["beta"]` when its version
+/// contains `-beta.`, otherwise nothing extra. There is no preference: the build
+/// decides, and a beta build only ever sees betas.
+///
+/// Why a binding is needed at all: `ReleaseChannel.detect` does call a
+/// `1.4.0-beta.37` build `.beta` from its version, but that is not authoritative,
+/// so `SparkleAppcastSource.allowedChannels` infers the tag from the installed
+/// build's own feed item. A beta the feed does not list (the vendor keeps a
+/// `republish-beta-appcast.yml` workflow for exactly that) is then put on the
+/// default channel, which the beta feed has no item for: the row reads unknown.
+///
+/// Keyed on the bundle's own `SUFeedURL` rather than on the version because that
+/// is what the resolver is handed; the same workflow stamps both. The tag is
+/// derived (`ReleaseChannel.beta.rawValue`), as the feed spells it, so no
+/// `sparkleChannelNames` are declared and no `bindingProofs` entry is owed.
+///
+/// Not in `boundBundleIDs`, same as CodeEdit: nothing a user sets changes the answer.
+enum SwiftVMChannel {
+    static let bundleID = "com.swiftvm.app"
+
+    /// The feed a beta build names as its own `SUFeedURL`.
+    static let betaFeed = URL(string: "https://github.com/swiftvm-app/swiftvm/releases/download/beta-channel/appcast-beta.xml")!
+    /// The feed a release build names as its own `SUFeedURL`.
+    static let stableFeed = URL(string: "https://github.com/swiftvm-app/swiftvm/releases/latest/download/appcast.xml")!
+
+    /// `.beta` for a build that reads the beta feed; nil otherwise, which leaves
+    /// a release build on the untagged items of its own feed.
+    static func resolve(bundleFeeds: [String: URL]) -> ResolvedChannel? {
+        bundleFeeds["SUFeedURL"] == betaFeed ? ResolvedChannel(channel: .beta) : nil
+    }
+}
