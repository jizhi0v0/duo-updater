+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift
@@ -0,0 +1,134 @@
+import Foundation
+import Testing
+@testable import DuoUpdaterCore
+
+/// OpenInTerminal (`wang.jianing.app.OpenInTerminal`) shares `Ji4n1ng/OpenInTerminal`
+/// with OpenInTerminal-Lite and OpenInEditor-Lite. Both trains use bare `vX.Y.Z`
+/// tags (the full app is v2.x, the Lite pair v1.x) and are cut minutes apart, so
+/// `/releases/latest` can land on a Lite release. The tag pattern cannot tell
+/// them apart; the asset name is what does. These tests pin that against the
+/// names and notes the vendor really published.
+///
+/// See `docs/app-audits/wang-jianing-app-OpenInTerminal.md` for the measurements.
+@Suite(.serialized)
+struct OpenInTerminalGitHubRuleTests {
+    private static var rule: GitHubReleaseRule {
+        get throws {
+            let found = GitHubReleaseRegistry.rules.filter {
+                $0.bundleID == "wang.jianing.app.OpenInTerminal"
+            }
+            try #require(found.count == 1, "expected exactly one OpenInTerminal rule")
+            return found[0]
+        }
+    }
+
+    /// The real v2.3.9 release body, verbatim.
+    static let v239Body = """
+        Changes:
+
+        - Security: Fixed an AppleScript/command injection vulnerability that allowed arbitrary command execution via a crafted folder name when opening it in a non-default terminal or an editor. Thanks to Paul Gerste ([Sonar](https://www.sonarsource.com)) for the responsible disclosure.
+        - Added support for Zed, Emacs, Kakoune, GitKraken, and cmux.
+        - Added an option to limit global keyboard shortcuts to Finder-only shortcuts. (#251, #243)
+        - Introduced a new default app icon with automatic light/dark mode support.
+        - Added an option to display the Finder context menu items in a submenu.
+        - Fixed the Finder extension icon being rendered as a template icon.
+        - Improved startup responsiveness by fetching installed applications on a background thread.
+        - Fixed the keyboard shortcut overlapping the "Open in ..." title in the status bar menu.
+        """
+
+    /// Every asset name the repo has published under this app's or the Lite
+    /// apps' releases (v2.3.1…v2.3.9, v1.2.3…v1.2.8).
+    @Test func theInstallPatternTakesOnlyTheFullApp() throws {
+        let pattern = try #require(try Self.rule.installAssetPattern)
+        let matches = { (name: String) in
+            name.range(of: pattern, options: .regularExpression) != nil
+        }
+        #expect(matches("OpenInTerminal.zip"))       // v2.3.7 onward
+        #expect(matches("OpenInTerminal.app.zip"))   // up to v2.3.6
+        #expect(!matches("OpenInTerminal-Lite.zip"))
+        #expect(!matches("OpenInTerminal-Lite.app.zip"))
+        #expect(!matches("OpenInEditor-Lite.zip"))
+        #expect(!matches("OpenInEditor-Lite.app.zip"))
+        #expect(!matches("Icons.zip"))
+    }
+
+    /// `/releases/latest` answering with the Lite release: the source must fall
+    /// back to the list and walk to the full app's tag rather than report 1.2.8.
+    @Test func aLiteReleaseOnTopIsSkippedForTheFullAppsRelease() async throws {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.protocolClasses = [FixtureProtocol.self]
+        let source = GitHubReleasesSource(
+            rules: [try Self.rule], session: URLSession(configuration: configuration))
+        let installed = InstalledApp(
+            name: "OpenInTerminal", bundleID: "wang.jianing.app.OpenInTerminal",
+            shortVersion: "2.3.8", buildVersion: "1",
+            path: URL(fileURLWithPath: "/Applications/OpenInTerminal.app"),
+            isMASApp: false, isToolboxManaged: false, sparkleFeedURL: nil)
+
+        let remote = try #require(try await source.latestVersion(for: installed))
+
+        #expect(remote.displayVersion == "2.3.9")
+        #expect(remote.vendorInstallerKind == .zip)
+        #expect(remote.requiresManualInstaller == false)
+        #expect(remote.downloadURL?.absoluteString
+                == "https://github.com/Ji4n1ng/OpenInTerminal/releases/download/v2.3.9/OpenInTerminal.zip")
+        let items = try #require(remote.structuredChangelog?.entries.first?.items)
+        #expect(items.count == 8)
+        #expect(items.first?.hasPrefix("Security: Fixed an AppleScript/command injection") == true)
+    }
+
+    private final class FixtureProtocol: URLProtocol, @unchecked Sendable {
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+        override func startLoading() {
+            let lite = Self.release(
+                tag: "v1.2.8", assets: ["OpenInEditor-Lite.zip", "OpenInTerminal-Lite.zip"],
+                body: "Changes:\n\n- Lite-only change")
+            let full = Self.release(
+                tag: "v2.3.9", assets: ["OpenInTerminal.zip"],
+                body: OpenInTerminalGitHubRuleTests.v239Body)
+            let status: Int
+            let body: String
+            switch request.url?.path ?? "" {
+            case "/repos/Ji4n1ng/OpenInTerminal/releases/latest":
+                status = 200
+                body = lite
+            case "/repos/Ji4n1ng/OpenInTerminal/releases":
+                status = 200
+                body = "[\(lite),\(full)]"
+            default:
+                status = 404
+                body = #"{"message":"Not Found"}"#
+            }
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: status,
+                httpVersion: "HTTP/1.1", headerFields: nil)!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: Data(body.utf8))
+            client?.urlProtocolDidFinishLoading(self)
+        }
+
+        override func stopLoading() {}
+
+        private static func release(tag: String, assets: [String], body: String) -> String {
+            let escapedBody = body
+                .replacingOccurrences(of: "\\", with: "\\\\")
+                .replacingOccurrences(of: "\"", with: "\\\"")
+                .replacingOccurrences(of: "\n", with: "\\n")
+            let assetJSON = assets.map { name in
+                """
+                {"name":"\(name)",\
+                "browser_download_url":"https://github.com/Ji4n1ng/OpenInTerminal/releases/download/\(tag)/\(name)",\
+                "size":24842104}
+                """
+            }.joined(separator: ",")
+            return """
+            {"tag_name":"\(tag)","prerelease":false,"draft":false,\
+            "published_at":"2026-07-13T12:08:34Z",\
+            "html_url":"https://github.com/Ji4n1ng/OpenInTerminal/releases/tag/\(tag)",\
+            "body":"\(escapedBody)","assets":[\(assetJSON)]}
+            """
+        }
+    }
+}
