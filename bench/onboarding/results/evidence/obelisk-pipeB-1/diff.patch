+import Foundation
+
+enum com_obelisk_app {
+    static let set = AppRecipeSet(
+        family: "com-obelisk-app",
+        changelogs: [
+        // The appcast's `<description>` is Markdown without sparkle:format="markdown"
+        // and each appcast carries only its own release. The GitHub release bodies
+        // hold the same notes with ##/### headings for every release. 0.2.0–0.2.2
+        // carry a `## Downloads` bullet list of asset filenames (0.2.2 lists a zip
+        // it never published), which the parser would show as change items with the
+        // heading dropped; the other install headings hold only code and prose and
+        // yield no items (2026-10-14).
+        ChangelogRecipe(
+            bundleID: "com.obelisk.app",
+            source: URL(string: "https://api.github.com/repos/tommy0103/obelisk/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["Downloads"]),
+        ],
+        githubRules: [
+        // Obelisk — Electron app, one bundle id (`com.obelisk.app`) in every shipped
+        // build. 0.1.0–0.2.2 ship no SUFeedURL and are ad-hoc linker-signed (no Team
+        // ID, no sealed resources). Sparkle arrived in 0.2.4, whose bundles declare
+        // releases/latest/download/appcast-<arch>.xml and are answered by
+        // `SparkleAppcastSource` first, so this rule only decides for the older
+        // copies (MacDown 3000 is the same shape). Tags are `v0.2.2`; short == tag
+        // minus `v`; the pattern refuses a future `-rc.N` prerelease tag. Detection
+        // only: the older copies have no Team ID to match, and ad-hoc → Developer ID
+        // is refused by the digest-only route too. 0.2.4+ is Developer ID
+        // 433DLLA855, notarized.
+        GitHubReleaseRule(
+            bundleID: "com.obelisk.app",
+            owner: "tommy0103", repo: "obelisk",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+        ])
+}
