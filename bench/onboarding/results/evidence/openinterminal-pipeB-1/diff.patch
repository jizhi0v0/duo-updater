+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/GitHubMarkdownParserTests.swift
@@ -521,3 +521,22 @@ import Testing
     #expect(entry?.items.count == 3)
     #expect(entry?.items.first == "A fenced bullet the strict pass has always read as an item")
 }
+
+// MARK: - OpenInTerminal (Ji4n1ng/OpenInTerminal)
+
+/// The vendor writes `Changes:` plus a flat `- ` list, with CRLF endings in the
+/// older releases (v2.3.8, 2025-01-07, kept verbatim) and LF in the newer ones
+/// (v2.3.9, 2026-07-13). Both must come back as one item per bullet, with the
+/// greeting and the `Changes:` line left out — the recipe has no changelog page
+/// of its own, so this body is the whole changelog.
+@Test func openInTerminalReleaseBodiesParseOneItemPerBullet() throws {
+    let crlf = "Happy New Year! 🎉\r\n\r\nChanges:\r\n\r\n- Support \"open in neovim\" for Alacritty, WezTerm, and kitty users.\r\n- Customize open command for kitty users.\r\n- Copy path with escaping.\r\n- Support fork, notepad--, Ghostty.\r\n- Support nix installed applications."
+    let old = try #require(GitHubMarkdownParser.parse(body: crlf, version: "2.3.8", date: nil)?.entries.first)
+    #expect(old.items.count == 5)
+    #expect(old.items.first == "Support \"open in neovim\" for Alacritty, WezTerm, and kitty users.")
+
+    let lf = "Changes:\n\n- Security: Fixed an AppleScript/command injection vulnerability that allowed arbitrary command execution via a crafted folder name when opening it in a non-default terminal or an editor. Thanks to Paul Gerste ([Sonar](https://www.sonarsource.com)) for the responsible disclosure.\n- Added support for Zed, Emacs, Kakoune, GitKraken, and cmux.\n- Added an option to limit global keyboard shortcuts to Finder-only shortcuts. (#251, #243)\n- Introduced a new default app icon with automatic light/dark mode support.\n- Added an option to display the Finder context menu items in a submenu.\n- Fixed the Finder extension icon being rendered as a template icon.\n- Improved startup responsiveness by fetching installed applications on a background thread.\n- Fixed the keyboard shortcut overlapping the \"Open in ...\" title in the status bar menu.\n"
+    let new = try #require(GitHubMarkdownParser.parse(body: lf, version: "2.3.9", date: "2026-07-13T12:08:34Z")?.entries.first)
+    #expect(new.items.count == 8)
+    #expect(new.items[1] == "Added support for Zed, Emacs, Kakoune, GitKraken, and cmux.")
+}
