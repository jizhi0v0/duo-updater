    "CotEditor: DuoUpdater reads its update channel. Without it, CotEditor is checked against its stable releases even if you chose prereleases.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CotEditor: DuoUpdater liest den Update-Kanal. Ohne den Zugriff wird CotEditor mit seinen stabilen Versionen verglichen, auch wenn du Vorabversionen gewählt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CotEditor: DuoUpdater lee su canal de actualización. Sin él, CotEditor se compara con sus versiones estables aunque hayas elegido versiones preliminares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CotEditor : DuoUpdater lit son canal de mise à jour. Sans cet accès, CotEditor est comparé à ses versions stables même si vous avez choisi les préversions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CotEditor: DuoUpdater legge il suo canale di aggiornamento. Senza questo accesso, CotEditor viene controllato rispetto alle release stabili anche se hai scelto le pre-release."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CotEditor：アップデートチャンネルを読み取ります。許可しない場合、プレリリースを選んでいても CotEditor は安定版と比較されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "CotEditor: o DuoUpdater lê o canal de atualização dele. Sem isso, o CotEditor é comparado com as versões estáveis mesmo que você tenha escolhido as pré-versões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CotEditor: DuoUpdater читает его канал обновлений. Без доступа CotEditor сравнивается со стабильными версиями, даже если вы выбрали предварительные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CotEditor: DuoUpdater güncelleme kanalını okur. Bu olmadan CotEditor, ön sürümleri seçmiş olsanız bile kararlı sürümlerine göre denetlenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CotEditor：DuoUpdater 会读取它的更新渠道。不授权时，即使你选择了预发布版本，CotEditor 也会按正式版检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CotEditor：DuoUpdater 會讀取它的更新通道。沒有此權限時，即使你選擇了預先發行版，CotEditor 仍會以正式版檢查。"
          }
        }
      }
    },
