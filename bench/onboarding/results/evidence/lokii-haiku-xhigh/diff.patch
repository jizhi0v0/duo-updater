+import Foundation
+
+enum com_lokii_app {
+    static let set = AppRecipeSet(
+        family: "com-lokii-app",
+        githubRules: [
+        // Lokii — native macOS file search (Rust + AppKit), huangy7/lokii, MIT.
+        // No SUFeedURL and no app-update.yml, so `/releases/latest` is the only
+        // source. Its own AppUpdater polls the same endpoint and only opens the
+        // dmg in a browser; it never stages or swaps a bundle. Tags v0.1.0,
+        // v0.1.1; one dmg per arch. short == tag, and CFBundleVersion is 1 on
+        // every build, so the marketing string is the one compared.
+        //
+        // Detection-only: both dmgs' apps are ad-hoc signed (`TeamIdentifier` not
+        // set, `spctl` rejects, no stapled ticket). The Team-ID gate refuses them,
+        // and the ad-hoc digest route is not taken here (see
+        // `Recipes/org-alacritty.swift`).
+        //
+        // No ChangelogRecipe: every release body is the same line ("See the
+        // assets to download this version and install."), so nothing to structure.
+        GitHubReleaseRule(
+            bundleID: "com.lokii.app",
+            owner: "huangy7", repo: "lokii",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+        ])
+}
