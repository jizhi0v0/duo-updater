@@ -0,0 +1,74 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// `SwiftVMChannel`: a beta build (its `SUFeedURL` is the beta appcast) resolves
+/// `.beta`; a stable build resolves nil and stays on the untagged items.
+@Suite struct SwiftVMChannelTests {
+    /// The first two items of `appcast-beta.xml` as read on 2026-10-14, minus the
+    /// signatures and notes links (no bearing on selection). Every item is tagged.
+    private static let betaFeed = #"""
+    <?xml version="1.0" encoding="utf-8"?>
+    <rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
+      <channel>
+        <item>
+          <title>Version 1.4.0-beta.37</title>
+          <sparkle:channel>beta</sparkle:channel>
+          <sparkle:version>37</sparkle:version>
+          <sparkle:shortVersionString>1.4.0-beta.37</sparkle:shortVersionString>
+          <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
+          <enclosure url="https://github.com/swiftvm-app/swiftvm/releases/download/v1.4.0-beta.37/SwiftVM-1.4.0-beta.37.dmg" length="6096786" type="application/octet-stream" sparkle:edSignature="x"/>
+        </item>
+        <item>
+          <title>Version 1.4.0-beta.35</title>
+          <sparkle:channel>beta</sparkle:channel>
+          <sparkle:version>35</sparkle:version>
+          <sparkle:shortVersionString>1.4.0-beta.35</sparkle:shortVersionString>
+          <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
+          <enclosure url="https://github.com/swiftvm-app/swiftvm/releases/download/v1.4.0-beta.35/SwiftVM-1.4.0-beta.35.dmg" length="6005437" type="application/octet-stream" sparkle:edSignature="x"/>
+        </item>
+      </channel>
+    </rss>
+    """#
+
+    private static let stableFeed = URL(
+        string: "https://github.com/swiftvm-app/swiftvm/releases/latest/download/appcast.xml")!
+
+    /// A beta copy the feed no longer lists (build 33 is not in the fixture).
+    private func offered(bound: ResolvedChannel?) -> String? {
+        let app = InstalledApp(
+            name: "SwiftVM", bundleID: SwiftVMChannel.bundleID,
+            shortVersion: "1.4.0-beta.33", buildVersion: "33",
+            path: URL(fileURLWithPath: "/Applications/ZZFixture-SwiftVM.app"),
+            isMASApp: false,
+            sparkleFeedURL: SwiftVMChannel.betaFeed,
+            sparkleChannelNames: bound?.sparkleChannelNames ?? [],
+            sparkleEdPublicKey: "key",
+            releaseChannel: bound?.channel ?? .beta,
+            channelIsAuthoritative: bound != nil)
+        return SparkleAppcastSource.bestItem(
+            for: app, from: SparkleAppcastParser.parse(Data(Self.betaFeed.utf8)),
+            osVersion: "27.0", hostArch: .arm64, allowingIntelTranslation: true
+        )?.shortVersionString
+    }
+
+    /// Mutation that turns this red: dropping SwiftVM's resolution.
+    @Test func aBetaCopyAbsentFromTheFeedIsStillOfferedTheNewestBeta() {
+        let bound = SwiftVMChannel.resolve(bundleFeeds: ["SUFeedURL": SwiftVMChannel.betaFeed])
+        #expect(bound == ResolvedChannel(channel: .beta))
+        #expect(offered(bound: bound) == "1.4.0-beta.37")
+        // What the binding exists for: inference alone finds no item to read the
+        // channel from and offers nothing.
+        #expect(offered(bound: nil) == nil)
+    }
+
+    @Test func aStableBuildIsLeftToTheDefaultChannel() {
+        #expect(SwiftVMChannel.resolve(bundleFeeds: ["SUFeedURL": Self.stableFeed]) == nil)
+        #expect(SwiftVMChannel.resolve(bundleFeeds: [:]) == nil)
+    }
+
+    @Test func swiftVMHasAResolverButNoPreferenceToWatch() {
+        #expect(ChannelBinding.hasResolver(bundleID: SwiftVMChannel.bundleID))
+        #expect(!ChannelBinding.boundBundleIDs.contains(SwiftVMChannel.bundleID.lowercased()))
+    }
+}
