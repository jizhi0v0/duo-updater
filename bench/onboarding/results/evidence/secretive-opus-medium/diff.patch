@@ -0,0 +1,25 @@
+import Foundation
+
+enum com_maxgoedjen_Secretive_Host {
+    static let set = AppRecipeSet(
+        family: "com-maxgoedjen-Secretive-Host",
+        githubRules: [
+        // Secretive — Secure Enclave SSH agent. No SUFeedURL; its own updater
+        // (an XPC service) GETs api.github.com/repos/maxgoedjen/secretive/releases
+        // and takes the newest non-prerelease, so the repo's Releases are the
+        // source. `release.yml` stamps the tag minus `v` into
+        // CFBundleShortVersionString (CFBundleVersion is `1.<run id>`). Nightlies
+        // (`0.0.0_nightly-<date>`) are Actions artifacts only, never a Release;
+        // the anchored pattern also keeps a `_beta` tag off this stable rule.
+        // One universal `Secretive.zip` per release. Team Z72PRUAWF6, notarized
+        // (not stapled). Per-release OS floor is in the body ("Minimum macOS
+        // Version"), which this rule cannot read; the installer's
+        // LSMinimumSystemVersion gate is what stops a too-new build.
+        GitHubReleaseRule(
+            bundleID: "com.maxgoedjen.Secretive.Host",
+            owner: "maxgoedjen", repo: "secretive",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^Secretive\.zip$"#,
+            installerKind: .zip),
+        ])
+}
