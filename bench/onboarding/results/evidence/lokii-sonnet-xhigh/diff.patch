@@ -0,0 +1,28 @@
+import Foundation
+
+enum com_lokii_app {
+    static let set = AppRecipeSet(
+        family: "com-lokii-app",
+        githubRules: [
+        // Shared rationale for Detection-only: Recipes/org-alacritty.swift.
+
+        // Lokii — file search, Rust core under an AppKit shell (huangy7/lokii).
+        // No Sparkle and no electron-builder config; the app's own updater
+        // (`AppUpdater.swift`) asks `/releases/latest` and opens the dmg's
+        // download page, it installs nothing. Tags are `v0.1.2`, matching
+        // CFBundleShortVersionString (the release workflow refuses a tag that
+        // differs from `lokii-core/Cargo.toml`); every release is stable and the
+        // anchored pattern keeps an rc tag from being read as its final.
+        //
+        // Detection-only: both per-architecture dmgs (`Lokii-arm64.dmg`,
+        // `Lokii-x86_64.dmg`) are ad-hoc signed with no Team ID and not
+        // notarized (0.1.1 and 0.1.2, measured), so the Team-ID gate in
+        // `VendorInstaller` would refuse the swap. They do meet the conditions of
+        // `InstallTrust.publishedDigestOnly`, which is an opt-in route; see the
+        // audit before setting it.
+        GitHubReleaseRule(
+            bundleID: "com.lokii.app",
+            owner: "huangy7", repo: "lokii",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/LokiiGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/LokiiGitHubRuleTests.swift
new file mode 100644
index 0000000..d0246e8
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/LokiiGitHubRuleTests.swift
@@ -0,0 +1,144 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Lokii (`Recipes/com-lokii-app.swift`), from the real release listing of
+/// huangy7/lokii read 2026-10-14: v0.1.0, v0.1.1 and v0.1.2, none a prerelease,
+/// each with `Lokii-arm64.dmg` and `Lokii-x86_64.dmg`.
+@Suite struct LokiiGitHubRuleTests {
+
+    private static let bundleID = "com.lokii.app"
+
+    private static var rule: GitHubReleaseRule? {
+        GitHubReleaseRegistry.rules.first { $0.bundleID == bundleID }
+    }
+
+    @Test func ruleReadsTheBareTagOfTheStableTrack() throws {
+        let rule = try #require(Self.rule, "no GitHubReleaseRule for \(Self.bundleID)")
+        #expect(rule.owner == "huangy7" && rule.repo == "lokii")
+        #expect(rule.channel == .stable && !rule.usePrereleases)
+        func extract(_ tag: String) -> String? {
+            VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+        }
+        #expect(extract("v0.1.2") == "0.1.2")
+        #expect(extract("v0.1.0") == "0.1.0")
+        // A release candidate is not its final: the anchor refuses what the
+        // default pattern would read as 0.2.0.
+        #expect(extract("v0.2.0-rc.1") == nil)
+        #expect(extract("0.1.2") == nil)
+    }
+
+    /// Both dmgs are ad-hoc signed with no Team ID and not notarized (0.1.1 and
+    /// 0.1.2, both architectures), which the Team-ID gate refuses. Opting into
+    /// `.publishedDigestOnly` is a decision for the audit, not a default, so the
+    /// rule must not carry an install spec until someone makes it.
+    @Test func ruleIsDetectionOnly() throws {
+        let rule = try #require(Self.rule)
+        #expect(rule.installAssetPattern == nil)
+        #expect(rule.installerKind == nil)
+        #expect(rule.installTrust == .developerID)
+    }
+
+    // MARK: - A listing through the source
+
+    /// Stubs the releases API with `listing`, newest first as `(tag, assetNames)`,
+    /// every row `prerelease: false`. The body is the placeholder sentence the
+    /// real releases carry.
+    class StubReleases: URLProtocol, @unchecked Sendable {
+        class var listing: [(String, [String])] { [] }
+
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+        override func startLoading() {
+            let url = request.url?.absoluteString ?? ""
+            let all = Self.listing
+            if url.contains("/releases/latest") {
+                respond(Data("{\(Self.fields(all[0]))}".utf8))
+                return
+            }
+            let perPage = URLComponents(string: url)?.queryItems?
+                .first { $0.name == "per_page" }?.value.flatMap(Int.init) ?? all.count
+            let page = all.prefix(perPage).map { "{\(Self.fields($0))}" }
+            respond(Data("[\(page.joined(separator: ","))]".utf8))
+        }
+
+        private static func fields(_ release: (String, [String])) -> String {
+            let assets = release.1.map {
+                """
+                {"name":"\($0)","browser_download_url":\
+                "https://github.com/huangy7/lokii/releases/download/\(release.0)/\($0)",\
+                "size":5000000}
+                """
+            }
+            return """
+            "tag_name":"\(release.0)","name":"Lokii \(release.0)","draft":false,\
+            "prerelease":false,"published_at":"2026-10-13T14:54:57Z",\
+            "html_url":"https://github.com/huangy7/lokii/releases/tag/\(release.0)",\
+            "body":"See the assets to download this version and install.",\
+            "assets":[\(assets.joined(separator: ","))]
+            """
+        }
+
+        private func respond(_ data: Data) {
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: 200, httpVersion: "HTTP/1.1",
+                headerFields: ["Content-Type": "application/json"])!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: data)
+            client?.urlProtocolDidFinishLoading(self)
+        }
+
+        override func stopLoading() {}
+    }
+
+    private static let dmgs = ["Lokii-arm64.dmg", "Lokii-x86_64.dmg"]
+
+    /// The real listing's shape.
+    final class StubRealListing: StubReleases, @unchecked Sendable {
+        override class var listing: [(String, [String])] {
+            [("v0.1.2", LokiiGitHubRuleTests.dmgs), ("v0.1.1", LokiiGitHubRuleTests.dmgs),
+             ("v0.1.0", LokiiGitHubRuleTests.dmgs)]
+        }
+    }
+
+    /// The real listing with a release candidate published un-flagged ahead of it.
+    final class StubUnflaggedCandidate: StubReleases, @unchecked Sendable {
+        override class var listing: [(String, [String])] {
+            [("v0.2.0-rc.1", LokiiGitHubRuleTests.dmgs), ("v0.1.2", LokiiGitHubRuleTests.dmgs)]
+        }
+    }
+
+    private func outcome(_ stub: StubReleases.Type) async throws -> ProbeOutcome {
+        let rule = try #require(Self.rule)
+        let config = URLSessionConfiguration.ephemeral
+        config.protocolClasses = [stub]
+        let source = GitHubReleasesSource(
+            rules: [rule], session: URLSession(configuration: config))
+        return await source.resolveDiagnostic(
+            rule, preferring: .arm64, allowingIntelTranslation: false)
+    }
+
+    /// Detection-only: the row names the version and links the releases page; it
+    /// carries no installer, whichever architecture the Mac is.
+    @Test func theNewestReleaseIsOfferedAsAManualInstall() async throws {
+        let outcome = try await outcome(StubRealListing.self)
+        #expect(outcome.failure == nil)
+        #expect(outcome.remote?.shortVersion == "0.1.2")
+        #expect(outcome.remote?.requiresManualInstaller == true)
+        #expect(outcome.remote?.vendorInstallerKind == nil)
+        #expect(outcome.remote?.downloadURL?.absoluteString
+                == "https://github.com/huangy7/lokii/releases")
+    }
+
+    /// With no asset pattern the source has no reason to read past a refused
+    /// `/releases/latest`, so an un-flagged rc yields no answer at all. What the
+    /// anchor guarantees is the other half: it is never offered as its final.
+    /// Mutation (run): with the default `versionPattern` this test and the tag
+    /// test above both fail, the candidate being offered.
+    @Test func anUnflaggedReleaseCandidateIsNeverOfferedAsItsFinal() async throws {
+        let outcome = try await outcome(StubUnflaggedCandidate.self)
+        #expect(outcome.remote == nil)
+    }
+}
