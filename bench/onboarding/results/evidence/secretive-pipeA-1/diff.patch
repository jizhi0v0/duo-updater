+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-maxgoedjen-Secretive-Host.swift
@@ -0,0 +1,32 @@
+import Foundation
+
+enum com_maxgoedjen_Secretive_Host {
+    static let set = AppRecipeSet(
+        family: "com-maxgoedjen-Secretive-Host",
+        githubRules: [
+        // Shared rationale for Detection-only: Recipes/org-alacritty.swift.
+
+        // Secretive — Secure Enclave SSH agent. No Sparkle, no SUFeedURL; its own
+        // updater (the `SecretiveUpdater` XPC service) reads the repo's releases
+        // list, so `/releases/latest` is the same list everyone can download by
+        // hand. `release.yml` stamps CFBundleShortVersionString with the tag minus
+        // its `v` (tag `v4.0.0` ↔ `4.0.0`) and CFBundleVersion with `1.<run id>`,
+        // so the default comparison is right. One `Secretive.zip` per release.
+        //
+        // Detection-only: the signed bundle was not unpacked, so its Team ID and
+        // notarization are unchecked, and Secretive's keys are scoped to the
+        // signing team — a build from another team would orphan them. Also,
+        // each release states its own macOS floor (v4.0.0: 15.0, v3.0.4: 14.0)
+        // and the vendor's updater skips releases above the running macOS;
+        // `GitHubReleaseRule` has no way to read that floor, so a Mac below it
+        // is offered the newest release anyway. Detection-only keeps that from
+        // becoming a download the installer then refuses. The nightly and one-off
+        // CI builds share this bundle id and carry `0.0.0_nightly-<date>` as
+        // their version; they are Actions artifacts, not releases, and read as
+        // stable here. See docs/app-audits/com-maxgoedjen-Secretive-Host.md.
+        GitHubReleaseRule(
+            bundleID: "com.maxgoedjen.Secretive.Host",
+            owner: "maxgoedjen", repo: "secretive",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#),
+        ])
+}
