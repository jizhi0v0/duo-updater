          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde busca Duo Updater las apps instaladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où Duo Updater recherche les applications installées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
