+import Foundation
+
+enum com_swiftvm_app {
+    static let set = AppRecipeSet(
+        family: "com-swiftvm-app",
+        changelogs: [
+        // SwiftVM (`com.swiftvm.app`, Team NYSXATY4AA) — an open-source VM app,
+        // detected through the Sparkle feed its own bundle declares: a stable
+        // build names `releases/latest/download/appcast.xml`, a beta build the
+        // rolling `beta-channel/appcast-beta.xml` (see `SwiftVMChannel`). Neither
+        // feed inlines notes: each item carries only
+        // `<sparkle:fullReleaseNotesLink>` to its release page, so without these
+        // recipes the pane read "none" (checked 2026-10-14 on 1.2.0, 1.3.0,
+        // 1.4.0-beta.35 and -beta.37).
+        //
+        // The notes are the GitHub release bodies, generated by the vendor's
+        // release workflows (`generate-notes` → `scripts/clean-changelog.sh`) as a
+        // `## What's Changed` list. Two channel-keyed recipes over one page keep
+        // the trains apart, the same pair UTM and Yaak use.
+        ChangelogRecipe(
+            bundleID: "com.swiftvm.app",
+            source: URL(string: "https://api.github.com/repos/swiftvm-app/swiftvm/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .stable,
+            structuredFormat: .gitHubReleases),
+
+        // The beta side reads prereleases only, and `includesPromotedStable` stays
+        // false: a beta copy's own updater reads the beta appcast, which lists
+        // betas alone, so it is never offered a stable release. `tagPattern` keeps
+        // the `beta-channel` prerelease out — it holds the rolling appcast, and
+        // its body ("Rolling Sparkle appcast for the beta channel…") is not notes.
+        ChangelogRecipe(
+            bundleID: "com.swiftvm.app",
+            source: URL(string: "https://api.github.com/repos/swiftvm-app/swiftvm/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .beta,
+            structuredFormat: .gitHubReleases,
+            tagPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+-beta\.[0-9]+)$"#),
+        ])
+}
