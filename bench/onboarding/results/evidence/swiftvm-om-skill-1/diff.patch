@@ -0,0 +1,42 @@
+import Foundation
+
+enum com_swiftvm_app {
+    static let set = AppRecipeSet(
+        family: "com-swiftvm-app",
+        changelogs: [
+        // SwiftVM (Team NYSXATY4AA) — detected through the generic Sparkle
+        // source: a stable build declares `releases/latest/download/appcast.xml`,
+        // a beta build `releases/download/beta-channel/appcast-beta.xml` (see
+        // `SwiftVMChannel`). Neither appcast carries notes, only a
+        // `sparkle:fullReleaseNotesLink` to the GitHub release, whose body the
+        // vendor's release workflows fill with GitHub's generated notes.
+        //
+        // One repo, two trains, split by GitHub's `prerelease` bit: `v<x.y.z>`
+        // stable and `v<x.y.z>-beta.N` prereleases (settled from source:
+        // `.github/workflows/release.yml` / `release-beta.yml`). Tag minus `v`
+        // is the appcast's `sparkle:shortVersionString` and the bundle's
+        // CFBundleShortVersionString on both trains.
+        //
+        // `tagPattern` on the beta recipe keeps out `beta-channel`, a rolling
+        // prerelease that only hosts the beta appcast. `includesPromotedStable`
+        // stays false: the beta appcast lists beta items only, so a beta copy is
+        // never offered a stable release (Yaak's choice, not UTM's).
+        ChangelogRecipe(
+            bundleID: "com.swiftvm.app",
+            source: URL(string: "https://api.github.com/repos/swiftvm-app/swiftvm/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .stable,
+            structuredFormat: .gitHubReleases,
+            tagPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#),
+
+        ChangelogRecipe(
+            bundleID: "com.swiftvm.app",
+            source: URL(string: "https://api.github.com/repos/swiftvm-app/swiftvm/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .beta,
+            structuredFormat: .gitHubReleases,
+            tagPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+-beta\.[0-9]+)$"#),
+        ])
+}
