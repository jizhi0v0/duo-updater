+import Foundation
+
+enum rocks_spotifast_Spotifast {
+    static let set = AppRecipeSet(
+        family: "rocks-spotifast-Spotifast",
+        changelogs: [
+        // Spotifast — release bodies from the releases API. The GitHub rule below
+        // carries only the newest body. Bodies are Markdown: a download line, then
+        // `## New` / `## Fixed` / `## Changed` / `## Thanks` sections, and a
+        // `Full changelog` compare link at the end. The download line and the
+        // compare link are not entries. The v0.5.0-rc and v0.4.0-rc prereleases
+        // are dropped by the decoder (stable only), so they never appear here.
+        ChangelogRecipe(
+            bundleID: "rocks.spotifast.Spotifast",
+            source: URL(string: "https://api.github.com/repos/crmne/spotifast/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases),
+        ],
+        githubRules: [
+        // Spotifast — Rust app (crmne/spotifast), a Spotify client for Linux, macOS
+        // and Windows. It does not use Sparkle: no `SUFeedURL`. Its own updater
+        // (`fastframe-update`, `src/updates.rs`) reads GitHub's `releases/latest`
+        // and installs `spotifast-v<ver>-macos-universal.dmg`, the same asset this
+        // rule names. Every stable release is non-prerelease; `/releases/latest`
+        // skips the `-rc` tags on its own, and the anchored pattern refuses them
+        // too. short == tag without the `v`.
+        //
+        // One-click: the dmg is Developer ID signed, notarized and stapled,
+        // Team JPL7999US3 on both 0.11.2 and 0.12.0. The bundle has one executable
+        // and no nested helper apps or login items, so the swap leaves no resident
+        // process running replaced code beyond the app itself.
+        GitHubReleaseRule(
+            bundleID: "rocks.spotifast.Spotifast",
+            owner: "crmne", repo: "spotifast",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^spotifast-v[0-9.]+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
