diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-xd-cindy.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-xd-cindy.swift
new file mode 100644
index 0000000..97f8659
--- /dev/null
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-xd-cindy.swift
@@ -0,0 +1,137 @@
+import Foundation
+
+enum com_xd_cindy {
+    static let set = AppRecipeSet(
+        family: "com-xd-cindy",
+        probes: [
+        // Cindy cn (`com.xd.cindycn`, Team NTC4BJ542G) — the app's own update
+        // manifest. The cn edition cannot be a second GitHub rule: the rule's
+        // `recipeID` is `github:<owner>/<repo>:<channel>`, so it would share a health
+        // row with the global rule. A vendor probe's id carries the bundle id.
+        //
+        // The base URL is in the package: the build bakes
+        // `ENDPOINT_MANIFEST_BASE_URL` (`shared/endpoints.ts`), and the app reads
+        // `<base>/endpoint.json`, whose `cdnBaseUrl` for cn is
+        // `https://hotfix.cindy.com.cn/cindy`. The stable manifests are public and
+        // take no device or account id (`manifestService.ts` appends only a
+        // cache-busting `?t=`): `manifest-darwin-<arch>.json`. The track is the
+        // GitHub stable release: its `app.installer.sha256` equals the GitHub asset
+        // digest of `cindy-<ver>-darwin-<arch>-cn.dmg`, and the file is a public
+        // download. The beta and canary tracks are other files (`-beta`, `-canary`),
+        // never read here.
+        //
+        // The body also carries `codex`, `claudeCode`, `pi` and `codexPackage` blocks
+        // with their own `"version"` keys, so every pattern is anchored inside
+        // `"app"` / `"installer"`. `app.version` is the marketing string
+        // (== CFBundleShortVersionString == CFBundleVersion on 0.1.103 and 0.1.104).
+        // arm64 and x64 are separate manifests and separate dmgs, hence one recipe
+        // per architecture, told apart by `variant` and `hostRequirement`.
+        // One-click: Developer ID, notarized, the same Team on 0.1.103 and 0.1.104;
+        // the digest is hex SHA-256 and was checked against the downloaded dmg.
+        VendorProbeRecipe(
+            bundleID: "com.xd.cindycn",
+            url: URL(string: "https://hotfix.cindy.com.cn/cindy/manifest-darwin-arm64.json")!,
+            mode: .responseBody,
+            versionPattern: #""app"\s*:\s*\{\s*"version"\s*:\s*"([0-9]+(?:\.[0-9]+)+)""#,
+            downloadURL: URL(string: "https://cindy.com.cn/download/"),
+            changelogURL: URL(string: "https://github.com/makecindy/cindy/releases"),
+            install: VendorInstallSpec(
+                urlSource: .bodyPatternRelative(
+                    #""installer"\s*:\s*\{\s*"file"\s*:\s*"(app/darwin-arm64/cindy-[0-9.]+-arm64\.dmg)""#,
+                    base: URL(string: "https://hotfix.cindy.com.cn/cindy/")!),
+                kind: .dmg,
+                checksumPattern:
+                    #""installer"\s*:\s*\{\s*"file"\s*:\s*"app/darwin-arm64/cindy-[0-9.]+-arm64\.dmg"\s*,\s*"sha256"\s*:\s*"([0-9a-f]{64})""#,
+                checksumFormat: .sha256Hex),
+            variant: "arm64",
+            hostRequirement: VendorHostRequirement(architectures: [.arm64])),
+        VendorProbeRecipe(
+            bundleID: "com.xd.cindycn",
+            url: URL(string: "https://hotfix.cindy.com.cn/cindy/manifest-darwin-x64.json")!,
+            mode: .responseBody,
+            versionPattern: #""app"\s*:\s*\{\s*"version"\s*:\s*"([0-9]+(?:\.[0-9]+)+)""#,
+            downloadURL: URL(string: "https://cindy.com.cn/download/"),
+            changelogURL: URL(string: "https://github.com/makecindy/cindy/releases"),
+            install: VendorInstallSpec(
+                urlSource: .bodyPatternRelative(
+                    #""installer"\s*:\s*\{\s*"file"\s*:\s*"(app/darwin-x64/cindy-[0-9.]+-x64\.dmg)""#,
+                    base: URL(string: "https://hotfix.cindy.com.cn/cindy/")!),
+                kind: .dmg,
+                checksumPattern:
+                    #""installer"\s*:\s*\{\s*"file"\s*:\s*"app/darwin-x64/cindy-[0-9.]+-x64\.dmg"\s*,\s*"sha256"\s*:\s*"([0-9a-f]{64})""#,
+                checksumFormat: .sha256Hex),
+            variant: "x64",
+            hostRequirement: VendorHostRequirement(architectures: [.x86_64])),
+        ],
+        changelogs: [
+        // Cindy — release bodies from the releases API. Bodies are Markdown:
+        // a `## 更新说明` heading over `###` sections, then a `## PRs` list of pull
+        // request links and a `---` block of build metadata (commit, source tag,
+        // mobile build numbers). Neither tail is release notes, so `PRs` is skipped.
+        // `.gitHubReleases` with no channel keeps stable releases only, which is
+        // the split this rule makes too: the `-beta` releases are prereleases.
+        // One release carries both regions' dmgs, so `com.xd.cindycn` reads the same
+        // list. The releases API orders by creation date, not version (v0.1.85 sits
+        // above v0.1.86), and the decoder keeps that order.
+        ChangelogRecipe(
+            bundleID: "com.xd.cindy",
+            source: URL(string: "https://api.github.com/repos/makecindy/cindy/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["PRs"]),
+        ChangelogRecipe(
+            bundleID: "com.xd.cindycn",
+            source: URL(string: "https://api.github.com/repos/makecindy/cindy/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["PRs"]),
+        ],
+        githubRules: [
+        // Cindy (makecindy/cindy) — an Electron app (Electron Forge, not
+        // electron-builder: no `app-update.yml`, no Sparkle, no `SUFeedURL`). Its own
+        // updater reads `manifest-<platform>-<arch>[-beta|-canary].json` from a vendor
+        // CDN (`manifestService.ts`) and downloads a hot-fix zip from there; the
+        // public GitHub release is the source for the global edition, and the cn
+        // edition's manifest is the probe above.
+        //
+        // Two regions, two identities (`forge.config.ts`: appId derives from the
+        // region): global `com.xd.cindy` (Team SX9RG894L5) and mainland-China
+        // `com.xd.cindycn` (Team NTC4BJ542G). Each release has four macOS dmgs,
+        // `cindy-<ver>-darwin-<arm64|x64>-<global|cn>.dmg`, arm64 and x64 apart
+        // (`lipo` says single-arch), so the pattern admits both arches and
+        // `installableAsset` picks the host's. The region is in the file name, so
+        // this pattern pins `global`; a global install is never offered the cn dmg
+        // (different Team, the gate would refuse it anyway).
+        //
+        // Only the global bundle id is a GitHub rule: a cn rule would be a second
+        // stable rule on the same repo, and `GitHubReleaseRule.recipeID` is
+        // `github:<owner>/<repo>:<channel>`, so both would write one health row
+        // (`rulesSharingASlugRecordSeparateHealthEntries` fails).
+        //
+        // Stable only. `vX.Y.Z` tags are stable releases; `vX.Y.Z-beta` tags are
+        // `prerelease: true` and `/releases/latest` skips them. The beta track is a
+        // per-device switch inside the app, and the beta bundle is the same
+        // `com.xd.cindy` / same Team / same plist keys as stable, so a beta install
+        // cannot be told apart from the bundle — beta is not tracked (the switch is a
+        // device-local file, `userData/update-channel-settings.json`; see the audit).
+        // A beta copy is offered a stable release only when that is newer than it,
+        // which the next graduation (beta numbers run ahead of stable) will be.
+        // The anchored tag is the backstop for the same split: `-beta` is refused
+        // even if a beta were ever published without the prerelease flag.
+        //
+        // `v1.0.0` is a source-snapshot release (stable flag, no assets). The asset
+        // pattern leaves it nothing to match, and it sits last in the list.
+        //
+        // short == build == tag without the `v` on every package measured.
+        // One-click: Developer ID, notarized, the same Team on 0.1.103 and 0.1.104
+        // in both regions. GitHub publishes a sha256 digest for every asset.
+        GitHubReleaseRule(
+            bundleID: "com.xd.cindy",
+            owner: "makecindy", repo: "cindy",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^cindy-[0-9]+\.[0-9]+\.[0-9]+-darwin-(?:arm64|x64)-global\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyGitHubRuleTests.swift
new file mode 100644
index 0000000..89f4a94
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyGitHubRuleTests.swift
@@ -0,0 +1,415 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Cindy (`Recipes/com-xd-cindy.swift`): the global region's bundle id through the
+/// GitHub release, and the cn region (`com.xd.cindycn`) through the vendor's own
+/// update manifest (a second GitHub rule would share the global rule's health row).
+///
+/// The release list below is the shape makecindy/cindy really publishes
+/// (2026-10-14): `-beta` releases flagged `prerelease: true` interleaved with
+/// stable ones, four macOS dmgs per release (`arm64`/`x64` × `global`/`cn`), and
+/// an assetless stable `v1.0.0` source snapshot at the far end.
+@Suite struct CindyGitHubRuleTests {
+
+    static let bundleIDs = ["com.xd.cindy"]
+
+    private static func region(_ bundleID: String) -> String { "global" }
+
+    private static func rule(_ bundleID: String) -> GitHubReleaseRule? {
+        GitHubReleaseRegistry.rules.first { $0.bundleID == bundleID }
+    }
+
+    @Test(arguments: bundleIDs)
+    func ruleReadsTheStableTagAndTheGlobalDmgsOnly(_ bundleID: String) throws {
+        let rule = try #require(Self.rule(bundleID), "no GitHubReleaseRule for \(bundleID)")
+        let region = Self.region(bundleID)
+        #expect(rule.owner == "makecindy" && rule.repo == "cindy")
+        #expect(rule.channel == .stable && !rule.usePrereleases)
+        #expect(rule.installerKind == .dmg)
+        let pattern = try #require(rule.installAssetPattern)
+        func extract(_ tag: String) -> String? {
+            VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+        }
+        func matches(_ name: String) -> Bool {
+            name.range(of: pattern, options: .regularExpression) != nil
+        }
+
+        #expect(extract("v0.1.104") == "0.1.104")
+        #expect(extract("v0.1.108-beta") == nil)
+
+        #expect(matches("cindy-0.1.104-darwin-arm64-\(region).dmg"))
+        #expect(matches("cindy-0.1.104-darwin-x64-\(region).dmg"))
+        #expect(!matches("cindy-0.1.104-darwin-arm64-cn.dmg"))
+        #expect(!matches("cindy-0.1.104-darwin-x64-cn.dmg"))
+        #expect(!matches("cindy-0.1.104-linux-x64-\(region).deb"))
+        #expect(!matches("cindy-0.1.104-win32-x64-\(region).exe"))
+    }
+
+    // MARK: - The real list through the source
+
+    /// Newest first: `(tag, prerelease, assetNames)`.
+    private static let releases: [(String, Bool, [String])] = [
+        ("v0.1.108-beta", true, dmgs("0.1.108")),
+        ("v0.1.106-beta", true, dmgs("0.1.106")),
+        ("v0.1.104", false, dmgs("0.1.104")),
+        ("v0.1.103", false, dmgs("0.1.103")),
+        ("v1.0.0", false, []),
+    ]
+
+    private static func dmgs(_ version: String) -> [String] {
+        ["arm64", "x64"].flatMap { arch in
+            ["cn", "global"].map { "cindy-\(version)-darwin-\(arch)-\($0).dmg" }
+        } + ["cindy-\(version)-linux-x64-global.deb", "cindy-\(version)-win32-x64-global.exe"]
+    }
+
+    final class StubReleases: URLProtocol, @unchecked Sendable {
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+        override func startLoading() {
+            let url = request.url?.absoluteString ?? ""
+            let all = CindyGitHubRuleTests.releases
+            if url.contains("/releases/latest") {
+                // GitHub's `latest` skips prereleases.
+                respond(Data("{\(Self.fields(all.first { !$0.1 }!))}".utf8))
+                return
+            }
+            let perPage = URLComponents(string: url)?.queryItems?
+                .first { $0.name == "per_page" }?.value.flatMap(Int.init) ?? all.count
+            let page = all.prefix(perPage).map { "{\(Self.fields($0))}" }
+            respond(Data("[\(page.joined(separator: ","))]".utf8))
+        }
+
+        private static func fields(_ release: (String, Bool, [String])) -> String {
+            let assets = release.2.map {
+                """
+                {"name":"\($0)","browser_download_url":\
+                "https://github.com/makecindy/cindy/releases/download/\(release.0)/\($0)",\
+                "size":1000}
+                """
+            }
+            return """
+            "tag_name":"\(release.0)","name":"\(release.0)","draft":false,\
+            "prerelease":\(release.1),"published_at":"2026-10-12T00:00:00Z",\
+            "html_url":"https://github.com/makecindy/cindy/releases/tag/\(release.0)",\
+            "body":"notes","assets":[\(assets.joined(separator: ","))]
+            """
+        }
+
+        private func respond(_ data: Data) {
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: 200, httpVersion: "HTTP/1.1",
+                headerFields: ["Content-Type": "application/json"])!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: data)
+            client?.urlProtocolDidFinishLoading(self)
+        }
+
+        override func stopLoading() {}
+    }
+
+    private func resolve(
+        _ bundleID: String, arch: HostArch
+    ) async throws -> ProbeOutcome {
+        let rule = try #require(Self.rule(bundleID))
+        let config = URLSessionConfiguration.ephemeral
+        config.protocolClasses = [StubReleases.self]
+        let source = GitHubReleasesSource(
+            rules: [rule], session: URLSession(configuration: config))
+        return await source.resolveDiagnostic(
+            rule, preferring: arch, allowingIntelTranslation: false)
+    }
+
+    @Test(arguments: bundleIDs)
+    func appleSiliconGetsItsRegionsArm64Dmg(_ bundleID: String) async throws {
+        let outcome = try await resolve(bundleID, arch: .arm64)
+        #expect(outcome.failure == nil)
+        #expect(outcome.remote?.shortVersion == "0.1.104")
+        #expect(outcome.remote?.downloadURL?.lastPathComponent
+                == "cindy-0.1.104-darwin-arm64-\(Self.region(bundleID)).dmg")
+    }
+
+    @Test(arguments: bundleIDs)
+    func intelGetsItsRegionsX64Dmg(_ bundleID: String) async throws {
+        let outcome = try await resolve(bundleID, arch: .x86_64)
+        #expect(outcome.failure == nil)
+        #expect(outcome.remote?.shortVersion == "0.1.104")
+        #expect(outcome.remote?.downloadURL?.lastPathComponent
+                == "cindy-0.1.104-darwin-x64-\(Self.region(bundleID)).dmg")
+    }
+
+    // MARK: - Release notes
+
+    /// The shape of a real body (v0.1.104, shortened): a title line, `###` sections
+    /// under `## 更新说明`, then a `## PRs` link list and a `---` metadata block.
+    private static let releaseBody = """
+        Desktop release 0.1.104
+
+        ## 更新说明
+        ### 🧩 供应商组自动换机
+        供应商组现在会自己挑一台能用的电脑运行任务。 @MagicLizi
+
+        ### ⬆️ 让 Agent 帮你更新 Cindy
+        现在可以在对话里让 Cindy 自己升级。 @dashhuang
+
+
+        ## PRs
+        [#5506](https://github.com/makecindy/cindy/pull/5506) [#5690](https://github.com/makecindy/cindy/pull/5690)
+
+        ---
+        - commit: `ebf092dc3fb9dfa3ad25b10258979c0bcd396634`
+        - source tag: `beta2026-10-12_12-43-52`
+        - regions: cn global
+        """
+
+    private static func listJSON() throws -> String {
+        let rows: [[String: Any]] = [
+            ["tag_name": "v0.1.108-beta", "prerelease": true, "draft": false,
+             "published_at": "2026-10-14T04:10:00Z", "body": "## 更新说明\n### 🧪 beta only\nbeta note"],
+            ["tag_name": "v0.1.104", "prerelease": false, "draft": false,
+             "published_at": "2026-10-12T04:56:47Z", "body": releaseBody],
+        ]
+        return String(decoding: try JSONSerialization.data(withJSONObject: rows), as: UTF8.self)
+    }
+
+    @Test(arguments: bundleIDs)
+    func recipeKeepsTheSectionHeadingsAndDropsTheBetaAndTheLinkList(_ bundleID: String) throws {
+        let recipe = try #require(
+            ChangelogRecipeRegistry.recipes.first { $0.bundleID == bundleID })
+        #expect(recipe.structuredFormat == .gitHubReleases)
+        let log = try #require(StructuredChangelogDecoder.decode(
+            try Self.listJSON(), format: .gitHubReleases, channel: nil,
+            maxEntries: recipe.maxEntries, skipSections: recipe.skipSections))
+
+        // The prerelease's notes describe a build a stable install was never shown.
+        #expect(log.entries.map(\.version) == ["0.1.104"])
+        let entry = log.entries[0]
+        let headings = entry.content.compactMap { block -> String? in
+            if case .heading(let text) = block { return text }
+            return nil
+        }
+        #expect(headings == ["🧩 供应商组自动换机", "⬆️ 让 Agent 帮你更新 Cindy"])
+        let text = entry.items.joined(separator: "\n")
+        #expect(!text.contains("pull/5506"))
+        #expect(!text.contains("source tag"))
+    }
+
+    // MARK: - cn: the vendor manifest
+
+    /// `https://hotfix.cindy.com.cn/cindy/manifest-darwin-<arch>.json`, fetched
+    /// 2026-10-14. The `codex`, `claudeCode`, `pi` and `codexPackage` blocks carry
+    /// their own `"version"` keys ahead of `app`.
+    private static let armManifest = #"""
+{
+  "codex": {
+    "version": "0.145.0",
+    "file": "codex/0.145.0/darwin-arm64/codex.gz",
+    "sha256": "c879b85129dac1b1199a0833da572fa2c42de878ee96ff03b344e458c8e9cbc1",
+    "size": 105756863,
+    "binarySha256": "1da3f4e0e96028b8a771814293c3033dafd1971f943f6c7e79b0897fe705f590"
+  },
+  "claudeCode": {
+    "version": "2.1.296",
+    "file": "claude-code/2.1.296/darwin-arm64/claude.gz",
+    "sha256": "55d0a80f327670eb52fdce8b304ae89cc6d6b88f1834ece242a94cf81bf2a075",
+    "size": 105099541,
+    "binarySha256": "c9b5341637becbd423ddffc5b254afb645682a3868cb708bbc6cc0e7bb419937"
+  },
+  "app": {
+    "version": "0.1.104",
+    "installer": {
+      "file": "app/darwin-arm64/cindy-0.1.104-arm64.dmg",
+      "sha256": "8f0704e311a4c960a202cb632cf1b8d164f095d9354eee62d9c8475d9cf46331",
+      "size": 305173888
+    },
+    "hotfix": {
+      "file": "hotfix/darwin-arm64/cindy-0.1.104-arm64-hotfix.zip",
+      "sha256": "ef719de4bc6fe2eb9ee9f14cf703ae4b96ef91440f1660cb876af725d1e73939",
+      "size": 278776768
+    }
+  },
+  "pi": {
+    "version": "1.0.2",
+    "file": "pi/1.0.2/darwin-arm64/pi.dist.tar.gz",
+    "sha256": "33408a2f5cf2f51661b59fc3faa9eaaeebfde1bf110bb30cb56cd314e481e7d2",
+    "size": 31694994
+  },
+  "codexPackage": {
+    "version": "0.159.2",
+    "file": "codex-package/0.159.2/darwin-arm64/codex-package.dist.tar.gz",
+    "sha256": "a1e58a10ac3c7e5345342f93504a7628e98283d91a91bddab747c40b1c1981bc",
+    "size": 133851150
+  }
+}
+"""#
+
+    private static let x64Manifest = #"""
+{
