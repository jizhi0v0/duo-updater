+/// Secretive's nightly and one-off CI builds ship under the SAME bundle id as the
+/// stable release (`com.maxgoedjen.Secretive.Host`) with a version of `0.0.0`
+/// plus an optional `_`-separated tail: `0.0.0_nightly-2026-10-13` (real bundle),
+/// bare `0.0.0` (nightlies before 2025-09-04), `0.0.0_oneoff-2025-11-29` (from
+/// the workflow source). Step 4 reads `-nightly`, not `_nightly`, so all of them
+/// read `.stable` without this rule, and the stable GitHub rule would offer
+/// 4.0.0 as an "update" that downgrades them off the nightly track.
+/// Mutation-checked: dropping `bundleID == "com.maxgoedjen.Secretive.Host"` from
+/// the rule fails the two `com.example.other` rows.
+@Test func secretiveTestBuildsAreReadOnlyForSecretive() {
+    func detect(_ bundleID: String, _ version: String) -> ReleaseChannel {
+        ReleaseChannel.detect(
+            name: "Secretive", bundleID: bundleID, keystoneChannel: nil, version: version)
+    }
+    let host = "com.maxgoedjen.Secretive.Host"
+    for version in ["0.0.0_nightly-2026-10-13", "0.0.0", "0.0.0_oneoff-2025-11-29"] {
+        #expect(detect(host, version) == .nightly, "\(version)")
+    }
+    // Real releases, including v0.1.1, which reports `1.0`.
+    for version in ["4.0.0", "3.0.4", "1.0", "0.5.1"] {
+        #expect(detect(host, version) == .stable, "\(version)")
+    }
+    // Scoped to this bundle id.
+    #expect(detect("com.example.other", "0.0.0_nightly-2026-10-13") == .stable)
+    #expect(detect("com.example.other", "0.0.0") == .stable)
+}
