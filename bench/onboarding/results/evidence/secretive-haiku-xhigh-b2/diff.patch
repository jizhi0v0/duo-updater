+import Foundation
+
+enum com_maxgoedjen_Secretive_Host {
+    static let set = AppRecipeSet(
+        family: "com-maxgoedjen-Secretive-Host",
+        githubRules: [
+        // Secretive — keeps SSH keys in the Secure Enclave. No SUFeedURL and no
+        // MAS. Its own updater only lists api.github.com/…/releases and shows a
+        // notice; it never downloads or swaps the bundle. v-tags, and
+        // CFBundleShortVersionString == tag on every release that is not v0.1.1
+        // (its bundle reads 1.0). Stable track only: the 0.x releases are
+        // prerelease-flagged, nightlies are Actions artifacts and are never
+        // published. One universal `Secretive.zip`; Developer ID, Team
+        // Z72PRUAWF6, notarized on all 27 published zips (v0.1.1..v4.0.0).
+        // LoginItems/SecretAgent.app is a resident helper (see the audit doc).
+        GitHubReleaseRule(
+            bundleID: "com.maxgoedjen.Secretive.Host",
+            owner: "maxgoedjen", repo: "secretive",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^Secretive\.zip$"#,
+            installerKind: .zip),
+        ])
+}
