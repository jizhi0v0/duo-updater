+import Foundation
+
+enum io_github_tobi_disktree {
+    static let set = AppRecipeSet(
+        family: "io-github-tobi-disktree",
+        githubRules: [
+        // disktree (tobi/disktree) — a treemap disk-usage viewer. The macOS
+        // build is a bare `disktree.app` in per-architecture zips
+        // (`disktree-<v>-aarch64-macos.zip`, `…-x86_64-macos.zip`), not a dmg.
+        // No `SUFeedURL`, no Sparkle framework, and no update endpoint in the
+        // arm64 binary (checked 2026-10-13), so GitHub is the only source.
+        //
+        // Tag `v0.11.0` matches CFBundleShortVersionString `0.11.0` on the
+        // arm64 build, so the default version pattern reads it.
+        //
+        // Detection-only: no `installAssetPattern`. The build is ad-hoc signed
+        // (`flags=0x2(adhoc)`, no Team ID) and `spctl` rejects it, so the
+        // Team-ID gate has nothing to pin. `installTrust: .publishedDigestOnly`
+        // would fit its seal and identifier, but it is opt-in and the
+        // coverage-discovery rule requires Developer ID plus notarization.
+        GitHubReleaseRule(
+            bundleID: "io.github.tobi.disktree",
+            owner: "tobi", repo: "disktree"),
+        ])
+}
