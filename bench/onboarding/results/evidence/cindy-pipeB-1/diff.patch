+@Suite struct CindyChangelogRecipeTests {
+    private func recipe(_ bundleID: String) throws -> ChangelogRecipe {
+        try #require(ChangelogRecipeRegistry.recipes.first { $0.bundleID == bundleID })
+    }
+
+    private func headings(_ entry: Changelog.Entry) -> [String] {
+        entry.content.compactMap { block -> String? in
+            if case .heading(let text) = block { return text }
+            return nil
+        }
+    }
+
+    @Test func theNoticeIsRequestedByVersion() throws {
+        #expect(try recipe("com.xd.cindy").resolvedSource(forVersion: "0.1.104").absoluteString
+            == "https://hotfix.cindy.app/cindy/notice/darwin-arm64/0.1.104.json")
+        #expect(try recipe("com.xd.cindycn").resolvedSource(forVersion: "0.1.104").absoluteString
+            == "https://hotfix.cindy.com.cn/cindy/notice/darwin-arm64/0.1.104.json")
+    }
+
+    @Test func englishTopicsBecomeHeadingsWithTheirNotes() throws {
+        let log = try #require(ChangelogService.parse(
+            try recipe("com.xd.cindy"), body: cindyGlobalNoticeFixture, version: "0.1.104"))
+        #expect(log.entries.count == 1)
+        let entry = try #require(log.entries.first)
+        #expect(entry.version == "0.1.104")
+        #expect(entry.date == "2026-10-12")
+        #expect(headings(entry) == [
+            "Provider Groups Phase 2: Same-Account Direct and Sharing Relay",
+            "Run Orca Workers on Another Computer",
+        ])
+        #expect(entry.items.count == 2)
+        // The JSON-escaped quotes come out as quotes.
+        #expect(entry.items[0].hasPrefix("Provider groups now cover your other computers"))
+        #expect(entry.items[0].contains("a single \"Provider Group\" entry"))
+        #expect(entry.items[1].hasPrefix("When starting collaboration or creating a worker"))
+        // heading, note, heading, note — in document order.
+        guard case .heading = entry.content[0], case .heading = entry.content[2] else {
+            Issue.record("expected a heading before each note: \(entry.content)")
+            return
+        }
+        // No zh-CN (top-level `topics`) or ja text leaks in.
+        let everything = entry.content.map { "\($0)" }.joined()
+        #expect(!everything.contains("供应商组"))
+        #expect(!everything.contains("プロバイダ"))
+    }
+
+    @Test func aNoticeWithoutIntroIsStillRead() throws {
+        let log = try #require(ChangelogService.parse(
+            try recipe("com.xd.cindycn"), body: cindyCNNoticeFixture, version: "0.1.106"))
+        let entry = try #require(log.entries.first)
+        #expect(entry.version == "0.1.106")
+        #expect(entry.date == "2026-10-13")
+        #expect(headings(entry) == ["No More Lag with Many Plugins"])
+        #expect(entry.items.count == 1)
+        #expect(entry.items[0].hasPrefix("Fixed the slowdown that grew worse with every plugin"))
+    }
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyGitHubRuleTests.swift
new file mode 100644
index 0000000..7246109
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyGitHubRuleTests.swift
@@ -0,0 +1,207 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Cindy's two editions (`Recipes/com-xd-cindy.swift`, `Recipes/com-xd-cindycn.swift`):
+/// one repo, one tag stream, separate `-global` / `-cn` dmgs per arch signed by
+/// different Teams. Each rule must take its own edition's dmg and refuse the other's,
+/// without leaning on the Team gate to catch a cross-edition pick. Asset names are the
+/// ones the real v0.1.104 release lists.
+@Suite struct CindyGitHubRuleTests {
+
+    private static let editions: [(bundleID: String, suffix: String)] = [
+        ("com.xd.cindy", "global"), ("com.xd.cindycn", "cn"),
+    ]
+
+    private static func rule(_ bundleID: String) -> GitHubReleaseRule? {
+        GitHubReleaseRegistry.rules.first { $0.bundleID == bundleID }
+    }
+
+    /// The eight assets of a full release, in the order the API lists them.
+    private static func assetNames(_ version: String) -> [String] {
+        ["cindy-\(version)-darwin-arm64-cn.dmg", "cindy-\(version)-darwin-arm64-global.dmg",
+         "cindy-\(version)-darwin-x64-cn.dmg", "cindy-\(version)-darwin-x64-global.dmg",
+         "cindy-\(version)-linux-x64-cn.deb", "cindy-\(version)-linux-x64-global.deb",
+         "cindy-\(version)-win32-x64-cn.exe", "cindy-\(version)-win32-x64-global.exe"]
+    }
+
+    @Test(arguments: editions)
+    func ruleReadsTheBareTagAndItsOwnEditionsDmgOnly(
+        _ edition: (bundleID: String, suffix: String)
+    ) throws {
+        let rule = try #require(Self.rule(edition.bundleID), "no GitHubReleaseRule for \(edition.bundleID)")
+        #expect(rule.owner == "makecindy" && rule.repo == "cindy")
+        #expect(rule.channel == .stable && !rule.usePrereleases)
+        #expect(rule.installerKind == .dmg)
+        let pattern = try #require(rule.installAssetPattern)
+        func extract(_ tag: String) -> String? {
+            VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+        }
+        func matches(_ name: String) -> Bool {
+            name.range(of: pattern, options: .regularExpression) != nil
+        }
+
+        #expect(extract("v0.1.104") == "0.1.104")
+        // A beta's Info.plist reads the bare X.Y.Z, so the tag is what keeps it out.
+        #expect(extract("v0.1.108-beta") == nil)
+
+        let other = edition.suffix == "global" ? "cn" : "global"
+        for arch in ["arm64", "x64"] {
+            #expect(matches("cindy-0.1.104-darwin-\(arch)-\(edition.suffix).dmg"))
+            #expect(!matches("cindy-0.1.104-darwin-\(arch)-\(other).dmg"))
+        }
+        #expect(!matches("cindy-0.1.104-linux-x64-\(edition.suffix).deb"))
+        #expect(!matches("cindy-0.1.104-win32-x64-\(edition.suffix).exe"))
+        #expect(!matches("cindy-0.1.108-beta-darwin-arm64-\(edition.suffix).dmg"))
+    }
+
+    @Test(arguments: editions)
+    func theHostsArchitectureChoosesTheDmg(_ edition: (bundleID: String, suffix: String)) throws {
+        let rule = try #require(Self.rule(edition.bundleID))
+        let pattern = try #require(rule.installAssetPattern)
+        let assets = Self.assetNames("0.1.104").map {
+            (name: $0, url: URL(string: "https://github.com/makecindy/cindy/releases/download/v0.1.104/\($0)")!,
+             size: Int64?.some(1000))
+        }
+        let arm = GitHubReleaseRule.installableAsset(
+            from: assets, matching: pattern, preferring: .arm64, allowingIntelTranslation: false)
+        #expect(arm?.url.lastPathComponent == "cindy-0.1.104-darwin-arm64-\(edition.suffix).dmg")
+        let intel = GitHubReleaseRule.installableAsset(
+            from: assets, matching: pattern, preferring: .x86_64, allowingIntelTranslation: false)
+        #expect(intel?.url.lastPathComponent == "cindy-0.1.104-darwin-x64-\(edition.suffix).dmg")
+    }
+
+    /// Same repo, same channel: only `variant` keeps the two editions' health rows
+    /// and baseline entries apart.
+    @Test func theTwoEditionsKeepSeparateRecipeIDs() throws {
+        let global = try #require(Self.rule("com.xd.cindy"))
+        let cn = try #require(Self.rule("com.xd.cindycn"))
+        #expect(global.slug == cn.slug && global.channel == cn.channel)
+        #expect(global.recipeID == "github:makecindy/cindy:stable:global")
+        #expect(cn.recipeID == "github:makecindy/cindy:stable:cn")
+    }
+
+    // MARK: - Replaying real release-list shapes through the source
+
+    struct Release {
+        let tag: String
+        let prerelease: Bool
+        let assets: [String]
+    }
+
+    /// Serves `releases` (newest first) as the list endpoint, and as
+    /// `/releases/latest` the first one that is not a prerelease, as GitHub does.
+    class StubReleases: URLProtocol, @unchecked Sendable {
+        class var releases: [Release] { [] }
+
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+        override func startLoading() {
+            let all = Self.releases
+            let url = request.url?.absoluteString ?? ""
+            if url.contains("/releases/latest") {
+                let latest = all.first { !$0.prerelease }!
+                respond(Data("{\(Self.fields(latest))}".utf8))
+                return
+            }
+            let perPage = URLComponents(string: url)?.queryItems?
+                .first { $0.name == "per_page" }?.value.flatMap(Int.init) ?? all.count
+            let page = all.prefix(perPage).map { "{\(Self.fields($0))}" }
+            respond(Data("[\(page.joined(separator: ","))]".utf8))
+        }
+
+        private static func fields(_ release: Release) -> String {
+            let assets = release.assets.map {
+                """
+                {"name":"\($0)","browser_download_url":\
+                "https://github.com/makecindy/cindy/releases/download/\(release.tag)/\($0)",\
+                "size":300000000}
+                """
+            }
+            return """
+            "tag_name":"\(release.tag)","name":"Cindy \(release.tag)","draft":false,\
+            "prerelease":\(release.prerelease),"published_at":"2026-10-12T04:56:47Z",\
+            "html_url":"https://github.com/makecindy/cindy/releases/tag/\(release.tag)",\
+            "body":"notes","assets":[\(assets.joined(separator: ","))]
+            """
+        }
+
+        private func respond(_ data: Data) {
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: 200, httpVersion: "HTTP/1.1",
+                headerFields: ["Content-Type": "application/json"])!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: data)
+            client?.urlProtocolDidFinishLoading(self)
+        }
+
+        override func stopLoading() {}
+    }
+
+    /// The real shape: a beta prerelease newer than the stable one.
+    final class BetaAhead: StubReleases, @unchecked Sendable {
+        override class var releases: [Release] {
+            [Release(tag: "v0.1.108-beta", prerelease: true, assets: CindyGitHubRuleTests.assetNames("0.1.108")),
+             Release(tag: "v0.1.104", prerelease: false, assets: CindyGitHubRuleTests.assetNames("0.1.104")),
+             Release(tag: "v0.1.103", prerelease: false, assets: CindyGitHubRuleTests.assetNames("0.1.103"))]
+        }
+    }
+
+    /// `v1.0.0` is a source-snapshot release with no assets. It matches the tag
+    /// pattern, so were it ever the newest the asset pattern is what refuses it.
+    final class AssetlessSnapshotNewest: StubReleases, @unchecked Sendable {
+        override class var releases: [Release] {
+            [Release(tag: "v1.0.0", prerelease: false, assets: []),
+             Release(tag: "v0.1.104", prerelease: false, assets: CindyGitHubRuleTests.assetNames("0.1.104")),
+             Release(tag: "v0.1.103", prerelease: false, assets: CindyGitHubRuleTests.assetNames("0.1.103"))]
+        }
+    }
+
+    /// A release that shipped one dmg only (v0.1.52 had `arm64-global` alone).
+    final class PartialNewest: StubReleases, @unchecked Sendable {
+        override class var releases: [Release] {
+            [Release(tag: "v0.1.52", prerelease: false, assets: ["cindy-0.1.52-darwin-arm64-global.dmg"]),
+             Release(tag: "v0.1.51", prerelease: false, assets: CindyGitHubRuleTests.assetNames("0.1.51"))]
+        }
+    }
+
+    private func answer(
+        _ bundleID: String, stub: URLProtocol.Type, arch: HostArch = .arm64
+    ) async throws -> (version: String?, asset: String?) {
+        let rule = try #require(Self.rule(bundleID))
+        let config = URLSessionConfiguration.ephemeral
+        config.protocolClasses = [stub]
+        let source = GitHubReleasesSource(rules: [rule], session: URLSession(configuration: config))
+        let outcome = await source.resolveDiagnostic(
+            rule, preferring: arch, allowingIntelTranslation: false)
+        #expect(outcome.failure == nil)
+        return (outcome.remote?.shortVersion, outcome.remote?.downloadURL?.lastPathComponent)
+    }
+
+    @Test(arguments: editions)
+    func aNewerBetaPrereleaseIsNotOffered(_ edition: (bundleID: String, suffix: String)) async throws {
+        let got = try await answer(edition.bundleID, stub: BetaAhead.self)
+        #expect(got.version == "0.1.104")
+        #expect(got.asset == "cindy-0.1.104-darwin-arm64-\(edition.suffix).dmg")
+    }
+
+    @Test(arguments: editions)
+    func theAssetlessSnapshotReleaseIsWalkedPast(_ edition: (bundleID: String, suffix: String)) async throws {
+        let got = try await answer(edition.bundleID, stub: AssetlessSnapshotNewest.self)
+        #expect(got.version == "0.1.104")
+        #expect(got.asset == "cindy-0.1.104-darwin-arm64-\(edition.suffix).dmg")
+    }
+
+    /// The edition without a build in the newest release is offered the previous
+    /// release: there was no such build to offer.
+    @Test func anEditionMissingFromTheNewestReleaseWalksBack() async throws {
+        let cn = try await answer("com.xd.cindycn", stub: PartialNewest.self)
+        #expect(cn.version == "0.1.51")
+        #expect(cn.asset == "cindy-0.1.51-darwin-arm64-cn.dmg")
+        let global = try await answer("com.xd.cindy", stub: PartialNewest.self)
+        #expect(global.version == "0.1.52")
+        #expect(global.asset == "cindy-0.1.52-darwin-arm64-global.dmg")
+    }
+}
