@@ -0,0 +1,264 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// T3 Code (`com.t3tools.t3code`): two GitHub rules on one bundle id, and the
+/// `ReleaseChannel.detect` step (0.9) without which neither could fire.
+///
+/// Every identity below was read off a mounted DMG from the repo's own
+/// Releases (2026-10-14), not from a cask or a tag:
+///
+///   T3-Code-0.0.45-arm64.dmg                      "T3 Code (Alpha)"   0.0.45
+///   T3-Code-0.0.44-arm64.dmg                      "T3 Code (Alpha)"   0.0.44
+///   T3-Code-0.0.46-nightly.20261014.3105-arm64.dmg "T3 Code (Nightly)" 0.0.46-nightly.20261014.3105
+///   T3-Code-0.0.46-preview.20261010.2909-arm64.dmg "T3 Code (Alpha)"   0.0.46-preview.20261010.2909
+///
+/// (`CFBundleName` = `CFBundleDisplayName`, `CFBundleShortVersionString` =
+/// `CFBundleVersion` on all four.) Before step 0.9 the stable and preview
+/// bundles both detected as `.alpha` — measured with `channel-verify` on the
+/// same DMGs — so a `.stable` rule would never have been consulted.
+@Suite(.serialized)
+struct T3CodeTests {
+
+    private static let bundleID = "com.t3tools.t3code"
+
+    private struct RealBundle {
+        let name: String
+        let version: String
+        let channel: ReleaseChannel
+    }
+
+    private static let realBundles: [RealBundle] = [
+        RealBundle(name: "T3 Code (Alpha)", version: "0.0.45", channel: .stable),
+        RealBundle(name: "T3 Code (Alpha)", version: "0.0.44", channel: .stable),
+        RealBundle(name: "T3 Code (Nightly)", version: "0.0.46-nightly.20261014.3105", channel: .nightly),
+        RealBundle(name: "T3 Code (Alpha)", version: "0.0.46-preview.20261010.2909", channel: .preview),
+    ]
+
+    private static func detect(_ name: String, _ version: String, bundleID: String = bundleID) -> ReleaseChannel {
+        ReleaseChannel.detect(
+            name: name, bundleID: bundleID, keystoneChannel: nil,
+            version: version, bundleFileName: name)
+    }
+
+    /// An installed copy as `AppScanner` would build it, channel included.
+    private static func app(_ name: String, _ version: String) -> InstalledApp {
+        InstalledApp(
+            name: name, bundleID: bundleID,
+            shortVersion: version, buildVersion: version,
+            path: URL(fileURLWithPath: "/Applications/\(name).app"),
+            isMASApp: false, sparkleFeedURL: nil,
+            releaseChannel: detect(name, version))
+    }
+
+    private static func rule(_ channel: ReleaseChannel) -> GitHubReleaseRule? {
+        GitHubReleaseRegistry.rules.first { $0.bundleID == bundleID && $0.channel == channel }
+    }
+
+    private static func extract(_ tag: String, _ channel: ReleaseChannel) -> String? {
+        guard let rule = rule(channel) else { return nil }
+        return VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+    }
+
+    // MARK: - channel detection
+
+    @Test func channelComesFromTheVersionShapeNotTheAlphaName() {
+        for bundle in Self.realBundles {
+            #expect(Self.detect(bundle.name, bundle.version) == bundle.channel,
+                    "\(bundle.name) \(bundle.version)")
+        }
+        // The name alone, under any other bundle id, still says `.alpha` — so it
+        // is step 0.9 that carries the stable verdict, not a change to step 3.
+        #expect(Self.detect("T3 Code (Alpha)", "0.0.45", bundleID: "com.example.other") == .alpha)
+    }
+
+    /// Shapes the vendor has published or builds but no rule serves. They must
+    /// land OFF stable, or the stable rule would offer them a cross-channel build.
+    @Test func otherVersionShapesNeverReadAsStable() {
+        // The March 2026 `v0.0.0-alpha.N` releases (published as non-prerelease).
+        #expect(Self.detect("T3 Code (Alpha)", "0.0.0-alpha.22") != .stable)
+        // A hand-installed pull-request build (`-pr.` in the build script).
+        #expect(Self.detect("T3 Code (Alpha)", "0.0.46-pr.1234.1") != .stable)
+        // A nightly shape missing its run counter is not a nightly either.
+        #expect(Self.detect("T3 Code (Alpha)", "0.0.46-nightly.20261014") != .nightly)
+    }
+
+    // MARK: - registry
+
+    /// Derived from the real bundles: every channel a copy can detect as has a
+    /// rule exactly when the vendor runs an update feed for it.
+    @Test func registryServesStableAndNightlyAndNothingElse() {
+        let rules = GitHubReleaseRegistry.rules.filter { $0.bundleID == Self.bundleID }
+        #expect(Set(rules.map(\.channel)) == [.stable, .nightly])
+        #expect(rules.count == 2)
+        for bundle in Self.realBundles {
+            let served = Self.rule(bundle.channel) != nil
+            #expect(served == (bundle.channel != .preview), "\(bundle.version)")
+        }
+        #expect(Self.rule(.stable)?.usePrereleases == false)
+        #expect(Self.rule(.nightly)?.usePrereleases == true)
+    }
+
+    /// Every tag SHAPE among the 672 releases on 2026-10-14, plus the next major
+    /// and a release candidate nobody remembered to flag.
+    @Test func versionPatternsReadTheirOwnTagsOnly() {
+        #expect(Self.extract("v0.0.45", .stable) == "0.0.45")
+        #expect(Self.extract("v1.0.0", .stable) == "1.0.0")
+        #expect(Self.extract("v1.0", .stable) == "1.0")
+        #expect(Self.extract("v1.0.0-rc.1", .stable) == nil)
+        #expect(Self.extract("v0.0.0-alpha.22", .stable) == nil)
+        #expect(Self.extract("v0.0.4-alpha.1", .stable) == nil)
+        #expect(Self.extract("v0.0.46-nightly.20261014.3105", .stable) == nil)
+        #expect(Self.extract("v0.0.46-preview.20261010.2909", .stable) == nil)
+
+        #expect(Self.extract("v0.0.46-nightly.20261014.3105", .nightly) == "0.0.46-nightly.20261014.3105")
+        #expect(Self.extract("v1.0.0-nightly.20270101.1", .nightly) == "1.0.0-nightly.20270101.1")
+        #expect(Self.extract("v0.0.45", .nightly) == nil)
+        #expect(Self.extract("v0.0.46-preview.20261010.2909", .nightly) == nil)
+        #expect(Self.extract("nightly-v0.0.21-nightly.20260417.58", .nightly) == nil)
+
+        for tag in ["android-nightly", "desktop-preview"] {
+            #expect(Self.extract(tag, .stable) == nil)
+            #expect(Self.extract(tag, .nightly) == nil)
+        }
+    }
+
+    /// What the tag yields must be what the bundle reports, or an up-to-date
+    /// copy sees a phantom update forever.
+    @Test func tagVersionEqualsTheInstalledVersion() throws {
+        for bundle in Self.realBundles where bundle.channel != .preview {
+            let version = try #require(Self.extract("v" + bundle.version, bundle.channel))
+            #expect(VersionComparator.compare(version, bundle.version) == .orderedSame)
+        }
+    }
+
+    @Test func installPatternsTakeTheirOwnTrainsArm64Dmg() throws {
+        let stable = try #require(Self.rule(.stable)?.installAssetPattern)
+        let nightly = try #require(Self.rule(.nightly)?.installAssetPattern)
+        func hit(_ name: String, _ pattern: String) -> Bool {
+            name.range(of: pattern, options: .regularExpression) != nil
+        }
+        #expect(hit("T3-Code-0.0.45-arm64.dmg", stable))
+        #expect(hit("T3-Code-0.0.46-nightly.20261014.3105-arm64.dmg", nightly))
+        for name in [
+            "T3-Code-0.0.45-x64.dmg", "T3-Code-0.0.45-arm64.zip",
+            "T3-Code-0.0.45-arm64.dmg.blockmap", "t3-0.0.45-darwin-arm64.tar.gz",
+            "T3-Code-0.0.46-nightly.20261014.3105-arm64.dmg",
+            "T3-Code-0.0.46-preview.20261010.2909-arm64.dmg",
+        ] {
+            #expect(!hit(name, stable), "\(name)")
+        }
+        for name in [
+            "T3-Code-0.0.45-arm64.dmg",
+            "T3-Code-0.0.46-nightly.20261014.3105-x64.dmg",
+            "T3-Code-0.0.46-nightly.20261014.3105-arm64.zip",
+            "T3-Code-0.0.46-preview.20261010.2909-arm64.dmg",
+        ] {
+            #expect(!hit(name, nightly), "\(name)")
+        }
+    }
+
+    // MARK: - end to end, against the captured Releases API
+
+    /// Serves the two endpoints the source asks for, trimmed from the real
+    /// responses of 2026-10-14: `/releases?per_page=20` (its real first page, in
+    /// order — nightlies, `android-nightly`, two previews) and
+    /// `/releases/latest`. Bodies are cut to three bullets; only `.dmg` assets
+    /// are kept.
+    private final class Fixture: URLProtocol, @unchecked Sendable {
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+        override func startLoading() {
+            let isLatest = request.url?.path.hasSuffix("/releases/latest") == true
+            let body = Data((isLatest ? T3CodeTests.latestJSON : T3CodeTests.listJSON).utf8)
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: 200, httpVersion: "HTTP/1.1", headerFields: nil)!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: body)
+            client?.urlProtocolDidFinishLoading(self)
+        }
+        override func stopLoading() {}
+    }
+
+    private static func source() -> GitHubReleasesSource {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.protocolClasses = [Fixture.self]
+        return GitHubReleasesSource(session: URLSession(configuration: configuration))
+    }
+
+    @Test func stableCopyIsOfferedTheStableDmgWithItsNotes() async throws {
+        let behind = Self.app("T3 Code (Alpha)", "0.0.44")
+        let remote = try #require(try await Self.source().latestVersion(for: behind))
+        #expect(UpdateChecker.evaluate(installed: behind, remote: remote)
+                == .updateAvailable(latest: "0.0.45"))
+        #expect(remote.downloadURL?.absoluteString
+                == "https://github.com/pingdotgg/t3code/releases/download/v0.0.45/T3-Code-0.0.45-arm64.dmg")
+        #expect(remote.vendorInstallerKind == .dmg)
+        #expect(remote.requiresManualInstaller == false)
+        // GitHub's generated "What's Changed" list; the contributor and
+        // compare-link sections are not release notes.
+        let entry = try #require(remote.structuredChangelog?.entries.first)
+        #expect(entry.version == "0.0.45")
+        #expect(entry.items.count == 3)
+
+        let current = Self.app("T3 Code (Alpha)", "0.0.45")
+        let same = try #require(try await Self.source().latestVersion(for: current))
+        #expect(UpdateChecker.evaluate(installed: current, remote: same) == .upToDate)
+    }
+
+    @Test func nightlyCopyIsOfferedTheNewestNightlyAndItsProofHolds() async throws {
+        let behind = Self.app("T3 Code (Nightly)", "0.0.46-nightly.20261014.3093")
+        let remote = try #require(try await Self.source().latestVersion(for: behind))
+        #expect(UpdateChecker.evaluate(installed: behind, remote: remote)
+                == .updateAvailable(latest: "0.0.46-nightly.20261014.3105"))
+        #expect(remote.downloadURL?.absoluteString
+                == "https://github.com/pingdotgg/t3code/releases/download/v0.0.46-nightly.20261014.3105/T3-Code-0.0.46-nightly.20261014.3105-arm64.dmg")
+        #expect(remote.vendorInstallerKind == .dmg)
+        #expect(remote.structuredChangelog?.entries.first?.items.isEmpty == false)
+        let rule = try #require(Self.rule(.nightly))
+        #expect(RecipeSanity.crossChannelArtifact(rule: rule, remote: remote) == nil)
+
