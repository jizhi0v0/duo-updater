@@ -0,0 +1,76 @@
+import Foundation
+
+enum com_xd_cindy {
+    static let set = AppRecipeSet(
+        family: "com-xd-cindy",
+        changelogs: [
+        // History: docs/app-audits/com-xd-cindy.md#历史与实测
+        // Cindy (global edition) — notes from the CDN notice the app's own "what's
+        // new" reads, not from the GitHub release body. The body ends in a `---`
+        // footer of build ids and branch names (`commit:`, `source tag:`, iOS and
+        // Android build numbers) that the Markdown parser reads as bullets, and
+        // about half the releases have no `## PRs` heading to skip before it.
+        //
+        // `<cdn>/notice/darwin-arm64/<version>.json` is one file per release, no
+        // "latest" alias (`index.json` lists the versions only), so the version comes
+        // from the offered update through `sourceTemplate`. The file carries every
+        // locale: top-level `topics` is zh-CN and `contentByLocale.en.topics` the
+        // English copy. English, like `com-kimi-code-desktop`. The pattern descends
+        // into `contentByLocale` → `en` before it reads `topics`, so no zh-CN text
+        // can leak in. The darwin-x64 notice is the same file.
+        //
+        // Each topic is `{id, emoji, title, text, contributors}`: the title is the
+        // heading and the text its one note. Plain-text pane, so tags stay
+        // (`stripTags: false`); `decodeEntities` stays on because it gates the JSON
+        // unescape (`\"` in a text).
+        ChangelogRecipe(
+            bundleID: "com.xd.cindy",
+            source: URL(string: "https://hotfix.cindy.app/cindy/notice/darwin-arm64/index.json")!,
+            entryPattern: #""version"\s*:\s*"(?<version>[0-9]+\.[0-9]+\.[0-9]+)"\s*,\s*"date"\s*:\s*"(?<date>[0-9]{4}-[0-9]{2}-[0-9]{2})".*?"contentByLocale"\s*:\s*\{.*?"en"\s*:\s*\{[^{}]*?"topics"\s*:\s*\[(?<body>(?:[^\[\]]|\[[^\[\]]*\])*)\]"#,
+            itemPatterns: [#""text"\s*:\s*"(?<item>(?:[^"\\]|\\.)*)""#],
+            mode: .json,
+            stripTags: false,
+            maxEntries: 1,
+            sourceTemplate: "https://hotfix.cindy.app/cindy/notice/darwin-arm64/{version}.json",
+            headingPattern: #""title"\s*:\s*"(?<heading>(?:[^"\\]|\\.)*)""#),
+        ],
+        githubRules: [
+        // Cindy — Electron Forge app from XD Entertainment, two editions built from
+        // one repo: global (`com.xd.cindy`, this family) and cn (`com.xd.cindycn`,
+        // `Recipes/com-xd-cindycn.swift`). They are signed by different Teams and
+        // ship as separate dmgs in every release.
+        //
+        // No Sparkle and no electron-builder `app-update.yml`: the app has its own
+        // updater, which reads a manifest on `hotfix.cindy.app` and swaps in a full
+        // `.app` zip. For the stable track that manifest names the same bytes as the
+        // GitHub release's dmg, so `/releases/latest` is what the app's own stable
+        // track installs. v-tags; `CFBundleShortVersionString` and `CFBundleVersion`
+        // are both the numeric X.Y.Z, so short == build == tag.
+        //
+        // The anchors: `vX.Y.Z-beta` tags are prereleases whose Info.plist reads the
+        // bare X.Y.Z, so an unanchored pattern would offer a beta as the stable
+        // version. The `v1.0.0` release is a source snapshot with no assets; the
+        // asset pattern is what keeps `/releases/latest` from ever answering it
+        // should it become the newest. A release can carry fewer dmgs than usual
+        // (one shipped only arm64 global); the source walks back past a release with
+        // no matching asset, which is right: that edition has no such build.
+        //
+        // Assets: `cindy-<ver>-darwin-{arm64,x64}-{global,cn}.dmg`, no universal
+        // build; the arch-aware picker takes the host's. `-win32-` and `-linux-`
+        // assets are excluded by the pattern. GitHub publishes a sha256 digest for
+        // every asset. One-click: com.xd.cindy, Team SX9RG894L5, notarized.
+        //
+        // `variant` keeps the two editions' rules apart: same repo and channel would
+        // otherwise give both the id `github:makecindy/cindy:stable`, one health row.
+        //
+        // The beta and canary tracks are not tracked: the switch is a device setting
+        // the bundle does not show.
+        GitHubReleaseRule(
+            bundleID: "com.xd.cindy",
+            owner: "makecindy", repo: "cindy",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^cindy-[0-9]+\.[0-9]+\.[0-9]+-darwin-(?:arm64|x64)-global\.dmg$"#,
+            installerKind: .dmg,
+            variant: "global"),
+        ])
+}
