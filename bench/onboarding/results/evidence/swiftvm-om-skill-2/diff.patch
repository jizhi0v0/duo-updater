+import Foundation
+
+enum com_swiftvm_app {
+    static let set = AppRecipeSet(
+        family: "com-swiftvm-app",
+        changelogs: [
+        // SwiftVM — detected by the generic Sparkle source (stable copies declare
+        // an untagged appcast; beta copies a `beta`-tagged one, see
+        // `SwiftVMChannel`). Neither appcast inlines notes: each item names only
+        // its GitHub release page as `fullReleaseNotesLink`, so the notes come
+        // from the release bodies of swiftvm-app/swiftvm.
+        //
+        // One Releases list, both tracks: stable is `vX.Y.Z`, beta `vX.Y.Z-beta.N`,
+        // and GitHub's `prerelease` bit is set on exactly the betas, plus the
+        // rolling `beta-channel` release that only hosts `appcast-beta.xml`. The
+        // tag patterns keep that one out and read the version each appcast
+        // offers. The beta recipe does not set `includesPromotedStable`: a beta
+        // copy's feed lists `-beta.N` builds only, never the stable release a
+        // beta is promoted to.
+        ChangelogRecipe(
+            bundleID: "com.swiftvm.app",
+            source: URL(string: "https://api.github.com/repos/swiftvm-app/swiftvm/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .stable,
+            structuredFormat: .gitHubReleases,
+            tagPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#),
+
+        ChangelogRecipe(
+            bundleID: "com.swiftvm.app",
+            source: URL(string: "https://api.github.com/repos/swiftvm-app/swiftvm/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .beta,
+            structuredFormat: .gitHubReleases,
+            tagPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+-beta\.[0-9]+)$"#),
+        ])
+}
