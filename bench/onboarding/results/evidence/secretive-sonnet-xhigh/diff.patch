@@ -0,0 +1,30 @@
+import Foundation
+
+enum com_maxgoedjen_Secretive_Host {
+    static let set = AppRecipeSet(
+        family: "com-maxgoedjen-Secretive-Host",
+        githubRules: [
+        // Secretive — Secure Enclave SSH agent. The bundle id is the host app's
+        // `.Host`, not `com.maxgoedjen.Secretive`. No SUFeedURL, no MAS listing;
+        // the Homebrew cask only answers a brew-installed copy, so a direct
+        // download has no other source. Its own updater (the SecretiveUpdater
+        // XPC service) GETs this repo's public releases list and only opens the
+        // release page: no device id, no staged rollout, no patch, so the newest
+        // non-prerelease release IS what the vendor offers.
+        // Tags are `vX.Y.Z` and equal CFBundleShortVersionString (CFBundleVersion
+        // is `1.<CI run id>`, not compared). The anchor refuses the repo's
+        // non-release tags (`v3.0.1-skipped`, `v0.0.0_test`, `v0.0.0_beta1`).
+        // The one asset is a universal `Secretive.zip`; Team Z72PRUAWF6,
+        // notarized. The release body states `## Minimum macOS Version`, which
+        // this source has no way to read; it cannot exclude a host here because
+        // the app runs on macOS 15+ and 4.x asks for 15.0 — re-check if a
+        // release states a higher floor. Nightlies (`0.0.0_nightly-<date>`) are
+        // Actions artifacts, not releases, and are not covered.
+        GitHubReleaseRule(
+            bundleID: "com.maxgoedjen.Secretive.Host",
+            owner: "maxgoedjen", repo: "secretive",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^Secretive\.zip$"#,
+            installerKind: .zip),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SecretiveGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SecretiveGitHubRuleTests.swift
new file mode 100644
index 0000000..b744c57
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/SecretiveGitHubRuleTests.swift
@@ -0,0 +1,155 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Secretive publishes plain `vX.Y.Z` releases from one repo, each carrying a
+/// single universal `Secretive.zip`, and writes its notes under fixed headings
+/// that are not all changes (`Minimum macOS Version`, `Build`, `Attestation`).
+/// The bundle id is the host app's, `.Host` — the cask's `uninstall quit:` names
+/// the same id. These tests pin the contract the rule relies on.
+@Suite struct SecretiveGitHubRuleTests {
+
+    private static let bundleID = "com.maxgoedjen.Secretive.Host"
+
+    private func rule() throws -> GitHubReleaseRule {
+        try #require(GitHubReleaseRegistry.rules.first { $0.bundleID == Self.bundleID })
+    }
+
+    // MARK: - Which release the rule accepts
+
+    @Test func theRuleReadsTheLatestStableReleaseOfTheVendorRepo() throws {
+        let rule = try rule()
+        #expect(rule.slug == "maxgoedjen/secretive")
+        #expect(rule.usePrereleases == false)
+        #expect(rule.channel == .stable)
+    }
+
+    /// `v4.0.0` is the tag, `4.0.0` is the installed `CFBundleShortVersionString`
+    /// — the two must be the same string or every install reads as outdated.
+    @Test func aReleaseTagYieldsTheBundlesOwnMarketingVersion() throws {
+        let rule = try rule()
+        #expect(VendorProbeRecipe.extractVersion(from: "v4.0.0", pattern: rule.versionPattern) == "4.0.0")
+        #expect(VendorProbeRecipe.extractVersion(from: "v3.0.4", pattern: rule.versionPattern) == "3.0.4")
+    }
+
+    /// The repo carries three tags that are not releases, plus the `_betaN`
+    /// shape the app's own version parser documents. The anchor must refuse every
+    /// one, so the list fallback (a release without the zip) can never walk onto
+    /// one of them.
+    @Test func theAnchorRefusesStrayNonReleaseTags() throws {
+        let rule = try rule()
+        for tag in ["v3.0.1-skipped", "v0.0.0_test", "v0.0.0_beta1", "v4.1.0_beta1", "4.0.0.zip"] {
+            #expect(
+                VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == nil,
+                "\(tag) must not read as a release version")
+        }
+    }
+
+    // MARK: - Which asset it installs
+
+    /// Every release has exactly one asset, `Secretive.zip`, built for
+    /// x86_64 + arm64 + arm64e. No architecture marker in the name means the
+    /// selector treats it as arch-neutral, which is right for either Mac.
+    @Test func theOneUniversalZipIsInstallableOnEitherArchitecture() throws {
+        let rule = try rule()
+        let pattern = try #require(rule.installAssetPattern)
+        #expect(rule.installerKind == .zip)
+        let assets: [(name: String, url: URL, size: Int64?)] = [
+            ("Secretive.zip",
+             URL(string: "https://github.com/maxgoedjen/secretive/releases/download/v4.0.0/Secretive.zip")!,
+             22_831_028),
+        ]
+        for arch in HostArch.allCases {
+            let asset = GitHubReleaseRule.installableAsset(
+                from: assets, matching: pattern, preferring: arch, allowingIntelTranslation: false)
+            #expect(asset?.url.lastPathComponent == "Secretive.zip", "no asset for \(arch)")
+        }
+    }
+
+    /// Anchored, so a future sibling artifact (a CLI zip, a `.dSYM.zip`) is not
+    /// installed in place of the app.
+    @Test func theAssetPatternDoesNotTakeASiblingArchive() throws {
+        let rule = try rule()
+        let pattern = try #require(rule.installAssetPattern)
+        for name in ["Secretive.dSYM.zip", "Secretive-cli.zip", "Secretive.zip.sha256", "secretive.zip"] {
+            #expect(
+                name.range(of: pattern, options: .regularExpression) == nil,
+                "\(name) must not be installable")
+        }
+    }
+
+    // MARK: - The notes
+
+    /// The body of v4.0.0 as GitHub serves it (CRLF line endings; contributor
+    /// handles replaced with a placeholder). Besides the two change lists it
+    /// carries headings that name no change: the OS floor, the CI run, the
+    /// attestation, the contributor roll and the compare link.
+    private static let body400: String = [
+        "Secretive 4 is here with big improvements in stacked requests, request usage attribution, first class SSH Certificate support, and support for macOS 27.",
+        "",
+        "## Features",
+        "- macOS 27 Support",
+        "- OpenSSH protocol cleanup (#775)",
+        "- LAContext persistence for smart cards (#760)",
+        "- SSH Certificate UI (#798, #802)",
+        "- OpenSSH extensions support (#823)",
+        "- Support for looking up hosts from `known_hosts` file (#826)",
+        "- Secure settings storage (#831)",
+        "- Pending requests UI (#821)",
+        "",
+        "## Fixes",
+        "- Fix macOS 27 UI issues (#814, #774)",
+        "- Fix context menu display on macOS 14 (#774)",
+        "- Various CI and config fixes (#767, #773, #807, #781, #833, #793, #824, #801, #768, #822, #800, #806, #783, #837, #829, #828)",
+        "- Fix SSH ECDSA signature mpint encoding (#772)",
+        "- Fix race condition in SocketController (#769)",
+        "- Use separate socket for debug builds (#766)",
+        "- Fix internet access policy linking (#794)",
+        "- PT-BR localization fixes (#804)",
+        "- Keychain fixes (#830)",
+        "- Log cleanup (#832)",
+        "- LLM usage policy (#799)",
+        "",
+        "## Minimum macOS Version",
+        "15.0.0",
+        "",
+        "## Build",
+        "https://github.com/maxgoedjen/secretive/actions/runs/35554366823",
+        "",
+        "## Attestation",
+        "https://github.com/maxgoedjen/secretive/attestations/48827601",
+        "",
+        "## New Contributors",
+        "* @contributor made their first contribution in https://github.com/maxgoedjen/secretive/pull/769",
+        "* @contributor made their first contribution in https://github.com/maxgoedjen/secretive/pull/772",
+        "",
+        "## Full Changelog",
+        "https://github.com/maxgoedjen/secretive/compare/v3.0.4...v4.0.0",
+    ].joined(separator: "\r\n")
+
+    /// The structured changelog is exactly the 8 features and 11 fixes. None of
+    /// the bookkeeping sections leaks in as a change, and the two real category
+    /// headings survive as styled blocks while `Minimum macOS Version`, `Build`
+    /// and `Attestation` — headings with no bullet under them — do not. A lone
+    /// trailing `(#775)` pull-request reference is stripped from its line.
+    @Test func theReleaseBodyParsesToTheTwoChangeListsAndNothingElse() throws {
+        let entry = try #require(GitHubMarkdownParser.parse(
+            body: Self.body400, version: "4.0.0", date: "2026-09-21T03:08:01Z")?.entries.first)
+        #expect(entry.version == "4.0.0")
+        #expect(entry.items.count == 19)
+        #expect(entry.items.first == "macOS 27 Support")
+        #expect(entry.items[1] == "OpenSSH protocol cleanup")
+        #expect(entry.items.last == "LLM usage policy")
+        for noise in ["15.0.0", "actions/runs", "attestations", "contributor", "compare/", "Secretive 4 is here"] {
+            #expect(
+                !entry.items.contains { $0.contains(noise) },
+                "bookkeeping text \(noise) leaked into the change list")
+        }
+        let headings = entry.content.compactMap { block -> String? in
+            if case .heading(let text) = block { return text }
+            return nil
+        }
+        #expect(headings == ["Features", "Fixes"])
+    }
+}
