diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-xd-cindy.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-xd-cindy.swift
new file mode 100644
index 0000000..e14fef5
--- /dev/null
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-xd-cindy.swift
@@ -0,0 +1,92 @@
+import Foundation
+
+enum com_xd_cindy {
+    // The two regions' notes are the same GitHub release bodies, so the two
+    // changelog recipes share their patterns.
+    //
+    // `.gitHubReleases` cannot read this vendor's bodies: every release ends
+    // `---` and seven to nine `- commit: …` / `- iOS(cn): …` bullets (build
+    // provenance and the mobile apps' versions), and with no `## PRs` heading
+    // above them nothing a recipe can name marks them as boilerplate, so the
+    // generic parser's "changes" were those bullets (v0.1.104: 7 items, none of
+    // them a change). So this reads the raw JSON, like Headlamp's recipe does.
+    //
+    // A body is `Desktop release X` over `## 更新说明`, then one `### <emoji>
+    // <title>` heading per change with ONE paragraph under it (218 sections in
+    // the newest 28 stable releases, none with a second line), then an optional
+    // `## PRs` link line and the `---` block. The item is the paragraph under
+    // each `###`; nothing else in the body matches, so the preamble, the PR
+    // links and the provenance bullets are never seen. Trailing `@handle`
+    // credits are left out of the item (174 of the 218 paragraphs end in one).
+    //
+    // Everything is matched on the JSON text, before it is unescaped, so a
+    // newline is the two characters `\n` and a character class must not stop at
+    // an escaped quote (`(?:\\[^rn]|[^"\\])`, as in Headlamp's recipe). `\s*` around
+    // each colon: GitHub serves this document both compact and pretty-printed.
+    //
+    // `v<digits>.<digits>.<digits>"` closes on the quote, which is what skips the
+    // `-beta` tags, and `"prerelease":false` is the same policy as
+    // `.gitHubReleases` states: the track the stable rule below is on. The gaps
+    // between fields refuse to cross a `"tag_name":` so a release with a null
+    // body cannot pair its version with the next release's notes.
+    private static let entryPattern =
+        #""tag_name"\s*:\s*"v(?<version>[0-9]+\.[0-9]+\.[0-9]+)""#
+        + #"(?:(?!"tag_name"\s*:).)*?"prerelease"\s*:\s*false\s*,"#
+        + #"(?:(?!"tag_name"\s*:).)*?"published_at"\s*:\s*"(?<date>[^"T]+)T"#
+        + #"(?:(?!"tag_name"\s*:).)*?"body"\s*:\s*"(?<body>(?:\\.|[^"\\])*)""#
+    private static let itemPattern =
+        #"\\(?:r\\)?n###[ \t]+(?:\\[^rn]|[^"\\])+?\\(?:r\\)?n(?:\\(?:r\\)?n)*(?!#)"#
+        + #"(?<item>(?:\\[^rn]|[^"\\])+?)(?:[ \t]+@[A-Za-z0-9][A-Za-z0-9_.-]*)*[ \t]*(?=\\(?:r\\)?n)"#
+    private static let headingPattern =
+        #"\\(?:r\\)?n###[ \t]+(?<heading>(?:\\[^rn]|[^"\\])+?)[ \t]*(?=\\(?:r\\)?n)"#
+
+    private static func changelog(bundleID: String) -> ChangelogRecipe {
+        ChangelogRecipe(
+            bundleID: bundleID,
+            source: URL(
+                string: "https://api.github.com/repos/makecindy/cindy/releases?per_page=40")!,
+            entryPattern: entryPattern,
+            itemPatterns: [itemPattern],
+            mode: .json,
+            markdownSource: true,
+            maxEntries: 20,
+            headingPattern: headingPattern)
+    }
+
+    static let set = AppRecipeSet(
+        family: "com-xd-cindy",
+        changelogs: [
+        changelog(bundleID: "com.xd.cindy"),
+        changelog(bundleID: "com.xd.cindycn"),
+        ],
+        githubRules: [
+        // Cindy — Electron desktop agent (makecindy/cindy, Apache-2.0). No
+        // SUFeedURL, no app-update.yml, no cask: it updates itself from its own
+        // CDN manifest (`manifest-darwin-<arch>.json`), which names the same dmg
+        // bytes GitHub carries (sha256 and size equal, both regions, 0.1.104).
+        // The release's `prerelease` flag is the beta track and `/releases/latest`
+        // leaves it out; the beta tags are also refused by the anchored pattern.
+        //
+        // Two apps, one release. The region is baked into the build: global is
+        // `com.xd.cindy` (Team SX9RG894L5), cn is `com.xd.cindycn` (Team
+        // NTC4BJ542G), both `Cindy.app`, both notarized, short == build == tag
+        // without the `v` (0.1.103 and 0.1.104 checked for both). Each release
+        // carries `-global` and `-cn` dmgs for arm64 and x64; each rule names its
+        // own region so a copy is never handed the other region's Team.
+        // Both read the same repo on the same channel, which is why
+        // `GitHubReleaseRule.recipeID` names the bundle when a registry sibling
+        // shares the repo and channel.
+        GitHubReleaseRule(
+            bundleID: "com.xd.cindy",
+            owner: "makecindy", repo: "cindy",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^cindy-[0-9.]+-darwin-(?:arm64|x64)-global\.dmg$"#,
+            installerKind: .dmg),
+        GitHubReleaseRule(
+            bundleID: "com.xd.cindycn",
+            owner: "makecindy", repo: "cindy",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^cindy-[0-9.]+-darwin-(?:arm64|x64)-cn\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
index b463f16..57466be 100644
--- a/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Sources/GitHubReleasesSource.swift
@@ -423,7 +423,23 @@ public extension GitHubReleaseRule {
     /// decides a row is orphaned when no rule produces its key. A second,
     /// separately-maintained spelling of this string would make the prune delete
     /// live rows the first time the two drifted.
-    var recipeID: String { "github:\(slug):\(channel.rawValue)" }
+    ///
+    /// The channel splits two rules on one repo (Zed and Zed Preview). It does
+    /// not split two rules on one repo AND channel, which is what a vendor
+    /// shipping one app per region makes (Cindy: `com.xd.cindy` and
+    /// `com.xd.cindycn` read the same releases, each its own region's dmg): they
+    /// would share one health row and one baseline entry, and whichever ran last
+    /// would decide the verdict for both. So when the registry holds a second
+    /// rule for the same repo and channel, the id also names the bundle. Every
+    /// rule that is alone on its repo and channel keeps the bare id, which is
+    /// what the baseline already files it under.
+    var recipeID: String {
+        let id = "github:\(slug):\(channel.rawValue)"
+        let shared = GitHubReleaseRegistry.rules.contains {
+            $0.slug == slug && $0.channel == channel && $0.bundleID != bundleID
+        }
+        return shared ? "\(id):\(bundleID)" : id
+    }
 }
 
