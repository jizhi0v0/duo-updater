    "No rollback point: parts of this app aren’t readable by you (common for apps installed by a .pkg, which are often root-owned).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Rücksetzpunkt: Teile dieser App sind für dich nicht lesbar (üblich bei Apps, die per .pkg installiert wurden und oft root gehören)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
