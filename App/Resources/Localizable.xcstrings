          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha già scaricato un aggiornamento — riapri per applicarlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでにアップデートをダウンロード済みです — 再起動して適用してください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já baixou uma atualização — reabra para aplicar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже загрузило обновление — перезапустите, чтобы применить"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir güncellemeyi zaten indirdi — uygulamak için yeniden başlatın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下载更新 — 重新启动以应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下載更新 — 重新開啟即可套用"
          }
        }
      }
    },
    "%@ has already downloaded an update and will apply it when you quit it — installing now would collide with it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat bereits ein Update heruntergeladen und installiert es beim Beenden – eine Installation jetzt würde damit kollidieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya descargó una actualización y la instalará cuando lo cierres: instalar ahora chocaría con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a déjà téléchargé une mise à jour et l’installera à sa fermeture — installer maintenant entrerait en conflit avec elle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha già scaricato un aggiornamento e lo applicherà quando la chiuderai: installare ora entrerebbe in conflitto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでにアップデートをダウンロード済みで、終了時に適用します。今インストールするとそれと衝突します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já baixou uma atualização e vai aplicá-la quando você o encerrar — instalar agora entraria em conflito com ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже загрузил обновление и установит его при выходе — установка сейчас столкнётся с ним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir güncellemeyi zaten indirdi ve siz uygulamadan çıktığınızda uygulayacak — şimdi yüklerseniz onunla çakışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已经下载好更新，会在你退出它时安装 —— 现在装会和它冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下載更新，會在你結束它時套用——現在安裝會與它衝突。"
          }
        }
      }
    },
    "%@ has its own update downloaded and waiting for the app to quit. Relaunching from here would install that one over the version now on disk, so it wasn't relaunched — quit %@ yourself when you're ready to take theirs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat ein eigenes Update heruntergeladen und wartet darauf, dass die App beendet wird. Ein Neustart von hier aus würde dieses über die Version installieren, die jetzt auf der Festplatte liegt – deshalb wurde nicht neu gestartet. Beende %@ selbst, wenn du deren Update übernehmen möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya ha descargado su propia actualización y espera a que la app se cierre. Reabrir desde aquí instalaría esa por encima de la versión que hay ahora en el disco, así que no se reabrió: cierra %@ tú cuando quieras aceptar la suya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a téléchargé sa propre mise à jour et attend que l’app soit quittée. Relancer depuis ici installerait celle-ci par-dessus la version actuellement sur le disque, donc rien n’a été relancé — quitte %@ toi-même quand tu veux prendre la leur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha già scaricato un proprio aggiornamento, in attesa che l’app venga chiusa. Riaprirla da qui installerebbe quello sopra la versione ora sul disco, quindi non è stata riaperta: chiudi tu %@ quando vuoi applicare il loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は自前の更新をダウンロード済みで、アプリの終了を待っています。ここから再起動すると、現在ディスクにあるバージョンの上にそれが上書きされるため、再起動はしていません。相手側の更新を適用したくなったら、%@ を自分で終了してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já baixou a própria atualização e está esperando o app ser encerrado. Reabrir daqui instalaria essa por cima da versão que está no disco agora, então ele não foi reaberto — encerre %@ você mesmo quando quiser ficar com a deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже скачало собственное обновление и ждёт, когда приложение будет закрыто. Перезапуск отсюда установил бы его поверх версии, которая сейчас на диске, поэтому перезапуск не выполнен — закройте %@ сами, когда захотите принять их обновление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kendi güncellemesini indirdi ve uygulamanın kapanmasını bekliyor. Buradan yeniden başlatmak o güncellemeyi diskteki sürümün üzerine yükleyecekti; bu yüzden yeniden başlatılmadı — onların sürümüne geçmeye hazır olduğunuzda %@ uygulamasından kendiniz çıkın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已经下载好它自己的更新，正等着这个 app 退出。从这里重新启动会把那份更新覆盖到当前磁盘上的版本，所以没有重新启动 —— 想用它们那份的时候，请自己退出 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已下載它自己的更新，正在等這個 App 結束。從這裡重新開啟會讓那份更新蓋過目前磁碟上的版本，所以沒有重新開啟——想改用它那一份時，請自行結束 %@。"
          }
        }
      }
    },
    "%@ has already downloaded an update itself, but which version can't be read from here — usually because it installs with administrator rights. Relaunch to apply it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat bereits selbst ein Update heruntergeladen, aber welche Version, lässt sich von hier aus nicht lesen – meist, weil es mit Administratorrechten installiert. Neu starten, um es anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya descargó una actualización por su cuenta, pero desde aquí no se puede leer qué versión es; normalmente porque se instala con permisos de administrador. Reabre para aplicarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a déjà téléchargé une mise à jour lui-même, mais sa version ne peut pas être lue d’ici — généralement parce qu’il s’installe avec des droits d’administrateur. Relancez pour l’appliquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha già scaricato da sola un aggiornamento, ma da qui non si può leggere quale versione, di solito perché si installa con i privilegi di amministratore. Riapri per applicarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに自分でアップデートをダウンロード済みですが、どのバージョンかはここから読み取れません（通常は管理者権限でインストールするためです）。再起動して適用してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já baixou uma atualização sozinho, mas não dá para ler daqui qual versão — geralmente porque ele instala com privilégios de administrador. Reabra para aplicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже само загрузило обновление, но какую версию — отсюда прочитать нельзя: обычно потому, что оно устанавливается с правами администратора. Перезапустите, чтобы применить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir güncellemeyi kendisi zaten indirdi, ancak hangi sürüm olduğu buradan okunamıyor — genellikle yönetici yetkileriyle yüklendiği için. Uygulamak için yeniden başlatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已自行下载了更新，但从这里读不到是哪个版本 —— 通常是因为它以管理员权限安装。重新启动以应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已自行下載更新，但從這裡讀不到是哪個版本——通常是因為它以管理者權限安裝。重新開啟即可套用。"
          }
        }
      }
    },
