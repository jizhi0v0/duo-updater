@@ -0,0 +1,95 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Two releases from `api.github.com/repos/tommy0103/obelisk/releases` (fetched
+/// 2026-10-14), bodies verbatim, trimmed to the fields the decoder reads. v0.2.5
+/// is the newest and ends in `## Included work` (the PR credit roll);
+/// v0.2.2 has both that and a `## Downloads` list of asset file names.
+private let obeliskReleasesFixture = #"""
+[{"tag_name":"v0.2.5","prerelease":false,"draft":false,"published_at":"2026-10-08T19:06:20Z","body":"Obelisk 0.2.5 brings together the work since 0.2.4: complete browsing of large session archives, reliable Copilot discovery across VS Code Stable and Insiders, local Kiro CLI history, and clearer setup documentation.\n\n## Highlights\n\n- **All your indexed sessions within reach.** The desktop catalogue no longer stops at the newest 1,000 sessions. Counts, metadata search, project/source filters, and oldest-first sorting cover the complete indexed history.\n- **Copilot history from both VS Code editions.** Discover Stable and Insiders by default, choose either folder independently in Settings, or select a custom folder.\n- **Kiro CLI joins the index.** Browse local messages, reasoning, tools, and reported usage across supported native formats, with child agents and compaction context in V3 histories.\n- **Clearer installation and setup.** A reorganized README and a new Chinese README make installation and everyday use easier to find, with updated Copilot source guidance.\n\n## Updates\n\n### Complete session browsing\n\n- Load the complete session metadata catalogue instead of only the newest 1,000 entries. Older indexed conversations remain reachable through the Sessions list and metadata search.\n- Make the Sessions badge, project navigation, and source/project filters cover the full catalogue, including projects whose conversations all fall outside the previously loaded subset.\n- Let oldest-first sorting reach the oldest matching conversation, rather than reversing a truncated recent list.\n- Open valid older sessions through direct links even when their metadata has not been loaded into the catalogue. Message detail remains loaded on demand.\n- Align statistics and project requests with the same all-source scope as the session catalogue.\n\n### Copilot history from Stable and Insiders\n\n- Fix the desktop worker handoff so default discovery indexes both **VS Code Stable and VS Code Insiders**, matching the folders watched for changes. Insiders-only installations are recognized as available sources.\n- Add two default-enabled folder switches in **Settings**, plus a custom-folder override. An explicitly selected custom folder continues to select that folder alone.\n- Keep the latest folder selection when settings writes or responses arrive late during indexing. Later refreshes also preserve unsaved recap-path edits.\n- Reconcile deleted transcript and Chronicle sessions correctly when a source path contains a literal `#`, while retaining the last indexed history for unavailable sources.\n- Turning a folder off retains its already indexed sessions during ordinary refresh. A deliberate **full rebuild** includes only enabled folders; excluding a folder does not itself count as deleting its source history.\n\n### Kiro CLI history\n\n- Add **Kiro CLI** as a local history source, reading the native SQLite store and supported CLI/workspace JSON and JSONL session layouts. Discover standard local paths and support custom/exported roots.\n- Index prompts, assistant text and reasoning, tools/results, and reported V1/V2 token counts. Source SQLite databases are opened read-only.\n- Preserve **V3 child agents, compaction summaries, and tangent sessions**, with links where the source records them. V1/V2 histories retain the context their native formats provide without inventing parent links.\n- Retain **V3 credits and context-usage percentages** as searchable metadata. Credits are not converted to tokens; V3 token counters remain unknown.\n- Avoid duplicate sessions from copied histories by combining native session identity with the normalized working directory. Track updates through the existing indexing and query interfaces.\n- Keep the scope to local history. Cloud history and `.history` line-editor copies are excluded.\n\n### Documentation and contribution guidance\n\n- Reorder the README around installation, everyday use, and deeper reference material, and add **README.zh-CN.md**.\n- Clarify where Copilot history is stored and how to configure its sources; document the new Kiro source in the READMEs, CLI documentation, and packaged skills.\n- Route source-root changes through shared guidance covering discovery, settings, watching, restart, full rebuild, and safe reconciliation.\n\n## Installation\n\n**macOS:** choose the DMG matching your Mac — **arm64** for Apple Silicon or **x64** for Intel — and install Obelisk.app in Applications. Both architectures are Developer ID signed and notarized.\n\n**Linux Intel/AMD 64-bit:** download `Obelisk-0.2.5-linux-amd64.deb` and install it with:\n\n```sh\nsudo apt install ./Obelisk-0.2.5-linux-amd64.deb\n```\n\nExisting **0.2.4 installations can upgrade through the app**. Use **Settings → About** to check manually, or use the sidebar update notice when the download is ready. Linux installation asks for administrator authorization. Existing **0.2.2 installations**, and older Linux builds without the updater, require one manual upgrade.\n\nThis release supplies **macOS DMG/ZIP and Linux amd64 Debian packages**. The Linux installer and two-version upgrades are verified on Ubuntu 22.04 and 24.04. Linux arm64, AppImage and Windows distribution/update channels remain outside this release. Shared Core and CLI documentation work is included in the source; the CLI keeps its separate npm release lifecycle.\n\n## Included work\n\nAll **6 merged pull requests** since [v0.2.4](https://github.com/tommy0103/obelisk/releases/tag/v0.2.4), including documentation and release preparation.\n\n- **@tommy0103 (owner)** — Reorganize the README and add a Chinese version; apply Copilot settings/reconciliation fixes; and prepare the desktop release. Included PRs: [#224](https://github.com/tommy0103/obelisk/pull/224), [#225](https://github.com/tommy0103/obelisk/pull/225), [#226](https://github.com/tommy0103/obelisk/pull/226).\n- Clarify Copilot history sources and setup — @22Goose ([#215](https://github.com/tommy0103/obelisk/pull/215)).\n- Make sessions beyond 1,000 reachable — @22Goose ([#217](https://github.com/tommy0103/obelisk/pull/217)).\n- Add the Kiro CLI history provider — @athemeroy ([#223](https://github.com/tommy0103/obelisk/pull/223)).\n- Discover Copilot Insiders history and select VS Code folders — @22Goose ([#225](https://github.com/tommy0103/obelisk/pull/225)).\n\n**Full changes:** [v0.2.4 → v0.2.5 release source](https://github.com/tommy0103/obelisk/compare/v0.2.4...7e8ea3336b31c1660ebbc688924b1d12283494a4).\n"},
+ {"tag_name":"v0.2.2","prerelease":false,"draft":false,"published_at":"2026-08-03T20:59:06Z","body":"Obelisk brings Claude Code, Codex, and Kimi Code sessions into the same local SQLite evidence layer — searchable by agents and browsable in the desktop app.\r\n\r\nThis release makes that evidence easier to inspect and navigate, while fixing provider edge cases and modernizing the Electron runtime.\r\n\r\n## Highlights\r\n\r\n- Render Markdown images directly inside session messages\r\n- Open local file references at the referenced line in your editor\r\n- Choose VS Code, VS Code Insiders, Cursor, Windsurf, or Zed\r\n- Exclude never-started Kimi Code placeholder sessions\r\n- Prevent missing Codex token usage from rolling back session indexing\r\n- Upgrade the desktop app from Electron 33 to Electron 43\r\n- Update macOS arm64 and Linux amd64 desktop packages\r\n- Update the `@obelisk-apps/cli` npm package\r\n\r\n## Session images\r\n\r\n- Displays Markdown images within the session reading column\r\n- Preserves the intrinsic size of smaller images\r\n- Prevents wide images from introducing horizontal overflow\r\n- Keeps virtual timeline rows measured without overlap\r\n- Preserves the reader position while images load or progressively decode\r\n- Uses a consistent “Image unavailable” state for blocked or failed images\r\n- Restricts image sources to supported local, remote, blob, and image-data protocols\r\n- Supports both current and newer `marked` image-renderer signatures\r\n\r\n## Local file references\r\n\r\n- Absolute Markdown paths are now clickable\r\n- Inline references such as `src/app.ts:42` open at the referenced line\r\n- Supports line, column, and line-range suffixes\r\n- Resolves relative paths against the originating message working directory\r\n- Prevents local links from navigating the desktop app away from the current session\r\n- Restricts references to known session and project roots\r\n- Resolves symlinks before opening files to prevent paths from escaping those roots\r\n- Adds an editor URL scheme selector under Settings\r\n\r\nSupported editors:\r\n\r\n- VS Code\r\n- VS Code Insiders\r\n- Cursor\r\n- Windsurf\r\n- Zed\r\n\r\n## Provider and indexing fixes\r\n\r\n- Never-started Kimi sessions titled `New Session` are no longer indexed\r\n- Previously indexed Kimi placeholders are automatically retracted\r\n- Kimi sessions containing a real user prompt remain visible even if metadata has not caught up\r\n- Missing or invalid Codex token usage is normalized to `null`\r\n- Codex `token_count` events without usage no longer cause `node:sqlite` binding failures\r\n- A malformed usage event can no longer roll back the entire session transaction\r\n\r\n## Runtime and reliability\r\n\r\n- Upgraded Electron from 33 to 43\r\n- Upgraded the embedded Node.js runtime from 20 to 24\r\n- Upgraded `better-sqlite3` from 11 to 13 for Electron 43 ABI compatibility\r\n- Upgraded `electron-builder` from 25 to 26\r\n- Added a unified Electron test runner covering:\r\n  - SQLite concurrency\r\n  - Session images\r\n  - Timeline virtualization\r\n  - Reader-state restoration\r\n  - Local file references\r\n- Removed obsolete generated demo HTML artifacts\r\n- 306 automated Node tests and all 5 Electron suites pass\r\n\r\n## Compatibility\r\n\r\n- macOS now requires macOS 12 Monterey or newer\r\n- CLI and source builds require Node.js 22.13 or newer\r\n\r\n## Downloads\r\n\r\n- `Obelisk-0.2.2-mac-arm64.dmg`\r\n- `Obelisk-0.2.2-mac-arm64.zip`\r\n- `Obelisk-0.2.2-linux-amd64.deb`\r\n\r\n## Install the Linux package\r\n\r\n```bash\r\nsudo apt install ./Obelisk-0.2.2-linux-amd64.deb\r\n```\r\n\r\n## Install or update the CLI\r\n\r\nRequires Node.js 22.13 or newer.\r\n\r\n```bash\r\nnpm install --global @obelisk-apps/cli@0.2.2\r\nobelisk install\r\n```\r\n\r\nVerify the installed version:\r\n\r\n```bash\r\nobelisk --version\r\n```\r\n\r\n## macOS installation\r\n\r\nThe macOS build is currently unsigned and not notarized.\r\n\r\nAfter copying Obelisk to `/Applications`, remove the quarantine attribute before opening it:\r\n\r\n```bash\r\nxattr -dr com.apple.quarantine /Applications/Obelisk.app\r\n```\r\n\r\nOnly bypass quarantine for the package downloaded from this release.\r\n\r\n## Included work\r\n\r\n- #3 — Normalize missing Codex token usage \r\n- #19 — Upgrade Electron 33 → 43\r\n- #20 — Open local file references at the referenced line\r\n- #24 — Exclude empty Kimi placeholder sessions\r\n- #25 — Render Markdown images within session bounds @KinomotoMio \r\n\r\n**Full changes:** [`[28fa99a... 47df0fe](https://github.com/tommy0103/obelisk/compare/28fa99a... 47df0fe)`](https://github.com/tommy0103/obelisk/compare/28fa99a...47df0fe)"}]
+"""#
+
+@Suite struct ObeliskChangelogRecipeTests {
+
+    /// Obelisk's update source is the Sparkle appcast its own `SUFeedURL` names
+    /// (`releases/latest/download/appcast-<arch>.xml`), so detection and one-click
+    /// need no recipe. Its NOTES come from GitHub: that appcast carries the release
+    /// body as XML-escaped Markdown with no `sparkle:format`, so the pane would
+    /// print it raw, and each feed holds one `<item>` and no history.
+    @Test func readsGitHubReleases() throws {
+        let recipe = try #require(ChangelogRecipeRegistry.recipe(forBundleID: "com.obelisk.app"))
+        #expect(recipe.structuredFormat == .gitHubReleases)
+        #expect(recipe.mode == .json)
+        #expect(recipe.source.host == "api.github.com")
+        #expect(recipe.source.path == "/repos/tommy0103/obelisk/releases")
+        #expect(recipe.maxEntries == 20)
+        #expect(recipe.skipSections == ["Included work", "Downloads"])
+    }
+
+    /// Newest first, `v` stripped so the rail version matches
+    /// `CFBundleShortVersionString` (`v0.2.5` → `0.2.5`, which is what the real
+    /// bundle reports), dates as ISO days.
+    @Test func versionsAndDatesMatchTheInstalledVersionScheme() throws {
+        let log = try decode()
+        #expect(log.entries.map(\.version) == ["0.2.5", "0.2.2"])
+        #expect(log.entries.map(\.date) == ["2026-10-08", "2026-08-03"])
+    }
+
+    /// The vendor's own section headings survive as headings, not as items —
+    /// `Highlights` plus the `###` groups under `## Updates` (the `## Updates`
+    /// heading itself holds no bullet of its own).
+    @Test func keepsTheVendorsSectionHeadings() throws {
+        let log = try decode()
+        #expect(headings(of: log.entries[0]) == [
+            "Highlights", "Complete session browsing", "Copilot history from Stable and Insiders",
+            "Kiro CLI history", "Documentation and contribution guidance",
+        ])
+        #expect(headings(of: log.entries[1]) == [
+            "Highlights", "Session images", "Local file references",
+            "Provider and indexing fixes", "Runtime and reliability", "Compatibility",
+        ])
+        #expect(log.entries.allSatisfy { entry in
+            !entry.items.contains { $0 == "Highlights" || $0 == "Updates" }
+        })
+    }
+
+    /// `## Included work` is one credit line per merged PR and `## Downloads` is a
+    /// list of asset names; neither is a change, and the first alone is half of a
+    /// large release's lines (0.2.4: 43 of 95). Both are named in `skipSections`.
+    @Test func dropsTheCreditRollAndTheDownloadList() throws {
+        let log = try decode()
+        #expect(!log.entries.contains { $0.items.contains { $0.contains("pull/2") } })
+        #expect(!log.entries.contains { $0.items.contains { $0.contains("@tommy0103 (owner)") } })
+        #expect(!log.entries.contains { $0.items.contains { $0.contains("mac-arm64.dmg") } })
+        #expect(!log.entries.contains { $0.content.contains(.heading("Included work")) })
+        #expect(!log.entries.contains { $0.content.contains(.heading("Downloads")) })
+    }
+
+    /// The bullets under the kept headings are the changes, in document order.
+    @Test func keepsTheChangeBullets() throws {
+        let log = try decode()
+        let latest = log.entries[0]
+        #expect(latest.items.count == 23)
+        #expect(latest.items.first?.hasPrefix("**All your indexed sessions within reach.**") == true)
+        #expect(latest.items.last?.hasPrefix("Route source-root changes through shared guidance") == true)
+        #expect(log.entries[1].items.count == 43)
+        #expect(log.entries[1].items.last == "CLI and source builds require Node.js 22.13 or newer")
+    }
+
+    private func decode() throws -> Changelog {
+        let recipe = try #require(ChangelogRecipeRegistry.recipe(forBundleID: "com.obelisk.app"))
+        return try #require(StructuredChangelogDecoder.decodeGitHubReleases(
+            obeliskReleasesFixture, maxEntries: recipe.maxEntries,
+            skipSections: recipe.skipSections))
+    }
+
+    private func headings(of entry: Changelog.Entry) -> [String] {
+        entry.content.compactMap { block in
+            if case .heading(let text) = block { return text }
+            return nil
+        }
+    }
+}
