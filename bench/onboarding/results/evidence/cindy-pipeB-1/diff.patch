+import Foundation
+
+enum com_xd_cindycn {
+    static let set = AppRecipeSet(
+        family: "com-xd-cindycn",
+        changelogs: [
+        // Cindy CN — same release pipeline and notice format as the global edition;
+        // shared rationale: Recipes/com-xd-cindy.swift. The notice lives on the cn
+        // CDN host and is worded separately from the global one.
+        ChangelogRecipe(
+            bundleID: "com.xd.cindycn",
+            source: URL(string: "https://hotfix.cindy.com.cn/cindy/notice/darwin-arm64/index.json")!,
+            entryPattern: #""version"\s*:\s*"(?<version>[0-9]+\.[0-9]+\.[0-9]+)"\s*,\s*"date"\s*:\s*"(?<date>[0-9]{4}-[0-9]{2}-[0-9]{2})".*?"contentByLocale"\s*:\s*\{.*?"en"\s*:\s*\{[^{}]*?"topics"\s*:\s*\[(?<body>(?:[^\[\]]|\[[^\[\]]*\])*)\]"#,
+            itemPatterns: [#""text"\s*:\s*"(?<item>(?:[^"\\]|\\.)*)""#],
+            mode: .json,
+            stripTags: false,
+            maxEntries: 1,
+            sourceTemplate: "https://hotfix.cindy.com.cn/cindy/notice/darwin-arm64/{version}.json",
+            headingPattern: #""title"\s*:\s*"(?<heading>(?:[^"\\]|\\.)*)""#),
+        ],
+        githubRules: [
+        // Cindy CN — `com.xd.cindycn`, Team NTC4BJ542G (the global edition is signed
+        // by a different Team), notarized. Same repo and tags as the global edition;
+        // the pattern takes only the `-cn` dmgs, so neither edition is offered the
+        // other's build. Rationale: Recipes/com-xd-cindy.swift.
+        GitHubReleaseRule(
+            bundleID: "com.xd.cindycn",
+            owner: "makecindy", repo: "cindy",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^cindy-[0-9]+\.[0-9]+\.[0-9]+-darwin-(?:arm64|x64)-cn\.dmg$"#,
+            installerKind: .dmg,
+            variant: "cn"),
+        ])
+}
