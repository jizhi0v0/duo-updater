@@ -0,0 +1,101 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Two releases from `api.github.com/repos/tommy0103/obelisk/releases` (fetched
+/// 2026-10-13), trimmed to the fields the decoder reads. Each body is trimmed to
+/// the lines the parser has to decide about — two bullets per change section, the
+/// `## Updates` umbrella over its `###` sections, the prose-and-code
+/// `Installation` / CLI-install blocks, and two or three rows of the
+/// `Included work` roster and the `Downloads` list. Every line kept is verbatim.
+private let obeliskReleasesFixture = #"""
+[
+ {
+  "tag_name": "v0.2.5",
+  "prerelease": false,
+  "draft": false,
+  "published_at": "2026-10-08T19:06:20Z",
+  "body": "Obelisk 0.2.5 brings together the work since 0.2.4: complete browsing of large session archives, reliable Copilot discovery across VS Code Stable and Insiders, local Kiro CLI history, and clearer setup documentation.\n\n## Highlights\n\n- **All your indexed sessions within reach.** The desktop catalogue no longer stops at the newest 1,000 sessions. Counts, metadata search, project/source filters, and oldest-first sorting cover the complete indexed history.\n- **Copilot history from both VS Code editions.** Discover Stable and Insiders by default, choose either folder independently in Settings, or select a custom folder.\n\n## Updates\n\n### Complete session browsing\n\n- Load the complete session metadata catalogue instead of only the newest 1,000 entries. Older indexed conversations remain reachable through the Sessions list and metadata search.\n- Make the Sessions badge, project navigation, and source/project filters cover the full catalogue, including projects whose conversations all fall outside the previously loaded subset.\n- Let oldest-first sorting reach the oldest matching conversation, rather than reversing a truncated recent list.\n\n### Kiro CLI history\n\n- Add **Kiro CLI** as a local history source, reading the native SQLite store and supported CLI/workspace JSON and JSONL session layouts. Discover standard local paths and support custom/exported roots.\n- Index prompts, assistant text and reasoning, tools/results, and reported V1/V2 token counts. Source SQLite databases are opened read-only.\n\n## Installation\n\n**macOS:** choose the DMG matching your Mac — **arm64** for Apple Silicon or **x64** for Intel — and install Obelisk.app in Applications. Both architectures are Developer ID signed and notarized.\n\n**Linux Intel/AMD 64-bit:** download `Obelisk-0.2.5-linux-amd64.deb` and install it with:\n\n```sh\nsudo apt install ./Obelisk-0.2.5-linux-amd64.deb\n```\n\n## Included work\n\nAll **6 merged pull requests** since [v0.2.4](https://github.com/tommy0103/obelisk/releases/tag/v0.2.4), including documentation and release preparation.\n\n- **@tommy0103 (owner)** — Reorganize the README and add a Chinese version; apply Copilot settings/reconciliation fixes; and prepare the desktop release. Included PRs: [#224](https://github.com/tommy0103/obelisk/pull/224), [#225](https://github.com/tommy0103/obelisk/pull/225), [#226](https://github.com/tommy0103/obelisk/pull/226).\n- Clarify Copilot history sources and setup — @22Goose ([#215](https://github.com/tommy0103/obelisk/pull/215)).\n\n**Full changes:** [v0.2.4 → v0.2.5 release source](https://github.com/tommy0103/obelisk/compare/v0.2.4...7e8ea3336b31c1660ebbc688924b1d12283494a4).\n"
+ },
+ {
+  "tag_name": "v0.2.2",
+  "prerelease": false,
+  "draft": false,
+  "published_at": "2026-08-03T20:59:06Z",
+  "body": "## Highlights\r\n\r\n- Render Markdown images directly inside session messages\r\n- Open local file references at the referenced line in your editor\r\n- Choose VS Code, VS Code Insiders, Cursor, Windsurf, or Zed\r\n\r\n## Compatibility\r\n\r\n- macOS now requires macOS 12 Monterey or newer\r\n- CLI and source builds require Node.js 22.13 or newer\r\n\r\n## Downloads\r\n\r\n- `Obelisk-0.2.2-mac-arm64.dmg`\r\n- `Obelisk-0.2.2-mac-arm64.zip`\r\n- `Obelisk-0.2.2-linux-amd64.deb`\r\n\r\n## Install or update the CLI\r\n\r\nRequires Node.js 22.13 or newer.\r\n\r\n```bash\r\nnpm install --global @obelisk-apps/cli@0.2.2\r\nobelisk install\r\n```\r\n\r\n## Included work\r\n\r\n- #3 — Normalize missing Codex token usage \r\n- #19 — Upgrade Electron 33 → 43\r\n- #20 — Open local file references at the referenced line\r"
+ }
+]
+"""#
+
+@Suite struct ObeliskChangelogRecipeTests {
+
+    private func recipe() throws -> ChangelogRecipe {
+        try #require(ChangelogRecipeRegistry.recipe(forBundleID: "com.obelisk.app"))
+    }
+
+    /// The recipe's own fields, so a test reads what the app reads.
+    private func decode(skipSections: [String]? = nil) throws -> Changelog {
+        let recipe = try recipe()
+        let format = try #require(recipe.structuredFormat)
+        return try #require(StructuredChangelogDecoder.decode(
+            obeliskReleasesFixture, format: format, channel: recipe.channel,
+            maxEntries: recipe.maxEntries, skipSections: skipSections ?? recipe.skipSections,
+            includesPromotedStable: recipe.includesPromotedStable, tagPattern: recipe.tagPattern))
+    }
+
+    private func headings(_ entry: Changelog.Entry) -> [String] {
+        entry.content.compactMap { if case let .heading(text) = $0 { return text } else { return nil } }
+    }
+
+    /// Obelisk is detected through the Sparkle appcast its own `SUFeedURL` names,
+    /// so the only recipe is this one, for the notes. Every release in the repo is
+    /// the desktop app's (the CLI ships through npm), hence no `tagPattern`.
+    @Test func readsGitHubReleases() throws {
+        let recipe = try recipe()
+        #expect(recipe.structuredFormat == .gitHubReleases)
+        #expect(recipe.mode == .json)
+        #expect(recipe.source.host == "api.github.com")
+        #expect(recipe.source.path == "/repos/tommy0103/obelisk/releases")
+        #expect(recipe.tagPattern == nil)
+        #expect(recipe.skipSections == ["Included work", "Downloads"])
+    }
+
+    /// Newest first, `v` stripped, so the rail version is the bundle's
+    /// `CFBundleShortVersionString` (`v0.2.5` → `0.2.5`); dates as ISO days.
+    @Test func versionsAndDatesMatchTheBundleVersionScheme() throws {
+        let log = try decode()
+        #expect(log.entries.map(\.version) == ["0.2.5", "0.2.2"])
+        #expect(log.entries.map(\.date) == ["2026-10-08", "2026-08-03"])
+    }
+
+    /// The vendor's sections survive as headings. `Updates` holds no bullet of its
+    /// own (only `###` sections), and `Installation` / `Install or update the CLI`
+    /// hold prose and code, so none of them is drawn as an empty heading.
+    @Test func keepsTheVendorsSectionHeadings() throws {
+        let log = try decode()
+        let latest = try #require(log.entries.first)
+        #expect(headings(latest) == ["Highlights", "Complete session browsing", "Kiro CLI history"])
+        #expect(latest.items.count == 7)
+        #expect(latest.items.first == "**All your indexed sessions within reach.** The desktop catalogue no longer stops at the newest 1,000 sessions. Counts, metadata search, project/source filters, and oldest-first sorting cover the complete indexed history.")
+        let older = try #require(log.entries.last)
+        #expect(headings(older) == ["Highlights", "Compatibility"])
+        #expect(older.items.count == 5)
+    }
+
+    /// `Included work` is the merged-PR roster by contributor and `Downloads` the
+    /// asset file names: neither is a change. The second half is what makes
+    /// `skipSections` earn its place — without it both reach the rail.
+    @Test func dropsThePullRequestRosterAndTheDownloadList() throws {
+        let log = try decode()
+        let items = log.entries.flatMap(\.items)
+        #expect(!items.contains { $0.contains("@22Goose") || $0.contains("@tommy0103") })
+        #expect(!items.contains { $0.contains("Upgrade Electron 33") })
+        #expect(!items.contains { $0.contains("Obelisk-0.2.2-mac-arm64") })
+        #expect(!log.entries.flatMap(headings).contains("Included work"))
+
+        let unskipped = try decode(skipSections: []).entries.flatMap(\.items)
+        #expect(unskipped.contains { $0.contains("@22Goose") })
+        #expect(unskipped.contains { $0.contains("Obelisk-0.2.2-mac-arm64") })
+    }
+}
