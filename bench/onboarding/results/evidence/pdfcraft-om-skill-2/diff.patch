+import Foundation
+
+enum ai_storyteller_pdfcraft {
+    static let set = AppRecipeSet(
+        family: "ai-storyteller-pdfcraft",
+        githubRules: [
+        // Shared rationale for storytold's "-craft" apps: Recipes/ai-storyteller-photocraft.swift.
+
+        // PdfCraft — PrintCraft renamed (storytold/pdfcraft#174, first shipped in
+        // v0.4.0): repo, dmg and bundle id all moved to pdfcraft. v0.4.0, v0.6.0 and
+        // v0.7.1 checked on the real dmgs: ai.storyteller.pdfcraft, short == build ==
+        // the tag's X.Y.Z. Copies still on ai.storyteller.printcraft (≤ 0.2.1) have
+        // their own detection-only rule in Recipes/ai-storyteller-printcraft.swift.
+        // Same pipeline, same anchors (they keep `-rc.N` tags and the
+        // `pdfcraft-cli-…` zip out).
+        // One-click: ai.storyteller.pdfcraft, Team DJ6XS33FX8, notarized.
+        GitHubReleaseRule(
+            bundleID: "ai.storyteller.pdfcraft",
+            owner: "storytold", repo: "pdfcraft",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^pdfcraft-[0-9]+\.[0-9]+\.[0-9]+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
