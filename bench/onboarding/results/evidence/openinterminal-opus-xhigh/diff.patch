@@ -0,0 +1,47 @@
+import Foundation
+
+enum wang_jianing_app_OpenInTerminal {
+    static let set = AppRecipeSet(
+        family: "wang-jianing-app-OpenInTerminal",
+        githubRules: [
+        // History: docs/app-audits/wang-jianing-app-OpenInTerminal.md#历史与实测
+        // OpenInTerminal — Finder toolbar / menu-bar app that opens the current
+        // folder in a terminal or editor. No SUFeedURL and no updater of its own
+        // (no Sparkle, no update check anywhere in the source); it ships as a zip
+        // on the repo's GitHub releases and as the `openinterminal` cask, which is
+        // not `auto_updates`, so `HomebrewCaskSource` answers only for a copy brew
+        // installed. Every other copy lands here.
+        //
+        // ⚠️ The same releases carry a SECOND product under the same tag shape:
+        // OpenInTerminal-Lite and OpenInEditor-Lite ride together in their own
+        // `vA.B.C` release (the 1.x line) beside this app's `vX.Y.Z` (2.x), both
+        // cut from one commit. GitHub's "Latest" goes to whichever release was
+        // published last unless the vendor re-marks it — their release process
+        // does that by hand — so `/releases/latest` can name the Lite release. The
+        // tag pattern cannot tell the two apart; the asset pattern is the guard.
+        // A Lite release carries `OpenInTerminal-Lite.zip` / `OpenInEditor-Lite.zip`
+        // and never `OpenInTerminal.zip`, so it fails the asset gate and `resolve`
+        // walks the stable list back to this app's release. Dropping
+        // `installAssetPattern` would read the Lite version as this app's: a
+        // remote behind the installed 2.x, i.e. a silent "up to date". The Lite
+        // apps have their own bundle ids and are not covered by this rule.
+        //
+        // short == tag (`v2.3.9` → 2.3.9); CFBundleVersion is a constant `1`.
+        // One-click: the zip holds a universal `OpenInTerminal.app`, Developer
+        // ID-signed, notarized and stapled. The vendor moved to Team C8VX3ZLX5U
+        // with 2.3.9; builds up to 2.3.8 are signed by Team Q33U8R4U57, so the
+        // Team-ID gate refuses a one-click from one of those (by design) and that
+        // copy has to be replaced by hand once (checked 2026-10-13; History has
+        // the details).
+        //
+        // Notes: the release body is a Markdown bullet list under "Changes:", so
+        // `GitHubMarkdownParser` renders it natively and no `ChangelogRecipe` is
+        // needed — a `.gitHubReleases` one would also pull in the Lite notes.
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.app.OpenInTerminal",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^OpenInTerminal\.zip$"#,
+            installerKind: .zip),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift
new file mode 100644
index 0000000..95ea762
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/OpenInTerminalGitHubRuleTests.swift
@@ -0,0 +1,257 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// OpenInTerminal's repository publishes TWO products out of one release list,
+/// under one tag shape: this app's `v2.x` release and, cut from the same commit,
+/// a `v1.x` release carrying OpenInTerminal-Lite and OpenInEditor-Lite. Nothing
+/// in a tag says which product it belongs to, and GitHub's "Latest" lands on
+/// whichever of the pair was published last unless the vendor re-marks it. The
+/// asset name is the only seam, so these tests drive it through the production
+/// resolve path rather than through the pattern alone.
+@Suite(.serialized)
+struct OpenInTerminalGitHubRuleTests {
+
+    private static let bundleID = "wang.jianing.app.OpenInTerminal"
+    private static let latestURL =
+        "https://api.github.com/repos/Ji4n1ng/OpenInTerminal/releases/latest"
+    private static let listURL =
+        "https://api.github.com/repos/Ji4n1ng/OpenInTerminal/releases?per_page=20"
+
+    /// Answers by URL string and records the order URLs were requested in.
+    private final class ByURLProtocol: URLProtocol, @unchecked Sendable {
+        final class Script: @unchecked Sendable {
+            private let lock = NSLock()
+            private var answers: [String: String] = [:]
+            private var requested: [String] = []
+            func load(_ table: [String: String]) { lock.lock(); answers = table; requested = []; lock.unlock() }
+            func answer(for url: String) -> String? {
+                lock.lock(); defer { lock.unlock() }
+                requested.append(url)
+                return answers[url]
+            }
+            var urls: [String] { lock.lock(); defer { lock.unlock() }; return requested }
+        }
+        static let script = Script()
+
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+        override func startLoading() {
+            let body = Self.script.answer(for: request.url!.absoluteString)
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: body == nil ? 404 : 200,
+                httpVersion: "HTTP/1.1", headerFields: [:])!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: Data((body ?? "{}").utf8))
+            client?.urlProtocolDidFinishLoading(self)
+        }
+        override func stopLoading() {}
+    }
+
+    private static func session() -> URLSession {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.protocolClasses = [ByURLProtocol.self]
+        configuration.urlCache = nil
+        return URLSession(configuration: configuration)
+    }
+
+    // MARK: - Real release objects (tags, asset names, sizes, dates, bodies)
+
+    private static let mainBody = """
+    Changes:
+
+    - Security: Fixed an AppleScript/command injection vulnerability that allowed arbitrary command execution via a crafted folder name when opening it in a non-default terminal or an editor. Thanks to Paul Gerste ([Sonar](https://www.sonarsource.com)) for the responsible disclosure.
+    - Added support for Zed, Emacs, Kakoune, GitKraken, and cmux.
+    - Added an option to limit global keyboard shortcuts to Finder-only shortcuts. (#251, #243)
+    - Introduced a new default app icon with automatic light/dark mode support.
+    - Added an option to display the Finder context menu items in a submenu.
+    - Fixed the Finder extension icon being rendered as a template icon.
+    - Improved startup responsiveness by fetching installed applications on a background thread.
+    - Fixed the keyboard shortcut overlapping the "Open in ..." title in the status bar menu.
+
+    """
+
+    private static let liteBody = """
+    Changes:
+
+    - Security: Fixed an AppleScript/command injection vulnerability that allowed arbitrary command execution via a crafted folder name when opening it in a non-default terminal or an editor. Thanks to Paul Gerste ([Sonar](https://www.sonarsource.com)) for the responsible disclosure.
+    - Updated the first-launch prompt to display all supported terminal applications.
+    - Introduced a new default app icon with automatic light/dark mode support.
+    - Added support for Zed, Emacs, Kakoune, GitKraken, and cmux.
+
+    """
+
+    /// The previous release's body as GitHub serves it — CRLF line endings and a
+    /// greeting line above the list.
+    private static let previousMainBody =
+        "Happy New Year! 🎉\r\n\r\nChanges:\r\n\r\n"
+        + "- Support \"open in neovim\" for Alacritty, WezTerm, and kitty users.\r\n"
+        + "- Customize open command for kitty users.\r\n"
+        + "- Copy path with escaping.\r\n"
+        + "- Support fork, notepad--, Ghostty.\r\n"
+        + "- Support nix installed applications."
+
+    private static func release(
+        _ tag: String, published: String, body: String, assets: [(String, Int)]
+    ) -> [String: Any] {
+        [
+            "tag_name": tag, "prerelease": false, "draft": false,
+            "published_at": published, "body": body,
+            "html_url": "https://github.com/Ji4n1ng/OpenInTerminal/releases/tag/\(tag)",
+            "assets": assets.map { name, size in
+                [
+                    "name": name, "size": size,
+                    "browser_download_url":
+                        "https://github.com/Ji4n1ng/OpenInTerminal/releases/download/\(tag)/\(name)",
+                ] as [String: Any]
+            },
+        ]
+    }
+
+    private static var main239: [String: Any] {
+        release("v2.3.9", published: "2026-07-13T12:08:34Z", body: mainBody,
+                assets: [("OpenInTerminal.zip", 24_842_104)])
+    }
+    private static var lite128: [String: Any] {
+        release("v1.2.8", published: "2026-07-13T12:08:48Z", body: liteBody,
+                assets: [("OpenInEditor-Lite.zip", 9_678_900), ("OpenInTerminal-Lite.zip", 9_652_162)])
+    }
+    private static var main238: [String: Any] {
+        release("v2.3.8", published: "2025-01-07T08:43:08Z", body: previousMainBody,
+                assets: [("OpenInTerminal.zip", 14_683_040)])
+    }
+    private static var lite127: [String: Any] {
+        release("v1.2.7", published: "2025-01-07T08:30:28Z", body: "Changes:\n\n- Lite notes",
+                assets: [("Icons.zip", 882_027), ("OpenInEditor-Lite.zip", 5_042_235),
+                         ("OpenInTerminal-Lite.zip", 5_022_717)])
+    }
+
+    private static func json(_ object: Any) -> String {
+        String(decoding: try! JSONSerialization.data(withJSONObject: object), as: UTF8.self)
+    }
+
+    private func rule() throws -> GitHubReleaseRule {
+        try #require(GitHubReleaseRegistry.rules.first { $0.bundleID == Self.bundleID })
+    }
+
+    private func resolve(_ rule: GitHubReleaseRule) async -> ProbeOutcome {
+        let source = GitHubReleasesSource(rules: [rule], session: Self.session())
+        return await source.resolveDiagnostic(
+            rule, preferring: .arm64, allowingIntelTranslation: false)
+    }
+
+    // MARK: - Which release the rule accepts
+
+    /// The tag pattern accepts BOTH products' tags — it has to, they are the same
+    /// shape — which is exactly why it cannot be the guard. The asset pattern is:
+    /// of every file name either product has shipped since the asset was renamed
+    /// from `OpenInTerminal.app.zip`, it takes only the main app's zip.
+    @Test func theTagCannotTellTheProductsApartSoTheAssetDoes() throws {
+        let rule = try rule()
+        #expect(rule.usePrereleases == false)
+        #expect(rule.channel == .stable)
+        #expect(rule.installerKind == .zip)
+        #expect(VendorProbeRecipe.extractVersion(from: "v2.3.9", pattern: rule.versionPattern) == "2.3.9")
+        #expect(VendorProbeRecipe.extractVersion(from: "v1.2.8", pattern: rule.versionPattern) == "1.2.8")
+
+        let pattern = try #require(rule.installAssetPattern)
+        #expect("OpenInTerminal.zip".range(of: pattern, options: .regularExpression) != nil)
+        for decoy in ["OpenInTerminal-Lite.zip", "OpenInEditor-Lite.zip", "Icons.zip",
+                      "OpenInTerminal.app.zip"] {
+            #expect(decoy.range(of: pattern, options: .regularExpression) == nil, "\(decoy)")
+        }
+    }
+
+    /// A build of this app reports the plain marketing version and a name with no
+    /// channel word, so it detects as stable and the stable rule applies.
+    @Test func theAppDetectsAsStable() {
+        #expect(ReleaseChannel.detect(
+            name: "OpenInTerminal", bundleID: Self.bundleID, keystoneChannel: nil,
+            version: "2.3.9") == .stable)
+    }
+
+    // MARK: - The production resolve path
+
+    /// The healthy round: `/releases/latest` is the main app's release, it carries
+    /// the zip, and nothing else is fetched. The parsed notes ride along.
+    @Test func whenLatestIsThisAppItIsTheOnlyRequest() async throws {
+        ByURLProtocol.script.load([
+            Self.latestURL: Self.json(Self.main239),
+            Self.listURL: Self.json([Self.main239, Self.lite128, Self.main238, Self.lite127]),
+        ])
+        let outcome = await resolve(try rule())
+
+        #expect(outcome.failure == nil)
+        #expect(outcome.remote?.shortVersion == "2.3.9")
+        #expect(outcome.remote?.downloadURL?.absoluteString
+            == "https://github.com/Ji4n1ng/OpenInTerminal/releases/download/v2.3.9/OpenInTerminal.zip")
+        #expect(outcome.remote?.requiresManualInstaller == false)
+        #expect(outcome.remote?.vendorInstallerKind == .zip)
+        let entry = try #require(outcome.remote?.structuredChangelog?.entries.first)
+        #expect(entry.version == "2.3.9")
+        #expect(entry.items.count == 8)
+        #expect(entry.items.first?.hasPrefix("Security: Fixed an AppleScript") == true)
+        #expect(ByURLProtocol.script.urls == [Self.latestURL])
+    }
+
+    /// The failure the asset pattern exists for. GitHub marks the most recently
+    /// published release "Latest" by default, and the Lite release goes out after
+    /// the main one; only a manual re-mark puts it back. With Lite as "Latest" the
+    /// rule must fall back to the list, skip every Lite row (Lite first in the
+    /// list too, the worse order) and answer with the main app's release — its
+    /// version, its zip and its notes, not Lite's.
+    @Test func aLiteReleaseMarkedLatestWalksBackToThisAppsRelease() async throws {
+        ByURLProtocol.script.load([
+            Self.latestURL: Self.json(Self.lite128),
+            Self.listURL: Self.json([Self.lite128, Self.main239, Self.lite127, Self.main238]),
+        ])
+        let outcome = await resolve(try rule())
+
+        #expect(outcome.failure == nil)
+        #expect(outcome.remote?.shortVersion == "2.3.9")
+        #expect(outcome.remote?.downloadURL?.lastPathComponent == "OpenInTerminal.zip")
+        #expect(outcome.remote?.downloadURL?.absoluteString.contains("/download/v2.3.9/") == true)
+        let entry = try #require(outcome.remote?.structuredChangelog?.entries.first)
+        #expect(entry.items.contains("Improved startup responsiveness by fetching installed applications on a background thread."))
+        #expect(!entry.items.contains("Updated the first-launch prompt to display all supported terminal applications."),
+                "the Lite release's notes were attached to this app")
+        #expect(ByURLProtocol.script.urls == [Self.latestURL, Self.listURL])
+    }
+
+    /// Why the rule is not detection-only: the same rule without its asset
+    /// pattern reads the Lite release as this app's version. That remote is
+    /// BEHIND every 2.x install, so the row reads "up to date" and every real
+    /// update disappears without an error anywhere.
+    @Test func withoutTheAssetPatternLiteWouldSilentlyHideUpdates() async throws {
+        let real = try rule()
+        let detectionOnly = GitHubReleaseRule(
+            bundleID: real.bundleID, owner: real.owner, repo: real.repo,
+            versionPattern: real.versionPattern)
+        ByURLProtocol.script.load([
+            Self.latestURL: Self.json(Self.lite128),
+            Self.listURL: Self.json([Self.lite128, Self.main239, Self.lite127, Self.main238]),
+        ])
+        let outcome = await resolve(detectionOnly)
+
+        #expect(outcome.remote?.shortVersion == "1.2.8")
+        #expect(!VersionComparator.isNewer("1.2.8", than: "2.3.8"))
+    }
+
+    // MARK: - Notes
+
+    /// Older bodies are CRLF with a greeting line above the list; they still
+    /// parse into the bullets alone, with no carriage return left in an item.
+    @Test func thePreviousReleasesCRLFBodyParsesToItsBullets() throws {
+        let entry = try #require(GitHubMarkdownParser.parse(
+            body: Self.previousMainBody, version: "2.3.8", date: nil)?.entries.first)
+        #expect(entry.items == [
+            "Support \"open in neovim\" for Alacritty, WezTerm, and kitty users.",
+            "Customize open command for kitty users.",
+            "Copy path with escaping.",
+            "Support fork, notepad--, Ghostty.",
+            "Support nix installed applications.",
+        ])
+        #expect(!entry.items.contains { $0.contains("\r") })
+    }
+}
