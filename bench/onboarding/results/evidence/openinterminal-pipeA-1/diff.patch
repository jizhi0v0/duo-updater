@@ -0,0 +1,35 @@
+import Foundation
+
+enum wang_jianing_app_OpenInTerminal {
+    static let set = AppRecipeSet(
+        family: "wang-jianing-app-OpenInTerminal",
+        githubRules: [
+        // OpenInTerminal — a Finder-toolbar app. No SUFeedURL; a Homebrew cask
+        // exists (not `auto_updates`) but only covers a brew-installed copy.
+        //
+        // The repo (Ji4n1ng/OpenInTerminal) carries THREE apps on one tag stream:
+        // this one on `v2.x`, and OpenInTerminal-Lite / OpenInEditor-Lite on
+        // `v1.x`, published back to back. So this rule must not read
+        // `/releases/latest`, which can name a `v1.x` release; it reads the list
+        // and lets the anchored tag grammar `^v(2\.…)$` pick its own train. The
+        // `^v` also keeps out the repo's pre-2022 bare tags (`2.2.3`, `0.10.3`).
+        //
+        // The two Lite apps are NOT covered, and not for lack of a rule to write:
+        // `GitHubReleaseRule.recipeID` is `github:<slug>:<channel>`, so a second
+        // rule on this repo and channel shares this rule's health and baseline key
+        // (`RecipeHealthKeyTests.rulesSharingASlugRecordSeparateHealthEntries`
+        // fails on it). Covering them needs a key that tells rules on one repo
+        // and channel apart — see the audit.
+        //
+        // Tags equal the Xcode `MARKETING_VERSION` of the project at that tag
+        // (`CFBundleShortVersionString` is `$(MARKETING_VERSION)`;
+        // `CFBundleVersion` is the literal `1`). Detection only: the package's Team
+        // ID and notarization were not read, so no `installAssetPattern` yet.
+        GitHubReleaseRule(
+            bundleID: "wang.jianing.app.OpenInTerminal",
+            owner: "Ji4n1ng", repo: "OpenInTerminal",
+            usePrereleases: true,
+            listPageSize: 10,
+            versionPattern: #"^v(2\.[0-9]+(?:\.[0-9]+)*)$"#),
+        ])
+}
