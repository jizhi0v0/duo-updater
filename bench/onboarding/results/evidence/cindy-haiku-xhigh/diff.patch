+import Foundation
+
+enum com_xd_cindy {
+    static let set = AppRecipeSet(
+        family: "com-xd-cindy",
+        changelogs: [
+        // Cindy's own release bodies, one per GitHub release, stable only. The
+        // rule below carries only the newest body, and stable ships every few
+        // days, so a copy a few versions back needs the list. Bodies are
+        // `## 更新说明` over `###` sections of prose, then `## PRs` and a `---`
+        // footer of build ids. The footer is top-level bullets (seven in most), so without
+        // `PRs` in skipSections the first bullet pass takes it as the whole
+        // changelog. Four older bodies (0.1.71, 0.1.79, 0.1.85, 0.1.86) have no
+        // `## PRs` heading and keep the footer as items: a skip rule can only name
+        // a heading, and the footer sits under a content section there. 0.1.97
+        // has more prose lines than `proseItemCap` allows, so the parser returns
+        // nothing for it and the decoder drops that entry.
+        ChangelogRecipe(
+            bundleID: "com.xd.cindy",
+            source: URL(
+                string: "https://api.github.com/repos/makecindy/cindy/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            channel: .stable,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["PRs"]),
+        ],
+        githubRules: [
+        // Cindy — Electron desktop app in the makecindy/cindy monorepo
+        // (apps/desktop). No SUFeedURL and no app-update.yml: it reads
+        // manifest-darwin-<arch>.json from the CDN named in config/endpoint.global.json,
+        // and that manifest's installer entry is the same dmg this rule downloads
+        // (sha256 equal for arm64 and x64 at 0.1.104). One dmg per arch with the
+        // `global` build; the `cn` dmg is another bundle (com.xd.cindycn, its own
+        // Team) and stays out. `/releases/latest` skips the -beta prereleases.
+        GitHubReleaseRule(
+            bundleID: "com.xd.cindy",
+            owner: "makecindy", repo: "cindy",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^cindy-[0-9.]+-darwin-(?:arm64|x64)-global\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
