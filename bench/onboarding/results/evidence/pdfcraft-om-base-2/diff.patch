+import Foundation
+
+enum ai_storyteller_pdfcraft {
+    static let set = AppRecipeSet(
+        family: "ai-storyteller-pdfcraft",
+        githubRules: [
+        // Shared rationale for storytold's "-craft" apps: Recipes/ai-storyteller-photocraft.swift.
+
+        // PdfCraft — PrintCraft renamed (storytold/pdfcraft#174, first shipped in v0.4.0).
+        // The rename changed the bundle id too, so this is a separate app from
+        // `ai.storyteller.printcraft`, whose rule still reads the redirected repo and
+        // stops at v0.2.1, the last release with a `printcraft-…` dmg. Same pipeline,
+        // same anchors (they keep `-rc.N` tags and the `pdfcraft-cli-…` zip out).
+        // One-click: ai.storyteller.pdfcraft, Team DJ6XS33FX8, notarized (0.6.0, 0.7.1).
+        GitHubReleaseRule(
+            bundleID: "ai.storyteller.pdfcraft",
+            owner: "storytold", repo: "pdfcraft",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^pdfcraft-[0-9]+\.[0-9]+\.[0-9]+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
