@@ -0,0 +1,65 @@
+import Foundation
+
+enum com_trycua_driver {
+    static let set = AppRecipeSet(
+        family: "com-trycua-driver",
+        githubRules: [
+        // History: docs/app-audits/com-trycua-driver.md#历史与实测
+        //
+        // Cua Driver — `/Applications/CuaDriver.app`, a headless (`LSUIElement`)
+        // bundle around the `cua-driver` binary, published from the `trycua/cua`
+        // monorepo. No `SUFeedURL`, no electron-builder config; the vendor's own
+        // updater is a CLI command that reruns its install script. The
+        // `cuadriver` Homebrew cask (not `auto_updates`) answers for copies brew
+        // installed; every other copy lands here.
+        //
+        // `usePrereleases: true` on a STABLE rule, and it is not optional: the
+        // vendor flags every `cua-driver-rs-v*` release as a GitHub prerelease so
+        // the repository-wide "Latest" pointer stays on another product (each
+        // release body says so under "Why GitHub says “Pre-release”"), and
+        // `/releases/latest` answers `cua-spaces-v…`. Reading the list and taking
+        // the first tag the pattern accepts is what the vendor's own resolver
+        // does too (`version_check.rs` ignores the flag and filters by prefix).
+        //
+        // The pattern is the only channel gate, so it is anchored at BOTH ends.
+        // `$` drops a suffixed tag (`-rc.1`, and the nightly track's
+        // `-nightly.<date>.<run>`) that would otherwise read as a plain release.
+        // `^` drops any tag that merely ENDS in `cua-driver-rs-v<x.y.z>` — the
+        // nightly track's prefix is `nightly-cua-driver-rs-v`, so a nightly tag
+        // published without its suffix would otherwise read as stable. Today
+        // each anchor alone rejects the real nightly tags; neither is redundant
+        // for the shapes above. Exactly three components, because that is what the
+        // vendor's resolver accepts as a stable release (semver parse, no
+        // pre/build part). The retired Swift port's `cua-driver-v*` tags share
+        // the bundle id but are a different prefix, so they never match; a Swift
+        // copy is offered the Rust release, which is the vendor's own upgrade
+        // path (same bundle id, same Team ID, same install path).
+        //
+        // `listPageSize` is measured tag depth in this monorepo, not a guess; the
+        // History section has the runs. The newest release is usually another
+        // product (driver tags are about one release in five), so the one-row
+        // probe would mostly add a request; it is off, as on Bitwarden.
+        //
+        // Nightly copies are NOT kept off this rule, and cannot be: the nightly
+        // build's `CFBundleShortVersionString` drops the `-nightly.<date>.<run>`
+        // suffix (the binary keeps it; the plist does not), and the channel
+        // choice lives in a state file under the user's home, not in the
+        // bundle. See the audit.
+        //
+        // One-click: the `darwin-universal.tar.gz` is what the vendor's
+        // installer and the Homebrew cask both install. It holds
+        // `cua-driver-rs-<v>-darwin-universal/CuaDriver.app` one level down,
+        // which `ArchiveExtractor` reaches. Developer ID, Team YCK386LBJ7,
+        // notarized and stapled. `-binary.tar.gz` (bare binary, no bundle) and
+        // the `.sigstore.json` siblings must not match.
+        GitHubReleaseRule(
+            bundleID: "com.trycua.driver",
+            owner: "trycua", repo: "cua",
+            usePrereleases: true,
+            listPageSize: 35,
+            versionPattern: #"^cua-driver-rs-v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^cua-driver-rs-[0-9]+\.[0-9]+\.[0-9]+-darwin-universal\.tar\.gz$"#,
+            installerKind: .tarGz,
+            probesNewestFirst: false),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CuaDriverGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CuaDriverGitHubRuleTests.swift
new file mode 100644
index 0000000..276b956
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CuaDriverGitHubRuleTests.swift
@@ -0,0 +1,282 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Cua Driver (`com.trycua.driver`, `trycua/cua`) lives in a monorepo that
+/// releases some thirty products from one Releases list, and the vendor flags
+/// every stable driver release as a GitHub prerelease. So the tag pattern is the
+/// whole channel gate here, and each test below pins one of the seams it holds
+/// against strings the vendor really published (2026-10-14).
+///
+/// See `docs/app-audits/com-trycua-driver.md` for the measurements.
+@Suite struct CuaDriverGitHubRuleTests {
+
+    private static let bundleID = "com.trycua.driver"
+
+    /// EVERY rule for this bundle id, not the first one — a second rule (a
+    /// nightly track, say) must not slip past the install-spec checks below.
+    /// Non-empty is required rather than assumed: a lookup that stops finding
+    /// anything has to fail loudly instead of leaving the suite green.
+    private static var rules: [GitHubReleaseRule] {
+        get throws {
+            let found = GitHubReleaseRegistry.rules.filter { $0.bundleID == bundleID }
+            try #require(!found.isEmpty, "com.trycua.driver is no longer in GitHubReleaseRegistry")
+            return found
+        }
+    }
+
+    private static var stableRule: GitHubReleaseRule {
+        get throws {
+            try #require(
+                self.rules.first { $0.channel == .stable },
+                "com.trycua.driver has no stable rule any more")
+        }
+    }
+
+    // MARK: - Which releases the rule reads
+
+    /// Every `cua-driver-rs-v*` release carries `prerelease: true` — the vendor
+    /// uses the flag only to keep the repository-wide "Latest" pointer off the
+    /// driver — and `/releases/latest` answers another product (`cua-spaces-v…`
+    /// on 2026-10-14). A stable rule that read `/releases/latest`, or that let
+    /// GitHub's flag decide, would never see a single driver release.
+    @Test func stableRuleReadsTheListBecauseTheVendorFlagsEveryReleasePrerelease() throws {
+        let rule = try Self.stableRule
+        #expect(rule.usePrereleases == true)
+        #expect(rule.owner == "trycua" && rule.repo == "cua")
+    }
+
+    /// Real tags, spanning the newest, a two-digit minor, a two-digit patch and
+    /// the oldest Rust-port release.
+    @Test(arguments: [
+        ("cua-driver-rs-v0.35.4", "0.35.4"),
+        ("cua-driver-rs-v0.35.2", "0.35.2"),
+        ("cua-driver-rs-v0.10.0", "0.10.0"),
+        ("cua-driver-rs-v0.2.18", "0.2.18"),
+        ("cua-driver-rs-v0.1.3", "0.1.3"),
+    ])
+    func realTagsResolveToTheirVersion(tag: String, expected: String) throws {
+        let rule = try Self.stableRule
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+                == expected)
+    }
+
+    /// The tags the anchors exist for. GitHub's flag cannot tell any of these
+    /// apart from a stable driver release (it is `true` on all of them), so if
+    /// the pattern lets one through, the rule offers it to every install.
+    ///
+    /// - the nightly track's real tag, which each anchor rejects on its own;
+    /// - an rc-shaped tag the vendor has not published yet, which a pattern
+    ///   without `$` would read as `0.36.0`;
+    /// - a nightly-prefixed tag WITHOUT its suffix (hypothetical — none has been
+    ///   published), which a pattern without `^` would read as `0.36.0`;
+    /// - the retired Swift port (`cua-driver-v…`) and two sibling products.
+    @Test(arguments: [
+        "nightly-cua-driver-rs-v0.30.5-nightly.20260929.36522098176",
+        "cua-driver-rs-v0.36.0-rc.1",
+        "nightly-cua-driver-rs-v0.36.0",
+        "cua-driver-v0.2.0",
+        "cua-spaces-v0.8.0",
+        "nightly-lume-v0.6.2-nightly.20261014.38513423832",
+    ])
+    func foreignAndSuffixedTagsAreRejected(tag: String) throws {
+        let rule = try Self.stableRule
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == nil)
+    }
+
+    // MARK: - Which asset it installs
+
+    /// Every macOS-looking asset on the real v0.35.4 release, verbatim. Only the
+    /// directory tarball carries `CuaDriver.app`; `-universal-binary` is the bare
+    /// CLI (installing it would leave the bundle untouched), and each archive has
+    /// a `.sigstore.json` sibling whose name starts the same way.
+    @Test func installPicksTheUniversalAppTarballOnly() throws {
+        let names = [
+            "cua-driver-rs-0.35.4-darwin-arm64.tar.gz",
+            "cua-driver-rs-0.35.4-darwin-arm64.tar.gz.sigstore.json",
+            "cua-driver-rs-0.35.4-darwin-universal-binary.tar.gz",
+            "cua-driver-rs-0.35.4-darwin-universal-binary.tar.gz.sigstore.json",
+            "cua-driver-rs-0.35.4-darwin-universal.tar.gz",
+            "cua-driver-rs-0.35.4-darwin-universal.tar.gz.sigstore.json",
+            "cua-driver-rs-0.35.4-darwin-x86_64.tar.gz",
+            "cua-driver-rs-v0.35.4-skills.tar.gz",
+            "cua_driver-0.35.4-py3-none-macosx_13_0_universal2.whl",
+        ]
+        let assets = names.map { name in
+            (name: name,
+             url: URL(string: "https://github.com/trycua/cua/releases/download/cua-driver-rs-v0.35.4/\(name)")!,
+             size: Int64?(83_035_346))
+        }
+        let rule = try Self.stableRule
+        let pattern = try #require(rule.installAssetPattern)
+        #expect(rule.installerKind == .tarGz)
+        let matching = names.filter {
+            $0.range(of: pattern, options: .regularExpression) != nil
+        }
+        #expect(matching == ["cua-driver-rs-0.35.4-darwin-universal.tar.gz"])
+        let asset = GitHubReleaseRule.installableAsset(from: assets, matching: pattern)
+        #expect(asset?.url.lastPathComponent == "cua-driver-rs-0.35.4-darwin-universal.tar.gz")
+    }
+
+    // MARK: - The nightly track
+
+    /// Why there is no nightly rule: a real nightly bundle
+    /// (`nightly-cua-driver-rs-v0.30.5-nightly.20260929.36522098176`, universal
+    /// tarball) reports `CFBundleShortVersionString` `0.30.5` — the suffix is in
+    /// the binary, not the plist — so detection files it as stable, and a nightly
+    /// rule would never be consulted. The vendor keeps the channel choice in a
+    /// state file under the user's home, which no bundle signal reflects.
+    @Test func aRealNightlyBundleDetectsAsStable() {
+        #expect(ReleaseChannel.detect(
+            name: "Cua Driver", bundleID: Self.bundleID, keystoneChannel: nil,
+            version: "0.30.5", bundleFileName: "CuaDriver.app") == .stable)
+    }
+
+    // MARK: - The changelog
+
+    /// The release body is the changelog, and `GitHubReleasesSource` parses it
+    /// inline. What has to hold is that the vendor's boilerplate stays out: the
+    /// install one-liners, the "Why GitHub says Pre-release" note and the
+    /// checksum block appear in every body and are not changes.
+    @Test func theRealReleaseBodyYieldsItsFixesAndNotItsBoilerplate() throws {
+        let parsed = try #require(GitHubMarkdownParser.parse(
+            body: Self.body0354, version: "0.35.4", date: "2026-10-14T12:32:14Z"))
+        let entry = try #require(parsed.entries.first)
+        #expect(entry.version == "0.35.4")
+        #expect(entry.items.count == 16)
+        #expect(entry.items.first?.hasPrefix("print the named command's help") == true)
+        for item in entry.items {
+            for boilerplate in ["curl -fsSL", "irm https", "SHA256SUMS", "Pre-release",
+                                "Thanks to @AyinLee987", "compare/cua-driver-rs"] {
+                #expect(!item.contains(boilerplate), "boilerplate leaked into an item: \(item)")
+            }
+        }
+    }
+
+    /// Why this family carries no `.gitHubReleases` ChangelogRecipe: that decoder
+    /// keeps a stable rail to releases GitHub flags stable, and this vendor flags
+    /// every driver release prerelease, so the recipe would fetch a page and
+    /// render nothing. The inline parse above is what the pane shows.
+    @Test func aGitHubReleasesRecipeWouldRenderNothingForThisVendor() throws {
+        let release: [String: Any] = [
+            "tag_name": "cua-driver-rs-v0.35.4", "prerelease": true, "draft": false,
+            "published_at": "2026-10-14T12:32:14Z", "body": Self.body0354,
+        ]
+        let json = try JSONSerialization.data(withJSONObject: [release])
+        let page = try #require(String(data: json, encoding: .utf8))
+        #expect(StructuredChangelogDecoder.decodeGitHubReleases(
+            page, channel: .stable, maxEntries: 20,
+            tagPattern: #"^cua-driver-rs-v([0-9]+\.[0-9]+\.[0-9]+)$"#) == nil)
+    }
+
+    /// Verbatim body of `cua-driver-rs-v0.35.4`, fetched 2026-10-14.
+    private static let body0354 = #"""
+        # Cua Driver 0.35.4
+
+        ## Summary
+
+        This release includes 16 fixes.
+
+        ## Fixes
+
+        - print the named command's help for `<command> --help`. ([#5083](https://github.com/trycua/cua/pull/5083)) Thanks @RitikaxG, @injaneity; reported by @coygeek.
+        - wake Chromium AT-SPI content before the first application tree traversal. ([#5074](https://github.com/trycua/cua/pull/5074))
+        - refuse background Cmd+V when the browser focus is its omnibox. ([#5124](https://github.com/trycua/cua/pull/5124))
+        - keep list_windows valid when macOS reports non-finite window bounds. ([#5125](https://github.com/trycua/cua/pull/5125)) Thanks @injaneity, @kayzenline.
+        - background browser clicks reach pointer-driven rows. ([#5110](https://github.com/trycua/cua/pull/5110))
+        - share one approved Chrome connection across sessions. ([#5115](https://github.com/trycua/cua/pull/5115))
+        - keep the Chromium screen rebase off a top-level frame that matches its window-manager frame. ([#4967](https://github.com/trycua/cua/pull/4967)) Thanks @CMGS.
+        - stop opening a console window for the embedded daemon on Windows. ([#5136](https://github.com/trycua/cua/pull/5136)) Thanks @SunflowersLwtech.
+        - keep background popups and context menus open on macOS. ([#5129](https://github.com/trycua/cua/pull/5129))
+        - fail type_text when a character cannot be typed. ([#5139](https://github.com/trycua/cua/pull/5139)) Thanks @CMGS.
+        - preserve macOS middle-click window routing. ([#5137](https://github.com/trycua/cua/pull/5137)) Thanks @Iflaqbhat.
+        - exit 64 for an unknown permissions subcommand. ([#5148](https://github.com/trycua/cua/pull/5148)) Thanks @UlviShukurzade.
+        - preserve recording start timestamp in session.json. ([#5145](https://github.com/trycua/cua/pull/5145)) Thanks @Iflaqbhat.
+        - isolate Computer History under CUA_DRIVER_RS_HOME. ([#5165](https://github.com/trycua/cua/pull/5165)) Thanks @AyinLee987.
+        - give each character of a text its own spare keycode. ([#5158](https://github.com/trycua/cua/pull/5158)) Thanks @CMGS.
+        - write action.json timestamp as ISO-8601 as documented. ([#5144](https://github.com/trycua/cua/pull/5144)) Thanks @methanoya.
+
+        ## Contributors
+
+        Thanks to @AyinLee987, @CMGS, @coygeek, @Iflaqbhat, @kayzenline, @methanoya, @RitikaxG, @SunflowersLwtech, @UlviShukurzade for contributing to this release.
+
+        ## Install
+
+        macOS and Linux:
+
+        ```bash
+        /bin/bash -c "$(curl -fsSL https://cua.ai/driver/install.sh)"
+        ```
+
+        Windows:
+
+        ```powershell
+        irm https://cua.ai/driver/install.ps1 | iex
+        ```
+
+        Cua Driver ships universal macOS binaries, x86_64 and arm64 Windows builds,
+        and Linux preview builds. Release assets also include tag-pinned installer and
+        uninstaller scripts.
+
+        ## Why GitHub says “Pre-release”
+
+        GitHub's label is used only to keep this monorepo's repository-wide “Latest”
+        pointer from switching between independently released products. A plain Cua
+        Driver SemVer is a stable release; npm and PyPI publish it on
+        their normal stable channels, and the installers resolve the versioned
+        `cua-driver-rs-v*` releases directly.
