diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/WhatCableGitHubRulesTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/WhatCableGitHubRulesTests.swift
