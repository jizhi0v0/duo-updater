@@ -0,0 +1,36 @@
+import Foundation
+
+enum ai_storyteller_pdfcraft {
+    static let set = AppRecipeSet(
+        family: "ai-storyteller-pdfcraft",
+        githubRules: [
+        // Shared rationale for storytold's "-craft" apps: Recipes/ai-storyteller-photocraft.swift.
+
+        // PdfCraft — the Acrobat counterpart, called PrintCraft up to v0.2.1. At v0.4.0
+        // the repo became storytold/pdfcraft (storytold/printcraft 301s to it), the dmg
+        // became `pdfcraft-…`, the app PdfCraft.app and the bundle id ai.storyteller.pdfcraft
+        // (v0.2.1 and v0.4.0 dmgs mounted; no v0.3.x was published). Same pipeline, same
+        // anchors (they keep `-rc.N` tags and the `pdfcraft-cli-…` zip out).
+        // One-click: ai.storyteller.pdfcraft, Team DJ6XS33FX8, notarized.
+        GitHubReleaseRule(
+            bundleID: "ai.storyteller.pdfcraft",
+            owner: "storytold", repo: "pdfcraft",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^pdfcraft-[0-9]+\.[0-9]+\.[0-9]+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+
+        // A copy still on the pre-rename id (PrintCraft 0.1.0–0.2.1, same Team).
+        // Detection-only on purpose, as for Spotifast's old id: the download is
+        // ai.storyteller.pdfcraft, which the bundle-id gate refuses over
+        // ai.storyteller.printcraft, and `BundleIDMigration` is read by vendor and
+        // changelog recipes only, not by GitHub rules. The vendor's PdfCraft moves
+        // the PrintCraft settings folder on first launch, so installing it by hand
+        // is safe. `variant` keeps its `recipeID` apart from the rule above, which
+        // reads the same repo.
+        GitHubReleaseRule(
+            bundleID: "ai.storyteller.printcraft",
+            owner: "storytold", repo: "pdfcraft",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            variant: "printcraft"),
+        ])
+}
