+/// WhatCable: three rules on one repo — stable and beta under
+/// `uk.whatcable.whatcable`, and detection for the pre-0.6.0 id. Iterates every
+/// rule the registry holds for the repo, so a fourth rule (or a dropped one)
+/// fails here instead of going unpinned. Tags and asset names are the real ones
+/// (Releases API, 2026-10-14); both trains ship the same `WhatCable.zip`.
+@Test func whatCableRulesCoverEveryTrainOnTheRepo() {
+    let stableTags = ["v1.5.0", "v1.4.0", "v1.1.9", "v0.99.3", "v0.2.0"]
+    let betaTags = ["v1.5.0-beta.10", "v1.5.0-beta.1", "v1.2.1-beta.1"]
+    // Shapes the vendor has not published: the next major, a two-part tag, and
+    // an rc the beta script would refuse but a hand-made release would not.
+    let unpublished = ["v2.0.0": "2.0.0", "v1.6": "1.6"]
+    let neverAccepted = ["v1.5.0-rc.1", "1.6.0", "v1.6.0-beta", "whatcable-cli-1.5.0"]
+
+    let rules = GitHubReleaseRegistry.rules.filter { $0.slug == "darrylmorley/whatcable" }
+    let keys = Set(rules.map { "\($0.bundleID)/\($0.channel.rawValue)" })
+    #expect(keys == ["uk.whatcable.whatcable/stable", "uk.whatcable.whatcable/beta",
+                     "com.bitmoor.whatcable/stable"])
+
+    for rule in rules {
+        let take = { (tag: String) in
+            VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+        }
+        for tag in neverAccepted { #expect(take(tag) == nil, "\(rule.bundleID) took \(tag)") }
+        switch rule.channel {
+        case .stable:
+            #expect(rule.usePrereleases == false)
+            for tag in stableTags { #expect(take(tag) == String(tag.dropFirst())) }
+            for (tag, v) in unpublished { #expect(take(tag) == v) }
+            for tag in betaTags { #expect(take(tag) == nil, "stable took \(tag)") }
+        case .beta:
+            #expect(rule.usePrereleases == true)
+            for tag in betaTags { #expect(take(tag) == String(tag.dropFirst())) }
+            for tag in stableTags { #expect(take(tag) == nil, "beta took \(tag)") }
+        default:
+            Issue.record("unexpected channel \(rule.channel) on \(rule.bundleID)")
+        }
+        guard rule.bundleID == "uk.whatcable.whatcable" else {
+            // Every artifact since 0.6.0 is `uk.whatcable.whatcable`; gate 4
+            // would refuse each one for a `com.bitmoor` copy.
+            #expect(rule.installAssetPattern == nil)
+            continue
+        }
+        let pattern = try! #require(rule.installAssetPattern)
+        #expect(rule.installerKind == .zip)
+        #expect("WhatCable.zip".range(of: pattern, options: .regularExpression) != nil)
+        #expect("whatcable-cli-1.5.0.zip".range(of: pattern, options: .regularExpression) == nil)
+        #expect("whatcable-cli-1.5.0-beta.10.zip".range(of: pattern, options: .regularExpression) == nil)
+    }
+
+    // The beta counter must order numerically, and a stable must outrank its
+    // own betas, or a beta.9 install never sees beta.10.
+    #expect(VersionComparator.isNewer("1.5.0-beta.10", than: "1.5.0-beta.9"))
+    #expect(VersionComparator.isNewer("1.5.0", than: "1.5.0-beta.10"))
+}
