index 0000000..a50093e
--- /dev/null
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-trycua-driver.swift
@@ -0,0 +1,112 @@
+import Foundation
+
+enum com_trycua_driver {
+    static let set = AppRecipeSet(
+        family: "com-trycua-driver",
+        changelogs: [
+        // Cua Driver's notes are the release-please CHANGELOG checked in beside
+        // the Rust crate, not the GitHub release bodies. Two reasons, both the
+        // vendor's doing:
+        //
+        //  * A `.gitHubReleases` recipe cannot read this repo at all. Every stable
+        //    Cua Driver release is published with GitHub's `prerelease` flag set
+        //    (see the rule below), and that decoder keeps stable releases only.
+        //    It would fetch a page and produce zero entries.
+        //  * The body `GitHubReleasesSource` already carries inline covers ONE
+        //    release, and around its notes it has `## Install`, `## Why GitHub
+        //    says "Pre-release"` and a `## SHA256 Checksums` block. The file has
+        //    the history, and nothing else.
+        //
+        // Release-please's shape, the version in BRACKETS followed by a compare
+        // link and the day in parentheses:
+        //
+        //   ## [0.35.4](https://github.com/trycua/cua/compare/cua-driver-rs-v0.35.3...cua-driver-rs-v0.35.4) (2026-10-14)
+        //
+        //   ### Bug Fixes
+        //
+        //   * **cua-driver:** background browser clicks reach pointer-driven rows ([#5110](…)) ([a7c4a0e](…))
+        //
+        // Every bullet is one line, so the single-line item pattern is enough.
+        // The `**scope:**` prefix stays: it is where the vendor says which
+        // platform a fix is for (`cua-driver/linux`, `cua-driver/windows`,
+        // `cua-driver/macos`). `\n##\s` cannot fire on a `###` group heading,
+        // because a `#` follows the second `#` there, not whitespace. Every
+        // `###` in the file is a release-please category (Bug Fixes, Features,
+        // Performance Improvements, Reverts, ⚠ BREAKING CHANGES), so
+        // `headingPattern` keeps them as real headings, as the Mac Performance
+        // Monitor recipe does for Keep a Changelog. `CuaDriverRecipeTests` pins
+        // both against the real file's opening.
+        ChangelogRecipe(
+            bundleID: "com.trycua.driver",
+            source: URL(string: "https://raw.githubusercontent.com/trycua/cua/main/libs/cua-driver/rust/CHANGELOG.md")!,
+            entryPattern:
+                #"(?:^|\n)##\s+\[(?<version>[0-9][^\]]*)\]\([^)\n]*\)\s*\((?<date>[0-9]{4}-[0-9]{2}-[0-9]{2})\)\n(?<body>.*?)(?=\n##\s|\z)"#,
+            itemPatterns: [#"\n\*\s+(?<item>[^\n]+)"#],
+            markdownSource: true,
+            headingPattern: #"\n###\s+(?<heading>[^\n]+)"#),
+        ],
+        githubRules: [
+        // History: docs/app-audits/com-trycua-driver.md#历史与实测
+        //
+        // Cua Driver (`CuaDriver.app`), from the `trycua/cua` monorepo. The bundle
+        // carries no `SUFeedURL` and no electron-builder config; the app's own
+        // `check-update` reads this same repo's Releases. A `cuadriver` cask
+        // exists (not `auto_updates`), so a copy brew installed is served by
+        // `HomebrewCaskSource` first; every other copy lands here.
+        //
+        // The repo releases dozens of products. Nightly lume, the SDKs, Cua
+        // Spaces and others sit in front of the driver's tag most of the time,
+        // so this is a list rule that takes the first `cua-driver-rs-vX.Y.Z`
+        // tag, the Bitwarden shape.
+        //
+        // `usePrereleases: true` on a STABLE rule, on purpose. The vendor's
+        // release workflow publishes every stable Cua Driver release with
+        // `--prerelease`, and each release body says why: the flag only keeps
+        // this monorepo's single "Latest" pointer from flipping between
+        // products, and "a plain Cua Driver SemVer is a stable release". So the
+        // flag carries no channel meaning here, `/releases/latest` never
+        // returns a driver release, and the tag shape is the only track split.
+        // The vendor's own updater (`version_check.rs`) splits the same way: it
+        // ignores the flag and accepts only plain `x.y.z` behind the
+        // `cua-driver-rs-v` prefix. This pattern copies that rule, anchored at
+        // both ends, so a `cua-driver-rs-v0.36.0-rc.1`, a
+        // `nightly-cua-driver-rs-v…-nightly.…` tag and the retired Swift port's
+        // `cua-driver-v…` tags all read as nothing.
+        //
+        // `listPageSize: 30` clears the floor `GitHubListPageSizeTests` records
+        // for this rule (the worst run between two driver tags, measured over
+        // the repo's whole history; History has it) with room for a bigger
+        // burst. A page is large here (each driver release lists dozens of
+        // assets), so it is not padded further. `probesNewestFirst: false` for
+        // the same reason as Bitwarden: nightly lume releases daily, so the
+        // newest row is rarely a driver tag and a one-row probe would mostly
+        // add a request.
+        //
+        // One-click installs the universal tarball, the same artifact the
+        // vendor's installer and the Homebrew cask use. It unpacks to
+        // `cua-driver-rs-<v>-darwin-universal/CuaDriver.app`, one directory
+        // down, which `ArchiveExtractor` finds. On macOS the vendor's installer
+        // only `ditto`s that bundle to `/Applications/CuaDriver.app` and links
+        // the CLI into it, so swapping the bundle in place is the whole install.
+        // The bundles are `com.trycua.driver`, Team `YCK386LBJ7`, notarized
+        // and stapled (History has the packages checked). The pattern does not
+        // take the `-universal-binary` tarball (a bare CLI, no app) or the
+        // per-arch ones.
+        //
+        // Nightly shares this bundle id, and its bundle cannot be told apart
+        // from stable: the workflow stamps `${VERSION%%-*}` into both
+        // CFBundle version keys, so `0.30.5-nightly.<date>.<run>` reads `0.30.5`.
+        // No nightly rule, then. A nightly copy is served this stable rule and
+        // is offered a stable release only once that release is above its base
+        // version. The audit has the details.
+        GitHubReleaseRule(
+            bundleID: "com.trycua.driver",
+            owner: "trycua", repo: "cua",
+            usePrereleases: true,
+            listPageSize: 30,
+            versionPattern: #"^cua-driver-rs-v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^cua-driver-rs-[0-9]+\.[0-9]+\.[0-9]+-darwin-universal\.tar\.gz$"#,
+            installerKind: .tarGz,
+            probesNewestFirst: false),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CuaDriverRecipeTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CuaDriverRecipeTests.swift
new file mode 100644
index 0000000..d6b2afe
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CuaDriverRecipeTests.swift
@@ -0,0 +1,283 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// Cua Driver (`com.trycua.driver`, `trycua/cua`). Three decisions in its family
+/// are easy to undo by accident, and each is pinned here against strings the
+/// vendor really publishes (fetched 2026-10-14):
+///
+///  * the stable rule reads the releases LIST and ignores GitHub's
+///    `prerelease` flag, because the vendor sets that flag on every stable
+///    release of this monorepo;
+///  * the tag pattern is anchored, because that flag no longer separates
+///    anything and the tag shape is the only track split left;
+///  * the notes come from the release-please `CHANGELOG.md`, not the release
+///    bodies.
+///
+/// See `docs/app-audits/com-trycua-driver.md` for the measurements.
+@Suite(.serialized)
+struct CuaDriverRecipeTests {
+    private static let bundleID = "com.trycua.driver"
+
+    /// Every rule this bundle id carries, and the lookup must find something:
+    /// a typo'd bundle id or an unregistered family would otherwise leave the
+    /// suite green while it checks nothing.
+    private static var rules: [GitHubReleaseRule] {
+        get throws {
+            let found = GitHubReleaseRegistry.rules.filter { $0.bundleID == bundleID }
+            try #require(!found.isEmpty, "com.trycua.driver is no longer in GitHubReleaseRegistry")
+            return found
+        }
+    }
+
+    private static var stableRule: GitHubReleaseRule {
+        get throws {
+            try #require(self.rules.first { $0.channel == .stable }, "com.trycua.driver has no stable rule")
+        }
+    }
+
+    /// Nightly copies carry the same bundle id and a version stripped of its
+    /// `-nightly.…` suffix, so nothing local can route one to a nightly rule.
+    /// A second rule here would be a rule no copy can be detected for.
+    @Test func thereIsOneRuleAndItIsStable() throws {
+        let rules = try Self.rules
+        #expect(rules.count == 1)
+        #expect(rules.first?.channel == .stable)
+    }
+
+    // MARK: - Tag pattern
+
+    /// Real tags, newest and oldest of the Rust line and the last one that
+    /// still shipped `CuaDriverRs.app`. `extractVersion` is the same call
+    /// `GitHubReleasesSource` makes on every release it walks.
+    @Test(arguments: [
+        ("cua-driver-rs-v0.35.4", "0.35.4"),
+        ("cua-driver-rs-v0.35.2", "0.35.2"),
+        ("cua-driver-rs-v0.2.18", "0.2.18"),
+        ("cua-driver-rs-v0.1.3", "0.1.3"),
+        ("cua-driver-rs-v1.0.0", "1.0.0"),
+    ])
+    func driverTagsResolveToTheirVersion(tag: String, expected: String) throws {
+        let rule = try Self.stableRule
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == expected)
+    }
+
+    /// Tags the rule must read as nothing. The first two are real (the nightly
+    /// track, and the retired Swift port that shares this bundle id); the rest
+    /// are shapes the vendor's own updater refuses for stable. GitHub's flag
+    /// cannot keep the rc out: the vendor sets `prerelease` on stable releases
+    /// too, so an rc would arrive looking exactly like them.
+    ///
+    /// Mutation: the registry default `v?([0-9]+(?:\.[0-9]+)+)` (unanchored)
+    /// reads `0.36.0` out of the rc and `0.2.0` out of the Swift tag.
+    @Test(arguments: [
+        "nightly-cua-driver-rs-v0.30.5-nightly.20260929.36522098176",
+        "cua-driver-v0.2.0",
+        "cua-driver-rs-v0.36.0-rc.1",
+        "cua-driver-rs-v0.36.0-beta.1",
+        "cua-driver-rs-v0.35.4+build.1",
+        "nightly-lume-v0.6.2-nightly.20261014.38513423832",
+        "cua-spaces-v0.8.0",
+    ])
+    func otherTracksAndProductsAreNotRead(tag: String) throws {
+        let rule = try Self.stableRule
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == nil)
+    }
+
+    // MARK: - Install asset
+
+    /// The real macOS-side asset names of `cua-driver-rs-v0.35.4`. Only the
+    /// universal tarball carries `CuaDriver.app`; `-universal-binary` is the
+    /// bare CLI and the per-arch tarballs are not what the vendor's installer
+    /// or the cask use.
+    private static let realDarwinAssets = [
+        "cua-driver-rs-0.35.4-darwin-arm64.tar.gz",
+        "cua-driver-rs-0.35.4-darwin-arm64.tar.gz.sigstore.json",
+        "cua-driver-rs-0.35.4-darwin-universal-binary.tar.gz",
+        "cua-driver-rs-0.35.4-darwin-universal-binary.tar.gz.sigstore.json",
+        "cua-driver-rs-0.35.4-darwin-universal.tar.gz",
+        "cua-driver-rs-0.35.4-darwin-universal.tar.gz.sigstore.json",
+        "cua-driver-rs-0.35.4-darwin-x86_64.tar.gz",
+        "cua-driver-rs-0.35.4-darwin-x86_64.tar.gz.sigstore.json",
+        "cua_driver-0.35.4-py3-none-macosx_13_0_universal2.whl",
+        "cua-driver-rs-v0.35.4-skills.tar.gz",
+    ]
+
+    @Test func onlyTheUniversalAppTarballIsInstallable() throws {
+        let rule = try Self.stableRule
+        let pattern = try #require(rule.installAssetPattern)
+        #expect(rule.installerKind == .tarGz)
+        let regex = try NSRegularExpression(pattern: pattern)
+        let matched = Self.realDarwinAssets.filter {
+            regex.firstMatch(in: $0, range: NSRange($0.startIndex..., in: $0)) != nil
+        }
+        #expect(matched == ["cua-driver-rs-0.35.4-darwin-universal.tar.gz"])
+    }
+
+    // MARK: - Resolution against the vendor's real page shape
+
+    private final class StubProtocol: URLProtocol, @unchecked Sendable {
+        final class Script: @unchecked Sendable {
+            private let lock = NSLock()
+            private var bodies: [String: String] = [:]
+            private var requested: [String] = []
+            func load(_ table: [String: String]) { lock.lock(); bodies = table; requested = []; lock.unlock() }
+            func body(for url: String) -> String? {
+                lock.lock(); defer { lock.unlock() }
+                requested.append(url)
+                return bodies[url]
+            }
+            var urls: [String] { lock.lock(); defer { lock.unlock() }; return requested }
+        }
+        static let script = Script()
+
+        override class func canInit(with request: URLRequest) -> Bool { true }
+        override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+        override func startLoading() {
+            let body = Self.script.body(for: request.url!.absoluteString)
+            let response = HTTPURLResponse(
+                url: request.url!, statusCode: body == nil ? 404 : 200,
+                httpVersion: "HTTP/1.1", headerFields: [:])!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: Data((body ?? "{}").utf8))
+            client?.urlProtocolDidFinishLoading(self)
+        }
+        override func stopLoading() {}
+    }
+
+    private static func session() -> URLSession {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.protocolClasses = [StubProtocol.self]
+        configuration.urlCache = nil
+        return URLSession(configuration: configuration)
+    }
+
+    /// One release row, flagged the way this vendor flags it.
+    private static func release(_ tag: String, prerelease: Bool, assets: [String]) -> String {
+        let assetJSON = assets.map {
+            #"{"name": "\#($0)", "browser_download_url": "https://github.com/trycua/cua/releases/download/\#(tag)/\#($0)", "size": 83035346}"#
+        }.joined(separator: ",")
+        return """
+        {"tag_name": "\(tag)", "assets": [\(assetJSON)], "prerelease": \(prerelease), "draft": false,
+         "published_at": "2026-10-14T12:32:14Z", "html_url": "https://github.com/trycua/cua/releases/tag/\(tag)",
+         "body": ""}
+        """
+    }
+
+    /// The head of the real list on 2026-10-14: a nightly-lume release on top,
+    /// then the driver's stable release (flagged prerelease, as all of them
+    /// are), then another product's release that is NOT flagged. A
+    /// hypothetical nightly-driver and rc tag sit in front of the stable one
+    /// as well, to prove the tag shape does the splitting.
+    ///
+    /// Mutations this catches: `usePrereleases: false` (the rule asks
+    /// `/releases/latest`, which this repo never points at a driver release —
+    /// the stub answers 404 and nothing resolves); a page size or probe change
+    /// (the URL differs and nothing resolves); an unanchored pattern (the rc or
+    /// the nightly is offered).
+    @Test func theStableReleaseResolvesThroughThePrereleaseFlag() async throws {
+        let rule = try Self.stableRule
+        let listURL = "https://api.github.com/repos/trycua/cua/releases?per_page=30"
+        StubProtocol.script.load([
+            listURL: "[" + [
+                Self.release("nightly-lume-v0.6.2-nightly.20261014.38513423832", prerelease: true,
+                             assets: ["lume-0.6.2-nightly.20261014.38513423832-darwin-arm64.tar.gz"]),
+                Self.release("nightly-cua-driver-rs-v0.35.5-nightly.20261015.1", prerelease: true,
+                             assets: ["cua-driver-rs-0.35.5-nightly.20261015.1-darwin-universal.tar.gz"]),
+                Self.release("cua-driver-rs-v0.36.0-rc.1", prerelease: true,
+                             assets: ["cua-driver-rs-0.36.0-rc.1-darwin-universal.tar.gz"]),
+                Self.release("cua-driver-rs-v0.35.4", prerelease: true, assets: Self.realDarwinAssets),
+                Self.release("cua-spaces-v0.8.0", prerelease: false,
+                             assets: ["cua-spaces-0.8.0-darwin-universal.dmg"]),
+            ].joined(separator: ",") + "]",
+        ])
+        let source = GitHubReleasesSource(rules: [rule], session: Self.session())
+
+        let outcome = await source.resolveDiagnostic(rule, preferring: .arm64, allowingIntelTranslation: false)
+
+        let remote = try #require(outcome.remote, "nothing resolved; requested \(StubProtocol.script.urls)")
+        #expect(remote.shortVersion == "0.35.4")
+        #expect(remote.downloadURL?.lastPathComponent == "cua-driver-rs-0.35.4-darwin-universal.tar.gz")
+        #expect(remote.vendorInstallerKind == .tarGz)
+        #expect(!remote.requiresManualInstaller)
+        #expect(StubProtocol.script.urls == [listURL])
+    }
+
+    // MARK: - Changelog
+
+    private static var changelogRecipe: ChangelogRecipe {
+        get throws {
+            try #require(ChangelogRecipeRegistry.recipes.first { $0.bundleID == bundleID })
+        }
+    }
+
+    /// Verbatim from `libs/cua-driver/rust/CHANGELOG.md` on `main`, 2026-10-14:
+    /// the preamble, then the 0.35.2 and 0.35.1 entries exactly as they sit
+    /// in the file (0.35.1 has two groups, so headings are exercised).
+    private static let fixture = #"""
+    # Changelog
+
+    ## [0.35.2](https://github.com/trycua/cua/compare/cua-driver-rs-v0.35.1...cua-driver-rs-v0.35.2) (2026-10-13)
+
+
+    ### Bug Fixes
+
+    * **cua-driver:** name the missing AT-SPI bus in the X11 background keyboard refusal ([#5070](https://github.com/trycua/cua/issues/5070)) ([d7c98c1](https://github.com/trycua/cua/commit/d7c98c1e0f661b1e0b1ca821a79b6a5ef45fbd2c))
+    * **cua-driver:** scroll an inner Electron scroller in the background on macOS ([#5079](https://github.com/trycua/cua/issues/5079)) ([f72e033](https://github.com/trycua/cua/commit/f72e033269cd42c6e630cccd6496325b8b698248))
+    * **cua-driver:** tolerate a transient UIA read and a twice-reported consent prompt on Windows ([#5082](https://github.com/trycua/cua/issues/5082)) ([f0c468f](https://github.com/trycua/cua/commit/f0c468f7b2b5875726a909b6d395204110777873))
+
+    ## [0.35.1](https://github.com/trycua/cua/compare/cua-driver-rs-v0.35.0...cua-driver-rs-v0.35.1) (2026-10-13)
+
+
+    ### Features
+
+    * **cua-driver:** attach to an existing Chrome profile in the background when Chrome is on another Space (macOS) ([#5052](https://github.com/trycua/cua/issues/5052)) ([10c5d3f](https://github.com/trycua/cua/commit/10c5d3f3d40f96009ac542fd3725b832b2ff7a36))
+
+
+    ### Bug Fixes
+
+    * **cua-driver:** pixel type_text, press_key and scroll in the background focus their target again on macOS ([#5062](https://github.com/trycua/cua/issues/5062)) ([d0a5093](https://github.com/trycua/cua/commit/d0a50933f0492993ebd6111ebb058712d7958080))
+    * **cua-driver:** skip AT-SPI frame rebase when the frame has no extents ([#4984](https://github.com/trycua/cua/issues/4984)) ([7d8378f](https://github.com/trycua/cua/commit/7d8378f168264ac2b622870334f37f6589e07c24))
+    * **cua-driver:** stop advertising pid as required for element_token tools ([#5047](https://github.com/trycua/cua/issues/5047)) ([a85f1be](https://github.com/trycua/cua/commit/a85f1be9cb787249118b3cfaac4a0935c6b21a6f))
+    """#
+
+    @Test func theRecipeReadsTheCheckedInChangelog() throws {
+        let recipe = try Self.changelogRecipe
+        #expect(recipe.source.absoluteString
+                == "https://raw.githubusercontent.com/trycua/cua/main/libs/cua-driver/rust/CHANGELOG.md")
+        #expect(recipe.markdownSource)
+        #expect(recipe.channel == nil)
+    }
+
+    /// Mutation: dropping the `\(...)` compare-link part of the entry pattern
+    /// (copying the Keep a Changelog recipe's `\]\s*-\s*` shape) parses nothing.
+    @Test func entriesAreTheReleasesWithTheirDays() throws {
+        let parsed = try #require(ChangelogService.parse(try Self.changelogRecipe, body: Self.fixture))
+        #expect(parsed.entries.map(\.version) == ["0.35.2", "0.35.1"])
+        #expect(parsed.entries.map(\.date) == ["2026-10-13", "2026-10-13"])
+        #expect(parsed.entries.map(\.items.count) == [3, 4])
+    }
+
+    /// The `**scope:**` prefix is where the vendor says which platform a fix is
+    /// for, so it stays; a group heading never becomes or leaks into an item.
+    @Test func itemsKeepTheirScopeAndHeadingsStayHeadings() throws {
+        let parsed = try #require(ChangelogService.parse(try Self.changelogRecipe, body: Self.fixture))
+        let newer = try #require(parsed.entries.first)
+        #expect(newer.items.first?.hasPrefix("**cua-driver:** name the missing AT-SPI bus") == true)
+        for entry in parsed.entries {
+            for item in entry.items {
+                #expect(!item.contains("###"), "a group heading leaked into an item: \(item)")
+                #expect(!item.contains("## ["), "an entry heading leaked into an item: \(item)")
+            }
+        }
+        let older = try #require(parsed.entries.last)
+        #expect(older.content == [
+            .heading("Features"),
+            .note(older.items[0]),
+            .heading("Bug Fixes"),
+            .note(older.items[1]),
+            .note(older.items[2]),
+            .note(older.items[3]),
+        ])
+    }
+}
