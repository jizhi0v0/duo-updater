@@ -0,0 +1,31 @@
+import Foundation
+
+enum io_github_tobi_disktree {
+    static let set = AppRecipeSet(
+        family: "io-github-tobi-disktree",
+        githubRules: [
+        // disktree (tobi/disktree) — a Rust + GPUI disk-usage treemap. No
+        // updater of any kind: no `SUFeedURL`, no electron-builder config, and
+        // the binary names no GitHub API or release address, so this rule is the
+        // only source. The release workflow refuses a tag that is not
+        // `v<Cargo.toml version>`, and `xtask bundle` writes that version into
+        // both CFBundleShortVersionString and CFBundleVersion, so short == tag
+        // (checked 2026-10-14 on 0.10.1/0.11.0). macOS assets start at 0.10.0.
+        //
+        // Digest-only (see `Recipes/org-alacritty.swift`): the workflow signs
+        // with a Developer ID only when the repository has signing secrets, and
+        // every published build so far is ad-hoc — no Team ID, `spctl`
+        // rejected — with a seal that verifies and a signed identifier equal to
+        // the bundle id. One zip per arch (`aarch64` / `x86_64`), `disktree.app`
+        // at the top, no nested apps or helpers. Should upstream start signing,
+        // the digest route refuses the first Developer ID build over an ad-hoc
+        // copy (`teamIdentifierAppeared`); that update is by hand once, and the
+        // rule then moves to the default trust.
+        GitHubReleaseRule(
+            bundleID: "io.github.tobi.disktree",
+            owner: "tobi", repo: "disktree",
+            installAssetPattern: #"^disktree-[0-9.]+-(?:aarch64|x86_64)-macos\.zip$"#,
+            installerKind: .zip,
+            installTrust: .publishedDigestOnly),
+        ])
+}
