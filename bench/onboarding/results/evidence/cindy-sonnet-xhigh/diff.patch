+        #expect(parsed.entries[0].items.count == 7)
+        #expect(parsed.entries[0].items.allSatisfy {
+            $0.hasPrefix("commit:") || $0.hasPrefix("source tag:") || $0.hasPrefix("regions:")
+                || $0.hasPrefix("iOS(") || $0.hasPrefix("Android(")
+        })
+    }
