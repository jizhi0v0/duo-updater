    "Turn them on to roll back an update and compare what it changed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere sie, um ein Update rückgängig zu machen und zu vergleichen, was es geändert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalas para revertir una actualización y comparar lo que cambió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-les pour annuler une mise à jour et comparer ce qu'elle a modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivali per ripristinare un aggiornamento e confrontare cosa ha cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、更新をロールバックしたり、変更内容を比較したりできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative-os para reverter uma atualização e comparar o que ela mudou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите их, чтобы откатывать обновления и сравнивать, что в них изменилось."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir güncellemeyi geri almak ve neyi değiştirdiğini karşılaştırmak için açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后可回滚更新，并比较更新改动了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後即可還原更新，並比對更新改了什麼。"
          }
        }
      }
    },
