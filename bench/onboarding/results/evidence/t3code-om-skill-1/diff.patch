@@ -0,0 +1,169 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// T3 Code (`pingdotgg/t3code`): Stable and Nightly share bundle id
+/// `com.t3tools.t3code`, and the Stable app is named "T3 Code (Alpha)".
+///
+/// Every identity below was read off a real arm64 dmg from the repo's releases,
+/// mounted read-only on 2026-10-14 (`CFBundleName`, `CFBundleShortVersionString`;
+/// `CFBundleVersion` is the same string in every one of them).
+private let bundleID = "com.t3tools.t3code"
+
+/// One real bundle per track, with the release tag it shipped under.
+private struct RealBundle {
+    let name: String
+    let version: String
+    let tag: String
+    let channel: ReleaseChannel
+}
+
+private let realBundles: [RealBundle] = [
+    RealBundle(name: "T3 Code (Alpha)", version: "0.0.45", tag: "v0.0.45", channel: .stable),
+    RealBundle(name: "T3 Code (Alpha)", version: "0.0.44", tag: "v0.0.44", channel: .stable),
+    RealBundle(name: "T3 Code (Alpha)", version: "0.0.21", tag: "v0.0.21", channel: .stable),
+    RealBundle(name: "T3 Code (Nightly)", version: "0.0.46-nightly.20261014.3105",
+               tag: "v0.0.46-nightly.20261014.3105", channel: .nightly),
+    // Maintainer-only test build ("do not install"): no rule serves it, and it
+    // must not read as Stable, because it carries Stable's name.
+    RealBundle(name: "T3 Code (Alpha)", version: "0.0.46-preview.20261010.2909",
+               tag: "v0.0.46-preview.20261010.2909", channel: .preview),
+]
+
+/// Early stable releases, tagged `v0.0.0-alpha.<N>` and NOT flagged prerelease.
+/// alpha.14 and older ship no `app-update.yml`, so they cannot update themselves.
+private let earlyStableVersions = ["0.0.0-alpha.22", "0.0.0-alpha.14", "0.0.0-alpha.3"]
+
+private func rules() -> [GitHubReleaseRule] {
+    GitHubReleaseRegistry.rules.filter { $0.bundleID == bundleID }
+}
+
+private func rule(_ channel: ReleaseChannel) -> GitHubReleaseRule? {
+    rules().first { $0.channel == channel }
+}
+
+private func detect(_ name: String, _ version: String) -> ReleaseChannel {
+    ReleaseChannel.detect(
+        name: name, bundleID: bundleID, keystoneChannel: nil, version: version,
+        bundleFileName: name)
+}
+
+@Test func t3CodeRealBundlesDetectAsTheirOwnTrack() {
+    for bundle in realBundles {
+        #expect(detect(bundle.name, bundle.version) == bundle.channel,
+                "\(bundle.name) \(bundle.version)")
+    }
+    for version in earlyStableVersions {
+        #expect(detect("T3 Code (Alpha)", version) == .stable, "\(version)")
+    }
+}
+
+/// The 0.9 step is scoped to this bundle id. Any other app with "Alpha" in its
+/// name keeps the generic reading.
+@Test func t3CodeAlphaOverrideDoesNotLeakToOtherApps() {
+    #expect(ReleaseChannel.detect(
+        name: "Something (Alpha)", bundleID: "com.example.something",
+        keystoneChannel: nil, version: "0.0.45") == .alpha)
+}
+
+/// A prerelease shape we have not seen falls through to the name, which reads
+/// `.alpha`, and no rule serves `.alpha`. So the copy gets nothing, not Stable.
+@Test func t3CodeUnknownPrereleaseShapeIsNotStable() {
+    let channel = detect("T3 Code (Alpha)", "0.1.0-beta.1")
+    #expect(channel != .stable)
+    #expect(rule(channel) == nil)
+}
+
+/// Derived from the registry. Every T3 Code rule has a real bundle on its
+/// channel. That bundle detects as the rule's channel. The rule reads the
+/// bundle's own tag as exactly the installed version. No other T3 Code rule
+/// accepts that tag.
+@Test func t3CodeEveryRuleReadsItsOwnTrackAndNoOther() throws {
+    let all = rules()
+    #expect(Set(all.map(\.channel)) == [.stable, .nightly])
+    for r in all {
+        let own = realBundles.filter { $0.channel == r.channel }
+        #expect(!own.isEmpty, "no real bundle backs the \(r.channel) rule")
+        for bundle in own {
+            #expect(detect(bundle.name, bundle.version) == r.channel)
+            let read = try #require(
+                VendorProbeRecipe.extractVersion(from: bundle.tag, pattern: r.versionPattern))
+            #expect(VersionComparator.compare(read, bundle.version) == .orderedSame,
+                    "\(r.channel) read \(read) for installed \(bundle.version)")
+        }
+        for bundle in realBundles where bundle.channel != r.channel {
+            #expect(VendorProbeRecipe.extractVersion(
+                from: bundle.tag, pattern: r.versionPattern) == nil,
+                "\(r.channel) rule accepts the \(bundle.channel) tag \(bundle.tag)")
+        }
+    }
+}
+
+@Test func t3CodeStablePatternReadsTheNextReleaseAndRefusesAnRc() throws {
+    let stable = try #require(rule(.stable))
+    #expect(stable.usePrereleases == false)
+    func read(_ tag: String) -> String? {
+        VendorProbeRecipe.extractVersion(from: tag, pattern: stable.versionPattern)
+    }
+    #expect(read("v0.0.9") == "0.0.9")
+    #expect(read("v0.1") == "0.1")
+    #expect(read("v1.0.0") == "1.0.0")
+    #expect(read("v0.1.0-rc.1") == nil)
+    #expect(read("android-nightly") == nil)
+}
+
+@Test func t3CodeNightlyVersionsOrderByRun() throws {
+    let nightly = try #require(rule(.nightly))
+    #expect(nightly.usePrereleases)
+    #expect(VendorProbeRecipe.extractVersion(
+        from: "nightly-v0.0.21-nightly.20260417.58", pattern: nightly.versionPattern) == nil)
+    #expect(VersionComparator.isNewer(
+        "0.0.46-nightly.20261014.3105", than: "0.0.46-nightly.20261014.3093"))
+    #expect(VersionComparator.isNewer(
+        "0.0.47-nightly.20261020.3200", than: "0.0.46-nightly.20261014.3105"))
+}
+
+/// Every macOS-relevant asset name in the real v0.0.45 and
+/// v0.0.46-nightly.20261014.3105 releases, plus the Preview build's dmg.
+private let realAssets = [
+    "T3-Code-0.0.45-arm64.dmg", "T3-Code-0.0.45-arm64.dmg.blockmap",
+    "T3-Code-0.0.45-arm64.zip", "T3-Code-0.0.45-arm64.zip.blockmap",
+    "T3-Code-0.0.45-x64.dmg", "T3-Code-0.0.45-x64.zip", "latest-mac.yml",
+    "T3-Code-0.0.45-arm64.AppImage", "T3-Code-0.0.45-arm64.exe",
+    "T3-Code-0.0.46-nightly.20261014.3105-arm64.dmg",
+    "T3-Code-0.0.46-nightly.20261014.3105-arm64.dmg.blockmap",
+    "T3-Code-0.0.46-nightly.20261014.3105-arm64.zip",
+    "T3-Code-0.0.46-nightly.20261014.3105-x64.dmg", "nightly-mac.yml",
+    "T3-Code-0.0.46-preview.20261010.2909-arm64.dmg",
+]
+
+@Test func t3CodeEachRuleMatchesOnlyItsOwnArm64Dmg() throws {
+    let expected: [ReleaseChannel: String] = [
+        .stable: "T3-Code-0.0.45-arm64.dmg",
+        .nightly: "T3-Code-0.0.46-nightly.20261014.3105-arm64.dmg",
+    ]
+    for r in rules() {
+        let pattern = try #require(r.installAssetPattern)
+        let hits = realAssets.filter { $0.range(of: pattern, options: .regularExpression) != nil }
+        #expect(hits == [expected[r.channel]], "\(r.channel) matched \(hits)")
+        #expect(r.installerKind == .dmg)
+    }
+}
+
+/// The stable release body is GitHub's generated "What's Changed" list. This is
+/// the real v0.0.44 body, verbatim.
+@Test func t3CodeReleaseBodyParsesIntoAStructuredChangelog() throws {
+    let body = """
+    ## What's Changed
+    * fix(codex): Pro Max accounts load, so Ultrafast shows up by @t3dotgg in https://github.com/pingdotgg/t3code/pull/14304
+
+
+    **Full Changelog**: https://github.com/pingdotgg/t3code/compare/v0.0.43...v0.0.44
+    """
+    let changelog = try #require(GitHubMarkdownParser.parse(
+        body: body, version: "0.0.44", date: "2026-09-29T20:48:58Z"))
+    #expect(changelog.entries.count == 1)
+    #expect(changelog.entries.first?.version == "0.0.44")
+    #expect(changelog.entries.first?.items == [
+        "fix(codex): Pro Max accounts load, so Ultrafast shows up"])
+}
