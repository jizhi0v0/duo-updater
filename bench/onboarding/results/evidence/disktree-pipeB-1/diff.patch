@@ -0,0 +1,37 @@
+import Foundation
+
+enum io_github_tobi_disktree {
+    static let set = AppRecipeSet(
+        family: "io-github-tobi-disktree",
+        githubRules: [
+        // Shared rationale for digest-only: Recipes/org-alacritty.swift.
+
+        // disktree (tobi) — Rust + GPUI disk treemap. No Sparkle and no updater
+        // of its own. Tags are `vX.Y.Z`: release.yml refuses a tag that is not
+        // `v` + the Cargo.toml version, and the bundle's short and build
+        // versions are both that version (0.10.0, 0.10.1 and 0.11.0, both arches).
+        // v0.9.x shipped no macOS build.
+        //
+        // Ad-hoc signed, no Team ID (`spctl` rejects it): release.yml signs with
+        // Developer ID only when the repo has the signing secrets, and no
+        // release so far was signed that way. The seal verifies (`codesign
+        // --verify --deep --strict` 0), the signed identifier is
+        // io.github.tobi.disktree, and GitHub publishes a sha256 for every
+        // asset (matches the downloads), so `.publishedDigestOnly`. Should a
+        // release ever arrive Developer ID signed, the digest-only gate refuses
+        // it (`teamIdentifierAppeared`) and this rule has to move to
+        // `.developerID`.
+        //
+        // Thin zips per arch, `disktree-<v>-aarch64-macos.zip` /
+        // `-x86_64-macos.zip`, beside Linux/Windows archives and `.sha256`
+        // sidecars; the arch is left to the source's arch preference. The
+        // bundle is the binary, its plist and icon: no helpers or nested apps.
+        GitHubReleaseRule(
+            bundleID: "io.github.tobi.disktree",
+            owner: "tobi", repo: "disktree",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^disktree-[0-9.]+-(?:aarch64|x86_64)-macos\.zip$"#,
+            installerKind: .zip,
+            installTrust: .publishedDigestOnly),
+        ])
+}
