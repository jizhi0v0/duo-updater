+import Foundation
+
+enum com_maxgoedjen_Secretive_Host {
+    static let set = AppRecipeSet(
+        family: "com-maxgoedjen-Secretive-Host",
+        githubRules: [
+        // Secretive — Secure Enclave SSH key agent. No SUFeedURL; the app's own
+        // updater (the SecretiveUpdater XPC) reads
+        // api.github.com/repos/maxgoedjen/secretive/releases, drops prereleases,
+        // and offers the newest release whose stated minimum macOS this Mac meets.
+        // `/releases/latest` is that same stable list. v-tags (`v4.0.0`) ==
+        // CFBundleShortVersionString; CFBundleVersion is `1.<CI run id>` and does
+        // not take part. One update track. The nightly and one-off workflows DO
+        // build signed, notarized copies on the same bundle id and Team, but only
+        // as Actions artifacts (never a release), with version
+        // `0.0.0_nightly-<date>` / `0.0.0_oneoff-<date>`; `ReleaseChannel.detect`
+        // step 0.75 reads those as non-stable so this rule refuses them. The
+        // `v0.x` prereleases are 2020. Every release carries one asset,
+        // `Secretive.zip` (universal, Developer ID, Team Z72PRUAWF6, notarized,
+        // no stapled ticket). The release's OS floor moves (11.0 → 12.0 → 14.0 →
+        // 15.0); the installer's own LSMinimumSystemVersion gate reads it off the
+        // downloaded bundle.
+        GitHubReleaseRule(
+            bundleID: "com.maxgoedjen.Secretive.Host",
+            owner: "maxgoedjen", repo: "secretive",
+            versionPattern: #"^v([0-9]+(?:\.[0-9]+)+)$"#,
+            installAssetPattern: #"^Secretive\.zip$"#,
+            installerKind: .zip),
+        ])
+}
