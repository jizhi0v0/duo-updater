+import Foundation
+
+enum rocks_spotifast_Spotifast {
+    static let set = AppRecipeSet(
+        family: "rocks-spotifast-Spotifast",
+        changelogs: [
+        // Spotifast — release bodies from the releases API. The GitHub rule
+        // below carries only the newest body, and upstream releases every few
+        // days, so a copy a few versions behind would see one version's notes.
+        // Each body is `packaging/release-notes/<tag>.md`: a summary paragraph,
+        // a download-links paragraph, then `## New` / `## Fixed` / `## Changed`
+        // / `## Known limitations` bullets and a `## Thanks` paragraph. The
+        // links and the thanks are paragraphs, so they never become items.
+        ChangelogRecipe(
+            bundleID: "rocks.spotifast.Spotifast",
+            source: URL(string: "https://api.github.com/repos/crmne/spotifast/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases),
+        ],
+        githubRules: [
+        // Spotifast — Rust/egui Spotify client (crmne/spotifast). No
+        // SUFeedURL: its own updater (fastframe-update) reads this repo's
+        // `/releases/latest`, never offers a prerelease, and installs
+        // `spotifast-v<ver>-macos-universal.dmg` after checking the release's
+        // Ed25519-signed `checksums.txt`. There is no Homebrew cask.
+        //
+        // The release workflow flags every tag with a `-` (`v0.5.0-rc1`) as a
+        // prerelease, and `packaging/macos/bundle.sh` stamps
+        // CFBundleShortVersionString with the tag minus `v`, so short == tag on
+        // stable. The anchors keep a suffixed tag out either way.
+        //
+        // The bundle id is `rocks.spotifast.Spotifast` from 0.10.0; 0.9.1 and
+        // earlier were `me.paolino.fastpotify` (Fastpotify, the old name), which
+        // upstream's own updater moves over. This rule covers the new id only —
+        // see the audit.
+        //
+        // One-click: one universal dmg per release, `Spotifast.app` at its
+        // root; Team JPL7999US3 on 0.10.0, 0.11.2 and 0.12.0, notarized, the
+        // dmg stapled. GitHub publishes a sha256 digest for the asset.
+        GitHubReleaseRule(
+            bundleID: "rocks.spotifast.Spotifast",
+            owner: "crmne", repo: "spotifast",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^spotifast-v[0-9]+\.[0-9]+\.[0-9]+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
