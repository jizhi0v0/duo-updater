diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift
new file mode 100644
index 0000000..3712a8d
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/TinycastGitHubRuleTests.swift
@@ -0,0 +1,177 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// Tinycast (`com.tinycast.app`, and its side-by-side beta app
+/// `com.tinycast.app.beta`, both from `abue-ammar/tinycast`). Every decision in
+/// `Recipes/com-tinycast-app.swift` that is easy to undo by accident is pinned
+/// here against the real strings the vendor publishes.
+///
+/// See `docs/app-audits/com-tinycast-app.md` for the measurements.
+@Suite struct TinycastGitHubRuleTests {
+
+    static let stableID = "com.tinycast.app"
+    static let betaID = "com.tinycast.app.beta"
+
+    /// EVERY rule either bundle id carries — the detection-only guard has to
+    /// vouch for all of them, not the first one found. Non-empty per id is
+    /// required, so a typo'd id or an unregistered family fails loudly instead
+    /// of leaving the suite green over nothing.
+    private static var rules: [GitHubReleaseRule] {
+        get throws {
+            let stable = GitHubReleaseRegistry.rules.filter { $0.bundleID == stableID }
+            let beta = GitHubReleaseRegistry.rules.filter { $0.bundleID == betaID }
+            try #require(!stable.isEmpty, "\(stableID) is no longer in GitHubReleaseRegistry")
+            try #require(!beta.isEmpty, "\(betaID) is no longer in GitHubReleaseRegistry")
+            return stable + beta
+        }
+    }
+
+    private static func rule(_ bundleID: String, _ channel: ReleaseChannel) throws -> GitHubReleaseRule {
+        try #require(
+            try rules.first { $0.bundleID == bundleID && $0.channel == channel },
+            "\(bundleID) has no \(channel) rule any more")
+    }
+
+    /// Every package is signed with the vendor's own "Tinycast Self-Signed"
+    /// certificate: no Team Identifier, no notarization ticket (measured on the
+    /// 0.11.19, 0.11.12 and 0.11.21-beta.120 zips). `SignatureVerifier` gate 3
+    /// throws `noTeamIdentifier` on such a bundle, so an install spec could only
+    /// ever produce an Update button that fails.
+    @Test func everyTinycastRuleStaysDetectionOnly() throws {
+        for rule in try Self.rules {
+            #expect(rule.installAssetPattern == nil,
+                    "\(rule.bundleID) (\(rule.channel)): Tinycast ships self-signed builds with no Team ID — an install pattern here can only fail gate 3")
+            #expect(rule.installerKind == nil,
+                    "\(rule.bundleID) (\(rule.channel)): see above")
+        }
+    }
+
+    /// The vendor's own split, restated: stable reads `/releases/latest`, which
+    /// GitHub computes without prereleases; beta reads the list, because every
+    /// beta is published flagged prerelease. Swap either and the rule reads the
+    /// other app's train.
+    @Test func eachBundleIDReadsItsOwnTrain() throws {
+        let stable = try Self.rule(Self.stableID, .stable)
+        let beta = try Self.rule(Self.betaID, .beta)
+        #expect(stable.usePrereleases == false)
+        #expect(beta.usePrereleases == true)
+        #expect(stable.installedTagPrefix == nil && beta.installedTagPrefix == nil,
+                "the channels are separate bundle ids — nothing needs tag-based channel discovery")
+    }
+
+    /// Real tags (fetched 2026-10-14) and what each rule must read out of them.
+    @Test(arguments: [("v0.11.19", "0.11.19"), ("v0.11.12", "0.11.12"), ("v0.10.23", "0.10.23")])
+    func stableTagsResolveToTheirVersion(tag: String, expected: String) throws {
+        let rule = try Self.rule(Self.stableID, .stable)
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == expected)
+    }
+
+    /// The beta pattern keeps the `-beta.<N>` tail, because the bundle keeps it:
+    /// the v0.11.21-beta.120 artifact's `CFBundleShortVersionString` reads
+    /// `0.11.21-beta.120`. Capturing only the base would compare `0.11.21`
+    /// against that and report a beta copy as behind its own release.
+    @Test(arguments: [
+        ("v0.11.21-beta.120", "0.11.21-beta.120"),
+        ("v0.11.20-beta.119", "0.11.20-beta.119"),
+        ("v0.9.6-beta.53", "0.9.6-beta.53"),
+    ])
+    func betaTagsResolveToTheBundlesOwnVersion(tag: String, expected: String) throws {
+        let rule = try Self.rule(Self.betaID, .beta)
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == expected)
+    }
+
+    /// The other tag shapes on this repo, each a real tag. The `-sequoia` and
+    /// `-alpha.<N>` ones are flagged prerelease today, so `/releases/latest`
+    /// would not return them anyway — the anchors are what still keep them out
+    /// if one is ever mis-flagged. Each train must also refuse the other's tags.
+    @Test(arguments: ["v0.9.7-sequoia", "v0.5.7-alpha.22", "v0.11.21-beta.120"])
+    func theStableRuleRefusesEveryOtherTagShape(tag: String) throws {
+        let rule = try Self.rule(Self.stableID, .stable)
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == nil)
+    }
+
+    @Test(arguments: ["v0.11.19", "v0.9.7-sequoia", "v0.5.7-alpha.22"])
+    func theBetaRuleRefusesEveryOtherTagShape(tag: String) throws {
+        let rule = try Self.rule(Self.betaID, .beta)
+        #expect(VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern) == nil)
+    }
+
+    /// Identities read off the real artifacts. The beta app is told apart by its
+    /// bundle id alone, which is also how the vendor's own updater does it.
+    ///
+    /// The third case is the known gap, pinned so it cannot change unnoticed: the
+    /// frozen macOS 15 build (v0.9.7-sequoia dmg) shares the stable bundle id and
+    /// detects as `.stable`, so the stable rule serves it.
+    @Test func realBundlesDetectAsTheirChannel() {
+        #expect(ReleaseChannel.detect(
+            name: "Tinycast Beta", bundleID: Self.betaID, keystoneChannel: nil,
+            version: "0.11.21-beta.120") == .beta)
+        #expect(ReleaseChannel.detect(
+            name: "Tinycast", bundleID: Self.stableID, keystoneChannel: nil,
+            version: "0.11.19") == .stable)
+        #expect(ReleaseChannel.detect(
+            name: "Tinycast", bundleID: Self.stableID, keystoneChannel: nil,
+            version: "0.9.7-sequoia") == .stable)
+    }
+
+    /// `-beta.<N>` must order numerically, and the base must win over `<N>`.
+    /// `<N>` is the Actions run number, so in practice both rise together; the
+    /// comparator has to agree with the vendor's semver either way.
+    @Test func betaVersionsOrderTheWayTheVendorOrdersThem() {
+        #expect(VersionComparator.isNewer("0.11.21-beta.120", than: "0.11.20-beta.119"))
+        #expect(VersionComparator.isNewer("0.10.0-beta.100", than: "0.9.10-beta.99"))
+        #expect(VersionComparator.isNewer("0.9.10-beta.58", than: "0.9.10-beta.9"))
+        #expect(!VersionComparator.isNewer("0.11.21-beta.120", than: "0.11.21-beta.120"))
+    }
+
+    /// Why this family carries no `ChangelogRecipe`: the inline parse of a real
+    /// body already yields the changelog, and nothing from below the vendor's
+    /// `<!-- tinycast:install -->` marker (Homebrew commands, the quarantine
+    /// note) reaches it — that text is prose and fenced code, never a top-level
+    /// bullet. "New Contributors" is skipped by the parser's own keyword list.
+    ///
+    /// The v0.11.19 body as fetched 2026-10-14, abridged: the first three and
+    /// the last of its 72 "What's Changed" bullets, the first two of its ten
+    /// "New Contributors" lines, and everything from the marker down verbatim.
+    @Test func theRealReleaseBodyYieldsOnlyTheChangelog() throws {
+        let body = """
+            ## What's Changed
+            * Add local Dictation and expand keyboard shortcut capabilities by @Risengan in #1280
+            * Preserve pinned clipboard state during Raycast import by @barissglc in #1284
+            * Truncate a long extension toast instead of squeezing the actions by @list-jonas in #1287
+            * Load bundled extension dependencies by @szupzj18 in #1489
+
+            ## New Contributors
+            * @barissglc made their first contribution in #1284
+            * @filiperocha made their first contribution in #1292
+
+            <!-- tinycast:install -->
+
+            **Channel:** stable · **Version:** 0.11.19 · **Bundle ID:** `com.tinycast.app`
+            Built from 126c998d87cd7e93bd5e3437098d9c646eb6a714. [Full changelog](https://github.com/abue-ammar/tinycast/compare/v0.11.12...v0.11.19)
+
+            **Recommended:** install via Homebrew — it clears the quarantine flag automatically on every install and update, so there's nothing to run by hand:
+            ```sh
+            brew trust --tap abue-ammar/tinycast
+            brew install --cask abue-ammar/tinycast/tinycast
+            ```
+            On an **Intel** Mac, install `abue-ammar/tinycast/tinycast-universal` instead — same app, built with both slices.
+            This build is self-signed. If you download the DMG directly instead of using Homebrew, macOS will refuse to open it until you clear the quarantine flag once:
+            ```sh
+            xattr -dr com.apple.quarantine "/Applications/Tinycast.app"
+            ```
+            """
+        let parsed = GitHubMarkdownParser.parse(body: body, version: "0.11.19", date: "2026-10-10")
+        let entry = try #require(parsed?.entries.first)
+
+        #expect(entry.items.count == 4)
+        #expect(entry.items.first?.hasPrefix("Add local Dictation") == true)
+        #expect(entry.items.last?.hasPrefix("Load bundled extension dependencies") == true)
+        for item in entry.items {
+            #expect(!item.contains("made their first contribution"), "\(item)")
+            #expect(!item.contains("brew"), "\(item)")
+            #expect(!item.contains("xattr"), "\(item)")
+        }
+    }
+}
