+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/LokiiGitHubRuleTests.swift
@@ -0,0 +1,45 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Lokii (`Recipes/com-lokii-app.swift`): one single-arch dmg per architecture,
+/// ad-hoc signed, so the rule is digest-only and must land the dmg built for this Mac.
+@Suite struct LokiiGitHubRuleTests {
+
+    private static var rule: GitHubReleaseRule? {
+        GitHubReleaseRegistry.rules.first { $0.bundleID == "com.lokii.app" }
+    }
+
+    @Test func ruleReadsTheBareTagAndBothArchDmgs() throws {
+        let rule = try #require(Self.rule, "no GitHubReleaseRule for com.lokii.app")
+        #expect(rule.owner == "huangy7" && rule.repo == "lokii")
+        #expect(rule.channel == .stable && !rule.usePrereleases)
+        #expect(rule.installerKind == .dmg)
+        #expect(rule.installTrust == .publishedDigestOnly)
+        let pattern = try #require(rule.installAssetPattern)
+        func matches(_ name: String) -> Bool {
+            name.range(of: pattern, options: .regularExpression) != nil
+        }
+
+        #expect(VendorProbeRecipe.extractVersion(from: "v0.1.2", pattern: rule.versionPattern) == "0.1.2")
+        #expect(VendorProbeRecipe.extractVersion(from: "v0.2.0-rc.1", pattern: rule.versionPattern) == nil)
+
+        #expect(matches("Lokii-arm64.dmg"))
+        #expect(matches("Lokii-x86_64.dmg"))
+        #expect(!matches("Lokii-arm64.dmg.sha256"))
+        #expect(!matches("Lokii-0.1.2-arm64.zip"))
+    }
+
+    @Test func eachMacGetsItsOwnDmg() throws {
+        let pattern = try #require(Self.rule?.installAssetPattern)
+        let assets: [(name: String, url: URL, size: Int64?)] = [
+            ("Lokii-arm64.dmg", URL(string: "https://example.com/Lokii-arm64.dmg")!, 4_993_892),
+            ("Lokii-x86_64.dmg", URL(string: "https://example.com/Lokii-x86_64.dmg")!, 5_102_738),
+        ]
+        #expect(GitHubReleaseRule.installableAsset(
+            from: assets, matching: pattern, preferring: .arm64)?.url.lastPathComponent == "Lokii-arm64.dmg")
+        #expect(GitHubReleaseRule.installableAsset(
+            from: assets, matching: pattern, preferring: .x86_64)?.url.lastPathComponent == "Lokii-x86_64.dmg")
+    }
+}
