@@ -0,0 +1,40 @@
+import Foundation
+
+enum ai_storyteller_pdfcraft {
+    static let set = AppRecipeSet(
+        family: "ai-storyteller-pdfcraft",
+        githubRules: [
+        // Shared rationale for storytold's "-craft" apps: Recipes/ai-storyteller-photocraft.swift.
+
+        // PdfCraft — the Acrobat counterpart, PrintCraft until v0.4.0. Same pipeline,
+        // same anchors (they keep `-rc.N` tags and the `pdfcraft-cli-…` zip out).
+        //
+        // The rename (storytold/pdfcraft#174) changed the repo (storytold/printcraft
+        // now redirects here), the assets (`printcraft-…` up to v0.2.1, `pdfcraft-…`
+        // from v0.4.0) and the bundle id (ai.storyteller.printcraft →
+        // ai.storyteller.pdfcraft). The asset pattern takes the `pdfcraft-` dmg
+        // alone, so it can never hand this id an old-id build.
+        // One-click: ai.storyteller.pdfcraft, Team DJ6XS33FX8, notarized.
+        GitHubReleaseRule(
+            bundleID: "ai.storyteller.pdfcraft",
+            owner: "storytold", repo: "pdfcraft",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern: #"^pdfcraft-[0-9]+\.[0-9]+\.[0-9]+-macos-universal\.dmg$"#,
+            installerKind: .dmg),
+
+        // A copy still on the pre-rename id (PrintCraft ≤ 0.2.1, same Team).
+        // Detection-only on purpose: the download is ai.storyteller.pdfcraft,
+        // which the bundle-id gate refuses over ai.storyteller.printcraft, and
+        // installing it leaves PrintCraft.app in place beside PdfCraft.app. The
+        // vendor moves PrintCraft's settings on PdfCraft's first launch (#174),
+        // so pointing such a copy at the release page is the honest answer. The
+        // old rule read `printcraft-…` dmgs and so walked back to v0.2.1 for
+        // ever. `variant` keeps its `recipeID` apart from the rule above, which
+        // reads the same repo.
+        GitHubReleaseRule(
+            bundleID: "ai.storyteller.printcraft",
+            owner: "storytold", repo: "pdfcraft",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            variant: "printcraft"),
+        ])
+}
