@@ -0,0 +1,146 @@
+import Testing
+import Foundation
+@testable import DuoUpdaterCore
+
+/// Spotifast (`rocks.spotifast.Spotifast`, `crmne/spotifast`): GitHub rule plus a
+/// changelog recipe over the same repo's releases. See `rocks-spotifast-Spotifast.swift`.
+///
+/// The fixture is three real releases from the live `per_page` listing fetched
+/// 2026-10-14: v0.12.0 and v0.11.2 verbatim (tag, `prerelease`, `draft`,
+/// `published_at`, body), and v0.5.0-rc2, which the workflow flagged as a prerelease.
+private let spotifastReleasesFixture = #"""
+[
+  {
+    "tag_name": "v0.12.0",
+    "prerelease": false,
+    "draft": false,
+    "published_at": "2026-10-03T16:05:07Z",
+    "body": "Spotifast 0.12.0 rests the audio device while you're paused, lets you drop skins on the window on Wayland again, speaks Turkish, and fixes the queue, the Add to playlist menu, the volume on phones and a crowded top bar. It also finishes the move from Fastpotify: the old name, command and profile move are gone.\n\n**Download Spotifast:** [Mac](https://github.com/crmne/spotifast/releases/download/v0.12.0/spotifast-v0.12.0-macos-universal.dmg) · [Windows](https://github.com/crmne/spotifast/releases/download/v0.12.0/spotifast-v0.12.0-x86_64-pc-windows-msvc-setup.exe) · [Windows ARM](https://github.com/crmne/spotifast/releases/download/v0.12.0/spotifast-v0.12.0-aarch64-pc-windows-msvc-setup.exe) · [Linux](https://github.com/crmne/spotifast/releases/download/v0.12.0/spotifast-v0.12.0-x86_64-unknown-linux-gnu.tar.gz) · [Linux ARM](https://github.com/crmne/spotifast/releases/download/v0.12.0/spotifast-v0.12.0-aarch64-unknown-linux-gnu.tar.gz) · [Flatpak](https://github.com/crmne/spotifast/releases/download/v0.12.0/spotifast-v0.12.0-x86_64.flatpak) · [AppImage](https://github.com/crmne/spotifast/releases/download/v0.12.0/spotifast-0.12.0-x86_64.AppImage) · [AppImage ARM](https://github.com/crmne/spotifast/releases/download/v0.12.0/spotifast-0.12.0-aarch64.AppImage)\n\n## New\n\n- **A paused Spotifast costs nothing.** Paused, Spotifast used to keep the audio device running and fed it silence. Now the device rests until you press Play, and starts again at once. On a Mac that took Spotifast from about 0.5% of a core to nothing, and macOS's audio service from about 4% to nearly nothing; Windows' audio service went from about 5% to nothing. By @crmne; thanks @gagarine. (#636)\n- **Turkish.** Spotifast is now available in Turkish. By @brsbrkctn. (#643)\n- **Drop skins on the window on Wayland again.** Dropping a `.wsz` skin, or any file, on the window works on Wayland again, and pasting keeps working on Hyprland. This lifts the 0.11.2 limitation. By @crmne.\n- **Every command works on Linux too.** `spotifast now-playing`, `devices`, `next`, `like`, `transfer` and the other subcommands now work on Linux as they do on macOS and Windows, beside MPRIS. By @crmne.\n- **Scrolling, the tray and media controls shared with ZapFast and Solco.** Spotifast's scrolling, single-instance guard and desktop media controls now come from fastframe, the foundation its sister apps share, so fixes reach every app. Scrolling picks up two fixes on the way: a slow frame no longer cuts a touchpad gesture short. By @crmne.\n\n## Fixed\n\n- **Reordering the queue moves the song you dragged.** Several quick moves in Playing next could move a different song, or empty the list until the next track. By @crmne; thanks @D3SOX. (#598)\n- **The Add to playlist menu stays open while you search.** Clicking its search field closed the menu, and clearing a search left the list short. By @crmne; thanks @D3SOX. (#638)\n- **The volume is greyed out for devices that won't take it.** When the playing device, such as an iPhone over Bluetooth, doesn't let other apps change its volume, the volume control is now greyed out with a tooltip instead of showing an error. By @crmne; thanks @jorisw. (#627)\n- **The top bar keeps its room in a narrow window.** With Queue or Lyrics open, the buttons beside the search field ran over it. The side panels now give way, down to their narrowest, and the window can't be made narrower than they need while they're open. By @crmne; thanks @oo7kc. (#624)\n- **A personal Spotify app is told to authorize again, not to sign in.** A personal app set up before 0.9.0 showed \"Spotify permissions changed. Sign in again.\" on every launch, which signing in couldn't fix. The message now points to Authorize in Settings → Account. By @crmne; thanks @azais-corentin. (#634)\n- **The window keeps its size when the interface is zoomed.** With the zoom not at 100%, the window shrank on every restart. By @crmne.\n- **Older Windows graphics drivers start Spotifast.** When a modern OpenGL context isn't available, Spotifast now falls back to a compatible one instead of failing to start. By @crmne.\n\n## Changed\n\n- **Fastpotify is gone.** Spotifast no longer carries the old name anywhere:\n  - the `fastpotify` command is gone; use `spotifast`;\n  - settings, sign-ins and caches from Fastpotify 0.9.0 or older are no longer moved over: if you update straight from one of those, you start fresh (your old files stay where they were);\n  - on Windows, if you're on 0.10.0 to 0.10.2, start Spotifast once by hand after this update: those versions' updater looks for the old program name.\n- **The `rodio` audio backend setting now always means Spotifast's own output,** which it always did in practice; librespot's separate rodio output is no longer included. PulseAudio stays available on Linux.\n- **Scripts and tools that talked to port 47113 need the command line now.** On macOS and Windows the fixed local port is gone, replaced by a private channel only your own `spotifast` command can use. The `spotifast` subcommands work as before; tools that opened the port directly, such as Stream Deck plugins, should call them instead.\n\n## Thanks\n\n@brsbrkctn, @D3SOX, @jorisw, @oo7kc, @azais-corentin, @gagarine, @jescribmun, and everyone who reported problems since 0.11.2.\n\n**Full changelog**: https://github.com/crmne/spotifast/compare/v0.11.2...v0.12.0\n"
+  },
+  {
+    "tag_name": "v0.5.0-rc2",
+    "prerelease": true,
+    "draft": false,
+    "published_at": "2026-09-01T14:57:40Z",
+    "body": "0.5.0-rc2 adds MilkDrop, a better queue, playback history, and multi-select. The macOS build is not notarized yet. Follow the first-open steps on the [download page](https://fastpotify.rocks/download/).\n\n## New\n\n- **MilkDrop** by @crmne. Run it in its own window, make it fullscreen, and switch between thousands of presets. It is not included in the Windows on ARM build.\n\n  https://github.com/user-attachments/assets/0d408524-2c31-4e43-bd05-73eef3a20f1e\n\n- **A better queue** by @crmne. It updates immediately, survives restarts, and can be cleared or saved as a playlist. Song radio now opens with its queue visible. Thanks @shaded00. (#93)\n- **Recent now includes Spotify history and songs played in Fastpotify.** By @zHeuzy2 and @crmne. Thanks @penguin221. (#106, #113)\n- **Multi-select** by @crmne. Ctrl-click or Cmd-click selects songs. Shift-click selects a range. Thanks @penguin221. (#105)\n- **Fastpotify remembers the last song and position.** By @koels. (#98)\n\n## Fixed\n\n- Artwork no longer makes the window flash. By @crmne; thanks @Ianuarius. (#129)\n- Browser sign-in works when Windows cannot find `powershell.exe`. By @crmne; thanks @Nippey. (#107)\n- The macOS first-open command works on macOS 27. By @crmne; thanks @jorisw. (#126)\n\n## Thanks\n\n@koels, @zHeuzy2, @braydenpb72, @penguin221, @shaded00, @Nippey, @jorisw, and @Ianuarius.\n\n**Full changelog**: https://github.com/crmne/fastpotify/compare/v0.4.1...v0.5.0-rc2\n"
+  },
+  {
+    "tag_name": "v0.11.2",
+    "prerelease": false,
+    "draft": false,
+    "published_at": "2026-09-30T23:11:58Z",
+    "body": "Spotifast 0.11.2 puts the new icon everywhere the app shows its logo, makes pasting work again on Hyprland, keeps running when a computer has no audio output, and keeps desktop media controls in step with the volume.\n\n**Download Spotifast:** [Mac](https://github.com/crmne/spotifast/releases/download/v0.11.2/spotifast-v0.11.2-macos-universal.dmg) · [Windows](https://github.com/crmne/spotifast/releases/download/v0.11.2/spotifast-v0.11.2-x86_64-pc-windows-msvc-setup.exe) · [Windows ARM](https://github.com/crmne/spotifast/releases/download/v0.11.2/spotifast-v0.11.2-aarch64-pc-windows-msvc-setup.exe) · [Linux](https://github.com/crmne/spotifast/releases/download/v0.11.2/spotifast-v0.11.2-x86_64-unknown-linux-gnu.tar.gz) · [Linux ARM](https://github.com/crmne/spotifast/releases/download/v0.11.2/spotifast-v0.11.2-aarch64-unknown-linux-gnu.tar.gz) · [Flatpak](https://github.com/crmne/spotifast/releases/download/v0.11.2/spotifast-v0.11.2-x86_64.flatpak) · [AppImage](https://github.com/crmne/spotifast/releases/download/v0.11.2/spotifast-0.11.2-x86_64.AppImage) · [AppImage ARM](https://github.com/crmne/spotifast/releases/download/v0.11.2/spotifast-0.11.2-aarch64.AppImage)\n\n![The sign-in and connecting card with the new icon](https://raw.githubusercontent.com/crmne/spotifast/v0.11.2/packaging/release-notes/v0.11.2/sign-in.png)\n\n*The sign-in card, before and while connecting (demo content).*\n\n## Fixed\n\n- **The new icon is on every screen.** 0.11.1 refreshed the app icon, but the sign-in and connecting card and Settings → About still drew the old flat disc. They now show the same icon as the app, the window and the tray, and the built-in Winamp skin's logo button and About mark have its polished look too. By @crmne.\n- **Pasting works again on Hyprland.** Ctrl+V and Paste in the text menu did nothing on Hyprland, such as on Omarchy, in every field, including the Client ID. By @crmne; thanks @fgrehm. (#614)\n- **No audio output no longer closes Spotifast.** On a computer without an output device, for example a new PC still missing its audio drivers, pressing play closed the app without a word. The song now pauses with a message saying no audio output device was found, in your language, and Spotifast stays open to play on another Spotify Connect device. By @crmne; thanks @spencernaugler7. (#623)\n- **Desktop media controls keep up with the volume.** Changing the volume from your desktop's media controls on Linux could leave them showing the old level. By @rosset-nocpes. (#599)\n\n## Known limitations\n\n- On Wayland, dropping a file on the window, such as a `.wsz` skin, is not available for now: it took the clipboard from the rest of the app on Hyprland. Put skins in the skins folder that Settings opens instead. X11, macOS and Windows are unaffected.\n\n## Thanks\n\n@rosset-nocpes, @spencernaugler7, @fgrehm, and everyone who reported problems after 0.11.1.\n\n**Full changelog**: https://github.com/crmne/spotifast/compare/v0.11.1...v0.11.2\n"
+  }
+]
+"""#
+
+private func spotifastRecipe() throws -> ChangelogRecipe {
+    try #require(
+        ChangelogRecipeRegistry.recipes.first { $0.bundleID == "rocks.spotifast.Spotifast" },
+        "no Spotifast changelog recipe")
+}
+
+private func spotifastChangelog() throws -> Changelog {
+    try #require(ChangelogService.parse(try spotifastRecipe(), body: spotifastReleasesFixture))
+}
+
+@Test func spotifastChangelogDropsThePrereleaseAndKeepsTheTagMinusV() throws {
+    #expect(try spotifastChangelog().entries.map(\.version) == ["0.12.0", "0.11.2"])
+}
+
+/// Sections stay headings; the `## Thanks` roster and the download-links line are not items
+/// (no `skipSections` needed: both are paragraphs).
+@Test func spotifastReleaseBodyKeepsItsSectionsWithoutTheRoster() throws {
+    let newest = try #require(try spotifastChangelog().entries.first)
+    #expect(newest.date == "2026-10-03")
+    let headings = newest.content.compactMap { block -> String? in
+        if case .heading(let h) = block { return h }
+        return nil
+    }
+    #expect(headings == ["New", "Fixed", "Changed"])
+    #expect(!newest.items.contains { $0.contains("D3SOX, @jorisw") || $0.contains("Download Spotifast") })
+}
+
+@Test func spotifastGitHubRuleReadsTheBareTagAndTheUniversalDmgOnly() throws {
+    let rule = try #require(
+        GitHubReleaseRegistry.rules.first { $0.bundleID == "rocks.spotifast.Spotifast" },
+        "no GitHubReleaseRule for rocks.spotifast.Spotifast")
+    #expect(rule.owner == "crmne" && rule.repo == "spotifast")
+    #expect(rule.channel == .stable && !rule.usePrereleases)
+    #expect(rule.installerKind == .dmg)
+    let pattern = try #require(rule.installAssetPattern)
+    func extract(_ tag: String) -> String? {
+        VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+    }
+    func matches(_ name: String) -> Bool {
+        name.range(of: pattern, options: .regularExpression) != nil
+    }
+
+    #expect(extract("v0.13.0") == "0.13.0")
+    #expect(extract("v0.5.0-rc2") == nil)
+
+    // The real v0.13.0 asset listing.
+    #expect(matches("spotifast-v0.13.0-macos-universal.dmg"))
+    #expect(!matches("spotifast-v0.5.0-rc2-macos-universal.dmg"))
+    #expect(!matches("spotifast-0.13.0-x86_64.AppImage"))
+    #expect(!matches("spotifast-v0.13.0-x86_64-pc-windows-msvc.msi"))
+    #expect(!matches("spotifast-v0.13.0-x86_64-unknown-linux-gnu.tar.gz"))
+    #expect(!matches("spotifast-v0.13.0-source.tar.gz"))
+    #expect(!matches("checksums.txt"))
+}
+
+// MARK: - Copies still on the Fastpotify bundle id (0.9.1 and below)
+
+/// Measured on the real dmgs: 0.7.1 is ad-hoc signed, 0.8.0 and 0.9.1 are Developer ID
+/// (JPL7999US3) and still `me.paolino.fastpotify`, 0.10.0 is the first
+/// `rocks.spotifast.Spotifast`.
+@Test func spotifastOldIdRuleDetectsAndNeverInstalls() throws {
+    let rule = try #require(
+        GitHubReleaseRegistry.rules.first { $0.bundleID == "me.paolino.fastpotify" },
+        "no GitHubReleaseRule for me.paolino.fastpotify")
+    #expect(rule.owner == "crmne" && rule.repo == "spotifast")
+    #expect(rule.channel == .stable && !rule.usePrereleases)
+    // Detection only: settings from 0.9.0 and older are not carried to current releases.
+    #expect(rule.installAssetPattern == nil && rule.installerKind == nil)
+    #expect(VendorProbeRecipe.extractVersion(from: "v0.13.0", pattern: rule.versionPattern) == "0.13.0")
+    #expect(VendorProbeRecipe.extractVersion(from: "v0.5.0-rc2", pattern: rule.versionPattern) == nil)
+}
+
+@Test func spotifastOldIdCopiesAreFiledUnderTheNewIdUpToTheBound() {
+    for version in ["0.7.1", "0.8.0", "0.9.1"] {
+        #expect(BundleIDMigration.recipeBundleID(
+            for: "me.paolino.fastpotify", installedVersion: version) == "rocks.spotifast.Spotifast")
+    }
+    #expect(BundleIDMigration.recipeBundleID(
+        for: "me.paolino.fastpotify", installedVersion: "0.10.0") == "me.paolino.fastpotify")
+    #expect(BundleIDMigration.recipeBundleID(
+        for: "rocks.spotifast.Spotifast", installedVersion: "0.9.1") == "rocks.spotifast.Spotifast")
+}
+
+/// The identity gate lets a new-id download replace a Developer ID old-id copy of the
+/// same Team only; an ad-hoc copy (0.7.1 and below, no Team) is refused.
+@Test func spotifastIdentityGateAdmitsOnlyTheSameTeam() {
+    func admitted(team: String?, version: String = "0.9.1") -> Bool {
+        BundleIDMigration.migration(
+            installed: "me.paolino.fastpotify", downloaded: "rocks.spotifast.Spotifast",
+            installedVersion: version, installedTeam: team, downloadedTeam: "JPL7999US3") != nil
+    }
+    #expect(admitted(team: "JPL7999US3"))
+    #expect(!admitted(team: nil, version: "0.7.1"))
+    #expect(!admitted(team: "ABCDE12345"))
+    #expect(!admitted(team: "JPL7999US3", version: "0.10.0"))
+}
+
+/// Both ids read `crmne/spotifast` on the stable channel, so the bundle id is what keeps their
+/// health rows apart; a rule with no sibling keeps the plain key.
+@Test func spotifastRulesKeepSeparateHealthKeys() throws {
+    let ids = GitHubReleaseRegistry.rules
+        .filter { $0.slug == "crmne/spotifast" }.map(\.recipeID).sorted()
+    #expect(ids == [
+        "github:crmne/spotifast:stable:me.paolino.fastpotify",
+        "github:crmne/spotifast:stable:rocks.spotifast.Spotifast",
+    ])
+    let photocraft = try #require(
+        GitHubReleaseRegistry.rules.first { $0.bundleID == "ai.storyteller.photocraft" })
+    #expect(photocraft.recipeID == "github:storytold/photocraft:stable")
+}
