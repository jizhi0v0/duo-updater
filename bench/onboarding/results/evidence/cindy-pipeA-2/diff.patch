diff --git a/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-xd-cindy.swift b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-xd-cindy.swift
new file mode 100644
index 0000000..7fa7a49
--- /dev/null
+++ b/DuoUpdaterCore/Sources/DuoUpdaterCore/Recipes/com-xd-cindy.swift
@@ -0,0 +1,122 @@
+import Foundation
+
+enum com_xd_cindy {
+    static let set = AppRecipeSet(
+        family: "com-xd-cindy",
+        probes: [
+        // Cindy (cn edition, com.xd.cindycn) — the vendor's own update manifest,
+        // one per architecture. The global edition is read from GitHub below; the
+        // cn edition cannot be, because a GitHub rule's `recipeID` is
+        // `github:<owner>/<repo>:<channel>` and a second stable rule on the same
+        // repo shares the first one's health row (`RecipeHealthKeyTests`). A
+        // probe is keyed by bundle id, so it has no such collision.
+        //
+        // The manifest base is the `cdnBaseUrl` the app loads from
+        // `config/endpoint.json` in the open-source repo; the file name is
+        // `manifest-<platform>-<arch>.json` (`manifestService.ts`). The track
+        // suffix (`-beta`, `-canary`) is the other two tracks and is not read
+        // here. The body also holds codex, claudeCode, pi and codexPackage
+        // entries with their own `version` and `sha256`, so every pattern is
+        // anchored to the `app` object, and the digest to the `installer`
+        // object inside it (`app.hotfix` is a full-bundle zip with a digest of
+        // its own, and is not what one-click installs). The digest is that of
+        // the dmg the install pattern resolves, and it equals the digest GitHub
+        // publishes for the same release asset.
+        //
+        // Bundle: com.xd.cindycn, Team NTC4BJ542G, notarized; short == build ==
+        // the manifest's `app.version`. Two recipes, one per architecture: the
+        // manifest URL differs, and `hostRequirement` keeps an Intel Mac off the
+        // arm64 build and the reverse.
+        VendorProbeRecipe(
+            bundleID: "com.xd.cindycn",
+            url: URL(string: "https://hotfix.cindy.com.cn/cindy/manifest-darwin-arm64.json")!,
+            mode: .responseBody,
+            versionPattern: #""app"\s*:\s*\{\s*"version"\s*:\s*"([0-9]+\.[0-9]+\.[0-9]+)""#,
+            downloadURL: URL(string: "https://cindy.com.cn"),
+            changelogURL: URL(string: "https://github.com/makecindy/cindy/releases"),
+            install: VendorInstallSpec(
+                urlSource: .bodyPatternRelative(
+                    #""installer"\s*:\s*\{\s*"file"\s*:\s*"(app/darwin-arm64/[^"]+\.dmg)""#,
+                    base: URL(string: "https://hotfix.cindy.com.cn/cindy/")!),
+                kind: .dmg,
+                checksumPattern: #""installer"\s*:\s*\{[^{}]*?"sha256"\s*:\s*"([0-9a-f]{64})""#,
+                checksumFormat: .sha256Hex),
+            variant: "arm64",
+            hostRequirement: VendorHostRequirement(architectures: [.arm64])),
+        VendorProbeRecipe(
+            bundleID: "com.xd.cindycn",
+            url: URL(string: "https://hotfix.cindy.com.cn/cindy/manifest-darwin-x64.json")!,
+            mode: .responseBody,
+            versionPattern: #""app"\s*:\s*\{\s*"version"\s*:\s*"([0-9]+\.[0-9]+\.[0-9]+)""#,
+            downloadURL: URL(string: "https://cindy.com.cn"),
+            changelogURL: URL(string: "https://github.com/makecindy/cindy/releases"),
+            install: VendorInstallSpec(
+                urlSource: .bodyPatternRelative(
+                    #""installer"\s*:\s*\{\s*"file"\s*:\s*"(app/darwin-x64/[^"]+\.dmg)""#,
+                    base: URL(string: "https://hotfix.cindy.com.cn/cindy/")!),
+                kind: .dmg,
+                checksumPattern: #""installer"\s*:\s*\{[^{}]*?"sha256"\s*:\s*"([0-9a-f]{64})""#,
+                checksumFormat: .sha256Hex),
+            variant: "x64",
+            hostRequirement: VendorHostRequirement(architectures: [.x86_64])),
+        ],
+        changelogs: [
+        // Cindy — release bodies from the releases API, for both editions (one
+        // repo, one body per release). Bodies are Markdown: a `## 更新说明` title
+        // over `###` sections, then a `## PRs` list of links and a `---` block of
+        // commit, source tag and mobile build numbers. `PRs` is not a change
+        // note. The list also carries the `-beta` prereleases, which the
+        // `.gitHubReleases` format leaves out.
+        ChangelogRecipe(
+            bundleID: "com.xd.cindy",
+            source: URL(string: "https://api.github.com/repos/makecindy/cindy/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["PRs"]),
+        ChangelogRecipe(
+            bundleID: "com.xd.cindycn",
+            source: URL(string: "https://api.github.com/repos/makecindy/cindy/releases?per_page=40")!,
+            mode: .json,
+            maxEntries: 20,
+            structuredFormat: .gitHubReleases,
+            skipSections: ["PRs"]),
+        ],
+        githubRules: [
+        // Cindy (global edition, com.xd.cindy, Team SX9RG894L5) — Electron app
+        // (makecindy/cindy, Apache-2.0). No `SUFeedURL`, no Sparkle, no
+        // `app-update.yml`; the app's own updater reads the CDN manifest the cn
+        // probe above reads, and the GitHub release carries the same dmgs (same
+        // sha256 per file). GitHub is the source here because it is one request
+        // that also names the release page; the cn edition is the one that
+        // cannot use it (see above). v-tags equal CFBundleShortVersionString and
+        // CFBundleVersion.
+        //
+        // The repo also holds a stable `v1.0.0` release with no assets (an
+        // open-source snapshot of the 1.0.0 line, not an installer). It matches
+        // the version pattern but has no dmg, so it can never be the answer
+        // while the source walks past a release without a matching asset;
+        // `/releases/latest` is the newest desktop build.
+        //
+        // Betas and canary are other tracks of the same bundle id, switched by a
+        // device-level setting and an account flag in the app's own userData, and
+        // are not covered (see the audit): `-beta` tags are prereleases, which
+        // `/releases/latest` never returns, and `installedTagPrefix` does not fit
+        // (`v` + short is not the `-beta` tag). The tag anchor keeps a `-beta`
+        // out should one ever be flagged stable.
+        //
+        // One-click: the dmg for the host architecture (`x64` marks the Intel
+        // build, which the architecture-aware selector prefers on an Intel Mac).
+        // Both are Developer ID, notarized, stapled; arm64 and x64 share the
+        // bundle id and Team, and the Team is the same on 0.1.103 and 0.1.104.
+        // The nested apps under `Contents/Frameworks` are Electron's
+        // `LSUIElement` helpers.
+        GitHubReleaseRule(
+            bundleID: "com.xd.cindy",
+            owner: "makecindy", repo: "cindy",
+            versionPattern: #"^v([0-9]+\.[0-9]+\.[0-9]+)$"#,
+            installAssetPattern:
+                #"^cindy-[0-9]+\.[0-9]+\.[0-9]+-darwin-(?:arm64|x64)-global\.dmg$"#,
+            installerKind: .dmg),
+        ])
+}
diff --git a/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyRecipeTests.swift b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyRecipeTests.swift
new file mode 100644
index 0000000..c7c16bc
--- /dev/null
+++ b/DuoUpdaterCore/Tests/DuoUpdaterCoreTests/CindyRecipeTests.swift
@@ -0,0 +1,150 @@
+import Foundation
+import Testing
+
+@testable import DuoUpdaterCore
+
+/// Cindy (`Recipes/com-xd-cindy.swift`): the global edition's GitHub rule and the
+/// cn edition's CDN-manifest probes. The two editions are separate apps (their
+/// own bundle ids and Teams) published from one repo.
+@Suite struct CindyRecipeTests {
+
+    // MARK: - global: GitHub rule
+
+    /// The asset list of release v0.1.104, as GitHub names them.
+    private static let assetNames = [
+        "cindy-0.1.104-darwin-arm64-cn.dmg", "cindy-0.1.104-darwin-arm64-global.dmg",
+        "cindy-0.1.104-darwin-x64-cn.dmg", "cindy-0.1.104-darwin-x64-global.dmg",
+        "cindy-0.1.104-linux-x64-cn.deb", "cindy-0.1.104-linux-x64-global.deb",
+        "cindy-0.1.104-win32-x64-cn.exe", "cindy-0.1.104-win32-x64-global.exe",
+    ]
+
+    private static func globalRule() throws -> GitHubReleaseRule {
+        try #require(GitHubReleaseRegistry.rules.first { $0.bundleID == "com.xd.cindy" })
+    }
+
+    private static func assets() -> [(name: String, url: URL, size: Int64?)] {
+        assetNames.map {
+            ($0, URL(string: "https://github.com/makecindy/cindy/releases/download/v0.1.104/\($0)")!, nil)
+        }
+    }
+
+    /// Each Mac gets its own architecture's global dmg, never the cn one, a deb or
+    /// an exe. An Intel host used to get nothing at all: with an arm64-only
+    /// pattern every release was arch-incompatible there.
+    @Test func eachHostGetsItsOwnArchitecturesGlobalDmg() throws {
+        let rule = try Self.globalRule()
+        let pattern = try #require(rule.installAssetPattern)
+        func pick(_ arch: HostArch) -> String? {
+            GitHubReleaseRule.installableAsset(
+                from: Self.assets(), matching: pattern, preferring: arch,
+                allowingIntelTranslation: false)?.url.lastPathComponent
+        }
+        #expect(pick(.arm64) == "cindy-0.1.104-darwin-arm64-global.dmg")
+        #expect(pick(.x86_64) == "cindy-0.1.104-darwin-x64-global.dmg")
+    }
+
+    @Test func theTagAnchorKeepsBetasAndOtherShapesOut() throws {
+        let rule = try Self.globalRule()
+        func extract(_ tag: String) -> String? {
+            VendorProbeRecipe.extractVersion(from: tag, pattern: rule.versionPattern)
+        }
+        #expect(extract("v0.1.104") == "0.1.104")
+        #expect(extract("v0.1.108-beta") == nil)
+        #expect(!rule.usePrereleases && rule.channel == .stable)
+    }
+
+    // MARK: - cn: CDN manifest probes
+
+    /// `https://hotfix.cindy.com.cn/cindy/manifest-darwin-arm64.json`, verbatim. The
+    /// codex, claudeCode, pi and codexPackage entries carry a `version` and a
+    /// `sha256` of their own, and `app.hotfix` a digest of the zip: none of them
+    /// may be read for the app.
+    private static let manifest = #"""
+{
+  "codex": {
+    "version": "0.145.0",
+    "file": "codex/0.145.0/darwin-arm64/codex.gz",
+    "sha256": "c879b85129dac1b1199a0833da572fa2c42de878ee96ff03b344e458c8e9cbc1",
+    "size": 105756863,
+    "binarySha256": "1da3f4e0e96028b8a771814293c3033dafd1971f943f6c7e79b0897fe705f590"
+  },
+  "claudeCode": {
+    "version": "2.1.296",
+    "file": "claude-code/2.1.296/darwin-arm64/claude.gz",
+    "sha256": "55d0a80f327670eb52fdce8b304ae89cc6d6b88f1834ece242a94cf81bf2a075",
+    "size": 105099541,
+    "binarySha256": "c9b5341637becbd423ddffc5b254afb645682a3868cb708bbc6cc0e7bb419937"
+  },
+  "app": {
+    "version": "0.1.104",
+    "installer": {
+      "file": "app/darwin-arm64/cindy-0.1.104-arm64.dmg",
+      "sha256": "8f0704e311a4c960a202cb632cf1b8d164f095d9354eee62d9c8475d9cf46331",
+      "size": 305173888
+    },
+    "hotfix": {
+      "file": "hotfix/darwin-arm64/cindy-0.1.104-arm64-hotfix.zip",
+      "sha256": "ef719de4bc6fe2eb9ee9f14cf703ae4b96ef91440f1660cb876af725d1e73939",
+      "size": 278776768
+    }
+  },
+  "pi": {
+    "version": "1.0.2",
+    "file": "pi/1.0.2/darwin-arm64/pi.dist.tar.gz",
+    "sha256": "33408a2f5cf2f51661b59fc3faa9eaaeebfde1bf110bb30cb56cd314e481e7d2",
+    "size": 31694994
+  },
+  "codexPackage": {
+    "version": "0.159.2",
+    "file": "codex-package/0.159.2/darwin-arm64/codex-package.dist.tar.gz",
+    "sha256": "a1e58a10ac3c7e5345342f93504a7628e98283d91a91bddab747c40b1c1981bc",
+    "size": 133851150
+  }
+}
+"""#
+
+    private static func probes() -> [VendorProbeRecipe] {
+        VendorProbeRegistry.recipes.filter { $0.bundleID == "com.xd.cindycn" }
+    }
+
+    @Test func oneProbePerArchitectureEachGatedToItsHost() throws {
+        let probes = Self.probes()
+        #expect(probes.count == 2)
+        #expect(Set(probes.compactMap(\.variant)) == ["arm64", "x64"])
+        for probe in probes {
+            let arch = probe.variant == "arm64" ? HostArch.arm64 : .x86_64
+            #expect(probe.hostRequirement?.architectures == [arch])
+            #expect(probe.channel == .stable)
+        }
+    }
+
+    @Test func theProbeReadsTheAppVersionInstallerFileAndItsOwnDigest() throws {
+        let probe = try #require(Self.probes().first { $0.variant == "arm64" })
+        #expect(VendorProbeRecipe.extractVersion(
+            from: Self.manifest, pattern: probe.versionPattern) == "0.1.104")
+        let spec = try #require(probe.install)
+        guard case .bodyPatternRelative(let filePattern, let base) = spec.urlSource else {
+            Issue.record("expected a .bodyPatternRelative install")
+            return
+        }
+        #expect(base.absoluteString == "https://hotfix.cindy.com.cn/cindy/")
+        #expect(VendorProbeRecipe.extractVersion(from: Self.manifest, pattern: filePattern)
+            == "app/darwin-arm64/cindy-0.1.104-arm64.dmg")
+        #expect(spec.checksumFormat == .sha256Hex)
+        // The installer's digest, which is the one GitHub publishes for
+        // `cindy-0.1.104-darwin-arm64-cn.dmg` — not the hotfix zip's or a neighbour's.
+        #expect(VendorProbeRecipe.extractVersion(
+            from: Self.manifest, pattern: try #require(spec.checksumPattern))
+            == "8f0704e311a4c960a202cb632cf1b8d164f095d9354eee62d9c8475d9cf46331")
+    }
+
+    /// An installer object that lost its digest reads nil, not the next object's.
+    @Test func aDigestlessInstallerReadsNoDigest() throws {
+        let probe = try #require(Self.probes().first { $0.variant == "arm64" })
+        let pattern = try #require(probe.install?.checksumPattern)
+        let body = Self.manifest.replacingOccurrences(
+            of: #""sha256": "8f0704e311a4c960a202cb632cf1b8d164f095d9354eee62d9c8475d9cf46331","#,
+            with: "")
+        #expect(VendorProbeRecipe.extractVersion(from: body, pattern: pattern) == nil)
+    }
+}
